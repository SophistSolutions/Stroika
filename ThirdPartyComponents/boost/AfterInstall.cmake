#
# cmake -DBUILDS_DIR=<the configuration's Builds directory, with a trailing /> -DPC=<Stroika's boost.pc for it> -P AfterInstall.cmake
#
# After boost's b2 install, as its Makefile does: Stroika's boost.pc (with Visual Studio, boost-msvc.pc, installed as
# boost.pc), and BOOST_AUTO_LINK_SYSTEM defined in boost/config/user.hpp - built with --layout=system, its libraries have no
# decorated names to auto-link by. Defined once: installing again leaves the installed user.hpp in place (newer than
# boost's own), so it may already be there. Written with UNIX line endings, as boost's own and its Makefile's echo (on
# Windows, file (APPEND) would write CRLF).
#
file (COPY_FILE "${PC}" "${BUILDS_DIR}lib/pkgconfig/boost.pc")
set (userHpp_ "${BUILDS_DIR}include/boost/config/user.hpp")
file (READ "${userHpp_}" text_)
if (NOT text_ MATCHES "#define BOOST_AUTO_LINK_SYSTEM 1")
    file (CONFIGURE OUTPUT "${userHpp_}" CONTENT "${text_}// GENERATED BY STROIKA MAKEFILE\n#define BOOST_AUTO_LINK_SYSTEM 1\n" @ONLY
        NEWLINE_STYLE UNIX)
endif ()
