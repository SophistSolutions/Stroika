#
# cmake -DBUILDS_DIR=<the configuration's Builds directory, with a trailing /> -DPC=<Stroika's boost.pc> -P AfterInstall.cmake
#
# After boost's b2 install, as its Makefile does: Stroika's boost.pc, and BOOST_AUTO_LINK_SYSTEM defined in
# boost/config/user.hpp - built with --layout=system, its libraries have no decorated names to auto-link by. Defined once:
# installing again leaves the installed user.hpp in place (newer than boost's own), so it may already be there.
#
file (COPY "${PC}" DESTINATION "${BUILDS_DIR}lib/pkgconfig")
set (userHpp_ "${BUILDS_DIR}include/boost/config/user.hpp")
file (READ "${userHpp_}" text_)
if (NOT text_ MATCHES "#define BOOST_AUTO_LINK_SYSTEM 1")
    file (APPEND "${userHpp_}" "// GENERATED BY STROIKA MAKEFILE\n#define BOOST_AUTO_LINK_SYSTEM 1\n")
endif ()
