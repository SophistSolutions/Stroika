#
# The LZMA SDK's C 7z decoder, as one library - the objects of its own C/Util/7z/makefile.gcc, less that sample program
# (7zMain, 7zFile, 7zAlloc). It is all Stroika uses (DataExchange::Archive::_7z::Reader).
#
OBJ_SUFFIX=.o
LIB_SUFFIX=.a

AR?=ar
ARCRATEFLAGS=cru
ARTARGETPREFIX=

# as that makefile: PPMd-compressed archives too; no encoders
override CFLAGS+=-DZ7_PPMD_SUPPORT -DZ7_EXTRACT_ONLY

Objs=	\
	7zArcIn$(OBJ_SUFFIX) \
	7zBuf$(OBJ_SUFFIX) \
	7zBuf2$(OBJ_SUFFIX) \
	7zCrc$(OBJ_SUFFIX) \
	7zCrcOpt$(OBJ_SUFFIX) \
	7zDec$(OBJ_SUFFIX) \
	7zStream$(OBJ_SUFFIX) \
	Bcj2$(OBJ_SUFFIX) \
	Bra$(OBJ_SUFFIX) \
	Bra86$(OBJ_SUFFIX) \
	BraIA64$(OBJ_SUFFIX) \
	CpuArch$(OBJ_SUFFIX) \
	Delta$(OBJ_SUFFIX) \
	Lzma2Dec$(OBJ_SUFFIX) \
	LzmaDec$(OBJ_SUFFIX) \
	Ppmd7$(OBJ_SUFFIX) \
	Ppmd7Dec$(OBJ_SUFFIX)

vpath %.c C

%$(OBJ_SUFFIX) : %.c
	echo '$(CC) $(CFLAGS) -c $<'
	"$(CC)" $(CFLAGS) -c $<

all:	lzma$(LIB_SUFFIX)

lzma$(LIB_SUFFIX):	$(Objs)
	echo "$(AR)" $(ARCRATEFLAGS) $(ARTARGETPREFIX)lzma$(LIB_SUFFIX) $(Objs)
	"$(AR)" $(ARCRATEFLAGS) $(ARTARGETPREFIX)lzma$(LIB_SUFFIX) $(Objs)

clean:
	@rm -f *$(OBJ_SUFFIX)

clobber:	clean
	@rm -f *$(LIB_SUFFIX)
