#!/usr/bin/python3
#
#   BuildProjectsFiles - run in its own directory: a directory NN for each regression test, holding Project-Template's
#   .gitignore and its TestN.vcxproj and TestN.vcxproj.filters as TestNN.*, with each line's first NNN replaced by NN.
#   A project file is rewritten only when that changes it, so Visual Studio does not reload an unchanged one.
#
import os
import shutil
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "..", "Scripts"))
from TestsList import ReadTests


def CopyWithSubst_(srcFile, trgFile, substValue):
    with open(srcFile, "rb") as f:
        data = b"".join(line.replace(b"NNN", substValue.encode(), 1) for line in f)
    if os.path.exists(trgFile):
        with open(trgFile, "rb") as f:
            if f.read() == data:
                return
    with open(trgFile + ".tmp", "wb") as f:
        f.write(data)
    os.replace(trgFile + ".tmp", trgFile)


for tst, _ in ReadTests():
    os.makedirs(tst, exist_ok=True)
    shutil.copyfile("Project-Template/.gitignore", tst + "/.gitignore")
    CopyWithSubst_("Project-Template/TestN.vcxproj", tst + "/Test" + tst + ".vcxproj", tst)
    CopyWithSubst_("Project-Template/TestN.vcxproj.filters", tst + "/Test" + tst + ".vcxproj.filters", tst)
