{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Chrome",
            "request": "launch",
            "type": "chrome",
            "url": "http://localhost:9000",
            "webRoot": "${workspaceFolder}/Samples/HTMLUI/QuasarBasedHTMLApp"
        },
        {
            "name": "(gdb-UNIX) Launch EXE",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/Builds/${command:cpptools.activeConfigName}/Tests/Test04",
            "args": [
                "-m"
            ],
            "stopAtEntry": true,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "UBSAN_OPTIONS",
                    "value": "halt_on_error=1"
                },
                {
                    "name": "ASAN_OPTIONS",
                    "value": "abort_on_error=1"
                },
                {
                    "name": "LSAN_OPTIONS",
                    "value": "halt_on_error=1"
                },
                {
                    "name": "MONGO_CONNECTION_STRING",
                    "value": "mongodb://admin:pass@medusa.lan:27017"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "break on ubsan failures",
                    "text": "-break __ubsan::ScopedReport::~ScopedReport",
                    "ignoreFailures": true
                }
            ],
            "additionalSOLibSearchPath": "/path/to/symbols;/another/path/to/symbols"
        },
        {
            "name": "(lldb-UNIX) Launch EXE",
            "type": "lldb-dap",
            "request": "launch",
            "program": "${workspaceFolder}/Builds/Debug/Tests/Test41",
            "args": []
        },
        {
            "name": "(Windows) Launch VisualStudio",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/Builds/${command:cpptools.activeConfigName}/Tests/Test04.exe",
            "args": [
                "--run-directly"
            ],
            "stopAtEntry": true,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "Path",
                    "value": "${env:Path};c:/tools/msys64/mingw64/bin;c:/tools/msys64/usr/bin"
                },
                {
                    "name": "MONGO_CONNECTION_STRING",
                    "value": "mongodb://admin:pass@medusa.lan:27017"
                },
                {
                    "name": "ASAN_OPTIONS",
                    "value": "abort_on_error=1"
                }
            ],
            "console": "externalTerminal",
            "logging": {
                "moduleLoad": false,
                "trace": true
            },
            "visualizerFile": "${workspaceFolder}/Library/Projects/VisualStudio.Net-2022/VisualStudio-Stroika-Foundation-Debugger-Template.natvis"
        },
        {
            "name": "gdbserver remote Launch(not sure helpful right now)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceRoot}/mybinary",
            "miDebuggerServerAddress": "myremotehostname:1234",
            "cwd": "${workspaceRoot}",
            "externalConsole": true,
            "linux": {
                "MIMode": "gdb"
            }
        },
        {
            "name": "C/C++: cl.exe build and debug active file",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${fileDirname}\\${fileBasenameNoExtension}.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [],
            "console": "integratedTerminal",
            "preLaunchTask": "C/C++: cl.exe build active file"
        }
    ]
}