#
# Stroika built with CMake (#1157), by make's own targets - to try the CMake build the way make is run:
#     make -f Makefile-TestCMake CONFIGURATION=Debug all run-tests -j8
# (after Build/Scripts/MakeBuildRoot, nothing else: as make's all does, it first makes the default configurations, if there
# are none). all: the configuration built with its CMake presets (CMakeUserPresets.json, written as it is applied) -
# its third-party components, then Stroika's libraries, tools, tests, samples and documentation, into
# Builds/<configuration>, where make puts them - running make's -j jobs at once (just -j, from make 3.81: one per
# processor) - with the CMake generator it prints as it starts (configure's --cmake-generator: by default ninja with Visual
# Studio, else make). libraries, tools, tests, samples, documentation, third-party-components: that part alone (and what it
# needs). Where the CMake build leaves the components to make (STROIKA_BUILD_THIRD_PARTY_COMPONENTS OFF in its cache), make
# builds them first. run-tests: all, then the tests, run by ctest one at a time, as make runs them. clean and clobber:
# below. Without CONFIGURATION, each configuration make builds by default (or each TAGS= names; clean and clobber: each
# configuration). Any other target is the Makefile's: distclean, default-configurations ...
#
export MAKE_INDENT_LEVEL ?= $(MAKELEVEL)
CONFIGURATION_TAGS ?= $(TAGS)

.PHONY: help all run-tests
.DEFAULT_GOAL := help

# any other target: the Makefile's (this file has a rule, so make never asks .DEFAULT to remake it)
Makefile-TestCMake: ;
.DEFAULT:
	@$(MAKE) --no-print-directory -f Makefile $@

help:
	@echo "Makefile-TestCMake: make's targets all and run-tests, built with CMake - any other target is the Makefile's:"
	@echo "    make -f Makefile-TestCMake CONFIGURATION=Debug all run-tests -j8"
	@echo
	@$(MAKE) --no-print-directory -f Makefile help

# the configuration's cmake, and the ctest beside it: with Visual Studio, Visual Studio's own; else those on PATH
FindCMake_ = cmake_="$$(Build/Scripts/GetConfigurationParameter $(CONFIGURATION) CMAKE)" &&\
	case "$$cmake_" in [A-Za-z]:/*) cmake_="$$(cygpath --unix "$$cmake_")";; esac &&\
	case "$$cmake_" in */*) ctest_="$$(dirname "$$cmake_")/ctest";; *) ctest_=ctest;; esac

# the jobs make was given (-jN), for cmake's build - a build of its own, given them as CMAKE_BUILD_PARALLEL_LEVEL, which
# its inner builds take too, under Ninja (CMakeLists.txt) - so not given this make's MAKEFLAGS: its jobserver, its -s and -k
FindJobs_ = jobs_="$$(echo " $$MAKEFLAGS" | sed -n 's/.* -j\([0-9][0-9]*\).*/\1/p')" &&\
	if [ -z "$$jobs_" ] && echo " $$MAKEFLAGS " | grep -q -e ' -j '; then jobs_="$$(getconf _NPROCESSORS_ONLN)"; fi

# first, as make's all does: the default configurations made if there are none; then, given CONFIGURATION, it checked, and
# applied if its configuration file changed. Each use is marked + (as running make): make sees that only in $(MAKE) itself,
# not in a variable holding it - and else warns that its make has no jobserver
ApplyConfigurationIfNeeded_ = $(MAKE) --no-print-directory --silent -f Makefile apply-configuration-if-needed_

# the targets that build: all of the configuration's build, or the part make's target of that name builds (the top
# CMakeLists.txt's target); and those that remove what was built
BUILD_TARGETS_ = all libraries tools tests samples documentation third-party-components
CLEAN_TARGETS_ = clean clobber
.PHONY: $(BUILD_TARGETS_) $(CLEAN_TARGETS_)

# each goal in turn, as make's own Makefile has it: two at once would share one build directory
.NOTPARALLEL:

ifeq ($(CONFIGURATION),)
$(BUILD_TARGETS_) run-tests:
	@+$(ApplyConfigurationIfNeeded_)
	@configurations_="$$(Build/Scripts/GetConfigurations --quiet $(if $(CONFIGURATION_TAGS),--config-tags "$(CONFIGURATION_TAGS)",--all-default))" &&\
	for i in $$configurations_ ; do\
		$(MAKE) --no-print-directory -f Makefile-TestCMake $@ CONFIGURATION=$$i MAKE_INDENT_LEVEL=$$(($(MAKE_INDENT_LEVEL)+1)) || exit $$?;\
	done
$(CLEAN_TARGETS_):
	@configurations_="$$(Build/Scripts/GetConfigurations --quiet $(if $(CONFIGURATION_TAGS),--config-tags "$(CONFIGURATION_TAGS)"))" &&\
	for i in $$configurations_ ; do\
		$(MAKE) --no-print-directory -f Makefile-TestCMake $@ CONFIGURATION=$$i MAKE_INDENT_LEVEL=$$(($(MAKE_INDENT_LEVEL)+1)) || exit $$?;\
	done
else
$(BUILD_TARGETS_):
	@Build/Scripts/PrintProgressLine $(MAKE_INDENT_LEVEL) "Stroika CMake Build$(if $(filter-out all,$@), $@) {$(CONFIGURATION)}:"
	@+$(ApplyConfigurationIfNeeded_)
	@# and applied again if its preset is missing (applied by Stroika before v3.0d26, whose ApplyConfiguration wrote none)
	@grep -qF '"name": "$(CONFIGURATION)"' CMakeUserPresets.json 2>/dev/null || $(MAKE) --no-print-directory -f Makefile apply-configuration
	@$(FindCMake_) && "$$cmake_" --preset $(CONFIGURATION)
	@Build/Scripts/PrintProgressLine $$(($(MAKE_INDENT_LEVEL)+1)) "CMake generator: $$(sed -n 's/^CMAKE_GENERATOR:INTERNAL=//p' IntermediateFiles/$(CONFIGURATION)/CMake/CMakeCache.txt 2>/dev/null) (configure's --cmake-generator)"
	@$(FindCMake_) &&\
	if "$$cmake_" --preset $(CONFIGURATION) -N -L 2>/dev/null | grep -q '^STROIKA_BUILD_THIRD_PARTY_COMPONENTS:BOOL=OFF'; then\
		$(MAKE) --no-print-directory -f Makefile third-party-components MAKE_INDENT_LEVEL=$$(($(MAKE_INDENT_LEVEL)+1));\
	fi
	@$(FindCMake_) && $(FindJobs_) && env -u MAKEFLAGS -u MFLAGS $${jobs_:+CMAKE_BUILD_PARALLEL_LEVEL=$$jobs_} "$$cmake_" --build --preset $(CONFIGURATION) $(if $(filter-out all,$@),--target $@)

# clean: what was built but not installed - Stroika's own build (built again next time), and the third-party components'
# sources and build trees, not what each installed, nor its stamps (so not built again: a component whose recipe then
# changes needs clobber), nor WIX's (its programs, which the installers run); clobber: all of it, as make's does
clean:
	@Build/Scripts/PrintProgressLine $(MAKE_INDENT_LEVEL) "Stroika CMake Clean {$(CONFIGURATION)}:"
	@rm -rf IntermediateFiles/$(CONFIGURATION)/CMake/Stroika IntermediateFiles/$(CONFIGURATION)/CMake/Stroika-prefix
	@for stamp_ in IntermediateFiles/$(CONFIGURATION)/CMake/ThirdParty/*/stamp ; do\
		component_="$${stamp_%/stamp}";\
		if [ -d "$$stamp_" ] && [ "$${component_##*/}" != WIX ]; then rm -rf "$$component_/src" "$$component_/build"; fi;\
	done
clobber:
	@Build/Scripts/PrintProgressLine $(MAKE_INDENT_LEVEL) "Stroika CMake Clobber {$(CONFIGURATION)}:"
	@builds_="$$(sed -n 's/^set(STROIKA_BUILDS_DIR "\(.*\)")$$/\1/p' IntermediateFiles/$(CONFIGURATION)/Stroika-Configuration.cmake 2>/dev/null)";\
	rm -rf IntermediateFiles/$(CONFIGURATION) "$${builds_:-Builds/$(CONFIGURATION)/}"

run-tests: all
	@Build/Scripts/PrintProgressLine $(MAKE_INDENT_LEVEL) "Stroika CMake Run-Tests {$(CONFIGURATION)}:"
	@$(FindCMake_) &&\
	if ! "$$ctest_" --preset $(CONFIGURATION); then\
		if [ "$${TEST_FAILURES_CAUSE_FAILED_MAKE:-1}" -ne 0 ]; then exit 1; fi;\
		echo "   ***SOME TESTS FAILED*** (exit suppressed by TEST_FAILURES_CAUSE_FAILED_MAKE)";\
	fi
endif
