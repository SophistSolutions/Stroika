                self.FEATUREFLAG_LZMA = Next()
            elif Is("-fmtlib", "--fmtlib"):
                i += 1
                self.FEATUREFLAG_fmtlib = Next()
            elif Is("-default-third-party-components", "--default-third-party-components"):
                self.DoSetThirdPartyComponentsParameterFromCommandLine = "default"
            elif Is("-all-available-third-party-components", "--all-available-third-party-components"):
                self.DoSetThirdPartyComponentsParameterFromCommandLine = "all-available"
            elif Is("-no-third-party-components", "--no-third-party-components"):
                self.DoSetThirdPartyComponentsParameterFromCommandLine = "none"
            elif Is("-trace2file", "--trace2file"):
                i += 1
                v = Next()
                if v == "enable":
                    self.ENABLE_TRACE2FILE = 1
                elif v == "disable":
                    self.ENABLE_TRACE2FILE = 0
                elif v == "default":
                    self.ENABLE_TRACE2FILE = DEFAULT_BOOL_OPTIONS
                else:
                    self.Print("UNRECOGNIZED ENABLE_TRACE2FILEG ARG: " + S(v) + "\n")
                    self.DoHelp_(1)
            elif Is("-static-link-gccruntime", "--static-link-gccruntime"):
                i += 1
                v = Next()
                if v == "enable":
                    self.STATIC_LINK_GCCRUNTIME = 1
                elif v == "disable":
                    self.STATIC_LINK_GCCRUNTIME = 0
                else:
                    self.Print("UNRECOGNIZED static-link-gccruntime ARG: " + S(v) + "\n")
                    self.DoHelp_(1)
            elif Is("-ar", "--ar"):
                i += 1
                self.AR = Next()
            elif Is("-as", "--as"):
                i += 1
                self.AS = Next()
            elif Is("-ranlib", "--ranlib"):
                i += 1
                self.RANLIB = Next()
            elif Is("-strip", "--strip"):
                i += 1
                self.STRIP = Next()
            elif Is("-extra-prefix-linker-args", "--extra-prefix-linker-args"):
                i += 1
                self.LinkerArgs_ExtraPrefix = Next()
            elif Is("-append-extra-prefix-linker-args", "--append-extra-prefix-linker-args"):
                i += 1
                if S(self.LinkerArgs_ExtraPrefix) != "":
                    self.LinkerArgs_ExtraPrefix += " "
                self.LinkerArgs_ExtraPrefix = S(self.LinkerArgs_ExtraPrefix) + S(Next())
            elif Is("-extra-suffix-linker-args", "--extra-suffix-linker-args"):
                i += 1
                self.LinkerArgs_ExtraSuffix = Next()
            elif Is("-append-extra-suffix-linker-args", "--append-extra-suffix-linker-args"):
                i += 1
                if S(self.LinkerArgs_ExtraSuffix) != "":
                    self.LinkerArgs_ExtraSuffix += " "
                self.LinkerArgs_ExtraSuffix = S(self.LinkerArgs_ExtraSuffix) + S(Next())
            elif Is("-append-CPPFLAGS", "--append-CPPFLAGS"):  # PERL QUIRK: never matches (capitals) - but --append-cppflags below does
                i += 1
                self.Platform_CPPFLAGS_B4Includes.append(Next())
            elif Is("-remove-CPPFLAGS", "--remove-CPPFLAGS"):  # PERL QUIRK: never matches (capitals)
                i += 1
                self.CPPFLAGS2Remove.append(Next())
            elif Is("-replace-all -CPPFLAGS", "--replace-all-CPPFLAGS"):  # PERL QUIRK: never matches (capitals)
                i += 1
                for x in PerlSplit(" ", S(Next())):
                    self.Platform_CPPFLAGS_B4Includes.append(x)
                self.CPPFLAGS_Overridden = true
            elif Is("-append-CFLAGS", "--append-cflags"):
                i += 1
                self.CFLAGS.append(Next())
            elif Is("-remove-CFLAGS", "--remove-cflags"):
                i += 1
                self.CFLAGS2Remove.append(Next())
            elif Is("-replace-all -CFLAGS", "--replace-all-cflags"):
                i += 1
                for x in PerlSplit(" ", S(Next())):
                    self.CFLAGS.append(x)
                self.CFLAGS_Overridden = true
            elif Is("-append-CXXFLAGS", "--append-cxxflags"):
                i += 1
                self.CXXFLAGS2Append.append(Next())
            elif Is("-remove-CXXFLAGS", "--remove-cxxflags"):
                i += 1
                self.CXXFLAGS2Remove.append(Next())
            elif Is("-replace-all -CXXFLAGS", "--replace-all-cxxflags"):
                i += 1
                for x in PerlSplit(" ", S(Next())):
                    self.CXXFLAGS.append(x)
                self.CXXFLAGS_Overridden = true
            elif Is("-append-CPPFLAGS", "--append-cppflags"):
                i += 1
                self.Platform_CPPFLAGS_B4Includes.append(Next())
            elif Is("-includes-path", "--includes-path"):
                i += 1
                self.PLATFORM_INCLUDES_PATH = PerlSplit(self.PATH_SEPERATOR, S(Next()))
                self.INCLUDES_PATH_SET = true
            elif Is("-append-includes-path", "--append-includes-path"):
                i += 1
                self.INCLUDES_PATH_ADD.append(Next())
            elif Is("-libs-path", "--libs-path"):
                i += 1
                self.LinkerArgs_LibPath = PerlSplit(self.PATH_SEPERATOR, S(Next()))
                self.LinkerArgs_LibPath_SET = true
            elif Is("-append-libs-path", "--append-libs-path"):
                i += 1
                self.LinkerArgs_LibPath_ADD.append(Next())
            elif Is("-linktime-copy-files-2-EXEDir", "--linktime-copy-files-2-EXEDir"):  # PERL QUIRK: never matches (capitals)
                i += 1
                self.LinkTime_CopyFilesToEXEDir = PerlSplit(" ", S(Next()))
            elif Is("-append-linktime-copy-files-2-EXEDir", "--append-linktime-copy-files-2-EXEDir"):  # PERL QUIRK: never matches
                i += 1
                self.LinkTime_CopyFilesToEXEDir.append(Next())
            elif Is("-lib-dependencies", "--lib-dependencies"):
                i += 1
                self.LinkerArgs_LibDependencies = Next()
            elif Is("-append-lib-dependencies", "--append-lib-dependencies"):
                i += 1
                self.LinkerArgs_LibDependencies_ADD.append(Next())
            elif Is("-run-prefix", "--run-prefix"):
                i += 1
                self.RunPrefix = Next()
            elif Is("-append-run-prefix", "--append-run-prefix"):
                i += 1
                if S(self.RunPrefix) != "":
                    self.RunPrefix += " "
                self.RunPrefix = S(self.RunPrefix) + S(Next())
            elif Is("-include-default-TSAN_OPTIONS", "--include-default-TSAN_OPTIONS"):  # PERL QUIRK: never matches (capitals)
                i += 1
                v = Next()
                if v not in ("true", "false"):
                    Die("Invalid argument to --include-default-TSAN_OPTIONS")
                self.autoIncludeTSAN_OPTIONSIfAppropriate = v
            elif Is("-append-extra-compiler-and-linker-args", "--append-extra-compiler-and-linker-args"):
                i += 1
                v = Next()
                self.CFLAGS.append(v)
                self.CXXFLAGS.append(v)
                if S(self.LinkerArgs_ExtraPrefix) != "":
                    self.LinkerArgs_ExtraPrefix += " "
                self.LinkerArgs_ExtraPrefix = S(self.LinkerArgs_ExtraPrefix) + S(v)
                if S(self.LinkerArgs_ExtraSuffix) != "":
                    self.LinkerArgs_ExtraSuffix += " "
                self.LinkerArgs_ExtraSuffix = S(self.LinkerArgs_ExtraSuffix) + S(v)
            elif Is("-lto", "--lto"):
                i += 1
                v = Next()
                if v == "enable":
                    self.ENABLE_LTO = true
                    self.ENABLE_LTO_SetExplicitly = true
                elif v == "disable":
                    self.ENABLE_LTO = false
                    self.ENABLE_LTO_SetExplicitly = true
                elif v == "default":
                    self.ENABLE_LTO = DEFAULT_BOOL_OPTIONS
                    self.ENABLE_LTO_SetExplicitly = false
                else:
                    self.Print("UNRECOGNIZED assertions ARG: " + S(v) + "\n")
                    self.DoHelp_(1)
            elif Is("-cross-compiling", "--cross-compiling"):
                i += 1
                v = Next()
                if v not in ("true", "false"):
                    Die("Invalid argument to --cross-compiling")
                self.CrossCompiling = v
            elif Is("-debug-symbols", "--debug-symbols"):
                i += 1
                v = Next()
                if v not in ("true", "false"):
                    Die("Invalid argument to --debug-symbols")
                self.INCLUDE_SYMBOLS_LIB = self.ToBool_(v)
                self.INCLUDE_SYMBOLS_EXE = self.ToBool_(v)
            elif Is("-debug-symbols-lib", "--debug-symbols-lib"):
                i += 1
                v = Next()
                if v not in ("true", "false"):
                    Die("Invalid argument to --debug-symbols-lib")
                self.INCLUDE_SYMBOLS_LIB = self.ToBool_(v)
            elif Is("-debug-symbols-exe", "--debug-symbols-exe"):
                i += 1
                v = Next()
                if v not in ("true", "false"):
                    Die("Invalid argument to --debug-symbols")
                self.INCLUDE_SYMBOLS_EXE = self.ToBool_(v)
            elif Is("-malloc-guard", "--malloc-guard"):
                i += 1
                self.MALLOC_GUARD = self.ToBool_(Next())
                # DISABLE LTO BY DEFAULT IF MALLOC_GAURD TURNED ON BECAUSE FOR NOW THEY DON'T WORK TOGETHER -- LGP 2016-07-14
                if self.MALLOC_GUARD == true:
                    self.ENABLE_LTO = false
            elif Is("-runtime-stack-check", "--runtime-stack-check"):
                i += 1
                v = Next()
                if v not in ("true", "false"):
                    Die("Invalid argument to --runtime-stack-check")
                self.runtimeStackProtectorFlag = v
            elif Is("-msvc-runtime-library", "--msvc-runtime-library"):
                i += 1
                self.VSVARS_MSVC_RUNTIME_LIBRARY = Next()
            elif Is("-sanitize", "--sanitize"):
                i += 1
                for flag in PerlSplit(",", S(Next())):
                    if flag == "none":
                        self.sanitizerFlags = []
                        self.sanitizerFlagsNoneSet = true
                    else:
                        if not self.IsTargettingSanitizer_(flag):
                            self.sanitizerFlags.append(flag)
                    self.sanitizerFlagsIsDefined = true
            elif Is("-no-sanitize", "--no-sanitize"):
                i += 1
                for flag in PerlSplit(",", S(Next())):
                    if flag == "none":
                        self.noSanitizerFlags = []
                    elif flag not in self.noSanitizerFlags:
                        self.noSanitizerFlags.append(flag)
            elif Is("-only-if-has-compiler", "--only-if-has-compiler"):
                self.onlyGenerateIfCompilerExists = true
            elif Is("-pg", "--pg"):
                self.CFLAGS.append("-pg")
                self.CXXFLAGS.append("-pg")
                self.LinkerArgs_ExtraPrefix = S(self.LinkerArgs_ExtraPrefix) + " -pg"
            elif Is("-help", "--help", "-?"):
                self.DoHelp_(0)
            else:
                # HANDLED EARLIER
                if Is("-apply-default-debug-flags", "--apply-default-debug-flags"):
                    pass
                elif Is("-apply-default-release-flags", "--apply-default-release-flags"):
                    pass
                elif Is("-build-platform", "--build-platform"):
                    i += 1
                elif Is("-arch", "--arch"):
                    i += 1
                elif Is("-compiler-driver", "--compiler-driver"):
                    i += 1
                else:
                    self.Print("UNRECOGNIZED ARG: " + var + "\n")
                    self.DoHelp_(1)
            i += 1

    @staticmethod
    def ZERO_OR_1_(x):
        if x is None or x == "" or x is False:
            return 0
        return 1 if N(x) == 1 else 0

    def CHECK_FEATURE_OPTION(self, x):
        if x not in (LIBFEATUREFLAG_BuildOnly, LIBFEATUREFLAG_UseStaticTPP, LIBFEATUREFLAG_UseSystem, LIBFEATUREFLAG_No):
            Die("Cannot identify feature argument (expected build-only, use-static, use-system, or no and got " + S(x) + ")")

    def CHECK_OPTIONS_(self):
        if S(self.BuildPlatform) == "":
            Die("Cannot identify BuildPlatform! Either explicitly supply the --build-platform argument (configure --help); or make sure you have Visual Studio.net installed")
        for old in ("2012", "2015", "2017", "2019"):
            if self.BuildPlatform == "VisualStudio.Net-" + old:
                Die("WE NO LONGER SUPPORT VISUAL STUDIO.Net " + old)
        validProjectPlatfromSubDirs = ("Unix", "VisualStudio.Net-2022", "VisualStudio.Net-2026")
        if self.BuildPlatform not in validProjectPlatfromSubDirs:
            Die("Unrecognized --build-platform argument: valid ones include: " + ",".join(validProjectPlatfromSubDirs))
        if S(self.TargetPlatforms) == "":
            Die("Cannot identify TargetPlatforms")
        self.CHECK_FEATURE_OPTION(self.FEATUREFLAG_LIBCURL)

    def ApplyCompilerBugWorkarounds_(self):
        """
        Turn OFF LTO for the gcc sanitizer builds it is known to break. MUST run after ParseCommandLine_Remaining_ (), since
        that is where --sanitize is parsed. configure.pl's comments here have the measurements behind each case.
        """
        if self.ApplyReleaseFlags != true:
            return
        if not self.IsGCCOrGPlusPlus_(self.COMPILER_DRIVER):
            return
        # NB: deliberately NOT disabling LTO for the address sanitizer (#1128): turning it off made asan release builds WORSE.

        # gcc 13 and 14 AS PACKAGED ON UBUNTU 24.04 miscompile Containers::Sequence / Traversal / DataExchange whenever the
        # build optimizes WITHOUT LTO - wrong answers, not crashes. POLICY: an explicit '--lto disable' is honored, but
        # warned about, loudly; an OPTIONAL configuration (--only-if-has-compiler) is skipped outright - see where
        # gUbuntu2404OptimizedNoLTOHazard is read below.
        if (N(self.lsb_release) == 24.04 and self.IsGCCOrGPlusPlus_(self.COMPILER_DRIVER)
                and 13.0 <= self.GetGCCVersion_(self.COMPILER_DRIVER) and self.GetGCCVersion_(self.COMPILER_DRIVER) < 15.0
                and self.ENABLE_LTO != true):
            self.gUbuntu2404OptimizedNoLTOHazard = true
            self.Print("WARNING: gcc " + S(self.GetGCCVersion_(self.COMPILER_DRIVER)) + " on Ubuntu 24.04 miscompiles Stroika containers when optimizing without LTO\n")
            self.Print("         (Containers::Sequence, Traversal, DataExchange give WRONG ANSWERS - not crashes - at -O1/-O2/-O3).\n")
            if self.ENABLE_LTO_SetExplicitly == true:
                self.Print("         Honoring your explicit '--lto disable' anyway - but be aware the failures are wrong ANSWERS, not crashes.\n")
            self.Print("         g++-12, clang++, or a newer Ubuntu can build optimized without LTO on this platform.\n")

        # WHAT WE ACTUALLY DO ON 24.04: keep LTO, and drop -O3 to -O2 for sanitizer builds (-O3 -flto -fsanitize=thread
        # fails Tests/47; -O2 passes, and the containers stay clean).
        if N(self.lsb_release) == 24.04 and len(self.sanitizerFlags) != 0:
            self.COPTIMIZE_FLAGS = "-O2"

        # armhf gcc (the Ubuntu cross compilers) crashes compiling mongo-c-driver under -fsanitize=address; -O2 is what
        # armhf asan has been validated at - https://github.com/SophistSolutions/Stroika/issues/1174
        if self.ARCH == "armhf" and self.IsTargettingSanitizer_("address"):
            self.COPTIMIZE_FLAGS = "-O2"

    def ParseCommandLine_(self):
        self.SetInitialDefaults_()

        if len(self.ARGV) >= 1:
            self.configurationName = self.ARGV[0]
        else:
            self.Print("Expected configuration name as first argument\n")
            self.DoHelp_(1)
        if self.configurationName.lower() in ("-h", "--h", "-help", "--help"):
            self.DoHelp_(0)
        elif self.configurationName.startswith("-"):
            self.Print("Expected configuration name (got " + self.configurationName + ") as first argument\n")
            self.DoHelp_(1)

        self.ParseEnvVarsToSetupInfluencedVariables_()
        self.ParseCommandLine_Platform_()
        self.SetDefaultsWhichDependOnPlatform_()

        self.ParseCommandLine_CompilerDriverAndDebugOrReleaseDefaultMode_()
        self.SetDefaultsWhichDependOnCompilerDriverAndApplyDefaultsDebugOrRel_()

        self.ParseCommandLine_Remaining_()

        self.ApplyCompilerBugWorkarounds_()

        self.DoSetThirdPartyComponents_(self.DoSetThirdPartyComponentsParameterFromCommandLine)

        self.CHECK_OPTIONS_()

    def GetDefaultCZZFLAGS_flags_(self, doCFLAGS, doPlatform, doFoundation):
        flags = []
        flagValues2Remove = list(self.GetDefaultCZZFLAGS_flags_flagValues2Remove)
        isVisualStudio = re.match(r"VisualStudio.Net", self.BuildPlatform) is not None

        # All the defines go to the compiler with -D (until Stroika v2.1d18 they were written to Stroika-Config.h), so they
        # appear in compiles of third-party-components too - which should not matter
        dashFlag = "-D"

        if doPlatform:
            if doCFLAGS == 2:
                # C++ only flags
                if self.CPPSTD_VERSION_FLAG != "":
                    flags.append(self.CPPSTD_VERSION_FLAG)
            if doCFLAGS == 2:
                if S(self.CXXWARNING_FLAGS) != "":
                    # @todo - need separate flags for C and CXX
                    for x in PerlSplit(" ", self.CXXWARNING_FLAGS):
                        flags.append(x)

            if doCFLAGS != 0:
                if self.COPTIMIZE_FLAGS != "":
                    flags.append(self.COPTIMIZE_FLAGS)
                if self.SharedSymbolVisibility is not None:
                    flags.append("-fvisibility=" + S(self.SharedSymbolVisibility))
                if self.INCLUDE_SYMBOLS_LIB:
                    if not isVisualStudio:
                        flags.append("-g")
                if isVisualStudio:
                    flags.append("-EHa" if self.Windows_Exceptions_SupportStructuredExceptions == true else "-EHsc")
                    flags.append("-nologo")
                    flags.append("-GR")  # Enable Run-Time Type Information
                    flags.append("-Gd")  # Calling Convention - the default setting, specifies the __cdecl calling convention for all functions
                    flags.append("-W4")  # Warning Level (most less than WALL)
                    flags.append("-Zc:inline")  # Remove unreferenced code and data
                    flags.append("-FC")  # Use full paths in diagnostic messages
                    flags.append("-bigobj")  # Avoid these failures - fatal error C1128: number of sections exceeded object file format limit: compile with /bigobj
                    if self.ApplyDebugFlags == true:
                        flags.append("-RTCsu")  # Run-Time Error Checks
                        flags.append("-GS")  # Enable Security Check
                        flags.append("-Oy-")  # (Dont) omit frame pointers
                        flags.append("-Od")  # Disable Optimization
                    if self.ApplyReleaseFlags == true:
                        flags.append("-GS-")  # Disable Security Check
                        flags.append("-Gy")  # Enable Function Level Linking
                        flags.append("-Oy")  # Omit frame pointers
                        flags.append("-O2")  # Maximum Optimization (Favor Speed)
                        flags.append("-GL")  # Whole Program Optimization
                        flags.append("-Oi")  # Enable Intrinsic Functions
                        flags.append("-GF")  # Enable String Pooling
                    rtl = self.VSVARS_MSVC_RUNTIME_LIBRARY
                    if rtl == "MultiThreaded":
                        flags.append("-MT")  # Multithreaded (not debug not dll)
                    elif rtl == "MultiThreadedDebug":
                        flags.append("-MTd")  # Multithreaded (Debug; but not dll)
                    elif rtl == "MultiThreadedDLL":
                        flags.append("-MD")  # NOT SURE REALLY SUPPORTED
                    elif rtl == "MultiThreadedDebugDLL":
                        flags.append("-MDd")  # NOT SURE REALLY SUPPORTED
                    else:
                        self.Print("WARNING: Unrecognized MSVC_RUNTIME_LIBRARY: " + S(rtl) + "\n")
                    if self.INCLUDE_SYMBOLS_LIB:
                        # -Z7 (debug info in the .obj), not -Zi (a separate .pdb): a static library's .pdb must ship beside
                        # it, and parallel builds failed writing the one .pdb, even with -FS. configure.pl says more.
                        flags.append("-Z7")
            if doCFLAGS == 0:
                if not isVisualStudio and self.ENABLE_GLIBCXX_DEBUG == 1:
                    flags.append("-D_GLIBCXX_DEBUG")
                if isVisualStudio:
                    flags.append("-D_UNICODE")
                    flags.append("-DUNICODE")
                    flags.append("-D_WINDOWS")  # just because visual studio .net sample projects defined this
                    if self.ApplyDebugFlags == true:
                        flags.append("-D_DEBUG")
                    if self.ApplyReleaseFlags == true:
                        flags.append("-DNDEBUG")
                for var in self.useExtraCDefines:
                    parts = PerlSplit(" ", var) + [None, None, None]
                    define, name, value = parts[0], parts[1], parts[2]
                    if define != "#define":
                        Die("NYI: mapping extraCDEFINE: " + var)
                    if S(value) == "":
                        value = 0
                    flags.append(dashFlag + S(name) + "=" + S(value))
        if doFoundation:
            if doCFLAGS == 0:
                Z = self.ZERO_OR_1_

                def Has(f):
                    return f in (LIBFEATUREFLAG_UseStaticTPP, LIBFEATUREFLAG_UseSystem)

                flags.append(dashFlag + "qStroika_Foundation_Debug_AssertionsChecked=" + S(Z(self.gAssertionsEnabled)))
                if self.FEATUREFLAG_ATLMFC is not None:
                    flags.append(dashFlag + "qStroika_HasComponent_ATLMFC=" + S(Z(self.FEATUREFLAG_ATLMFC == LIBFEATUREFLAG_UseSystem)))
                flags.append(dashFlag + "qStroika_HasComponent_boost=" + S(Z(Has(self.FEATUREFLAG_boost))))
                flags.append(dashFlag + "qStroika_HasComponent_libcurl=" + S(Z(Has(self.FEATUREFLAG_LIBCURL))))
                flags.append(dashFlag + "qStroika_HasComponent_fmtlib=" + S(Z(Has(self.FEATUREFLAG_fmtlib))))
                flags.append(dashFlag + "qStroika_HasComponent_googletest=" + S(Z(Has(self.FEATUREFLAG_GoogleTest))))
                flags.append(dashFlag + "qStroika_HasComponent_LZMA=" + S(Z(Has(self.FEATUREFLAG_LZMA))))
                flags.append(dashFlag + "qStroika_HasComponent_OpenSSL=" + S(Z(Has(self.FEATUREFLAG_OpenSSL))))
                flags.append(dashFlag + "qStroika_HasComponent_sqlite=" + S(Z(Has(self.FEATUREFLAG_sqlite))))
                flags.append(dashFlag + "qStroika_HasComponent_mongocxxdriver=" + S(Z(Has(self.FEATUREFLAG_mongocxxdriver))))
                flags.append(dashFlag + "qStroika_HasComponent_WinHTTP=" + S(Z(self.FEATUREFLAG_WinHTTP == LIBFEATUREFLAG_UseSystem)))
                flags.append(dashFlag + "qStroika_HasComponent_xerces=" + S(Z(Has(self.FEATUREFLAG_Xerces))))
                flags.append(dashFlag + "qStroika_HasComponent_libxml2=" + S(Z(Has(self.FEATUREFLAG_libxml2))))
                flags.append(dashFlag + "qStroika_HasComponent_zlib=" + S(Z(Has(self.FEATUREFLAG_ZLib))))
                flags.append(dashFlag + "qStroika_HasComponent_zstd=" + S(Z(Has(self.FEATUREFLAG_zstd))))
                if self.ENABLE_TRACE2FILE != DEFAULT_BOOL_OPTIONS:
                    flags.append(dashFlag + "qStroika_Foundation_Debug_TraceToFile=" + S(Z(self.ENABLE_TRACE2FILE)))
                    # override the default (true iff qStroika_Foundation_Debug_AssertionsChecked) - if set the trace2file option set
                    if self.ENABLE_TRACE2FILE == 1:
                        flags.append(dashFlag + "qStroika_Foundation_Debug_DefaultTracingOn=1")

        # PERL QUIRK: configure.pl's indexOf () keeps only its first argument, so never finds anything: each of these is
        # appended, not toggled - and the --remove-CFLAGS/--remove-CXXFLAGS values (flagValues2Remove) remove nothing
        for r in self.GetDefaultCZZFLAGS_flags_flags:
            flags.append(r)
        del flagValues2Remove
        return flags

    def PostProcessOptions_(self):
        isVisualStudio = re.match(r"VisualStudio.Net", self.BuildPlatform) is not None

        if isVisualStudio:
            if self.BuildToolsRoot is None:
                self.BuildToolsRoot = self.GetDefaultToolsBuildDir(self.BuildPlatform)

        # Here, not where it is decided, because --lto enable is parsed only after the release defaults are applied
        if self.gLTODefaultedOffForNoLLD and self.ENABLE_LTO != true and self.HasCompiler_(self.COMPILER_DRIVER_CPlusPlus):
            self.Print("NOTE: LTO defaults OFF for " + S(self.COMPILER_DRIVER) + " here - it has no lld, and GNU ld mis-links clang LTO; install lld to get LTO\n")
        if self.ENABLE_LTO == true:
            if self.IsGCCOrGPlusPlus_(self.COMPILER_DRIVER_CPlusPlus):
                self.CFLAGS.append("-flto")
                self.CXXFLAGS.append("-flto")
                # -flto=auto runs the LTRANS jobs under make's jobserver, so they share the -j budget (configure.pl's
                # comment here has the history)
                self.LinkerArgs_ExtraPrefix += " -flto=auto"
            if self.IsClangOrClangPlusPlus_(self.COMPILER_DRIVER_CPlusPlus):
                self.CFLAGS.append("-flto")
                self.CXXFLAGS.append("-flto")
                self.LinkerArgs_ExtraPrefix += " -flto"
                # GNU ld mis-links clang LTO - see where the release flags default ENABLE_LTO. An explicit -fuse-ld wins, but
                # is warned about unless it is lld.
                m = re.search(r"-fuse-ld=(\S+)", self.LinkerArgs_ExtraPrefix) if PERL_OS != "darwin" else None
                if m:
                    explicitLD = m.group(1)
                    if "lld" not in explicitLD:
                        self.Print("CONFIGURATION-WARNING: LTO with " + S(self.COMPILER_DRIVER_CPlusPlus) + " and -fuse-ld=" + explicitLD + " - only lld is known to link clang LTO correctly (GNU ld mis-links it).\n")
                elif PERL_OS != "darwin":
                    if self.GetClangLLD_(self.COMPILER_DRIVER_CPlusPlus) is not None:
                        self.LinkerArgs_ExtraPrefix += " -fuse-ld=lld"
                    else:
                        self.Print("CONFIGURATION-WARNING: LTO with " + S(self.COMPILER_DRIVER_CPlusPlus) + " but no lld, so linking with GNU ld, which mis-links clang LTO (install lld, or --lto disable).\n")
            if self.IsMSVCCompiler_(self.COMPILER_DRIVER_CPlusPlus):
                self.CFLAGS.append("-GL")  # Whole Program Optimization
                self.CXXFLAGS.append("-GL")  # Whole Program Optimization
                self.LinkerArgs_ExtraPrefix += " -LTCG"

            if self.IsGCCOrGPlusPlus_(self.COMPILER_DRIVER):
                # avoid release (LTO) warnings - bogus -Wreturn-local-addr from Xerces' DOMCharacterDataImpl.cpp, with
                # g++-11 and 12 (configure.pl's comment here has the diagnostic); g++-13 and later are quiet
                itsVersion = self.GetGCCVersion_(self.COMPILER_DRIVER_CPlusPlus)
                if itsVersion < 13:
                    self.LinkerArgs_ExtraPrefix = self.LinkerArgs_ExtraPrefix + " -Wno-return-local-addr"

        if self.IsGCCOrGPlusPlus_(self.COMPILER_DRIVER):
            itsVersion = self.GetGCCVersion_(self.COMPILER_DRIVER_CPlusPlus)
            if 12.0 <= itsVersion < 14 and self.COPTIMIZE_FLAGS != "":
                # With gcc 12/13 - release builds - we get lots of spurrious uninitialized warnings, raspi and direct x86
                self.CXXWARNING_FLAGS = S(self.CXXWARNING_FLAGS) + " -Wno-maybe-uninitialized"
            if itsVersion < 12:
                # With gcc 11 cannot seem to suppress with pragma warning
                self.CXXWARNING_FLAGS = S(self.CXXWARNING_FLAGS) + " -Wno-stringop-overflow"

        if self.IsClangOrClangPlusPlus_(self.COMPILER_DRIVER_CPlusPlus):
            self.CXXWARNING_FLAGS = S(self.CXXWARNING_FLAGS) + "-Wno-unqualified-std-cast-call "

        if self.sanitizerFlagsIsDefined and len(self.sanitizerFlags) != 0:
            inNoSanitizeList = set(self.noSanitizerFlags)
            crap2Add2CZZFlags = "-fsanitize="
            effectiveSanitizerFlags = []
            for i, f in enumerate(self.sanitizerFlags):
                if f not in inNoSanitizeList:
                    crap2Add2CZZFlags += f
                    if i < len(self.sanitizerFlags) - 1:
                        crap2Add2CZZFlags += ","
                    effectiveSanitizerFlags.append(f)
            self.sanitizerFlags = effectiveSanitizerFlags  # subtract out no-sanitize entries
            if self.IsGCCOrGPlusPlus_(self.COMPILER_DRIVER) or self.IsClangOrClangPlusPlus_(self.COMPILER_DRIVER):
                self.LinkerArgs_ExtraPrefix += " " + crap2Add2CZZFlags
            if isVisualStudio:
                # asan executables need the asan runtime DLL beside them (https://github.com/SophistSolutions/Stroika/issues/1116)
                if self.IsTargettingSanitizer_("address"):
                    self.FillInToolsPathAdditionsIfNeeded_()
                    dir2Add = self.GetMSVCVarName_("ASAN_DLL_DIR")
                    names = {"x86": "i386", "x86_64": "x86_64"}.get(self.ARCH)
                    if names is not None:
                        for x in self.Cygpath(["--mixed"], [dir2Add + "/clang_rt.asan_dynamic-" + names + ".dll",
                                                            dir2Add + "/clang_rt.asan_dynamic-" + names + ".pdb"]):
                            self.LinkTime_CopyFilesToEXEDir.append(x)
            self.CFLAGS.append(crap2Add2CZZFlags)
            self.CXXFLAGS.append(crap2Add2CZZFlags)

            if self.sanitizerFlagsIsDefined and len(self.sanitizerFlags) != 0 and self.STATIC_LINK_SANITIZERS != 0:
                if self.IsGCCOrGPlusPlus_(self.COMPILER_DRIVER):
                    for f in self.sanitizerFlags:
                        if f == "address":
                            self.LinkerArgs_ExtraPrefix += " -static-libasan"
                        elif f == "undefined":
                            self.LinkerArgs_ExtraPrefix += " -static-libubsan"
                        elif f == "thread":
                            self.LinkerArgs_ExtraPrefix += " -static-libtsan"
                        elif f == "leak":
                            self.LinkerArgs_ExtraPrefix += " -static-liblsan"
                elif self.IsClangOrClangPlusPlus_(self.COMPILER_DRIVER):
                    if len(self.sanitizerFlags) != 1:
                        self.LinkerArgs_ExtraPrefix += " -static-libsan"
        if len(self.noSanitizerFlags) >= 1:
            s = ", ".join(self.noSanitizerFlags)
            self.CFLAGS.append(" -fno-sanitize=" + s)
            self.CXXFLAGS.append(" -fno-sanitize=" + s)

        if self.autoIncludeTSAN_OPTIONSIfAppropriate:
            if self.IsTargettingSanitizer_("thread"):
                # prepend, so stuff already there takes precedence
                if S(self.RunPrefix) != "":
                    self.RunPrefix = " " + S(self.RunPrefix)
                self.RunPrefix = "TSAN_OPTIONS=suppressions=${StroikaRoot}/Tests/ThreadSanitizerSuppressions.supp" + S(self.RunPrefix)

        if S(self.FEATUREFLAG_OpenSSL) == "":
            self.FEATUREFLAG_OpenSSL = LIBFEATUREFLAG_UseStaticTPP

        if isVisualStudio:
            # Default to true for visual studio, because debug symbols go in separate file, and don't balloon the exe size (.pdb)
            if self.INCLUDE_SYMBOLS_EXE == DEFAULT_BOOL_OPTIONS:
                self.INCLUDE_SYMBOLS_EXE = true
        if self.INCLUDE_SYMBOLS_EXE == DEFAULT_BOOL_OPTIONS:
            self.INCLUDE_SYMBOLS_EXE = false

        if self.MALLOC_GUARD == true:
            self.useExtraCDefines.append("#define qStroika_Foundation_Debug_MallocGuard 1")

        if self.FEATUREFLAG_StrawberryPerl is None:
            self.FEATUREFLAG_StrawberryPerl = "use" if (self.FEATUREFLAG_OpenSSL == "use" and IS_WINDOWS_HOST) else LIBFEATUREFLAG_No
        if self.FEATUREFLAG_WIX is None:
            # No need to install, because its checked into ThirdPartyComponents/WiX
            self.FEATUREFLAG_WIX = "use" if IS_WINDOWS_HOST else LIBFEATUREFLAG_No

        if self.STDCXXLIB is not None:
            if self.IsClangOrClangPlusPlus_(self.COMPILER_DRIVER_CPlusPlus):
                self.LinkerArgs_ExtraPrefix += " -stdlib=" + self.STDCXXLIB
                self.CXXFLAGS.append(" -stdlib=" + self.STDCXXLIB)

        if self.BuildPlatform == "Unix":
            # Ahead of the libstdc++ entries below, since it uses libstdc++
            if self.STDCXXLIB is not None and self.STDCXXLIB == "libstdc++" and self.HasCompiler_(self.COMPILER_DRIVER_CPlusPlus):
                stdlibFlag = "-stdlib=libstdc++" if self.IsClangOrClangPlusPlus_(self.COMPILER_DRIVER_CPlusPlus) else ""
                stacktraceLib = self.GetLibStdCXXStacktraceLib_(self.COMPILER_DRIVER_CPlusPlus, self.CPPSTD_VERSION_FLAG + " " + stdlibFlag)
                if stacktraceLib is None:
                    self.Print("Warning: found no library that makes std::stacktrace link with " + S(self.COMPILER_DRIVER_CPlusPlus) + " " + self.CPPSTD_VERSION_FLAG + " - if Debug/BackTrace fails to link, that is why\n")
                elif stacktraceLib != "":
                    self.LinkerArgs_LibDependencies_ADD.append(stacktraceLib)
            if self.STATIC_LINK_GCCRUNTIME == 1:
                # tried $IF_STATIC_LINK_GCCRUNTIME_USE_PRINTPATH_METHOD=0 in Ubuntu 1804, and g++-7, and failed (still left .so file in ldd)
                lib2FindStatic = S(self.STDCXXLIB) + ".a"
                lib = Trim(self.Backtick(S(self.COMPILER_DRIVER_CPlusPlus) + " -print-file-name=" + lib2FindStatic + " 2>/dev/null"))
                if lib != lib2FindStatic:
                    self.LinkerArgs_LibDependencies_ADD.append(lib)
                else:
                    # consider using apt-get install glibc-static libstdc++-static
                    dashLName = Trim(self.Backtick("echo " + S(self.STDCXXLIB) + " | sed s/lib//"))
                    self.LinkerArgs_LibDependencies_ADD.append("-l" + dashLName)

            if self.IsGCCOrGPlusPlus_(self.COMPILER_DRIVER_CPlusPlus):
                if not self.STATIC_LINK_GCCRUNTIME:
                    self.LinkerArgs_LibDependencies_ADD.append("-lstdc++")
                if self.STATIC_LINK_GCCRUNTIME == 1:
                    # https://github.com/SophistSolutions/Stroika/issues/811 (-static causes some apps crash; and there is no option to JUST staticly link libc - eg no -static-libc)
                    self.LinkerArgs_ExtraPrefix += " -static-libstdc++"
                    self.LinkerArgs_ExtraPrefix += " -static-libgcc"
            elif self.IsClangOrClangPlusPlus_(self.COMPILER_DRIVER_CPlusPlus):
                if self.STDCXXLIB == "libc++":
                    self.LinkerArgs_LibDependencies_ADD.append("-lc++")

        self.FillDefaultIncludesPathIfNeeded_()
        self.FillDefaultLibsPathIfNeeded_()
        self.FillDefaultLibDependencies_()
        self.FillInToolsPathAdditionsIfNeeded_()

        if isVisualStudio:
            self.LinkerArgs_ExtraPrefix += " -nologo"
            WIN_LIBCOMPATIBLE_ARCH = "x64" if self.ARCH == "x86_64" else S(self.ARCH)
            self.LinkerArgs_ExtraPrefix += " -MACHINE:" + WIN_LIBCOMPATIBLE_ARCH
            if self.VSVARS_MSVC_RUNTIME_LIBRARY is None:
                self.VSVARS_MSVC_RUNTIME_LIBRARY = "MultiThreadedDebug" if self.gAssertionsEnabled else "MultiThreaded"

        if self.CPPFLAGS_Overridden == false:
            self.GetDefaultCZZFLAGS_flags_flags = list(self.Platform_CPPFLAGS_B4Includes)
            self.GetDefaultCZZFLAGS_flags_flagValues2Remove = list(self.CPPFLAGS2Remove)
            self.Platform_CPPFLAGS_B4Includes = self.GetDefaultCZZFLAGS_flags_(0, true, false)
            self.GetDefaultCZZFLAGS_flags_flags = []
            self.GetDefaultCZZFLAGS_flags_flagValues2Remove = []
            self.StroikaFoundation_CPPFLAGS_B4Includes = self.GetDefaultCZZFLAGS_flags_(0, false, true)
        if self.CFLAGS_Overridden == false:
            self.GetDefaultCZZFLAGS_flags_flags = list(self.CFLAGS)
            self.GetDefaultCZZFLAGS_flags_flagValues2Remove = list(self.CFLAGS2Remove)
            self.CFLAGS = self.GetDefaultCZZFLAGS_flags_(1, true, true)
        if self.CXXFLAGS_Overridden == false:
            self.GetDefaultCZZFLAGS_flags_flags = list(self.CXXFLAGS)
            self.GetDefaultCZZFLAGS_flags_flagValues2Remove = list(self.CXXFLAGS2Remove)
            self.CXXFLAGS = self.GetDefaultCZZFLAGS_flags_(2, true, true)

        # Append these last so they can be used to override earlier options
        for r in self.CXXFLAGS2Append:
            self.CXXFLAGS.append(r)

        if self.BuildPlatform == "Unix" and self.CPPSTD_VERSION_FLAG != "":
            self.LinkerArgs_ExtraPrefix += " " + self.CPPSTD_VERSION_FLAG

        if self.INCLUDE_SYMBOLS_EXE:
            if isVisualStudio:
                # PREPEND this option, because it effects the default for other options like -OPT and resets them
                self.LinkerArgs_ExtraPrefix = "-DEBUG:FULL " + self.LinkerArgs_ExtraPrefix
            elif self.BuildPlatform == "Unix":
                self.LinkerArgs_ExtraPrefix += " -g"

        if PERL_OS == "darwin" and self.IsClangPlusPlus_(self.COMPILER_DRIVER_CPlusPlus) and S(self.ARCH) != "":
            self.CFLAGS.append(" -arch " + self.ARCH)
            self.CXXFLAGS.append(" -arch " + self.ARCH)
            self.LinkerArgs_ExtraPrefix += " -arch " + self.ARCH
            # Since XCode 15: 'ld: warning: ignoring duplicate libraries' and no simple way to avoid them (configure.pl's
            # comment here has what was tried). Seems least bad of a bad bunch of options:
            self.LinkerArgs_ExtraSuffix += " -Wl,-no_warn_duplicate_libraries"

        # Under LTO, gcc emits every middle/back-end diagnostic at LINK time, and LTRANS honours only the link command's -W
        # flags, so the compile warning policy must be repeated on the link line. Here, after the last change to
        # CXXWARNING_FLAGS; prepended, so the link-only suppressions already in LinkerArgs_ExtraPrefix still win.
        if self.IsGCCOrGPlusPlus_(self.COMPILER_DRIVER) and self.ENABLE_LTO == true:
            self.LinkerArgs_ExtraPrefix = S(self.CXXWARNING_FLAGS) + " " + self.LinkerArgs_ExtraPrefix

    def ValidateConfigurationAndEmitNeededWarnings_(self):
        if self.IsClangPlusPlus_(self.COMPILER_DRIVER_CPlusPlus) and self.GetClangVersion_(self.COMPILER_DRIVER_CPlusPlus) < 15.0:
            self.Print("CONFIGURATION-WARNING: Stroika v3 requires clang 15 or later (compiler-driver: " + S(self.COMPILER_DRIVER_CPlusPlus) + ").\n")
        if self.IsGCCOrGPlusPlus_(self.COMPILER_DRIVER_CPlusPlus) and self.GetGCCVersion_(self.COMPILER_DRIVER) < 11:
            self.Print("CONFIGURATION-WARNING: Stroika 3 requires gcc 11 or later (compiler-driver: " + S(self.COMPILER_DRIVER_CPlusPlus) + ").\n")

    def GetMSVCVarName_(self, envVarName):
        """The Visual Studio environment (vcvarsall.bat's) for this ARCH and BuildToolsRoot - computed once"""
        if re.match(r"VisualStudio.Net", self.BuildPlatform):
            self.VSSupportLoaded_ = True
        if S(self.ARCH) == "":
            Die("reorg code so this set first")
        if not self.GetMSVCVarName_filled_:
            # Visual Studio targets only x86 and x86_64. Any other ARCH (e.g. UNKNOWN, for a compiler that is not installed) gets
            # no Visual Studio environment, so configure gets far enough for --only-if-has-compiler to skip the configuration.
            if self.ARCH in ("x86", "x86_64"):
                if not self.VSSupportLoaded_:
                    raise CannotMatchPerl("Visual Studio support used for a non-Visual Studio build platform")
                if self.BuildToolsRoot is None:
                    self.BuildToolsRoot = self.GetDefaultToolsBuildDir(self.BuildPlatform)
                self.GetMSVCVarName_e_ = self.GetAugmentedEnvironmentVariablesForConfiguration(self.ARCH, self.BuildToolsRoot)
            self.GetMSVCVarName_filled_ = true
        return S(self.GetMSVCVarName_e_.get(envVarName))

    # ---------------------------------------------------------------- Build/Lib/Perl/Configure-VisualStudio-Support.pl

    def toCygPath_(self, arg):
        if arg is None:
            arg = ""
        if arg.endswith("\\"):
            arg = arg[:-1]
        if arg == "":
            return ""
        return self.Cygpath(["--unix"], [arg])[0]

    def fromCygPath_(self, arg):
        if S(arg) == "":
            return ""
        return self.Cygpath(["--mixed"], [arg])[0]

    toExternallyUsedPath_ = fromCygPath_

    def GetDefaultToolsBuildDir(self, PLATFORM):
        """The default (guessed) Visual Studio installation directory, e.g. C:/Program Files/Microsoft Visual Studio/18/Community"""
        PROGRAMFILESDIR = S(Env("PROGRAMFILES"))
        PROGRAMFILESDIR86 = S(Env("ProgramFiles(x86)"))
        names = ["18"]  # default to vs2k2026
        if PLATFORM == "VisualStudio.Net-2022":
            names = ["2022"]
        elif PLATFORM == "VisualStudio.Net-2026":
            names = ["18"]
        elif PLATFORM == "VisualStudio.Net":
            pass  # keep default
        else:
            Die("PLATFORM unreconfigued in configure")
        VSDIR = None
        for n in names:
            VSDIR = PROGRAMFILESDIR86 + "\\Microsoft Visual Studio\\" + n
            if not PerlExists(self.toCygPath_(VSDIR)):
                VSDIR = PROGRAMFILESDIR + "\\Microsoft Visual Studio\\" + n
            if not PerlExists(self.toCygPath_(VSDIR)):
                break
        # @todo consider somehow redoing this logic with use of vswhere, but not 100% sure how to fetch efficiently to use
        VSDIRs = PerlGlob(self.toCygPath_(VSDIR + "\\*"))
        if len(VSDIRs) == 0:
            Die("No 'VSDIR' found automatically")
        VSDIR = self.fromCygPath_(VSDIRs[0])
        if len(VSDIRs) > 1:
            self.Print("Configure Warning: Multiple VSDirs found: using " + VSDIR + "\n")
        if not PerlExists(self.toCygPath_(VSDIR)):
            Die("directory '" + VSDIR + "' doesn't exist")
        return VSDIR

    def GetString2InsertIntoBatchFileToInitCompiles_(self, ARCH, VSDIR):
        # SEE https://docs.microsoft.com/en-us/cpp/build/building-on-the-command-line?view=vs-2019 for docs on calling vcvarsall.bat
        if ARCH == "x86":
            arg = "x64_x86"
        elif ARCH == "x86_64":
            arg = "x64"
        else:
            Die("hardwired/to fix logic about mapping config names to 32/64")
        VSDIR_VC = S(VSDIR) + "\\VC"
        if not PerlExists(self.toCygPath_(VSDIR_VC)):
            Die("Couldn't find " + VSDIR_VC + ": did you install visual studio desktop C++ support?")
        # pushd/popd: vcvarsall.bat cd's to %VSCMD_START_DIR% if that is set, and older Visual Studios to %USERPROFILE%\Source
        result = "pushd %TEMP%\r\n"
        result += 'call "' + VSDIR_VC + "\\Auxiliary\\Build\\vcvarsall.bat" + '" ' + arg + " > nul;\r\n"
        result += "popd\r\n"
        return result

    def RunBackTickWithVCVarsSetInEnvironment_(self, ARCH, VSDIR, cmd2Run):
        fd, tmpPath = tempfile.mkstemp(prefix="runCmdInVCVarsContext_", suffix=".bat", dir=".")
        try:
            with os.fdopen(fd, "wb") as f:
                f.write(("@echo off\r\n" + self.GetString2InsertIntoBatchFileToInitCompiles_(ARCH, VSDIR) + cmd2Run + "\r\n").encode(ENC))
            # https://github.com/SophistSolutions/Stroika/issues/1073 /E:ON needed for this ticket
            # cmd finds the .bat by its bare name, in the current directory - which NoDefaultCurrentDirectoryInExePath turns off
            p = subprocess.run(["cmd", "/E:ON/C", os.path.basename(tmpPath)], stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                               env=ChildEnv(drop=["NoDefaultCurrentDirectoryInExePath"]))
            self.PrintErr(p.stderr.decode(ENC))
            return p.stdout.decode(ENC)
        finally:
            os.unlink(tmpPath)

    def GetEnvironmentVariablesForConfiguration_(self, ARCH, VSDIR):
        resultStr = self.RunBackTickWithVCVarsSetInEnvironment_(ARCH, VSDIR, "set")
        result = {}
        for line in re.split(r"[\r\n]", resultStr):
            splitLine = PerlSplit("=", line)
            envVar = splitLine[0] if len(splitLine) > 0 else ""
            envVarValue = splitLine[1] if len(splitLine) > 1 else ""
            result[envVar] = result.get(envVar, "") + envVarValue  # PERL QUIRK: a value is cut at its second '='
        return result

    def GetAugmentedEnvironmentVariablesForConfiguration(self, ARCH, VSDIR):
        """A dictionary with all the configuration for the given argument ARCH string"""
        resEnv = self.GetEnvironmentVariablesForConfiguration_(ARCH, VSDIR)
        cwVSDIR = self.toCygPath_(VSDIR)
        HOSTSTR = "HostX64"  # I doubt anyone develops on 32bit anymore, but if they do we can easily detect and fix this
        if ARCH not in ("x86", "x86_64"):
            Die("unrecongized ARCH")
        target, asName = ("x86", "ml") if ARCH == "x86" else ("x64", "ml64")
        exeDirs = PerlGlob(cwVSDIR + "/VC/Tools/MSVC/*/bin/" + HOSTSTR + "/" + target)
        exeDir = self.fromCygPath_(exeDirs[-1] if exeDirs else None)
        if len(exeDirs) > 1:
            self.Print(self.PrintLevelLeader(N(self.MAKE_INDENT_LEVEL) + 2) + "Configure Warning: Multiple Compiler directories found: using " + exeDir + "\n")
        sdkPath = self.toCygPath_(resEnv.get("WindowsSdkVerBinPath"))
        exeDir2 = sdkPath + "/x64/"
        names = ["AS", "CC", "LD", "AR", "ASAN_DLL_DIR", "MIDL", "RC", "WindowsSdkVerBinPath"]
        values = self.Cygpath(["--mixed"], [exeDir + "\\" + asName, exeDir + "\\cl", exeDir + "\\link", exeDir + "\\lib", exeDir,
                                            exeDir2 + "midl", exeDir2 + "rc", sdkPath], emptyGivesEmpty=True)
        for n, v in zip(names, values):
            resEnv[n] = v

        myOrigFullPath = S(Env("PATH"))
        if sys.platform == "win32":  # what an MSYS2/Cygwin Perl's $ENV{PATH} says
            myOrigFullPath = self.Backtick('cygpath --unix --path "' + myOrigFullPath + '"')
            if myOrigFullPath.endswith("\n"):
                myOrigFullPath = myOrigFullPath[:-1]
        # PERL QUIRK: the new PATH is not trimmed, so its last entry ends with a newline, matches nothing, and is always added
        newFullPath = self.Backtick('cygpath --unix --path "' + S(resEnv.get("PATH")) + '"')
        myOrigFullPathHash = set(PerlSplit(":", myOrigFullPath))
        newFullPathHash = set(PerlSplit(":", newFullPath)) - myOrigFullPathHash
        # Sorting is not desirable, but has doesn't preserve order anyhow, so best the output is regular (the same across runs)
        resEnv["TOOLS_PATH_ADDITIONS"] = ":".join(Trim(ip) for ip in sorted(newFullPathHash))

        for n in ("VCToolsInstallDir", "VSINSTALLDIR", "WindowsSdkDir"):
            resEnv[n] = self.toExternallyUsedPath_(self.toCygPath_(resEnv.get(n)))
        return resEnv

    # ---------------------------------------------------------------- writing the configuration file

    def ConfigFileText_(self):
        """
        The configuration file's text. A PartialWrite carries what the Perl had written by then, if it dies part way: it
        writes the file as it goes.
        """
        isVS = re.match(r"VisualStudio.Net", self.BuildPlatform) is not None
        # probably belongs elsewhere
        if isVS:
            self.VC_PLATFORM_INCLUDES_PATH = self.Cygpath(["--mixed"], self.VC_PLATFORM_INCLUDES_PATH)
            self.PLATFORM_INCLUDES_PATH = self.Cygpath(["--mixed"], self.PLATFORM_INCLUDES_PATH)
            self.FOUNDATION_INCLUDES_PATH = self.Cygpath(["--mixed"], self.FOUNDATION_INCLUDES_PATH)
            self.LinkerArgs_LibPath = self.Cygpath(["--mixed"], self.LinkerArgs_LibPath)
        # FIXUP LinkerArgs_LibPath
        LinkerArgs_LibPathString = ""
        for l in self.LinkerArgs_LibPath:
            l = S(l)
            if isVS:
                if len(l) > 0 and l.endswith("\\"):
                    l += '"'
                LinkerArgs_LibPathString += '-LIBPATH:"' + l + '" '
            else:
                LinkerArgs_LibPathString += "-L" + l + " "

        appArgs = self.GetAppArgs_()
        o = []
        w = o.append
        w("<!--This file autogenerated by the configure command: see ConfigureCommandLine, modify it, and re-run-->\n\n")
        w("<Configuration>\n")

        w("    <!--Overall-->\n")
        w("    <ConfigureCommandLine>")
        w("configure ")
        w(" ".join(appArgs))
        w("</ConfigureCommandLine>\n")
        w("    <BuildPlatform>" + S(self.BuildPlatform) + "</BuildPlatform>\n")
        if self.BuildToolsRoot is not None:
            w("    <BuildToolsRoot>" + self.BuildToolsRoot + "</BuildToolsRoot>\n")
        w("    <TargetPlatforms>" + S(self.TargetPlatforms) + "</TargetPlatforms>\n")
        w("    <ARCH>" + S(self.ARCH) + "</ARCH>\n")
        w("    <ConfigTags>" + S(self.Config_Tag) + "</ConfigTags>\n")
        w("    <BuildByDefault>" + S(self.BuildByDefault) + "</BuildByDefault>\n")

        w("\n    <!--Tools-->\n")
        if self.AR is not None:
            w("    <AR>" + self.AR + "</AR>\n")
        w("    <AS>" + S(self.AS) + "</AS>\n")
        w("    <CC>" + S(self.COMPILER_DRIVER_C) + "</CC>\n")
        w("    <CXX>" + S(self.COMPILER_DRIVER_CPlusPlus) + "</CXX>\n")
        w("    <CMAKE>" + (self.CMAKE if self.CMAKE is not None else "cmake") + "</CMAKE>\n")
        if self.LIBTOOL is not None:
            w("    <LIBTOOL>" + self.LIBTOOL + "</LIBTOOL>\n")
        w("    <LINKER>" + S(self.LINKER) + "</LINKER>\n")
        for name in ("MIDL", "RANLIB", "RC", "STRIP"):
            if getattr(self, name) is not None:
                w("    <" + name + ">" + getattr(self, name) + "</" + name + ">\n")

        w("\n    <!--Features Enabled-->\n")
        if self.FEATUREFLAG_ATLMFC is not None:
            w("    <qFeatureFlag_ATLMFC>" + self.FEATUREFLAG_ATLMFC + "</qFeatureFlag_ATLMFC>\n")
        w("    <qFeatureFlag_boost>" + S(self.FEATUREFLAG_boost) + "</qFeatureFlag_boost>\n")
        w("    <qFeatureFlag_LibCurl>" + S(self.FEATUREFLAG_LIBCURL) + "</qFeatureFlag_LibCurl>\n")
        w("    <qFeatureFlag_fmtlib>" + S(self.FEATUREFLAG_fmtlib) + "</qFeatureFlag_fmtlib>\n")
        w("    <qFeatureFlag_GoogleTest>" + S(self.FEATUREFLAG_GoogleTest) + "</qFeatureFlag_GoogleTest>\n")
        w("    <qFeatureFlag_LZMA>" + S(self.FEATUREFLAG_LZMA) + "</qFeatureFlag_LZMA>\n")
        w("    <qFeatureFlag_mongocxxdriver>" + S(self.FEATUREFLAG_mongocxxdriver) + "</qFeatureFlag_mongocxxdriver>\n")
        w("    <qFeatureFlag_OpenSSL>" + S(self.FEATUREFLAG_OpenSSL) + "</qFeatureFlag_OpenSSL>\n")
        if S(self.FEATUREFLAG_OpenSSLExtraArgs) != "":
            if self.FEATUREFLAG_OpenSSL == LIBFEATUREFLAG_UseStaticTPP:
                w("    <qFeatureFlag_OpenSSL_ExtraArgs>" + self.FEATUREFLAG_OpenSSLExtraArgs + "</qFeatureFlag_OpenSSL_ExtraArgs>\n")
            else:
                raise PartialWrite("".join(o), "Cannot specify OpenSSL-ExtraArgs unless --OpenSSL use")
        w("    <qFeatureFlag_sqlite>" + S(self.FEATUREFLAG_sqlite) + "</qFeatureFlag_sqlite>\n")
        w("    <qFeatureFlag_StrawberryPerl>" + S(self.FEATUREFLAG_StrawberryPerl) + "</qFeatureFlag_StrawberryPerl>\n")
        w("    <qFeatureFlag_WinHTTP>" + S(self.FEATUREFLAG_WinHTTP) + "</qFeatureFlag_WinHTTP>\n")
        w("    <qFeatureFlag_WIX>" + S(self.FEATUREFLAG_WIX) + "</qFeatureFlag_WIX>\n")
        w("    <qFeatureFlag_Xerces>" + S(self.FEATUREFLAG_Xerces) + "</qFeatureFlag_Xerces>\n")
        w("    <qFeatureFlag_libxml2>" + S(self.FEATUREFLAG_libxml2) + "</qFeatureFlag_libxml2>\n")
        w("    <qFeatureFlag_ZLib>" + S(self.FEATUREFLAG_ZLib) + "</qFeatureFlag_ZLib>\n")
        w("    <qFeatureFlag_zstd>" + S(self.FEATUREFLAG_zstd) + "</qFeatureFlag_zstd>\n")
        if self.gAssertionsEnabled != DEFAULT_BOOL_OPTIONS:
            w("    <AssertionsEnabled>" + S(self.gAssertionsEnabled) + "</AssertionsEnabled>\n")
        w("    <SanitizerFlags>" + "".join(S(v) + " " for v in self.sanitizerFlags) + "</SanitizerFlags>\n")

        w("\n    <!--MISC-->\n")
        w("    <CrossCompiling>" + S(self.CrossCompiling) + "</CrossCompiling>\n")
        w("    <ExtraMakeDefines>\n")
        for var in self.useExtraMakeDefines:
            w("       <MakeDefine>" + S(var) + "</MakeDefine>\n")
        w("    </ExtraMakeDefines>\n")
        w("    <Foundation_PkgConfigNames>" + " ".join(self.foundationPackageCfgNames) + "</Foundation_PkgConfigNames>\n")

        w("\n    <!--Platform Settings-->\n")
        for name in ("VSVARS_WindowsSdkDir", "VSVARS_WindowsSDKVersion", "VSVARS_VSINSTALLDIR", "VSVARS_VCToolsInstallDir",
                     "VSVARS_MSVC_RUNTIME_LIBRARY"):
            if getattr(self, name) is not None:
                w("    <" + name + ">" + getattr(self, name) + "</" + name + ">\n")
        if S(self.MACOSX_DEPLOYMENT_TARGET) != "":
            w("    <MACOSX_DEPLOYMENT_TARGET>" + self.MACOSX_DEPLOYMENT_TARGET + "</MACOSX_DEPLOYMENT_TARGET>\n")
        if self.TOOLS_PATH_ADDITIONS is not None:
            w("    <TOOLS_PATH_ADDITIONS>" + self.TOOLS_PATH_ADDITIONS + "</TOOLS_PATH_ADDITIONS>\n")
        if len(self.VC_PLATFORM_INCLUDES_PATH) != 0:
            w("    <VSVARS_PLATFORM_INCLUDES_PATH>" + self.PATH_SEPERATOR.join(S(p) for p in self.VC_PLATFORM_INCLUDES_PATH) + "</VSVARS_PLATFORM_INCLUDES_PATH>\n")

        w("\n    <!--Compiling-->\n")
        w("    <PLATFORM_CPPFLAGS_NOTINCLUDES>" + " ".join(S(v) for v in self.Platform_CPPFLAGS_B4Includes) + "</PLATFORM_CPPFLAGS_NOTINCLUDES>\n")
        w("    <PLATFORM_INCLUDES_PATH>" + self.PATH_SEPERATOR.join(S(p) for p in self.PLATFORM_INCLUDES_PATH) + "</PLATFORM_INCLUDES_PATH>\n")
        w("    <PLATFORM_CFLAGS>" + " ".join(S(v) for v in self.CFLAGS) + "</PLATFORM_CFLAGS>\n")
        w("    <PLATFORM_CXXFLAGS>" + " ".join(S(v) for v in self.CXXFLAGS) + "</PLATFORM_CXXFLAGS>\n")
        w("    <FOUNDATION_CPPFLAGS_NOTINCLUDES>" + " ".join(S(v) for v in self.StroikaFoundation_CPPFLAGS_B4Includes) + "</FOUNDATION_CPPFLAGS_NOTINCLUDES>\n")
        w("    <FOUNDATION_INCLUDES_PATH>" + self.PATH_SEPERATOR.join(S(p) for p in self.FOUNDATION_INCLUDES_PATH) + "</FOUNDATION_INCLUDES_PATH>\n")

        w("\n    <!--Linking-->\n")
        w("    <IncludeDebugSymbolsInLibraries>" + S(self.INCLUDE_SYMBOLS_LIB) + "</IncludeDebugSymbolsInLibraries>\n")
        w("    <IncludeDebugSymbolsInExecutables>" + S(self.INCLUDE_SYMBOLS_EXE) + "</IncludeDebugSymbolsInExecutables>\n")
        w("    <Platform_LinkerArgs_LibPath>" + LinkerArgs_LibPathString + "</Platform_LinkerArgs_LibPath>\n")
        w("    <Platform_LinkerArgs_LibDependencies>" + S(self.LinkerArgs_LibDependencies) + "</Platform_LinkerArgs_LibDependencies>\n")
        w("    <Platform_LinkerArgs_ExtraPrefix>" + S(self.LinkerArgs_ExtraPrefix) + "</Platform_LinkerArgs_ExtraPrefix>\n")
        w("    <Platform_LinkerArgs_ExtraSuffix>" + S(self.LinkerArgs_ExtraSuffix) + "</Platform_LinkerArgs_ExtraSuffix>\n")

        # todo fix/wrong - only works for case of zero or one file
        # ';' separated list of files to be copied into same directory as we link to, as part of linking operations.
        w("    <LinkTime_CopyFilesToEXEDir>" + " ".join('"' + S(v) + '"' for v in self.LinkTime_CopyFilesToEXEDir) + "</LinkTime_CopyFilesToEXEDir>\n")

        w("\n    <!--Runtime/Testing-->\n")
        w("    <RunPrefix>" + S(self.RunPrefix) + "</RunPrefix>\n")

        w("\n    <!--Compiler/Tool Bug Workarounds/Defines-->\n")
        if self.qCompiler_HasNoMisleadingIndentation_Flag is not None:
            w("    <qCompiler_HasNoMisleadingIndentation_Flag>" + S(self.qCompiler_HasNoMisleadingIndentation_Flag) + "</qCompiler_HasNoMisleadingIndentation_Flag>\n")

        w("\n    <!--VERSIONS-->\n")
        if self.IsGCCOrGPlusPlus_(self.COMPILER_DRIVER_CPlusPlus):
            w("        <!--g++ version: " + S(self.GetGCCVersion_(self.COMPILER_DRIVER_CPlusPlus, true)) + "-->\n")
        if self.IsClangOrClangPlusPlus_(self.COMPILER_DRIVER_CPlusPlus):
            w("        <!--clang++ version: " + S(self.GetClangVersion_(self.COMPILER_DRIVER_CPlusPlus, true)) + "-->\n")
        if self.IsMSVCCompiler_(self.COMPILER_DRIVER_CPlusPlus):
            w("        <!--MSVC++ version: " + S(self.Get_MSVC_CL_Version_(self.COMPILER_DRIVER_CPlusPlus)) + "-->\n")
        ubuntuVersion = self.getUbuntuVersion()
        if ubuntuVersion != 0:
            w("        <!--Ubuntu: " + S(ubuntuVersion) + "-->\n")
        if PERL_OS == "darwin":
            w("        <!--MacOS: " + self.getMacOSVersion_() + "-->\n")
            w("        <!--XCode: " + S(self.getXCodeVersion_()) + " ; selected: " + self.getXCodeSelect_() + "-->\n")

        w("</Configuration>\n")
        return "".join(o)

    # ---------------------------------------------------------------- the top level

    def Run(self):
        """Everything configure.pl does but write the file: the file's name and text, or (None, None) if skipped"""
        # PERL QUIRK: never true - MSYS2's perl says "cygwin" - so configure run by hand (not by make, which exports it)
        # leaves MSYS2's argument conversion on
        if PERL_OS == "msys":
            # Workaround MSYS compatabilty issues with microsoft visual C++ tools.
            #   Note: MSYS2_ENV_CONV_EXCL doesn't appear necessary (as of 2022-01-25)
            os.environ["MSYS2_ARG_CONV_EXCL"] = "*"
        self.ParseCommandLine_()
        self.PostProcessOptions_()

        try:
            os.mkdir(self.configurationFiles)
        except OSError:
            pass

        generate = true
        generateBecause = ""
        CXX = self.COMPILER_DRIVER_CPlusPlus
        if self.onlyGenerateIfCompilerExists:
            if not self.HasCompiler_(CXX):
                generate = false
                generateBecause = "compiler " + S(CXX) + " not present"

            # Really should do similar for anything we say == system and $onlyGenerateIfCompilerExists
            if generate and self.FEATUREFLAG_ZLib == LIBFEATUREFLAG_UseSystem:
                if self.System("pkg-config --libs zlib 2>/dev/null >/dev/null") != 0:
                    generate = false
                    generateBecause = "zlib is not installed"
            # --valgrind enable compiles in memcheck's client requests, so every compile needs <valgrind/memcheck.h>: ask the
            # compiler rather than look for the file, so the answer is the include path the build will really search.
            if generate and self.TargettingValgrind:
                if self.System('printf "#include <valgrind/memcheck.h>\n" | ' + S(CXX) + " -fsyntax-only -x c++ - 2>/dev/null > /dev/null") != 0:
                    generate = false
                    generateBecause = "valgrind is not installed (no <valgrind/memcheck.h>)"

            if generate and self.IsGCCOrGPlusPlus_(CXX):
                itsVersion = self.GetGCCVersion_(CXX)
                if itsVersion < 11.0:
                    generate = false
                    generateBecause = "GCC (" + S(CXX) + ") v=" + S(itsVersion) + " is older than Stroika's minimum, gcc 11"
            if self.FEATUREFLAG_fmtlib is not None and self.FEATUREFLAG_fmtlib == LIBFEATUREFLAG_No and self.NeedsFmtLib_():
                generate = false
                generateBecause = "This compiler requires fmtlib, and configure arguments disabled fmtlib use."
            ubuntuVersion = self.getUbuntuVersion()
            # if flag to use libc++ - check if right version is available (but not on XCode)
            if generate and self.IsClangOrClangPlusPlus_(CXX):
                itsVersion = self.GetClangVersion_(CXX)
                if itsVersion < 15.0:
                    generate = false
                    generateBecause = S(CXX) + " v=" + S(itsVersion) + " is older than Stroika's minimum, clang 15"
                if generate and ubuntuVersion == 24.04 and itsVersion < 16.0 and self.STDCXXLIB == "libstdc++":
                    # clang++-15-release-libstdc++ fails building google test
                    generate = false
                    generateBecause = S(CXX) + " with libstdc++ doesn't work with this version of libstdc++"
                if (generate and 16.0 <= itsVersion < 18.0 and self.STDCXXLIB == "libstdc++"
                        and self.CPPSTD_VERSION_FLAG in ("--std=c++2b", "--std=c++23")):
                    # PERHAPS should fine tune this check to make sure we are looking at g++ lib 13
                    generate = false
                    generateBecause = "clang++-16/17 with libstdc++ doesn't support c++23 mode"
                if generate and self.STDCXXLIB == "libc++" and not self.StdLibSupportsCompiler_(CXX, "libc++"):
                    # only reached when libc++ was asked for explicitly - the default would already have fallen back
                    generate = false
                    generateBecause = "the installed libc++ says it does not support " + S(CXX)
                if generate and not self.HasStdLib_(CXX, self.STDCXXLIB):
                    generate = false
                    generateBecause = S(self.STDCXXLIB) + " not available for " + S(CXX)
            if generate and ubuntuVersion != 0:
                # needed for example of HOST OS is Ubuntu 24.04 (not necessarily OS in container)
                if self.IsTargettingSanitizer_("thread"):
                    randBits = self.Backtick("sudo -S cat /proc/sys/vm/mmap_rnd_bits < /dev/null 2>/dev/null")
                    if randBits == "":
                        generate = false
                        generateBecause = "Cannot read mmap_rnd_bits and https://stackoverflow.com/questions/77850769/fatal-threadsanitizer-unexpected-memory-mapping-when-running-on-linux-kernels"
                    elif N(randBits) > 28:
                        generate = false
                        generateBecause = "sudo sysctl vm.mmap_rnd_bits=28 to allow tsan: https://stackoverflow.com/questions/77850769/fatal-threadsanitizer-unexpected-memory-mapping-when-running-on-linux-kernels"
            if generate and ubuntuVersion == 24.04 and self.gUbuntu2404OptimizedNoLTOHazard:
                # gcc 13/14 as packaged on Ubuntu 24.04 give WRONG ANSWERS when optimizing without LTO - see
                # ApplyCompilerBugWorkarounds_. For an OPTIONAL configuration, do not generate it at all.
                generate = false
                generateBecause = "gcc 13/14 on Ubuntu 24.04 miscompile Stroika containers when optimizing without LTO (see ApplyCompilerBugWorkarounds_ in configure)"
            if generate and ubuntuVersion == 22.04:
                # needed for [34] Foundation::DataExchange::XML - raspberrypi-g++-12-release-sanitize_address/Tests/Test34
                if self.IsGCCOrGPlusPlus_(CXX):
                    if self.GetGCCVersion_(CXX) < 13.0 and self.ARCH == "armhf":
                        # maybe only needed for release builds - but fine tune tests later in the cycle, and also not checking if arm only issue
                        if self.IsTargettingSanitizer_("address"):
                            generate = false
                            generateBecause = "bogus failure on raspberrypi-g++-12-release-sanitize_address/Tests/Test34 - so skipping asan by default - for this target"
            if generate and self.qCompiler_SanitizerDoubleLockWithConditionVariables_Buggy:
                if "thread" in self.sanitizerFlags:
                    generate = false
                    generateBecause = "qCompiler_SanitizerDoubleLockWithConditionVariables_Buggy - see https://github.com/SophistSolutions/Stroika/issues/851 AND https://gcc.gnu.org/bugzilla//show_bug.cgi?id=101978 "

        if generate:
            self.ValidateConfigurationAndEmitNeededWarnings_()
            masterXMLConfigFile = self.configurationFiles + self.configurationName + ".xml"
            self.Print(self.PrintLevelLeader(self.MAKE_INDENT_LEVEL) + 'Writing "' + masterXMLConfigFile + '" ... ')
            try:
                text = self.ConfigFileText_()
            except PartialWrite as e:
                e.fileName = masterXMLConfigFile
                raise
            self.Print("done\n")
            return masterXMLConfigFile, text
        self.Print(self.PrintLevelLeader(self.MAKE_INDENT_LEVEL) + "Skipping configuration " + self.configurationName + " because "
                   + generateBecause + " and configuration invoked with --only-if-has-compiler\n")
        return None, None


class PartialWrite(PerlDie):
    """A die part way through writing the configuration file, which the Perl leaves holding what it had written"""

    def __init__(self, text, msg):
        PerlDie.__init__(self, msg)
        self.text = text
        self.fileName = None


HELP_TEXT_ = (
    'Usage:\n'
    '  configure CONFIGURATION-NAME [OPTIONS]* where options can be:\n'
    '\t    --arch {ARCH}                                    /* for high level architecture - first section of gcc -machine - e.g. x86, x86_64, arm - usually auto-detected */\n'
    '\t    [--config-tag {TAG-NAME}]*                       /* Add TAG-NAME to the list of tags associated with this configuration (for now limit one). Maybe repeated */\n'
    '\t    --build-by-default never|always|{uname}          /* Mark configuration to be built by default always (DEFAULT), never, or only if host uname/uname -o equals ARGUMENT */\n'
    '\t    --build-platform {PLATFORM}                      /* Specifies the BuildPlatform (currently supported: Unix (even on macos), VisualStudio.Net-2022, VisualStudio.Net-2026) - usually auto-detected (was ProjectPlatformSubDir in Stroika v2.1) */\n'
    '\t    --target-platforms {TargetPlatforms}             /* Specifies the TargetPlatforms- system compiling Stroika for - (set of ENUM where ENUM=(Windows, POSIX, Linux, MacOS)) - usually auto-detected */\n'
    '\t    --build-tools-root {BuildToolsRoot}              /* Specifies the BuildToolsRoot (makefile variable) - initially just for visual studio - usually auto-detected */\n'
    '\t    --assertions { enable|disable|default }          /* Enables/disable assertion feature (setting qStroika_Foundation_Debug_AssertionsChecked) */\n'
    '\t    --block-allocation { enable|disable|default }    /* Enables/disable block-allocation (a feature that improves performance, but messes up valgrind) */\n'
    '\t    --valgrind { enable|disable|default }            /* Enables/disable valgrind-specific runtime code */\n'
    '\t    --GLIBCXX_DEBUG { enable|disable|default }       /* Enables/Disables GLIBCXX_DEBUG (G++-specific) */\n'
