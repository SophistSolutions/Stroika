        # So in Stroika 2.1a2 switch default to more standard (and recommended by MSFT docs above) no structured exceptions
        self.Windows_Exceptions_SupportStructuredExceptions = False

        self.GetDefaultCZZFLAGS_flags_flags = []
        self.GetDefaultCZZFLAGS_flags_flagValues2Remove = []
