OPTIONS_BY_NAME_ = {n.lower(): o for o in OPTIONS_ for n in (o.name,) + o.aliases}
HELP_OPTION_ = OPTIONS_BY_NAME_["help"]


def FindOption_(arg):
    """The option arg names - -NAME or --NAME, the name in any case - or None"""
    m = re.fullmatch(r"--?([^-].*)", arg)
    return OPTIONS_BY_NAME_.get(m.group(1).lower()) if m else None


def HelpText_():
    lines = ["Usage:", "  configure CONFIGURATION-NAME [OPTIONS]* where options can be:"]
    for o in OPTIONS_:
        usage = "--" + o.name
        if isinstance(o.arg, dict):
            usage += " {" + "|".join(o.arg) + "}"
        elif o.arg is not None:
            usage += " " + o.arg
        text = o.help.split("\n")
        text[-1] += " */"
        lines.append("\t    " + usage.ljust(48) + " /* " + text[0])
        lines += ["\t" + " " * 56 + t for t in text[1:]]
    lines += [
        "",
        "Configure's behavior is also influenced by the following environment variables:",
        "\t    CC, CXX, PLATFORM, ARCH, AS, AR, RANLIB, STRIP; each just simulates adding the obvious associated argument to configure",
        "\t    EXTRA_CONFIGURE_ARGS= a space separated list of arguments added to the beginning of the configure command",
    ]
    return "\n".join(lines) + "\n"


def Main_(argv):
    c = Configure_(argv)
    try:
        fileName, text = c.Run()
    except Exit_ as e:
        return e.status
    except ConfigureError_ as e:
        c.PrintErr(str(e) + ("" if str(e).endswith("\n") else "\n"))
        return 1
    if fileName is not None:
        with open(fileName, "wb") as f:
            f.write(text.encode(ENCODING_, ENCODING_ERRORS_))
        try:
            os.remove("IntermediateFiles/APPLIED_CONFIGURATIONS")
        except OSError:
            pass
    return 0


if __name__ == "__main__":
    sys.exit(Main_(sys.argv[1:]))
