    # ---------------------------------------------------------------- running things, as Perl's `` and system () do

    @staticmethod
    def Print(s, stream=None):
        stream = stream or sys.stdout
        stream.buffer.write(s.encode(ENC))
        stream.flush()

    def PrintErr(self, s):
        if s:
            self.Print(s, sys.stderr)

    @staticmethod
    def PerlCommandLine_(cmd):
        """
        How Perl runs a command given as one string (`cmd`, system (cmd)): through sh -c if it has a shell metacharacter, or
        starts VAR= or 'exec ' or '. '; otherwise split on white space, and run directly - when no such program is found,
        that prints nothing, where sh would say "command not found".
        """
        words = re.split(r"[ \t\n\r\f]+", cmd.strip(" \t\n\r\f"))
        if (any(c in "$&*(){}[]'\";\\|?<>~`\n" for c in cmd) or re.match(r"[A-Za-z]*=", cmd.lstrip(" \t\n\r\f"))
                or re.match(r"(exec|\.)[ \t\n\r\f]", cmd.lstrip(" \t\n\r\f")) or words == [""]):
            return ["sh", "-c", cmd]
        # through sh all the same - a native Windows Python cannot run a #! script itself - but silent when not found
        return ["sh", "-c", 'command -v "$1" > /dev/null 2>&1 || exit 127; exec "$@"', "sh"] + words

    def Backtick(self, cmd):
        """Perl's `cmd`: its stdout; its stderr goes where the Perl's would (kept, here, with what this prints)"""
        p = subprocess.run(self.PerlCommandLine_(cmd), stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        self.PrintErr(p.stderr.decode(ENC))
        return p.stdout.decode(ENC)

    def CachedBacktick(self, cmd):
        """Backtick, for a query whose answer cannot change during one run (a compiler's version, say)"""
        if cmd not in self.cache_:
            self.cache_[cmd] = self.Backtick(cmd)
        return self.cache_[cmd]

    def System(self, cmd):
        """Perl's system (cmd): its exit status, 0 meaning success"""
        p = subprocess.run(self.PerlCommandLine_(cmd), stderr=subprocess.PIPE)
        self.PrintErr(p.stderr.decode(ENC))
        return p.returncode

    def Cygpath(self, flags, paths, emptyGivesEmpty=False):
        """
        trim (`cygpath FLAGS "PATH"`) for each of paths, in one cygpath run. An empty path, which cygpath refuses, is given to
        it alone, so it complains as the Perl's does - or, with emptyGivesEmpty, becomes "", as the Perl's toCygPath_ does.
        If that one run fails, each path is given to cygpath alone, so the one it refuses complains.
        """
        if emptyGivesEmpty:
            paths = [p if S(p) != "" else "" for p in paths]
        results = ["" if (emptyGivesEmpty and p == "") else None for p in paths]
        todo = [i for i, p in enumerate(paths) if results[i] is None and S(p) != ""]
        if todo:
            p = subprocess.run(["cygpath"] + flags + [paths[i] for i in todo], stdout=subprocess.PIPE, stderr=subprocess.PIPE)
            lines = p.stdout.decode(ENC).split("\n")
            if p.returncode == 0 and len(lines) >= len(todo) and not p.stderr:
                for n, i in enumerate(todo):
                    results[i] = Trim(lines[n])
        for i, p in enumerate(paths):
            if results[i] is None:
                results[i] = Trim(self.Backtick('cygpath ' + " ".join(flags) + ' "' + S(p) + '"'))
        return results

    def PrintLevelLeader(self, level):
        return "   " * int(N(level))

    # ---------------------------------------------------------------- the Perl's subs, in its order

    def MongoCXXDriverDefaultsOn_(self):
        # Whether mongo-cxx-driver defaults ON - only where it will build successfully. An explicit --mongo-cxx-driver on
        # the command line always wins (the flag is already defined, so this is never consulted).
        #   - NOT armhf + address sanitizer: the armhf gcc cross compilers crash - "internal compiler error: Segmentation
        #     fault" - compiling mongo-c-driver under -fsanitize=address (e.g. in libbson/src/bson/bson-clock.c). Measured
        #     2026-09-24: gcc 13.3/14.2 (Ubuntu 24.04) and 13.4/15.2 (26.04) crash at -O2 AND -O0; 26.04's 14.3 built it in
        #     one container and crashed in the regression-test image - which file crashes shifts with the exact headers, so a
        #     passing combination is luck. The other third-party components built fine under asan, so these configurations
        #     just go without mongo (it is still tested on armhf by the release and ubsan configurations).
        #     TO RETEST on a newer mongo-cxx-driver or compiler: configure the armhf asan configuration WITH
        #     --mongo-cxx-driver use, then build only 'make -C ThirdPartyComponents CONFIGURATION=<it> mongo-cxx-driver' (a
        #     few minutes - no Pi needed). Re-enabled and still broken looks like that ICE in that component's BUILD-OUT.txt,
        #     and the whole configuration failing to build. If it builds, delete this case.
        #     https://github.com/SophistSolutions/Stroika/issues/1174
        if self.ARCH == "armhf" and self.IsTargettingSanitizer_("address"):
            if not self.sMongoArmhfAsanNoted_:
                self.Print("NOTE: mongo-cxx-driver defaults OFF for armhf + address sanitizer (armhf gcc crashes compiling it - see #1174); --mongo-cxx-driver use to force it\n")
                self.sMongoArmhfAsanNoted_ = true
            return false
        return true

    def DoSetThirdPartyComponents_(self, x):
        """x is "all-available", "default", "fill-in-defaults" or "none" """
        if x == "all-available":
            # Basically the same as fill-in-defaults, except for those that default off (maybe more soon)
            # and except fmtlib which is basically a pollyfill
            xercesAlreadySet = self.FEATUREFLAG_Xerces is not None
            mongoAlreadySet = self.FEATUREFLAG_mongocxxdriver is not None
            self.DoSetThirdPartyComponents_("fill-in-defaults")
            if not xercesAlreadySet:
                self.FEATUREFLAG_Xerces = LIBFEATUREFLAG_UseStaticTPP
            if not mongoAlreadySet and self.MongoCXXDriverDefaultsOn_():
                # if not explicitly listed on command-line, only default-on if will build successfully
                self.FEATUREFLAG_mongocxxdriver = LIBFEATUREFLAG_UseStaticTPP
        elif x == "default":
            self.FEATUREFLAG_ATLMFC = None
            self.FEATUREFLAG_boost = None
            self.FEATUREFLAG_LIBCURL = None
            self.FEATUREFLAG_fmtlib = None
            self.FEATUREFLAG_GoogleTest = None
            self.FEATUREFLAG_LZMA = None
            self.FEATUREFLAG_mongocxxdriver = None
            self.FEATUREFLAG_OpenSSL = None
            self.FEATUREFLAG_sqlite = None
            self.FEATUREFLAG_WinHTTP = None
            self.FEATUREFLAG_libxml2 = None
            self.FEATUREFLAG_Xerces = None
        elif x == "fill-in-defaults":
            # Called late enuf that other variables have been filled in...
            if self.FEATUREFLAG_ATLMFC is None:
                if self.BuildPlatform in ("VisualStudio.Net-2022", "VisualStudio.Net-2026"):
                    # in VS2k22, separate checkboxes for ATL and MFC and we need MFC AND ATL
                    if PerlExists(S(self.VSVARS_VCToolsInstallDir) + "/atlmfc/include/afxext.h"):
                        self.FEATUREFLAG_ATLMFC = LIBFEATUREFLAG_UseSystem
                if self.FEATUREFLAG_ATLMFC is None:
                    self.FEATUREFLAG_ATLMFC = LIBFEATUREFLAG_No
            if self.FEATUREFLAG_boost is None:
                self.FEATUREFLAG_boost = LIBFEATUREFLAG_UseStaticTPP
            if self.FEATUREFLAG_LIBCURL is None:
                self.FEATUREFLAG_LIBCURL = LIBFEATUREFLAG_UseStaticTPP if PERL_OS in ("linux", "darwin") else LIBFEATUREFLAG_No
            if self.FEATUREFLAG_libxml2 is None:
                self.FEATUREFLAG_libxml2 = LIBFEATUREFLAG_UseStaticTPP
            if self.FEATUREFLAG_Xerces is None:
                # if we have libxml2 being used, then DEFAULT to not including xerces (takes a long time to build and libxml2 better(?))
                self.FEATUREFLAG_Xerces = LIBFEATUREFLAG_UseStaticTPP if self.FEATUREFLAG_libxml2 == LIBFEATUREFLAG_No else LIBFEATUREFLAG_No
            if self.FEATUREFLAG_LZMA is None:
                self.FEATUREFLAG_LZMA = LIBFEATUREFLAG_UseStaticTPP
            if self.FEATUREFLAG_fmtlib is None:
                self.FEATUREFLAG_fmtlib = LIBFEATUREFLAG_UseStaticTPP if self.NeedsFmtLib_() else LIBFEATUREFLAG_No
            if self.FEATUREFLAG_OpenSSL is None:
                self.FEATUREFLAG_OpenSSL = LIBFEATUREFLAG_UseStaticTPP
            if self.FEATUREFLAG_sqlite is None:
                self.FEATUREFLAG_sqlite = LIBFEATUREFLAG_UseStaticTPP
            if self.FEATUREFLAG_mongocxxdriver is None:
                # if not explicitly listed on command-line, only default-on if will build successfully
                self.FEATUREFLAG_mongocxxdriver = LIBFEATUREFLAG_UseStaticTPP if self.MongoCXXDriverDefaultsOn_() else LIBFEATUREFLAG_No
            if self.FEATUREFLAG_WinHTTP is None:
                self.FEATUREFLAG_WinHTTP = LIBFEATUREFLAG_UseSystem if IS_WINDOWS_HOST else LIBFEATUREFLAG_No
            if self.FEATUREFLAG_ZLib is None:
                self.FEATUREFLAG_ZLib = LIBFEATUREFLAG_UseStaticTPP
            if self.FEATUREFLAG_zstd is None:
                self.FEATUREFLAG_zstd = LIBFEATUREFLAG_UseStaticTPP
            if self.FEATUREFLAG_GoogleTest is None:
                self.FEATUREFLAG_GoogleTest = LIBFEATUREFLAG_UseStaticTPP
        elif x == "none":
            for f in ("ATLMFC", "boost", "LIBCURL", "libxml2", "Xerces", "LZMA", "fmtlib", "OpenSSL", "sqlite", "mongocxxdriver",
                      "WinHTTP", "ZLib", "zstd", "GoogleTest"):
                if getattr(self, "FEATUREFLAG_" + f) is None:
                    setattr(self, "FEATUREFLAG_" + f, LIBFEATUREFLAG_No)
        else:
            Die("Bad argument to DoSetThirdPartyComponents_")

    def ValidateUseArg_(self, var, forName):
        if var not in ("build-only", "use", "use-system", "no"):
            self.Print(forName + " ARG: " + S(var) + "\n")
            self.DoHelp_(1)

    def DoHelp_(self, x):
        self.Print("".join(HELP_TEXT_))
        raise PerlExit(x)

    def ToBool_(self, x):
        if x == "true":
            return true
        if x == "false":
            return false
        Die("expected bool argument to be true/false")

    @staticmethod
    def IsGCCOrGPlusPlus_(x):
        x = S(x)
        return "gcc" in x or ("g++" in x and "clang++" not in x)

    @staticmethod
    def IsClangOrClangPlusPlus_(x):
        return "clang" in S(x)

    @staticmethod
    def IsClangPlusPlus_(x):
        return "clang++" in S(x)

    def GetGCCVersion_(self, x, fullString=None):
        """A number - or, given fullString, the version string"""
        if fullString is not None:
            return Trim(self.CachedBacktick("./Build/Scripts/GetGCCVersion " + S(x)))
        v = Trim(self.CachedBacktick("./Build/Scripts/GetGCCVersion " + S(x) + " -i"))
        if v == "":
            return 0
        return N(v)

    def GetClangVersion_(self, x, fullString=None):
        """A number - or, given fullString, the version string"""
        x = Trim(S(x))
        if fullString is not None:
            return Trim(self.CachedBacktick("./Build/Scripts/GetClangVersion " + x))
        v = Trim(self.CachedBacktick("./Build/Scripts/GetClangVersion " + x + " -i"))
        if v == "":
            return -1
        return N(v)

    def HasStdLib_(self, compilerDriver, stdLib):
        compilerDriver = Trim(S(compilerDriver))
        stdLib = Trim(S(stdLib))
        return self.System('printf "#include <ciso646>\nint main () {}" | ' + compilerDriver + " -E -stdlib=" + stdLib + " -x c++ -dM - 2>/dev/null > /dev/null") == 0

    def StdLibSupportsCompiler_(self, compilerDriver, stdLib):
        # libc++ names the oldest clang it supports in a #warning in its own headers (libc++ 22 wants clang
        # 20 or later). That matters because a distro ships ONE unversioned libc++ while keeping several clang
        # versions installed, so an older clang silently picks up a libc++ that disowns it - ubuntu 26.04 pairs
        # clang++-19 with libc++ 22, and ubuntu 24.04 paired clang++-15 with libc++ 18. Ask the library which
        # compilers it supports rather than keeping those pairs in a table here: a table has to be revisited
        # whenever either side ships a release, and says nothing about a machine whose libc++ came from
        # somewhere else. MacOS needs no special case - Apple's libc++ always matches Apple's clang.
        compilerDriver = Trim(S(compilerDriver))
        stdLib = Trim(S(stdLib))
        return self.System('printf "#include <version>\nint main () {}" | ' + compilerDriver + " -stdlib=" + stdLib + " -fsyntax-only '-Werror=#warnings' -x c++ - 2>/dev/null > /dev/null") == 0

    def GetClangLLD_(self, compilerDriver):
        """
        The lld this clang would link with given -fuse-ld=lld, or None if it has none. Asks the compiler rather than
        looking for ld.lld-NN, so the answer is the lld the link will really get: clang looks in its own bin directory,
        then on PATH, and -print-prog-name echoes back the bare name when it finds nothing.
        """
        compilerDriver = Trim(S(compilerDriver))
        lld = Trim(self.CachedBacktick(compilerDriver + " -print-prog-name=ld.lld 2>/dev/null"))
        return lld if (lld.startswith("/") and os.access(ToPosixPathForTest(lld), os.X_OK)) else None

    def GetLibStdCXXStacktraceLib_(self, compilerDriver, flags):
        """
        The library a std::stacktrace program must link with this compiler, C++ version and libstdc++: "" if none (including
        when std::stacktrace is not there to use at that C++ version), None if no candidate links. libstdc++ keeps it out of
        libstdc++ proper - libstdc++exp from gcc 14 (and 13.3), libstdc++_libbacktrace in 12 and 13. Asks the compiler by
        linking one, rather than going by version, since the distribution decides what is built and shipped.
        """
        compilerDriver = Trim(S(compilerDriver))
        flags = Trim(S(flags))
        src = "#include <version>\n#if __cpp_lib_stacktrace\n#include <stacktrace>\nint main () { return std::stacktrace::current ().empty (); }\n#else\nint main () {}\n#endif\n"
        for lib in ("", "-lstdc++exp", "-lstdc++_libbacktrace"):
            if self.System("printf '" + src + "' | " + compilerDriver + " " + flags + " -x c++ - " + lib + " -o /dev/null 2>/dev/null >/dev/null") == 0:
                return lib
        return None

    def HasCompiler_(self, compilerDriver):
        """
        Whether this compiler is installed. Probes that ask the compiler something report "found nothing" when it is missing,
        so check this first: otherwise every configuration --only-if-has-compiler goes on to skip prints that noise, and
        RegressionTests counts it as a warning (25 of the 40 in a 3.0d25 WSL run, on a box with one g++).
        """
        compilerDriver = Trim(S(compilerDriver))
        return Trim(self.CachedBacktick("./Build/Scripts/HasCompiler " + compilerDriver)) != "0"

    @staticmethod
    def IsMSVCCompiler_(x):
        return re.search(r"cl.exe", S(x)) is not None

    def Get_MSVC_CL_Version_(self, x):
        x = Trim(S(x))
        firstLine = Trim(self.Backtick("('" + x + "' 2>&1) | head -1"))
        fields = firstLine.split()  # echo "$firstLine" | awk '{print $7}' | sed 's/\.//g'
        return N(fields[6].replace(".", "") if len(fields) > 6 else "")

    def getUbuntuVersion(self):
        a = Trim(self.CachedBacktick('(. /etc/os-release ; echo "$VERSION_ID") 2>/dev/null'))
        return 0 if a == "" else N(a)

    def getMacOSVersion_(self):
        return Trim(self.CachedBacktick("/usr/bin/sw_vers | grep ProductVersion | awk 'END {print $2}'"))

    def getXCodeVersion_(self):
        # Version of the SELECTED developer directory (xcode-select -p), which need not match the CommandLineTools package.
        # xcodebuild fails when the CommandLineTools themselves are selected, so fall back to their package version.
        a = Trim(self.Backtick("xcodebuild -version 2>/dev/null | head -1 | grep -E -o '[0-9]+\\.[0-9]+' | head -1"))
        if a == "":
            a = Trim(self.Backtick("pkgutil --pkg-info=com.apple.pkg.CLTools_Executables | grep version: | awk 'END {print $2}' | grep -E -o '[0-9]+\\.[0-9]+' | head -1"))
        if a == "":
            return 0
        return a  # only ever printed; as a number, 26.10 would come out as 26.1

    def getXCodeSelect_(self):
        return Trim(self.Backtick("xcode-select -p"))

    def IsTargettingSanitizer_(self, x):
        return x in self.sanitizerFlags

    def NeedsFmtLib_(self):
        if self.IsClangPlusPlus_(self.COMPILER_DRIVER):
            itsVersion = self.GetClangVersion_(self.COMPILER_DRIVER)
            if PERL_OS == "darwin":
                # Every supported XCode (Apple clang 17 - XCode 16.3 and later) has a usable <format>
                return false
            # For <format> support - in clang++15 - appears good enuf (if you enable --experimental...) - but that is sometimes unvailable, so dont count on it
            if itsVersion < 16.0:
                return true
        if self.IsGCCOrGPlusPlus_(self.COMPILER_DRIVER):
            itsVersion = self.GetGCCVersion_(self.COMPILER_DRIVER)
            # Builtin supports works for gcc as of gcc 13
            if itsVersion < 13.0:
                return true
        return false

    def FillDefaultIncludesPathIfNeeded_(self):
        # IF we set include path explicitly, then suppress adding include path automatically (based on features etc) - just explicitly added ones from the commandline
        includeAutomaticDependencies = not self.INCLUDES_PATH_SET
        if includeAutomaticDependencies:
            # @todo unclear if we want to add this to platform includes path - probably yes (alternative is FOUNDATION_INCLUDES_PATH below)
            self.INCLUDES_PATH_ADD.append(Trim(self.Backtick("realpath --canonicalize-missing Builds/" + S(self.configurationName) + "/include/")) + "/")
            self.PLATFORM_INCLUDES_PATH = []
            self.FOUNDATION_INCLUDES_PATH.append(Trim(self.Backtick("realpath --canonicalize-missing Library/Sources/")) + "/")
            # for now include this (for Stroika/Current-Version.h) but later package all these up in Builds/$CONF/includes/Stroika
            #   self.FOUNDATION_INCLUDES_PATH.append(Trim(self.Backtick("realpath --canonicalize-missing IntermediateFiles/" + S(self.configurationName))) + "/")
            if re.match(r"VisualStudio.Net", self.BuildPlatform):
                self.VC_PLATFORM_INCLUDES_PATH = PerlSplit(";", self.GetMSVCVarName_("INCLUDE"))
                self.PLATFORM_INCLUDES_PATH = list(self.VC_PLATFORM_INCLUDES_PATH)
        for var in self.INCLUDES_PATH_ADD:
            self.PLATFORM_INCLUDES_PATH.append(var)

    def FillDefaultLibsPathIfNeeded_(self):
        includeAutomaticDependencies = not self.LinkerArgs_LibPath_SET
        if includeAutomaticDependencies:
            self.LinkerArgs_LibPath = []
            if re.match(r"VisualStudio.Net", self.BuildPlatform):
                # Add the list of library search paths to Platform_LinkerArgs_LibPath (which makes it into stroika-platform.pc as -L lines)
                self.LinkerArgs_LibPath = PerlSplit(";", self.GetMSVCVarName_("LIB"))
        for var in self.LinkerArgs_LibPath_ADD:
            self.LinkerArgs_LibPath.append(var)

    def FillDefaultLibDependencies_(self):
        # IF we set lib dependencies explicitly, then suppress adding libs automatically (based on features etc) - just explicitly added ones from the commandline
        includeAutomaticLibDependencies = self.LinkerArgs_LibDependencies is None
        if self.LinkerArgs_LibDependencies is None:
            self.LinkerArgs_LibDependencies = ""
        mustAppendDefaults = self.LinkerArgs_LibDependencies == ""
        for var in self.LinkerArgs_LibDependencies_ADD:
            self.LinkerArgs_LibDependencies += S(var) + " "
        if includeAutomaticLibDependencies:
            for flag, name in (("Xerces", "xerces-c"), ("libxml2", "libxml-2.0"),
                               ("mongocxxdriver", "libmongocxx1-static"),  # Since mongovcxx version 4.4.0
                               ("OpenSSL", "openssl"), ("LIBCURL", "libcurl"), ("fmtlib", "fmt"), ("LZMA", "lzma"),
                               ("sqlite", "sqlite"), ("ZLib", "zlib"), ("zstd", "libzstd"), ("GoogleTest", "gtest_main"),
                               ("boost", "boost")):
                if S(getattr(self, "FEATUREFLAG_" + flag)) != LIBFEATUREFLAG_No:
                    self.foundationPackageCfgNames.append(name)
        if mustAppendDefaults:
            if "Windows" in self.TargetPlatforms:
                for lib in ("urlmon", "rpcrt4", "kernel32", "user32", "gdi32", "winspool", "comdlg32", "advapi32", "shell32",
                            "ole32", "oleaut32", "uuid", "odbc32", "odbccp32"):
                    self.LinkerArgs_LibDependencies += lib + ".lib "
            if "POSIX" in self.TargetPlatforms:
                self.LinkerArgs_LibDependencies += "-lpthread "
                self.LinkerArgs_LibDependencies += "-lm "
                if self.FEATUREFLAG_librt == LIBFEATUREFLAG_UseSystem:
                    self.LinkerArgs_LibDependencies += "-lrt "

    def FillInToolsPathAdditionsIfNeeded_(self):
        includeAutomaticDependencies = self.TOOLS_PATH_ADDITIONS is None
        if includeAutomaticDependencies:
            if re.match(r"VisualStudio.Net", self.BuildPlatform):
                x = self.GetMSVCVarName_("TOOLS_PATH_ADDITIONS")
                self.TOOLS_PATH_ADDITIONS = Trim(self.Backtick('cygpath --mixed --path "' + x + '"'))
                self.VSVARS_VSINSTALLDIR = self.GetMSVCVarName_("VSINSTALLDIR")
                self.VSVARS_WindowsSdkDir = self.GetMSVCVarName_("WindowsSdkDir")
                if self.VSVARS_WindowsSdkDir == "":
                    self.PrintErr("WARNING: VSVARS_WindowsSdkDir empty\n")
                self.VSVARS_WindowsSDKVersion = self.GetMSVCVarName_("WindowsSDKVersion")
                if self.VSVARS_WindowsSDKVersion == "":
                    self.PrintErr("WARNING: VSVARS_WindowsSDKVersion empty\n")
                if self.VSVARS_WindowsSDKVersion.endswith("\\"):
                    self.VSVARS_WindowsSDKVersion = self.VSVARS_WindowsSDKVersion[:-1]
                self.VSVARS_VCToolsInstallDir = self.GetMSVCVarName_("VCToolsInstallDir")

    def SetInitialDefaults_(self):
        """Initial defaults before looking at command-line arguments"""
        if self.TargetPlatforms == "":
            if PERL_OS == "linux":
                self.TargetPlatforms = "Linux POSIX"
            elif PERL_OS == "darwin":
                self.TargetPlatforms = "MacOS POSIX"
            elif IS_WINDOWS_HOST:
                self.TargetPlatforms = "Windows"
        if PERL_OS in ("linux", "darwin"):
            self.BuildPlatform = "Unix"
        if IS_WINDOWS_HOST:
            PROGRAMFILESDIR = Trim(self.Backtick('cygpath "' + S(Env("PROGRAMFILES")) + '"'))
            PROGRAMFILESDIR2 = Trim(self.Backtick('cygpath "' + S(Env("ProgramFiles(x86)")) + '"'))
            # Try vs2k26
            if self.BuildPlatform == "":
                if PerlGlob(PROGRAMFILESDIR + "/Microsoft Visual Studio/18/*/VC"):
                    self.BuildPlatform = "VisualStudio.Net-2026"
                if PerlGlob(PROGRAMFILESDIR2 + "/Microsoft Visual Studio/18/*/VC"):
                    self.BuildPlatform = "VisualStudio.Net-2026"
            # Fallback/Try VS2k 2022
            if self.BuildPlatform == "":
                if PerlGlob(PROGRAMFILESDIR + "/Microsoft Visual Studio/2022/*/VC"):
                    self.BuildPlatform = "VisualStudio.Net-2022"
                if PerlGlob(PROGRAMFILESDIR2 + "/Microsoft Visual Studio/2022/*/VC"):
                    self.BuildPlatform = "VisualStudio.Net-2022"
        if PERL_OS == "darwin":
            # hacks so can do initial port/compile
            self.FEATUREFLAG_librt = LIBFEATUREFLAG_No
            self.STATIC_LINK_GCCRUNTIME = 0
            self.COMPILER_DRIVER = "clang"
            self.COMPILER_DRIVER_C = "clang"
            self.COMPILER_DRIVER_CPlusPlus = "clang++"
            self.AR = "ar"
            self.AS = "as"
            self.RANLIB = "ranlib"

    @staticmethod
    def ReplaceLast_(srcString, replaceThis, withThis):
        """The last replaceThis in srcString, made withThis (the Perl reverses all three with rev, and lets sed do the first)"""
        s = " ".join(S(srcString).split())  # echo $srcString: its words, one space apart
        i = s.rfind(replaceThis)
        if i >= 0:
            s = s[:i] + withThis + s[i + len(replaceThis):]
        return Trim(s)

    def SetDefaultsWhichDependOnCompilerDriverAndApplyDefaultsDebugOrRel_(self):
        self.ComputeARCHFlag_()

        if S(self.COMPILER_DRIVER) == "":
            if re.match(r"VisualStudio.Net", self.BuildPlatform):
                self.COMPILER_DRIVER = self.GetMSVCVarName_("CC")
        if S(self.COMPILER_DRIVER) == "":
            Die("must set COMPILER_DRIVER before SetDefaultsWhichDependOnCompilerDriverAndApplyDefaultsDebugOrRel_")

        isVisualStudio = re.match(r"VisualStudio.Net", self.BuildPlatform) is not None

        if isVisualStudio:
            if self.AS is None:
                self.AS = self.GetMSVCVarName_("AS")
            if self.CMAKE is None:
                self.CMAKE = self.GetMSVCVarName_("VSINSTALLDIR") + "/Common7/IDE/CommonExtensions/Microsoft/CMake/CMake/bin/cmake.exe"
            if self.COMPILER_DRIVER_C == "":
                self.COMPILER_DRIVER_C = self.GetMSVCVarName_("CC")
            if self.COMPILER_DRIVER_CPlusPlus == "":
                self.COMPILER_DRIVER_CPlusPlus = self.GetMSVCVarName_("CC")  # not cxx for msvc

            # autodetect ATLMFC (Express verison missing it)
            if self.FEATUREFLAG_ATLMFC is None:
                if self.BuildPlatform in ("VisualStudio.Net-2022", "VisualStudio.Net-2026"):
                    if self.VSVARS_VCToolsInstallDir is None:
                        self.VSVARS_VCToolsInstallDir = self.GetMSVCVarName_("VCToolsInstallDir")
                    # in VS2k22, separate checkboxes for ATL and MFC and we need MFC AND ATL
                    if PerlExists(S(self.VSVARS_VCToolsInstallDir) + "/atlmfc/include/afxext.h"):
                        self.FEATUREFLAG_ATLMFC = LIBFEATUREFLAG_UseSystem
                    else:
                        self.FEATUREFLAG_ATLMFC = LIBFEATUREFLAG_No

        # I've found almost no docs about this. However, when I first ported to new imac with m1 chip,
        # and rebuilt stroika, I found XERCES automatically did something like this to force this
        # setting. But rest of my code didn't and I got compiler warnings. So try to find the best
        # setting to force to, and allow external settings to override.
        # This appears to only be needed when running on m1 hardware, but no easy way I can find to
        # tell that so always do this by default
        if self.MACOSX_DEPLOYMENT_TARGET is None and PERL_OS == "darwin":
            osVersion = self.getMacOSVersion_()
            # force convert to 2-digit form as I've seen in examples but not sure makes much sense
            m = re.match(r"(\d+)(?:\.(\d+))?", osVersion)
            if m:
                self.MACOSX_DEPLOYMENT_TARGET = m.group(1) + "." + (m.group(2) or "0")

        if self.CPPSTD_VERSION_FLAG == "":
            if self.IsGCCOrGPlusPlus_(self.COMPILER_DRIVER):
                self.CPPSTD_VERSION_FLAG = "--std=c++20"
            elif self.IsClangOrClangPlusPlus_(self.COMPILER_DRIVER):
                self.CPPSTD_VERSION_FLAG = "--std=c++20"
            elif re.match(r"VisualStudio.Net", self.BuildPlatform):
                self.CPPSTD_VERSION_FLAG = "-std:c++latest"
        if self.BuildPlatform == "Unix":
            if self.STATIC_LINK_GCCRUNTIME == DEFAULT_BOOL_OPTIONS:
                self.STATIC_LINK_GCCRUNTIME = 1

        if self.COMPILER_DRIVER_C == "":
            self.COMPILER_DRIVER_C = self.COMPILER_DRIVER
            if self.IsGCCOrGPlusPlus_(self.COMPILER_DRIVER):
                self.COMPILER_DRIVER_C = self.ReplaceLast_(self.COMPILER_DRIVER, "g++", "gcc")
            elif self.IsClangOrClangPlusPlus_(self.COMPILER_DRIVER):
                self.COMPILER_DRIVER_C = self.ReplaceLast_(self.COMPILER_DRIVER, "clang++", "clang")
        if self.COMPILER_DRIVER_CPlusPlus == "":
            self.COMPILER_DRIVER_CPlusPlus = self.COMPILER_DRIVER
            if self.IsGCCOrGPlusPlus_(self.COMPILER_DRIVER):
                self.COMPILER_DRIVER_CPlusPlus = self.ReplaceLast_(self.COMPILER_DRIVER, "gcc", "g++")
            elif self.IsClangOrClangPlusPlus_(self.COMPILER_DRIVER_CPlusPlus):
                if not self.IsClangPlusPlus_(self.COMPILER_DRIVER_CPlusPlus):
                    self.COMPILER_DRIVER_CPlusPlus = self.ReplaceLast_(self.COMPILER_DRIVER_CPlusPlus, "clang", "clang++")
        if self.CXXWARNING_FLAGS is None:
            self.CXXWARNING_FLAGS = ""
            if self.IsGCCOrGPlusPlus_(self.COMPILER_DRIVER):
                self.CXXWARNING_FLAGS += self.DEFAULT_CXXWARNING_FLAGS_GCC
            elif self.IsClangOrClangPlusPlus_(self.COMPILER_DRIVER):
                self.CXXWARNING_FLAGS += self.DEFAULT_CXXWARNING_FLAGS_CLANG

        if S(self.AS) == "":
            if self.IsGCCOrGPlusPlus_(self.COMPILER_DRIVER_CPlusPlus):
                self.AS = re.sub(r"-as-.*$", "-as", self.ReplaceLast_(self.COMPILER_DRIVER_CPlusPlus, "g++", "as"), count=1)
            elif self.IsClangOrClangPlusPlus_(self.COMPILER_DRIVER_CPlusPlus):
                if not self.IsClangPlusPlus_(self.COMPILER_DRIVER_CPlusPlus):
                    self.AS = re.sub(r"-as-.*$", "-as", self.ReplaceLast_(self.COMPILER_DRIVER_CPlusPlus, "clang++", "as"), count=1)
        if self.STDCXXLIB is None:
            if self.IsGCCOrGPlusPlus_(self.COMPILER_DRIVER_CPlusPlus):
                self.STDCXXLIB = "libstdc++"
            if self.IsClangOrClangPlusPlus_(self.COMPILER_DRIVER_CPlusPlus):
                # clang's own libc++ is the better default, but only where the installed libc++ supports this clang -
                # otherwise every compile carries 'Libc++ only supports Clang NN and later'. Only the DEFAULT bends: an
                # explicit --stdlib is honored as given (and refused, for a configuration marked --only-if-has-compiler).
                self.STDCXXLIB = "libc++"
                if not self.StdLibSupportsCompiler_(self.COMPILER_DRIVER_CPlusPlus, "libc++") and self.HasStdLib_(self.COMPILER_DRIVER_CPlusPlus, "libstdc++"):
                    self.STDCXXLIB = "libstdc++"
        if self.ApplyDebugFlags == true:
            if self.gAssertionsEnabled == DEFAULT_BOOL_OPTIONS:
                self.gAssertionsEnabled = 1
            if self.IsGCCOrGPlusPlus_(self.COMPILER_DRIVER_CPlusPlus) or self.IsClangOrClangPlusPlus_(self.COMPILER_DRIVER_CPlusPlus):
                if self.ENABLE_GLIBCXX_DEBUG == DEFAULT_BOOL_OPTIONS:
                    self.ENABLE_GLIBCXX_DEBUG = 1
                if self.runtimeStackProtectorFlag == DEFAULT_BOOL_OPTIONS:
                    self.runtimeStackProtectorFlag = true

                skipSanCuzBroken = false
                skipASANSanCuzBroken = false
                # Sanitizers crash with gcc 11 and ubuntu 22.04 (not worth debugging right now...) -
                # failure running some regtests - crash in leak sanitizer at end of run... --LGP 2024-05-01
                # NOTE - now disabling BOTH ASAN and UBSAN, but maybe only ASAN broken--LGP 2024-08-21
                if self.getUbuntuVersion() == 22.04:
                    if self.IsGCCOrGPlusPlus_(self.COMPILER_DRIVER):
                        skipSanCuzBroken = true
                    # with asan and ununtu 22.04, about 1/2 the tests fail (somewhat randomly, not always). --LGP 2024-05-01
                    if self.IsClangOrClangPlusPlus_(self.COMPILER_DRIVER):
                        skipSanCuzBroken = true
                if PERL_OS == "darwin":
                    # From MacOS 15, and XCode 16:
                    #   clang++ -rdynamic -mmacosx-version-min=15.0 -fsanitize=address,undefined -static-libsan -stdlib=libc++ --std=c++20 -g -arch arm64 -Wl,-no_warn_duplicate_libraries -o 7zDec 7zMain.o lzma.a -lstdc++ -lc
                    #   clang++: error: static AddressSanitizer runtime is not supported on darwin
                    skipASANSanCuzBroken = true
                if not skipSanCuzBroken and not self.sanitizerFlagsNoneSet:
                    if not self.IsTargettingSanitizer_("address") and not skipASANSanCuzBroken:
                        self.sanitizerFlags.append("address")
                    if not self.IsTargettingSanitizer_("undefined"):
                        self.sanitizerFlags.append("undefined")
                    self.sanitizerFlagsIsDefined = true

            if self.IsMSVCCompiler_(self.COMPILER_DRIVER):
                if not self.sanitizerFlagsNoneSet:
                    if not self.IsTargettingSanitizer_("address"):
                        self.sanitizerFlags.append("address")
                    # note ubsan not yet supported --LGP 2022-01-04
                    #   if not self.IsTargettingSanitizer_("undefined"):
                    #       self.sanitizerFlags.append("undefined")
                self.sanitizerFlagsIsDefined = true

            if self.ENABLE_TRACE2FILE == DEFAULT_BOOL_OPTIONS:
                self.ENABLE_TRACE2FILE = 1
            if self.INCLUDE_SYMBOLS_EXE == DEFAULT_BOOL_OPTIONS:
                self.INCLUDE_SYMBOLS_EXE = true

            # helpful to print stack traces in log (not critical, and has performance overhead) - see Debug::BackTrace ()
            if self.BuildPlatform == "Unix":
                if self.LinkerArgs_ExtraPrefix != "":
                    self.LinkerArgs_ExtraPrefix += " "
                self.LinkerArgs_ExtraPrefix += "-rdynamic"
        elif self.ApplyReleaseFlags == true:
            if self.gAssertionsEnabled == DEFAULT_BOOL_OPTIONS:
                self.gAssertionsEnabled = 0
            # clang LTO on Linux needs lld. GNU ld (ld.bfd, reading the bitcode through the LLVMgold plugin) mis-links Stroika:
            # undefined references to symbols that ARE in the archive, e.g. on clang++-20
            #   ld-temp.o:(.text.startup+0x2a66): undefined reference to `Stroika::Foundation::DataExchange::ObjectVariantMapper::ObjectVariantMapper()'
            # and to boost::json::detail::error_code_category (clang++-16 through 22), 'DWARF error: invalid or unhandled FORM
            # value: 0x23' (clang++-15), or no LLVMgold.so installed at all (clang++-18). lld reads the bitcode itself, and links
            # the identical objects correctly. So default to LTO only when this clang has an lld - PostProcessOptions_ adds the
            # -fuse-ld=lld. Without one, the build still works, just without LTO. macOS needs none of this: its linker is
            # Apple's own, reading the bitcode through Apple's libLTO.
            if (self.ENABLE_LTO == DEFAULT_BOOL_OPTIONS and self.IsClangOrClangPlusPlus_(self.COMPILER_DRIVER) and PERL_OS != "darwin"
                    and self.GetClangLLD_(self.COMPILER_DRIVER) is None):
                self.ENABLE_LTO = false
                self.gLTODefaultedOffForNoLLD = true

            if self.ENABLE_LTO == DEFAULT_BOOL_OPTIONS:
                if self.IsGCCOrGPlusPlus_(self.COMPILER_DRIVER):
                    self.ENABLE_LTO = true
                if self.IsClangOrClangPlusPlus_(self.COMPILER_DRIVER):
                    self.ENABLE_LTO = true
                if isVisualStudio:
                    self.ENABLE_LTO = true
            if self.IsGCCOrGPlusPlus_(self.COMPILER_DRIVER) or self.IsClangOrClangPlusPlus_(self.COMPILER_DRIVER):
                if self.COPTIMIZE_FLAGS == "":
                    self.COPTIMIZE_FLAGS = "-O3"
                if self.ENABLE_GLIBCXX_DEBUG == DEFAULT_BOOL_OPTIONS:
                    self.ENABLE_GLIBCXX_DEBUG = 0
            if self.IsMSVCCompiler_(self.COMPILER_DRIVER):
                self.COPTIMIZE_FLAGS = "-O2 -Oi -Oy"
            if self.ENABLE_TRACE2FILE == DEFAULT_BOOL_OPTIONS:
                self.ENABLE_TRACE2FILE = 0

            if isVisualStudio:
                if self.LinkerArgs_ExtraPrefix != "":
                    self.LinkerArgs_ExtraPrefix += " "
                #   /OPT:REF eliminates functions and or data that are never referenced
                #   /OPT:ICF[=iterations] to perform identical COMDAT folding
                self.LinkerArgs_ExtraPrefix += "-OPT:REF"
                self.LinkerArgs_ExtraPrefix += " -OPT:ICF"

        if self.IsGCCOrGPlusPlus_(self.COMPILER_DRIVER):
            if self.ENABLE_LTO == true:
                itsVersion = self.GetGCCVersion_(self.COMPILER_DRIVER)
                # In function 'copy',
                # inlined from '__ct ' at /usr/include/c++/13/bits/basic_string.h:683:23,
                # inlined from 'operator+' at /usr/include/c++/13/bits/basic_string.h:3676:46,
                # inlined from 'OnTestProgramEnd' at /home/lewis/Sandbox/Stroika-Build-Dir-Ubuntu2404_x86_64/ThirdPartyComponents/GoogleTest/CURRENT/googletest/src/gtest-internal-inl.h:1156:43:
                # /usr/include/c++/13/bits/char_traits.h:435:56: warning: '__builtin_memcpy' writing 30 bytes into a region of size 16 overflows the destination [-Wstringop-overflow=]
                # 435 |         return static_cast<char_type*>(__builtin_memcpy(__s1, __s2, __n));
                # |                                                        ^
                # /home/lewis/Sandbox/Stroika-Build-Dir-Ubuntu2404_x86_64/ThirdPartyComponents/GoogleTest/CURRENT/googletest/src/gtest-internal-inl.h: In member function 'OnTestProgramEnd':
                # /home/lewis/Sandbox/Stroika-Build-Dir-Ubuntu2404_x86_64/ThirdPartyComponents/GoogleTest/CURRENT/googletest/src/gtest-internal-inl.h:1156:74: note: at offset 16 into destination object '<anonymous>' of size 32
                # 1156 |     SendLn("event=TestProgramEnd&passed=" + FormatBool(unit_test.Passed()));
                # |                                                                          ^
                #   NOTE - happens on g++-15 on Ubuntu 25.04 as well
                if itsVersion < 16.0:
                    self.LinkerArgs_ExtraPrefix += " -Wno-stringop-overflow"

                # In member function 'deallocate',
                # inlined from 'deallocate' at /usr/arm-linux-gnueabihf/include/c++/12/bits/allocator.h:200:35,
                # inlined from 'deallocate' at /usr/arm-linux-gnueabihf/include/c++/12/bits/alloc_traits.h:496:23,
                # inlined from '_M_deallocate' at /usr/arm-linux-gnueabihf/include/c++/12/bits/stl_vector.h:387:19,
                # inlined from '__dt_base ' at /usr/arm-linux-gnueabihf/include/c++/12/bits/stl_vector.h:366:15,
                # inlined from '__dt_comp ' at /usr/arm-linux-gnueabihf/include/c++/12/bits/stl_vector.h:733:7,
                # inlined from 'KeepSignificantBits' at ../../Library/Sources/Stroika/Foundation/IO/Network/InternetAddress.cpp:383:1,
                # inlined from '__ct ' at ../../Library/Sources/Stroika/Foundation/IO/Network/CIDR.cpp:25:57,
                # inlined from 'read_' at ../../Library/Sources/Stroika/Foundation/IO/Network/CIDR.cpp:46:34,
                # inlined from '__ct ' at ../../Library/Sources/Stroika/Foundation/IO/Network/CIDR.cpp:54:18,
                # inlined from 'TestBody' at Test.cpp:1961:51:
                # /usr/arm-linux-gnueabihf/include/c++/12/bits/new_allocator.h:158:33: warning: 'operator delete' called on pointer '_1397' with nonzero offset [1, 2147483647] [-Wfree-nonheap-object]
                # 158 |         _GLIBCXX_OPERATOR_DELETE(_GLIBCXX_SIZED_DEALLOC(__p, __n));
                #
                # NOTE - happens on g++-15 on Ubuntu 25.04 as well (with no armhf) - and cannot suppress with direct DISABLE_COMPILER_GCC_WARNING_START on g++15 and ubuntu 25.04
                #
                # NOTE - happens on g++-16 on Ubuntu 26.04 as well (g++-16-release++23), now out of std::function instead of
                # vector - inlining _M_manager/_M_destroy, gcc cannot prove the small-object-optimized branch is the one taken,
                # so it reports the heap branch deleting the union's pointer value - which for a [&]-capture-one-local closure
                # is the address of that local. e.g. Tests/03 (Foundation::Common):
                # In function '_M_destroy',
                #   inlined from '_M_manager' at /usr/include/c++/16/bits/std_function.h:208:18,
                #   inlined from '__dt_base ' at /usr/include/c++/16/bits/std_function.h:324:11,
                #   inlined from 'TestBody' at Test.cpp:172:72:
                # /usr/include/c++/16/bits/std_function.h:180:11: warning: 'operator delete' called on unallocated object 'firstEventHandlerCalled' [-Wfree-nonheap-object]
                # 180 |           delete __victim._M_access<_Functor*>();
                # Same as g++-15: DISABLE_COMPILER_GCC_WARNING_START at the call site does not suppress it - the diagnostic
                # comes out of LTRANS at link time, and its location is inside std_function.h, not our source.
                if itsVersion < 17.0:
                    self.LinkerArgs_ExtraPrefix += " -Wno-free-nonheap-object"

        if isVisualStudio:
            # Avoid this - not sure what the reason/need for this is.
            #   Creating library C:\Sandbox\Stroika\DevRoot\Builds\Debug\Tests\Test13.lib and object C:\Sandbox\Stroika\DevRoot\Builds\Debug\Tests\Test13.exp
            #   --LGP 2025-07-05
            if self.LinkerArgs_ExtraPrefix != "":
                self.LinkerArgs_ExtraPrefix += " "
            self.LinkerArgs_ExtraPrefix += "-noexp -noimplib"

        if self.AR is None:
            if self.IsGCCOrGPlusPlus_(self.COMPILER_DRIVER):
                ccLessArgs = re.sub(r" .*", "", S(self.COMPILER_DRIVER_C), count=1)
                self.AR = self.ReplaceLast_(ccLessArgs, "gcc", "gcc-ar")
            elif self.IsClangOrClangPlusPlus_(self.COMPILER_DRIVER):
                ccLessArgs = re.sub(r" .*", "", S(self.COMPILER_DRIVER_C), count=1)
                self.AR = self.ReplaceLast_(ccLessArgs, "clang", "llvm-ar")
        if self.AS is None and not IS_WINDOWS_HOST:
            self.AS = "as"
        if self.AR is None and not IS_WINDOWS_HOST:
            self.AR = "ar"
        if self.RANLIB is None:
            if self.IsGCCOrGPlusPlus_(self.COMPILER_DRIVER):
                ccLessArgs = re.sub(r" .*", "", S(self.COMPILER_DRIVER_C), count=1)
                self.RANLIB = self.ReplaceLast_(ccLessArgs, "gcc", "gcc-ranlib")
            elif self.IsClangOrClangPlusPlus_(self.COMPILER_DRIVER):
                ccLessArgs = re.sub(r" .*", "", S(self.COMPILER_DRIVER_C), count=1)
                self.RANLIB = self.ReplaceLast_(ccLessArgs, "clang", "llvm-ranlib")
            elif not IS_WINDOWS_HOST:
                self.RANLIB = "ranlib"
        if self.STRIP is None and self.IsGCCOrGPlusPlus_(self.COMPILER_DRIVER):
            ccLessArgs = re.sub(r" .*", "", S(self.COMPILER_DRIVER_C), count=1)
            ma = Trim(self.Backtick(ccLessArgs + " -print-multiarch"))
            self.STRIP = "strip" if ma == "" else ma + "-strip"

        if self.IsGCCOrGPlusPlus_(self.COMPILER_DRIVER):
            # Needed for sqlite build warning
            self.qCompiler_HasNoMisleadingIndentation_Flag = true

        if self.onlyGenerateIfCompilerExists == false:
            if PERL_OS == "darwin" and self.IsClangPlusPlus_(self.COMPILER_DRIVER):
                if self.GetClangVersion_(self.COMPILER_DRIVER) < 17:
                    self.Print("CONFIGURATION-WARNING: Stroika v3 requires Apple clang 17 (XCode 16.3) or later (compiler-driver: " + S(self.COMPILER_DRIVER) + ").\n")
            if self.IsClangPlusPlus_(self.COMPILER_DRIVER):
                itsVersion = self.GetClangVersion_(self.COMPILER_DRIVER)
                if 0 < itsVersion < 15:
                    self.Print("CONFIGURATION-WARNING: Stroika v3 requires clang 15 or later needed (compiler-driver: " + S(self.COMPILER_DRIVER) + ", version: " + S(itsVersion) + ").\n")

        if N(self.lsb_release) == 22.04:
            # https://github.com/SophistSolutions/Stroika/issues/851 - first seen on 20.10; 22.04 is the last supported release it affects
            # VERIFIED STILL BROKEN TSAN DEBUG on Ubuntu 22.04 g++-debug-sanitize_thread
            if self.IsGCCOrGPlusPlus_(self.COMPILER_DRIVER) and self.GetGCCVersion_(self.COMPILER_DRIVER) < 14.0:
                self.qCompiler_SanitizerDoubleLockWithConditionVariables_Buggy = true

        if self.FEATUREFLAG_librt is None and not IS_WINDOWS_HOST:
            self.FEATUREFLAG_librt = LIBFEATUREFLAG_UseSystem
        if self.FEATUREFLAG_librt is None:
            self.FEATUREFLAG_librt = LIBFEATUREFLAG_No
        if self.STRIP is None and self.BuildPlatform == "Unix":
            self.STRIP = "strip"

        if self.LIBTOOL is None:
            if re.match(r"VisualStudio.Net", self.BuildPlatform):
                self.LIBTOOL = Trim(self.GetMSVCVarName_("AR"))
        if self.LINKER is None:
            if re.match(r"VisualStudio.Net", self.BuildPlatform):
                self.LINKER = Trim(self.GetMSVCVarName_("LD"))
            else:
                self.LINKER = self.COMPILER_DRIVER_CPlusPlus

        if re.match(r"VisualStudio.Net", self.BuildPlatform):
            self.MIDL = self.GetMSVCVarName_("MIDL")
            self.RC = self.GetMSVCVarName_("RC")

        if S(self.MACOSX_DEPLOYMENT_TARGET) != "":
            self.LinkerArgs_ExtraPrefix += " -mmacosx-version-min=" + S(self.MACOSX_DEPLOYMENT_TARGET)

        if PERL_OS == "darwin" and S(self.ARCH) != "":
            # check if given ARCH can be executed and conditionally set CrossCompile flag
            if self.System("arch -arch " + S(self.ARCH) + " uname 2> /dev/null > /dev/null") != 0:
                self.CrossCompiling = "true"

    def ComputeARCHFlag_(self):
        """These depend on compiler driver, OS, ARCH, etc..."""
        args = self.GetAppArgs_()
        i = 1
        while i < len(args):
            var = args[i]
            if var.lower() in ("-arch", "--arch"):
                i += 1
                self.ARCH = args[i] if i < len(args) else None
            i += 1

        if S(self.ARCH) == "":
            if re.match(r"VisualStudio.Net", self.BuildPlatform):
                if re.search(r"64$", self.configurationName):
                    self.ARCH = "x86_64"
                    self.PrintErr("WARNING: guessing the target arch (x86 or x86_64) from the configuration name: use --arch instead!\n")
                if "32" in self.configurationName:
                    self.ARCH = "x86"
                    self.PrintErr("WARNING: guessing the target arch (x86 or x86_64) from the configuration name: use --arch instead!\n")

        if S(self.ARCH) == "":
            self.ARCH = Trim(self.Backtick("./Build/Scripts/GetCompilerArch " + S(self.COMPILER_DRIVER)))

        # Patch some old/bad names
        if self.ARCH in ("32", "WIN32"):
            self.PrintErr("WARNING: replacing ARCH " + self.ARCH + " with x86\n")
            self.ARCH = "x86"
        if self.ARCH in ("64", "WIN64"):
            self.PrintErr("WARNING: replacing ARCH " + self.ARCH + " with x86_64\n")
            self.ARCH = "x86_64"

        if S(self.ARCH) == "":
            Die("Failed to compute ARCH - specify with --arch flag")

    def SetDefaultsWhichDependOnPlatform_(self):
        if self.BuildPlatform == "Unix" and S(self.COMPILER_DRIVER) == "":
            self.COMPILER_DRIVER = "gcc"

    def ParseEnvVarsToSetupInfluencedVariables_(self):
        if Env("ARCH") is not None:
            self.EXTRA_ARGS += ["--arch", Env("ARCH")]
        if Env("PLATFORM") is not None:
            self.EXTRA_ARGS += ["--build-platform", Env("PLATFORM")]
        if Env("CC") is not None:
            self.EXTRA_ARGS += ["--compiler-driver", Env("CC")]
            self.COMPILER_DRIVER_C = Env("CC")
        if Env("CXX") is not None:
            self.EXTRA_ARGS += ["--compiler-driver", Env("CXX")]
            self.COMPILER_DRIVER_CPlusPlus = Env("CXX")
        if Env("AR") is not None:
            self.EXTRA_ARGS += ["--ar", Env("AR")]
        if Env("AS") is not None:
            self.EXTRA_ARGS += ["--as", Env("AS")]
        if Env("RANLIB") is not None:
            self.EXTRA_ARGS += ["--ranlib", Env("RANLIB")]
        if Env("STRIP") is not None:
            self.EXTRA_ARGS += ["--strip", Env("STRIP")]
        if Env("EXTRA_CONFIGURE_ARGS") is not None:
            for i in PerlSplit(" ", Env("EXTRA_CONFIGURE_ARGS")):
                self.EXTRA_ARGS.append(i)

    def GetAppArgs_(self):
        """merge 'extra' args (from environment variables) with those specified on the commandline"""
        args = list(self.ARGV)
        args[1:1] = self.EXTRA_ARGS
        return args

    def ParseCommandLine_Platform_(self):
        """Do initial pass, just looking for platform"""
        args = self.GetAppArgs_()
        i = 0
        while i < len(args):
            var = args[i]
            if var.lower() in ("-build-platform", "--build-platform"):
                i += 1
                self.BuildPlatform = args[i] if i < len(args) else None
                self.SetDefaultsWhichDependOnPlatform_()
            i += 1

    def ParseCommandLine_CompilerDriverAndDebugOrReleaseDefaultMode_(self):
        """Do initial pass, just looking for compiler-driver and apply-default-xxx flags"""
        args = self.GetAppArgs_()
        i = 0
        while i < len(args):
            var = args[i]
            lv = var.lower()
            if lv in ("-compiler-driver", "--compiler-driver"):
                i += 1
                self.COMPILER_DRIVER = args[i] if i < len(args) else None
                self.COMPILER_DRIVER_C = ""  # reset so computed later
                self.COMPILER_DRIVER_CPlusPlus = ""
            elif lv in ("-apply-default-debug-flags", "--apply-default-debug-flags"):
                self.ApplyDebugFlags = true
            elif lv in ("-apply-default-release-flags", "--apply-default-release-flags"):
                self.ApplyReleaseFlags = true
            i += 1

    def ParseCommandLine_Remaining_(self):
        args = self.GetAppArgs_()
        n = len(args)
        i = 1

        def Next():
            return args[i] if i < n else None

        while i < n:
            var = args[i]
            lv = var.lower()

            def Is(*names):
                """Option names match in any case: --append-CXXFLAGS or --append-cxxflags"""
                return lv in (n.lower() for n in names)

            if Is("-make-define", "--make-define"):
                i += 1
                self.useExtraMakeDefines.append(Next())
            elif Is("-build-platform", "--build-platform"):
                i += 1
                self.BuildPlatform = Next()
            elif Is("-target-platforms", "--target-platforms"):
                i += 1
                self.TargetPlatforms = Next()
            elif Is("-build-tools-root", "--build-tools-root"):
                i += 1
                self.BuildToolsRoot = Next()
            elif Is("-assertions", "--assertions"):
                i += 1
                v = Next()
                if v == "enable":
                    self.gAssertionsEnabled = 1
                elif v == "disable":
                    self.gAssertionsEnabled = 0
                elif v == "default":
                    self.gAssertionsEnabled = DEFAULT_BOOL_OPTIONS
                else:
                    self.Print("UNRECOGNIZED assertions ARG: " + S(v) + "\n")
                    self.DoHelp_(1)
            elif Is("-shared-symbol-visibility", "--shared-symbol-visibility"):
                i += 1
                self.SharedSymbolVisibility = Next()
            elif Is("-block-allocation", "--block-allocation"):
                i += 1
                v = Next()
                if v == "enable":
                    self.useExtraCDefines.append("#define qStroika_Foundation_Memory_PreferBlockAllocation 1")
                elif v == "disable":
                    self.useExtraCDefines.append("#define qStroika_Foundation_Memory_PreferBlockAllocation 0")
                elif v == "default":
                    pass
                else:
                    self.Print("UNRECOGNIZED block-allocation ARG: " + S(v) + "\n")
                    self.DoHelp_(1)
            elif Is("-valgrind", "--valgrind"):
                i += 1
                v = Next()
                if v == "enable":
                    self.useExtraCDefines.append("#define qStroika_FeatureSupported_Valgrind 1")
                    self.TargettingValgrind = true
                elif v == "disable":
                    self.useExtraCDefines.append("#define qStroika_FeatureSupported_Valgrind 0")
                elif v == "default":
                    pass
                else:
                    self.Print("UNRECOGNIZED block-allocation ARG: " + S(v) + "\n")
                    self.DoHelp_(1)
            elif Is("-glibcxx_debug", "--glibcxx_debug"):
                i += 1
                v = Next()
                if v == "enable":
                    self.ENABLE_GLIBCXX_DEBUG = 1
                elif v == "disable":
                    self.ENABLE_GLIBCXX_DEBUG = 0
                elif v == "default":
                    self.ENABLE_GLIBCXX_DEBUG = DEFAULT_BOOL_OPTIONS
                else:
                    self.Print("UNRECOGNIZED" + S(self.ENABLE_GLIBCXX_DEBUG) + " ARG: " + S(v) + "\n")
                    self.DoHelp_(1)
            elif Is("-macosx_deployment_target", "--macosx_deployment_target"):
                i += 1
                v = Next()
                if v == "none":
                    self.MACOSX_DEPLOYMENT_TARGET = ""  # "" means not set, undefined means do default
                elif v == "default":
                    self.MACOSX_DEPLOYMENT_TARGET = None
                else:
                    self.MACOSX_DEPLOYMENT_TARGET = v
            elif Is("-stdlib", "--stdlib"):
                i += 1
                self.STDCXXLIB = Next()
            elif Is("-cppstd-version", "--cppstd-version"):
                i += 1
                v = Next()
                if v == "c++14":
                    self.Print("Warning: c++14 not supported by Stroika v2.1 or later\n")
                if v == "c++17":
                    self.Print("Warning: c++17 not supported by Stroika v3 or later\n")
                if v not in ("c++2a", "c++20", "c++2b", "c++23"):
                    self.Print("Warning: unrecognized arg to --cppstd-version\n")
                if S(v) == "":
                    self.Print("UNRECOGNIZED cppstd-version ARG: " + S(v) + "\n")
                    self.DoHelp_(1)
                self.CPPSTD_VERSION_FLAG = "--std=" + S(v)
            elif Is("-strawberryperl", "--strawberryperl"):
                i += 1
                self.FEATUREFLAG_StrawberryPerl = Next()
            elif Is("-wix", "--wix"):
                i += 1
                self.FEATUREFLAG_WIX = Next()
            elif Is("-config-tag", "--config-tag"):
                i += 1
                v = Next()
                if re.search(r"[\s+.]+", S(v)):
                    Die("No spaces allowed in config-tag")
                if self.Config_Tag is None:
                    self.Config_Tag = ""
                else:
                    self.Config_Tag += " "
                self.Config_Tag += S(v)
            elif Is("-build-by-default", "--build-by-default"):
                i += 1
                self.BuildByDefault = Next()
            elif Is("-libcurl", "--libcurl"):
                i += 1
                self.ValidateUseArg_(Next(), "--libcurl")
                self.FEATUREFLAG_LIBCURL = Next()
            elif Is("-boost", "--boost"):
                i += 1
                self.ValidateUseArg_(Next(), "--boost")
                self.FEATUREFLAG_boost = Next()
            elif Is("-openssl", "--openssl"):
                i += 1
                self.ValidateUseArg_(Next(), "--openssl")
                self.FEATUREFLAG_OpenSSL = Next()
            elif Is("-openssl-extraargs", "--openssl-extraargs"):
                i += 1
                self.FEATUREFLAG_OpenSSLExtraArgs = Next()
            elif Is("-winhttp", "--winhttp"):
                i += 1
                self.FEATUREFLAG_WinHTTP = Next()
            elif Is("-atlmfc", "--atlmfc"):
                i += 1
                self.FEATUREFLAG_ATLMFC = Next()
            elif Is("-xerces", "--xerces"):
                i += 1
                self.ValidateUseArg_(Next(), "--xerces")
                self.FEATUREFLAG_Xerces = Next()
            elif Is("-libxml2", "--libxml2"):
                i += 1
                self.ValidateUseArg_(Next(), "--libxml2")
                self.FEATUREFLAG_libxml2 = Next()
            elif Is("-zlib", "--zlib"):
                i += 1
                self.ValidateUseArg_(Next(), "--zlib")
                self.FEATUREFLAG_ZLib = Next()
            elif Is("-zstd", "--zstd"):
                i += 1
                self.ValidateUseArg_(Next(), "--zstd")
                self.FEATUREFLAG_zstd = Next()
            elif Is("-googletest", "--googletest"):
                i += 1
                self.ValidateUseArg_(Next(), "--googletest")
                self.FEATUREFLAG_GoogleTest = Next()
            elif Is("-mongo-cxx-driver", "--mongo-cxx-driver"):
                i += 1
                self.ValidateUseArg_(Next(), "--mongo-cxx-driver")
                self.FEATUREFLAG_mongocxxdriver = Next()
            elif Is("-sqlite", "--sqlite"):
                i += 1
                self.ValidateUseArg_(Next(), "--sqlite")
                self.FEATUREFLAG_sqlite = Next()
            elif Is("-lzma", "--lzma"):
                i += 1
                self.ValidateUseArg_(Next(), "--lzma")
                self.FEATUREFLAG_LZMA = Next()
            elif Is("-fmtlib", "--fmtlib"):
                i += 1
                self.FEATUREFLAG_fmtlib = Next()
            elif Is("-default-third-party-components", "--default-third-party-components"):
                self.DoSetThirdPartyComponentsParameterFromCommandLine = "default"
            elif Is("-all-available-third-party-components", "--all-available-third-party-components"):
                self.DoSetThirdPartyComponentsParameterFromCommandLine = "all-available"
            elif Is("-no-third-party-components", "--no-third-party-components"):
                self.DoSetThirdPartyComponentsParameterFromCommandLine = "none"
            elif Is("-trace2file", "--trace2file"):
                i += 1
                v = Next()
                if v == "enable":
                    self.ENABLE_TRACE2FILE = 1
                elif v == "disable":
                    self.ENABLE_TRACE2FILE = 0
                elif v == "default":
                    self.ENABLE_TRACE2FILE = DEFAULT_BOOL_OPTIONS
                else:
                    self.Print("UNRECOGNIZED ENABLE_TRACE2FILEG ARG: " + S(v) + "\n")
                    self.DoHelp_(1)
            elif Is("-static-link-gccruntime", "--static-link-gccruntime"):
                i += 1
                v = Next()
                if v == "enable":
                    self.STATIC_LINK_GCCRUNTIME = 1
                elif v == "disable":
                    self.STATIC_LINK_GCCRUNTIME = 0
                else:
                    self.Print("UNRECOGNIZED static-link-gccruntime ARG: " + S(v) + "\n")
                    self.DoHelp_(1)
            elif Is("-ar", "--ar"):
                i += 1
                self.AR = Next()
            elif Is("-as", "--as"):
                i += 1
                self.AS = Next()
            elif Is("-ranlib", "--ranlib"):
                i += 1
                self.RANLIB = Next()
            elif Is("-strip", "--strip"):
                i += 1
                self.STRIP = Next()
            elif Is("-extra-prefix-linker-args", "--extra-prefix-linker-args"):
                i += 1
                self.LinkerArgs_ExtraPrefix = Next()
            elif Is("-append-extra-prefix-linker-args", "--append-extra-prefix-linker-args"):
                i += 1
                if S(self.LinkerArgs_ExtraPrefix) != "":
                    self.LinkerArgs_ExtraPrefix += " "
                self.LinkerArgs_ExtraPrefix = S(self.LinkerArgs_ExtraPrefix) + S(Next())
            elif Is("-extra-suffix-linker-args", "--extra-suffix-linker-args"):
                i += 1
                self.LinkerArgs_ExtraSuffix = Next()
            elif Is("-append-extra-suffix-linker-args", "--append-extra-suffix-linker-args"):
                i += 1
                if S(self.LinkerArgs_ExtraSuffix) != "":
                    self.LinkerArgs_ExtraSuffix += " "
                self.LinkerArgs_ExtraSuffix = S(self.LinkerArgs_ExtraSuffix) + S(Next())
            elif Is("-append-CPPFLAGS", "--append-CPPFLAGS"):
                i += 1
                self.Platform_CPPFLAGS_B4Includes.append(Next())
            elif Is("-remove-CPPFLAGS", "--remove-CPPFLAGS"):
                i += 1
                self.CPPFLAGS2Remove.append(Next())
            elif Is("-replace-all-CPPFLAGS", "--replace-all-CPPFLAGS"):
                i += 1
                for x in PerlSplit(" ", S(Next())):
                    self.Platform_CPPFLAGS_B4Includes.append(x)
                self.CPPFLAGS_Overridden = true
            elif Is("-append-CFLAGS", "--append-CFLAGS"):
                i += 1
                self.CFLAGS.append(Next())
            elif Is("-remove-CFLAGS", "--remove-CFLAGS"):
                i += 1
                self.CFLAGS2Remove.append(Next())
            elif Is("-replace-all-CFLAGS", "--replace-all-CFLAGS"):
                i += 1
                for x in PerlSplit(" ", S(Next())):
                    self.CFLAGS.append(x)
                self.CFLAGS_Overridden = true
            elif Is("-append-CXXFLAGS", "--append-CXXFLAGS"):
                i += 1
                self.CXXFLAGS2Append.append(Next())
            elif Is("-remove-CXXFLAGS", "--remove-CXXFLAGS"):
                i += 1
                self.CXXFLAGS2Remove.append(Next())
            elif Is("-replace-all-CXXFLAGS", "--replace-all-CXXFLAGS"):
                i += 1
                for x in PerlSplit(" ", S(Next())):
                    self.CXXFLAGS.append(x)
                self.CXXFLAGS_Overridden = true
            elif Is("-includes-path", "--includes-path"):
                i += 1
                self.PLATFORM_INCLUDES_PATH = PerlSplit(self.PATH_SEPERATOR, S(Next()))
                self.INCLUDES_PATH_SET = true
            elif Is("-append-includes-path", "--append-includes-path"):
                i += 1
                self.INCLUDES_PATH_ADD.append(Next())
            elif Is("-libs-path", "--libs-path"):
                i += 1
                self.LinkerArgs_LibPath = PerlSplit(self.PATH_SEPERATOR, S(Next()))
                self.LinkerArgs_LibPath_SET = true
            elif Is("-append-libs-path", "--append-libs-path"):
                i += 1
                self.LinkerArgs_LibPath_ADD.append(Next())
            elif Is("-linktime-copy-files-2-EXEDir", "--linktime-copy-files-2-EXEDir"):
                i += 1
                self.LinkTime_CopyFilesToEXEDir = PerlSplit(" ", S(Next()))
            elif Is("-append-linktime-copy-files-2-EXEDir", "--append-linktime-copy-files-2-EXEDir"):
                i += 1
                self.LinkTime_CopyFilesToEXEDir.append(Next())
            elif Is("-lib-dependencies", "--lib-dependencies"):
                i += 1
                self.LinkerArgs_LibDependencies = Next()
            elif Is("-append-lib-dependencies", "--append-lib-dependencies"):
                i += 1
                self.LinkerArgs_LibDependencies_ADD.append(Next())
            elif Is("-run-prefix", "--run-prefix"):
                i += 1
                self.RunPrefix = Next()
            elif Is("-append-run-prefix", "--append-run-prefix"):
                i += 1
                if S(self.RunPrefix) != "":
                    self.RunPrefix += " "
                self.RunPrefix = S(self.RunPrefix) + S(Next())
            elif Is("-include-default-TSAN_OPTIONS", "--include-default-TSAN_OPTIONS"):
                i += 1
                v = Next()
                if v not in ("true", "false"):
                    Die("Invalid argument to --include-default-TSAN_OPTIONS")
                self.autoIncludeTSAN_OPTIONSIfAppropriate = true if v == "true" else false
            elif Is("-append-extra-compiler-and-linker-args", "--append-extra-compiler-and-linker-args"):
                i += 1
                v = Next()
                self.CFLAGS.append(v)
                self.CXXFLAGS.append(v)
                if S(self.LinkerArgs_ExtraPrefix) != "":
                    self.LinkerArgs_ExtraPrefix += " "
                self.LinkerArgs_ExtraPrefix = S(self.LinkerArgs_ExtraPrefix) + S(v)
                if S(self.LinkerArgs_ExtraSuffix) != "":
                    self.LinkerArgs_ExtraSuffix += " "
                self.LinkerArgs_ExtraSuffix = S(self.LinkerArgs_ExtraSuffix) + S(v)
            elif Is("-lto", "--lto"):
                i += 1
                v = Next()
                if v == "enable":
                    self.ENABLE_LTO = true
                    self.ENABLE_LTO_SetExplicitly = true
                elif v == "disable":
                    self.ENABLE_LTO = false
                    self.ENABLE_LTO_SetExplicitly = true
                elif v == "default":
                    self.ENABLE_LTO = DEFAULT_BOOL_OPTIONS
                    self.ENABLE_LTO_SetExplicitly = false
                else:
                    self.Print("UNRECOGNIZED assertions ARG: " + S(v) + "\n")
                    self.DoHelp_(1)
            elif Is("-cross-compiling", "--cross-compiling"):
                i += 1
                v = Next()
                if v not in ("true", "false"):
                    Die("Invalid argument to --cross-compiling")
                self.CrossCompiling = v
            elif Is("-debug-symbols", "--debug-symbols"):
                i += 1
                v = Next()
                if v not in ("true", "false"):
                    Die("Invalid argument to --debug-symbols")
                self.INCLUDE_SYMBOLS_LIB = self.ToBool_(v)
                self.INCLUDE_SYMBOLS_EXE = self.ToBool_(v)
            elif Is("-debug-symbols-lib", "--debug-symbols-lib"):
                i += 1
                v = Next()
                if v not in ("true", "false"):
                    Die("Invalid argument to --debug-symbols-lib")
                self.INCLUDE_SYMBOLS_LIB = self.ToBool_(v)
            elif Is("-debug-symbols-exe", "--debug-symbols-exe"):
                i += 1
                v = Next()
                if v not in ("true", "false"):
                    Die("Invalid argument to --debug-symbols")
                self.INCLUDE_SYMBOLS_EXE = self.ToBool_(v)
            elif Is("-malloc-guard", "--malloc-guard"):
                i += 1
                self.MALLOC_GUARD = self.ToBool_(Next())
                # DISABLE LTO BY DEFAULT IF MALLOC_GAURD TURNED ON BECAUSE FOR NOW THEY DON'T WORK TOGETHER -- LGP 2016-07-14
                if self.MALLOC_GUARD == true:
                    self.ENABLE_LTO = false
            elif Is("-runtime-stack-check", "--runtime-stack-check"):
                i += 1
                v = Next()
                if v not in ("true", "false"):
                    Die("Invalid argument to --runtime-stack-check")
                self.runtimeStackProtectorFlag = v
            elif Is("-msvc-runtime-library", "--msvc-runtime-library"):
                i += 1
                self.VSVARS_MSVC_RUNTIME_LIBRARY = Next()
            elif Is("-sanitize", "--sanitize"):
                i += 1
                for flag in PerlSplit(",", S(Next())):
                    if flag == "none":
                        self.sanitizerFlags = []
                        self.sanitizerFlagsNoneSet = true
                    else:
                        if not self.IsTargettingSanitizer_(flag):
                            self.sanitizerFlags.append(flag)
                    self.sanitizerFlagsIsDefined = true
            elif Is("-no-sanitize", "--no-sanitize"):
                i += 1
                for flag in PerlSplit(",", S(Next())):
                    if flag == "none":
                        self.noSanitizerFlags = []
                    elif flag not in self.noSanitizerFlags:
                        self.noSanitizerFlags.append(flag)
            elif Is("-only-if-has-compiler", "--only-if-has-compiler"):
                self.onlyGenerateIfCompilerExists = true
            elif Is("-pg", "--pg"):
                self.CFLAGS.append("-pg")
                self.CXXFLAGS.append("-pg")
                self.LinkerArgs_ExtraPrefix = S(self.LinkerArgs_ExtraPrefix) + " -pg"
            elif Is("-help", "--help", "-?"):
                self.DoHelp_(0)
            else:
                # HANDLED EARLIER
                if Is("-apply-default-debug-flags", "--apply-default-debug-flags"):
                    pass
                elif Is("-apply-default-release-flags", "--apply-default-release-flags"):
                    pass
                elif Is("-build-platform", "--build-platform"):
                    i += 1
                elif Is("-arch", "--arch"):
                    i += 1
                elif Is("-compiler-driver", "--compiler-driver"):
                    i += 1
                else:
                    self.Print("UNRECOGNIZED ARG: " + var + "\n")
                    self.DoHelp_(1)
            i += 1

    @staticmethod
    def ZERO_OR_1_(x):
        if x is None or x == "" or x is False:
            return 0
        return 1 if N(x) == 1 else 0

    def CHECK_FEATURE_OPTION(self, x):
        if x not in (LIBFEATUREFLAG_BuildOnly, LIBFEATUREFLAG_UseStaticTPP, LIBFEATUREFLAG_UseSystem, LIBFEATUREFLAG_No):
            Die("Cannot identify feature argument (expected build-only, use-static, use-system, or no and got " + S(x) + ")")

    def CHECK_OPTIONS_(self):
        if S(self.BuildPlatform) == "":
            Die("Cannot identify BuildPlatform! Either explicitly supply the --build-platform argument (configure --help); or make sure you have Visual Studio.net installed")
        for old in ("2012", "2015", "2017", "2019"):
            if self.BuildPlatform == "VisualStudio.Net-" + old:
                Die("WE NO LONGER SUPPORT VISUAL STUDIO.Net " + old)
        validProjectPlatfromSubDirs = ("Unix", "VisualStudio.Net-2022", "VisualStudio.Net-2026")
        if self.BuildPlatform not in validProjectPlatfromSubDirs:
            Die("Unrecognized --build-platform argument: valid ones include: " + ",".join(validProjectPlatfromSubDirs))
        if S(self.TargetPlatforms) == "":
            Die("Cannot identify TargetPlatforms")
        self.CHECK_FEATURE_OPTION(self.FEATUREFLAG_LIBCURL)

    def ApplyCompilerBugWorkarounds_(self):
        """
        Turn OFF LTO for the gcc sanitizer builds it is known to break. MUST run after ParseCommandLine_Remaining_ (), since
        that is where --sanitize is parsed - doing this in SetDefaultsWhichDependOnCompilerDriverAndApplyDefaultsDebugOrRel_
        (where it used to live) meant sanitizerFlags was still empty and the test never fired.
        """
        # NB: deliberately does NOT bail out when --lto was given explicitly - an explicit '--lto disable'
        # is the main way to walk into the 24.04 hazard below, so that case must still be caught (and is
        # overridden, loudly).
        if self.ApplyReleaseFlags != true:
            return
        if not self.IsGCCOrGPlusPlus_(self.COMPILER_DRIVER):
            return

        # NB: deliberately NOT disabling LTO for the address sanitizer.
        # https://github.com/SophistSolutions/Stroika/issues/1128 asked for that (an asan
        # allocation-size-too-big report from Tests/02, gcc 13.2), but that test never actually ran - it sat in a sub called
        # before --sanitize was parsed - so asan release builds have had LTO on for years and are fine with it. Turning it on
        # for real (tried 2026-08-29, gcc < 14 only) made things WORSE, not better:
        #     WITH -flto (as shipped for years): 24.04/g++-13.3 asan run is clean
        #     WITHOUT -flto (the workaround):    19 NEW failures on g++-13.3, all in
        #                                        g++-release-sanitize_address_undefined_leak - wrong VALUES
        #                                        (not asan reports) in Containers::Sequence, Traversal, and
        #                                        DataExchange, including the new *_ContiguousFastPath_ tests
        # So the workaround is not merely unnecessary, it is harmful on the one compiler it targeted. Left
        # out entirely rather than re-scoped; if issue 1128 ever recurs, reproduce it first - it was last
        # seen on gcc 13.2 and has not been reproducible since.

        # The THREAD sanitizer is the opposite case - there, LTO is what breaks things. The Ubuntu 24.04
        # gcc toolchain generates wrong code for
        # Math::Optimization::DownhillSimplexMinimization with '-O3 -flto -fsanitize=thread'. Showed up in
        # 3.0d24 as Tests/47 Test9_Optimization_DownhillSimplexMinimization_ failing under
        # g++-release-sanitize_thread ONLY - the minimizer stops after 12 iterations instead of 72 and
        # returns a point nowhere near the minimum. Not a Stroika logic bug, and not FP tolerance: the
        # same source passes in every other configuration, an equivalent plain-std::vector transcription
        # is bit-identical under -O0/-O1/-O2/-O3/-Ofast/LTO/asan/tsan, ubsan reports nothing, and a single
        # printf (or asm memory barrier) anywhere in the iteration loop makes the code correct again.
        # Flag bisection on the failing configuration:
        #         -O3 -flto -fsanitize=thread    FAILS  (as configured)
        #         -O1 -flto -fsanitize=thread    FAILS
        #         -O2 -flto -fsanitize=thread    passes
        #         -O3       -fsanitize=thread    passes  (ie -fno-lto fixes it)
        #         -O3 -flto                      passes
        #         -O0                            passes
        # so LTO is the necessary ingredient.
        # Compiler/platform matrix actually measured (2026-08-29, same source, same probe):
        #         24.04  g++-13 (13.3.0-6ubuntu2~24.04.1)  FAILS
        #         24.04  g++-14 (14.2.0-4ubuntu2~24.04.1)  FAILS
        #         25.04  g++-14 (14.2.0-19ubuntu2)         passes
        #         25.04  g++-15 (15-20250404)              passes
        #         26.04  g++-14 (14.3.0-14ubuntu1)         passes
        #         26.04  g++-15 (15.2.0-16ubuntu1)         passes
        #         26.04  g++-16 (16-20260322)              passes
        # ie it tracks the 24.04 TOOLCHAIN, not the gcc version - the same upstream 14.2.0 fails as
        # packaged on 24.04 and passes as packaged on 25.04. Kept unconditional rather than keyed to
        # lsb_release: an lsb-version test would rot, and LTO buys little in a sanitizer build anyway.
        # THE BIGGER 24.04 PROBLEM, which has nothing to do with sanitizers: gcc 13 and gcc 14 AS PACKAGED
        # ON UBUNTU 24.04 miscompile Containers::Sequence / Traversal / DataExchange whenever the build
        # optimizes WITHOUT LTO. Measured 2026-08-30, same tree, Tests/21 + Tests/51, -O3 and no -flto:
        #         g++-13.3 (24.04)  14 failures        g++-12    (24.04)   0 failures
        #         g++-14.2 (24.04)  14 failures        clang++-18 + libstdc++  0 failures
        #     also fails at -O1 (7) and -O2 (17), so it is not an -O3-only problem; and it is NOT
        #     strict-aliasing (-fno-strict-aliasing changes nothing) and NOT an ODR violation (rebuilt
        #     with -Wodr/-Wlto-type-mismatch re-enabled: zero diagnostics). clang on the SAME libstdc++
        #     is clean, so it is the compiler, not the library and not Stroika.
        # Every config Stroika ships uses LTO for optimized builds, which is why this went unnoticed for
        # so long - LTO happens to mask it. But anyone building a Stroika-based app on 24.04 LTS with
        # optimization and without LTO gets silently wrong container behavior.
        # POLICY: an explicit request is honored. If the caller asked for '--lto disable' they get it -
        # they may have a workaround, it may not matter for their app, or they may be working on this very
        # bug - but WARN, loudly, because it is silently-wrong-answers rather than a crash. Only OPTIONAL
        # configurations (--only-if-has-compiler, ie "generate this if the toolchain can do it") are
        # skipped outright - see where gUbuntu2404OptimizedNoLTOHazard is read, in Run.
        if (N(self.lsb_release) == 24.04 and self.IsGCCOrGPlusPlus_(self.COMPILER_DRIVER)
                and 13.0 <= self.GetGCCVersion_(self.COMPILER_DRIVER) and self.GetGCCVersion_(self.COMPILER_DRIVER) < 15.0
                and self.ENABLE_LTO != true):
            self.gUbuntu2404OptimizedNoLTOHazard = true
            self.Print("WARNING: gcc " + S(self.GetGCCVersion_(self.COMPILER_DRIVER)) + " on Ubuntu 24.04 miscompiles Stroika containers when optimizing without LTO\n")
            self.Print("         (Containers::Sequence, Traversal, DataExchange give WRONG ANSWERS - not crashes - at -O1/-O2/-O3).\n")
            if self.ENABLE_LTO_SetExplicitly == true:
                self.Print("         Honoring your explicit '--lto disable' anyway - but be aware the failures are wrong ANSWERS, not crashes.\n")
            self.Print("         g++-12, clang++, or a newer Ubuntu can build optimized without LTO on this platform.\n")

        # WHAT WE ACTUALLY DO ON 24.04: keep LTO, and drop -O3 to -O2 for sanitizer builds. Measured on
        # 24.04/g++-13.3, same tree, same box, only -O differing:
        #     -O3 -flto -fsanitize=thread   Tests/47 Test9_Optimization_DownhillSimplexMinimization_ FAILS
        #     -O2 -flto -fsanitize=thread   Tests/47 passes, and Tests/21+51 (the containers that break
        #                                   without LTO) stay clean
        # 26.04/g++-15.2 is clean in every combination, so this is scoped to 24.04 rather than applied
        # everywhere - no reason to give up -O3 on toolchains that are not broken.
        if N(self.lsb_release) == 24.04 and len(self.sanitizerFlags) != 0:
            self.COPTIMIZE_FLAGS = "-O2"

        # Dropping LTO for tsan instead is NOT a cure: on the 3.0d24 Ubuntu 24.04 release run (g++ 13.3) it took
        # g++-release-sanitize_thread from 1 failure (Tests/47) to TWENTY - wrong VALUES in Containers::Sequence,
        # Traversal and DataExchange, the same set the address sanitizer gave without LTO (above).

        # armhf gcc (the Ubuntu cross compilers) crashes - "internal compiler error: Segmentation fault" -
        # compiling mongo-c-driver (e.g. bson_get_monotonic_time () in libbson/src/bson/bson-clock.c) under
        # -fsanitize=address. Dropping to -O2 is what lets 26.04's gcc 14.3 build it (it crashes at -O3).
        # That is the ONLY armhf compiler it helps: in real builds (2026-09-24) 26.04's gcc 13.4 and 15.2 and
        # 24.04's gcc 13.3 and 14.2 crash at -O2 and at -O0 alike - and which files crash shifts with the exact
        # preprocessed source, so -O2 working for 14.3 is luck, not a fix - even 14.3 crashed in the regression
        # image. So mongo now defaults OFF for armhf asan (see MongoCXXDriverDefaultsOn_); -O2 stays for when it is
        # forced on to retest, and because armhf asan has only been validated at -O2.
        # https://github.com/SophistSolutions/Stroika/issues/1174
        # (Makefile-CMake-Common.mk makes sure the configuration's -O is what reaches the cmake-built components.)
        if self.ARCH == "armhf" and self.IsTargettingSanitizer_("address"):
            self.COPTIMIZE_FLAGS = "-O2"

    def ParseCommandLine_(self):
        self.SetInitialDefaults_()

        if len(self.ARGV) >= 1:
            self.configurationName = self.ARGV[0]
        else:
            self.Print("Expected configuration name as first argument\n")
            self.DoHelp_(1)
        if self.configurationName.lower() in ("-h", "--h", "-help", "--help"):
            self.DoHelp_(0)
        elif self.configurationName.startswith("-"):
            self.Print("Expected configuration name (got " + self.configurationName + ") as first argument\n")
            self.DoHelp_(1)

        self.ParseEnvVarsToSetupInfluencedVariables_()
        self.ParseCommandLine_Platform_()
        self.SetDefaultsWhichDependOnPlatform_()

        self.ParseCommandLine_CompilerDriverAndDebugOrReleaseDefaultMode_()
        self.SetDefaultsWhichDependOnCompilerDriverAndApplyDefaultsDebugOrRel_()

        self.ParseCommandLine_Remaining_()

        self.ApplyCompilerBugWorkarounds_()

        self.DoSetThirdPartyComponents_(self.DoSetThirdPartyComponentsParameterFromCommandLine)

        self.CHECK_OPTIONS_()

    def GetDefaultCZZFLAGS_flags_(self, doCFLAGS, doPlatform, doFoundation):
        flags = []
        flagValues2Remove = list(self.GetDefaultCZZFLAGS_flags_flagValues2Remove)
        isVisualStudio = re.match(r"VisualStudio.Net", self.BuildPlatform) is not None

        # Until Stroika v2.1d18 these were written to Stroika-Config.h, but now all just provided to C++ compiler via -D
        # Doing this way means the defines appear in compiles of third-party-components, but they should not interfere, and if they ever
        # did we could add a new separate flag to extract/remove/keep them out (e.g STROIKA_CPP_DEFINE_ARGS, and just -filter-out all those from the CXXFLAGS)
        #
        # Doing ALL the flags through the command line is somewhat clearer than having MOST done through the Stroika-Configs.h file but a few done through the commandline.
        #
        # It has ONE possible disadvantage, which is confusing some tools that preparse the the (like visual studio code) but we must just find some way
        # to get them to also know about these defines (TBD)
        #       --LGP 2019-02-10
        dashFlag = "-D"

        if doPlatform:
            if doCFLAGS == 2:
                # C++ only flags
                if self.CPPSTD_VERSION_FLAG != "":
                    flags.append(self.CPPSTD_VERSION_FLAG)
            if doCFLAGS == 2:
                if S(self.CXXWARNING_FLAGS) != "":
                    # @todo - need separate flags for C and CXX
                    for x in PerlSplit(" ", self.CXXWARNING_FLAGS):
                        flags.append(x)

            if doCFLAGS != 0:
                if self.COPTIMIZE_FLAGS != "":
                    flags.append(self.COPTIMIZE_FLAGS)
                if self.SharedSymbolVisibility is not None:
                    flags.append("-fvisibility=" + S(self.SharedSymbolVisibility))
                if self.INCLUDE_SYMBOLS_LIB:
                    if not isVisualStudio:
                        flags.append("-g")
                if isVisualStudio:
                    flags.append("-EHa" if self.Windows_Exceptions_SupportStructuredExceptions == true else "-EHsc")
                    flags.append("-nologo")
                    flags.append("-GR")  # Enable Run-Time Type Information
                    flags.append("-Gd")  # Calling Convention - the default setting, specifies the __cdecl calling convention for all functions
                    flags.append("-W4")  # Warning Level (most less than WALL)
                    # flags.append("-WX-")  # (Dont) treat warnings as errors
                    # flags.append("-JMC")  # Just my code debugging (DONT TURN ON - let users add this but dont default on)
                    flags.append("-Zc:inline")  # Remove unreferenced code and data
                    flags.append("-FC")  # Use full paths in diagnostic messages
                    flags.append("-bigobj")  # Avoid these failures - fatal error C1128: number of sections exceeded object file format limit: compile with /bigobj
                    # flags.append("-errorReport:prompt")  # users can add this if desired
                    # flags.append("-experimental:module")
                    if self.ApplyDebugFlags == true:
                        flags.append("-RTCsu")  # Run-Time Error Checks - https://docs.microsoft.com/en-us/cpp/build/reference/rtc-run-time-error-checks?view=vs-2019
                        flags.append("-GS")  # Enable Security Check
                        flags.append("-Oy-")  # (Dont) omit frame pointers
                        flags.append("-Od")  # Disable Optimization
                    if self.ApplyReleaseFlags == true:
                        flags.append("-GS-")  # Disable Security Check
                        flags.append("-Gy")  # Enable Function Level Linking
                        flags.append("-Oy")  # Omit frame pointers
                        flags.append("-O2")  # Maximum Optimization (Favor Speed)
                        flags.append("-GL")  # Whole Program Optimization
                        flags.append("-Oi")  # Enable Intrinsic Functions
                        flags.append("-GF")  # Enable String Pooling
                    # flags.append("-fp:precise")  # vs2k sample projects define this, but maybe can use default?
                    rtl = self.VSVARS_MSVC_RUNTIME_LIBRARY
                    if rtl == "MultiThreaded":
                        flags.append("-MT")  # Multithreaded (not debug not dll)
                    elif rtl == "MultiThreadedDebug":
                        flags.append("-MTd")  # Multithreaded (Debug; but not dll)
                    elif rtl == "MultiThreadedDLL":
                        flags.append("-MD")  # NOT SURE REALLY SUPPORTED
                    elif rtl == "MultiThreadedDebugDLL":
                        flags.append("-MDd")  # NOT SURE REALLY SUPPORTED
                    else:
                        self.Print("WARNING: Unrecognized MSVC_RUNTIME_LIBRARY: " + S(rtl) + "\n")
                    if self.INCLUDE_SYMBOLS_LIB:
                        # Use intra-obj file debug info format, rather than -Zi (a separate .pdb).
                        # Reasons we do NOT use -Zi (tried, and abandoned):
                        #   o   With a static library, a separate .pdb must be shipped next to the .lib, or
                        #       every later link of it warns LNK4099 and silently drops the debug info for
                        #       those objects.
                        #   o   All the directories making up one library share a single .pdb, and parallel
                        #       builds (make -jN - which this project requires) got errors writing it, even
                        #       with -FS (Force Synchronous PDB Writes).
                        # -Z7 costs some disk space in the .obj/.lib files, and that is the tradeoff taken.
                        # See Build/Lib/Make/Makefile-CMake-Common.mk, which makes the cmake-built
                        # third-party components match this choice.
                        flags.append("-Z7")
            if doCFLAGS == 0:
                if not isVisualStudio and self.ENABLE_GLIBCXX_DEBUG == 1:
                    flags.append("-D_GLIBCXX_DEBUG")
                if isVisualStudio:
                    flags.append("-D_UNICODE")
                    flags.append("-DUNICODE")
                    flags.append("-D_WINDOWS")  # just because visual studio .net sample projects defined this
                    if self.ApplyDebugFlags == true:
                        flags.append("-D_DEBUG")
                    if self.ApplyReleaseFlags == true:
                        flags.append("-DNDEBUG")
                for var in self.useExtraCDefines:
                    parts = PerlSplit(" ", var) + [None, None, None]
                    define, name, value = parts[0], parts[1], parts[2]
                    if define != "#define":
                        Die("NYI: mapping extraCDEFINE: " + var)
                    if S(value) == "":
                        value = 0
                    flags.append(dashFlag + S(name) + "=" + S(value))
        if doFoundation:
            if doCFLAGS == 0:
                Z = self.ZERO_OR_1_

                def Has(f):
                    return f in (LIBFEATUREFLAG_UseStaticTPP, LIBFEATUREFLAG_UseSystem)

                flags.append(dashFlag + "qStroika_Foundation_Debug_AssertionsChecked=" + S(Z(self.gAssertionsEnabled)))
                if self.FEATUREFLAG_ATLMFC is not None:
                    flags.append(dashFlag + "qStroika_HasComponent_ATLMFC=" + S(Z(self.FEATUREFLAG_ATLMFC == LIBFEATUREFLAG_UseSystem)))
                flags.append(dashFlag + "qStroika_HasComponent_boost=" + S(Z(Has(self.FEATUREFLAG_boost))))
                flags.append(dashFlag + "qStroika_HasComponent_libcurl=" + S(Z(Has(self.FEATUREFLAG_LIBCURL))))
                flags.append(dashFlag + "qStroika_HasComponent_fmtlib=" + S(Z(Has(self.FEATUREFLAG_fmtlib))))
                flags.append(dashFlag + "qStroika_HasComponent_googletest=" + S(Z(Has(self.FEATUREFLAG_GoogleTest))))
                flags.append(dashFlag + "qStroika_HasComponent_LZMA=" + S(Z(Has(self.FEATUREFLAG_LZMA))))
                flags.append(dashFlag + "qStroika_HasComponent_OpenSSL=" + S(Z(Has(self.FEATUREFLAG_OpenSSL))))
                flags.append(dashFlag + "qStroika_HasComponent_sqlite=" + S(Z(Has(self.FEATUREFLAG_sqlite))))
                flags.append(dashFlag + "qStroika_HasComponent_mongocxxdriver=" + S(Z(Has(self.FEATUREFLAG_mongocxxdriver))))
                flags.append(dashFlag + "qStroika_HasComponent_WinHTTP=" + S(Z(self.FEATUREFLAG_WinHTTP == LIBFEATUREFLAG_UseSystem)))
                flags.append(dashFlag + "qStroika_HasComponent_xerces=" + S(Z(Has(self.FEATUREFLAG_Xerces))))
                flags.append(dashFlag + "qStroika_HasComponent_libxml2=" + S(Z(Has(self.FEATUREFLAG_libxml2))))
                flags.append(dashFlag + "qStroika_HasComponent_zlib=" + S(Z(Has(self.FEATUREFLAG_ZLib))))
                flags.append(dashFlag + "qStroika_HasComponent_zstd=" + S(Z(Has(self.FEATUREFLAG_zstd))))
                if self.ENABLE_TRACE2FILE != DEFAULT_BOOL_OPTIONS:
                    flags.append(dashFlag + "qStroika_Foundation_Debug_TraceToFile=" + S(Z(self.ENABLE_TRACE2FILE)))
                    # override the default (true iff qStroika_Foundation_Debug_AssertionsChecked) - if set the trace2file option set
                    if self.ENABLE_TRACE2FILE == 1:
                        flags.append(dashFlag + "qStroika_Foundation_Debug_DefaultTracingOn=1")

        for r in self.GetDefaultCZZFLAGS_flags_flags:
            flags.append(r)
        # each --remove-XXXFLAGS value goes, a default or an added flag (but --append-CXXFLAGS values are added after this, so
        # they can override); one that names no flag is a mistake worth seeing
        for r in flagValues2Remove:
            kept = [f for f in flags if Trim(S(f)) != Trim(S(r))]
            if len(kept) == len(flags):
                flagsName = ("CPPFLAGS", "CFLAGS", "CXXFLAGS")[doCFLAGS]
                self.Print(self.PrintLevelLeader(N(self.MAKE_INDENT_LEVEL) + 2) + "Configure Warning: --remove-" + flagsName + " " + S(r) + ": no such flag\n")
            flags = kept
        return flags

    def PostProcessOptions_(self):
        isVisualStudio = re.match(r"VisualStudio.Net", self.BuildPlatform) is not None

        if isVisualStudio:
            if self.BuildToolsRoot is None:
                self.BuildToolsRoot = self.GetDefaultToolsBuildDir(self.BuildPlatform)

        # Here, not where it is decided, because --lto enable is parsed only after the release defaults are applied
        if self.gLTODefaultedOffForNoLLD and self.ENABLE_LTO != true and self.HasCompiler_(self.COMPILER_DRIVER_CPlusPlus):
            self.Print("NOTE: LTO defaults OFF for " + S(self.COMPILER_DRIVER) + " here - it has no lld, and GNU ld mis-links clang LTO; install lld to get LTO\n")
        if self.ENABLE_LTO == true:
            if self.IsGCCOrGPlusPlus_(self.COMPILER_DRIVER_CPlusPlus):
                self.CFLAGS.append("-flto")
                self.CXXFLAGS.append("-flto")
                # -flto=auto runs the LTRANS jobs under make's jobserver, so they share the -j budget. It used to spin up too
                # many processes (2023-10-26, when -flto=2 was chosen instead): with make before 4.4 a plain recipe line gets no
                # jobserver, so gcc starts one job per CPU. DEFAULT_LINK_LINE now marks LTO links '+' there, which fixes that.
                # (-flto=0, 1 or missing produce warnings: lto-wrapper: warning: using serial compilation of 13 LTRANS jobs)
                self.LinkerArgs_ExtraPrefix += " -flto=auto"
            if self.IsClangOrClangPlusPlus_(self.COMPILER_DRIVER_CPlusPlus):
                self.CFLAGS.append("-flto")
                self.CXXFLAGS.append("-flto")
                self.LinkerArgs_ExtraPrefix += " -flto"
                # GNU ld mis-links clang LTO - see where the release flags default ENABLE_LTO. An explicit -fuse-ld wins, but
                # is warned about unless it is lld.
                m = re.search(r"-fuse-ld=(\S+)", self.LinkerArgs_ExtraPrefix) if PERL_OS != "darwin" else None
                if m:
                    explicitLD = m.group(1)
                    if "lld" not in explicitLD:
                        self.Print("CONFIGURATION-WARNING: LTO with " + S(self.COMPILER_DRIVER_CPlusPlus) + " and -fuse-ld=" + explicitLD + " - only lld is known to link clang LTO correctly (GNU ld mis-links it).\n")
                elif PERL_OS != "darwin":
                    if self.GetClangLLD_(self.COMPILER_DRIVER_CPlusPlus) is not None:
                        self.LinkerArgs_ExtraPrefix += " -fuse-ld=lld"
                    else:
                        self.Print("CONFIGURATION-WARNING: LTO with " + S(self.COMPILER_DRIVER_CPlusPlus) + " but no lld, so linking with GNU ld, which mis-links clang LTO (install lld, or --lto disable).\n")
            if self.IsMSVCCompiler_(self.COMPILER_DRIVER_CPlusPlus):
                self.CFLAGS.append("-GL")  # Whole Program Optimization
                self.CXXFLAGS.append("-GL")  # Whole Program Optimization
                self.LinkerArgs_ExtraPrefix += " -LTCG"

            if self.IsGCCOrGPlusPlus_(self.COMPILER_DRIVER):
                # avoid release (LTO) warnings like this:
                #   /home/lewis/Sandbox/Stroika-Build-Dir-Ubuntu2004_x86_64/IntermediateFiles/g++-12-release++2b/ThirdPartyComponents/Xerces/src/xercesc/dom/impl/DOMCharacterDataImpl.cpp:319:12: warning: function may return address of local variable [-Wreturn-local-addr]
                # Seen on Ubuntu 2204, 2404, and 2604 with Test Builds/g++-12-release/Tests/Test48 (Foundation::Memory) ...
                #   /home/lewis/Sandbox/Stroika-Build-Dir-Ubuntu2604_x86_64/ThirdPartyComponents/Xerces/CURRENT/src/xercesc/dom/impl/DOMCharacterDataImpl.cpp: In member function 'substringData':
                #   /home/lewis/Sandbox/Stroika-Build-Dir-Ubuntu2604_x86_64/ThirdPartyComponents/Xerces/CURRENT/src/xercesc/dom/impl/DOMCharacterDataImpl.cpp:319:12: warning: function may return address of local variable [-Wreturn-local-addr]
                #   319 |     return retString;
                # Bogus: getPooledString () returns a string-pool entry (or 0), never its argument, so retString cannot point at
                # the local temp[]. g++-11 needs it too (seen 2026-09-24, 22.04 g++-11-release++2b and raspberrypi-g++-11-release);
                # g++-13 and later are quiet.
                itsVersion = self.GetGCCVersion_(self.COMPILER_DRIVER_CPlusPlus)
                if itsVersion < 13:
                    self.LinkerArgs_ExtraPrefix = self.LinkerArgs_ExtraPrefix + " -Wno-return-local-addr"

        if self.IsGCCOrGPlusPlus_(self.COMPILER_DRIVER):
            itsVersion = self.GetGCCVersion_(self.COMPILER_DRIVER_CPlusPlus)
            if 12.0 <= itsVersion < 14 and self.COPTIMIZE_FLAGS != "":
                # With gcc 12/13 - release builds - we get lots of spurious uninitialized warnings, raspi and direct x86
                # EG:
                #   In member function 'constexpr std::__cxx11::basic_string<_CharT, _Traits, _Alloc>::size_type std::__cxx11::basic_string<_CharT, _Traits, _Alloc>::length() const [with _CharT = char; _Traits = std::char_traits<char>; _Alloc = std::allocator<char>]',
                #       inlined from 'constexpr std::__cxx11::basic_string<_CharT, _Traits, _Alloc>& std::__cxx11::basic_string<_CharT, _Traits, _Alloc>::operator=(std::__cxx11::basic_string<_CharT, _Traits, _Alloc>&&) [with _CharT = char; _Traits = std::char_traits<char>; _Alloc = std::allocator<char>]' at /usr/include/c++/13/bits/basic_string.h:887:15,
                #       inlined from 'Stroika::Foundation::Time::Duration& Stroika::Foundation::Time::Duration::operator=(Stroika::Foundation::Time::Duration&&)' at ../Time/Duration.inl:157:56,
                #       inlined from 'void Stroika::Foundation::Execution::Sleep(const Stroika::Foundation::Time::Duration&, Stroika::Foundation::Time::Duration*)' at Sleep.cpp:38:49:
                #   /usr/include/c++/13/bits/basic_string.h:1067:16: warning: '<unnamed>.Stroika::Foundation::Time::Duration::<unnamed>.Stroika::Foundation::Time::Duration::._anon_544::fStringRep_.std::__cxx11::basic_string<char>::_M_string_length' may be used uninitialized [-Wmaybe-uninitialized]
                #   1067 |       { return _M_string_length; }
                #       |                ^~~~~~~~~~~~~~~~
                self.CXXWARNING_FLAGS = S(self.CXXWARNING_FLAGS) + " -Wno-maybe-uninitialized"
            if itsVersion < 12:
                # With gcc 11 cannot seem to suppress with pragma warning
                self.CXXWARNING_FLAGS = S(self.CXXWARNING_FLAGS) + " -Wno-stringop-overflow"

        if self.IsClangOrClangPlusPlus_(self.COMPILER_DRIVER_CPlusPlus):
            self.CXXWARNING_FLAGS = S(self.CXXWARNING_FLAGS) + "-Wno-unqualified-std-cast-call "

        if self.sanitizerFlagsIsDefined and len(self.sanitizerFlags) != 0:
            inNoSanitizeList = set(self.noSanitizerFlags)
            crap2Add2CZZFlags = "-fsanitize="
            effectiveSanitizerFlags = []
            for i, f in enumerate(self.sanitizerFlags):
                if f not in inNoSanitizeList:
                    crap2Add2CZZFlags += f
                    if i < len(self.sanitizerFlags) - 1:
                        crap2Add2CZZFlags += ","
                    effectiveSanitizerFlags.append(f)
            self.sanitizerFlags = effectiveSanitizerFlags  # subtract out no-sanitize entries
            if self.IsGCCOrGPlusPlus_(self.COMPILER_DRIVER) or self.IsClangOrClangPlusPlus_(self.COMPILER_DRIVER):
                self.LinkerArgs_ExtraPrefix += " " + crap2Add2CZZFlags
            if isVisualStudio:
                # asan executables need the asan runtime DLL beside them (https://github.com/SophistSolutions/Stroika/issues/1116)
                if self.IsTargettingSanitizer_("address"):
                    self.FillInToolsPathAdditionsIfNeeded_()
                    dir2Add = self.GetMSVCVarName_("ASAN_DLL_DIR")
                    # eg ls -l /c/Program\ Files/Microsoft\ Visual\ Studio/2022/Community/VC/Tools/MSVC/14.38.33130/bin/Hostx64/x64/
                    names = {"x86": "i386", "x86_64": "x86_64"}.get(self.ARCH)
                    if names is not None:
                        for x in self.Cygpath(["--mixed"], [dir2Add + "/clang_rt.asan_dynamic-" + names + ".dll",
                                                            dir2Add + "/clang_rt.asan_dynamic-" + names + ".pdb"]):
                            self.LinkTime_CopyFilesToEXEDir.append(x)
            self.CFLAGS.append(crap2Add2CZZFlags)
            self.CXXFLAGS.append(crap2Add2CZZFlags)

            if self.sanitizerFlagsIsDefined and len(self.sanitizerFlags) != 0 and self.STATIC_LINK_SANITIZERS != 0:
                if self.IsGCCOrGPlusPlus_(self.COMPILER_DRIVER):
                    for f in self.sanitizerFlags:
                        if f == "address":
                            self.LinkerArgs_ExtraPrefix += " -static-libasan"
                        elif f == "undefined":
                            self.LinkerArgs_ExtraPrefix += " -static-libubsan"
                        elif f == "thread":
                            self.LinkerArgs_ExtraPrefix += " -static-libtsan"
                        elif f == "leak":
                            self.LinkerArgs_ExtraPrefix += " -static-liblsan"
                elif self.IsClangOrClangPlusPlus_(self.COMPILER_DRIVER):
                    if len(self.sanitizerFlags) != 1:
                        self.LinkerArgs_ExtraPrefix += " -static-libsan"
        if len(self.noSanitizerFlags) >= 1:
            s = ", ".join(self.noSanitizerFlags)
            self.CFLAGS.append(" -fno-sanitize=" + s)
            self.CXXFLAGS.append(" -fno-sanitize=" + s)

        if self.autoIncludeTSAN_OPTIONSIfAppropriate:
            if self.IsTargettingSanitizer_("thread"):
                # prepend, so stuff already there takes precedence
                if S(self.RunPrefix) != "":
                    self.RunPrefix = " " + S(self.RunPrefix)
                self.RunPrefix = "TSAN_OPTIONS=suppressions=${StroikaRoot}/Tests/ThreadSanitizerSuppressions.supp" + S(self.RunPrefix)

        if S(self.FEATUREFLAG_OpenSSL) == "":
            self.FEATUREFLAG_OpenSSL = LIBFEATUREFLAG_UseStaticTPP

        if isVisualStudio:
            # Default to true for visual studio, because debug symbols go in separate file, and don't balloon the exe size (.pdb)
            if self.INCLUDE_SYMBOLS_EXE == DEFAULT_BOOL_OPTIONS:
                self.INCLUDE_SYMBOLS_EXE = true
        if self.INCLUDE_SYMBOLS_EXE == DEFAULT_BOOL_OPTIONS:
            self.INCLUDE_SYMBOLS_EXE = false

        if self.MALLOC_GUARD == true:
            self.useExtraCDefines.append("#define qStroika_Foundation_Debug_MallocGuard 1")

        if self.FEATUREFLAG_StrawberryPerl is None:
            self.FEATUREFLAG_StrawberryPerl = "use" if (self.FEATUREFLAG_OpenSSL == "use" and IS_WINDOWS_HOST) else LIBFEATUREFLAG_No
        if self.FEATUREFLAG_WIX is None:
            # No need to install, because its checked into ThirdPartyComponents/WiX
            self.FEATUREFLAG_WIX = "use" if IS_WINDOWS_HOST else LIBFEATUREFLAG_No

        if self.STDCXXLIB is not None:
            if self.IsClangOrClangPlusPlus_(self.COMPILER_DRIVER_CPlusPlus):
                self.LinkerArgs_ExtraPrefix += " -stdlib=" + self.STDCXXLIB
                self.CXXFLAGS.append(" -stdlib=" + self.STDCXXLIB)

        if self.BuildPlatform == "Unix":
            # Ahead of the libstdc++ entries below, since it uses libstdc++
            if self.STDCXXLIB is not None and self.STDCXXLIB == "libstdc++" and self.HasCompiler_(self.COMPILER_DRIVER_CPlusPlus):
                stdlibFlag = "-stdlib=libstdc++" if self.IsClangOrClangPlusPlus_(self.COMPILER_DRIVER_CPlusPlus) else ""
                stacktraceLib = self.GetLibStdCXXStacktraceLib_(self.COMPILER_DRIVER_CPlusPlus, self.CPPSTD_VERSION_FLAG + " " + stdlibFlag)
                if stacktraceLib is None:
                    self.Print("Warning: found no library that makes std::stacktrace link with " + S(self.COMPILER_DRIVER_CPlusPlus) + " " + self.CPPSTD_VERSION_FLAG + " - if Debug/BackTrace fails to link, that is why\n")
                elif stacktraceLib != "":
                    self.LinkerArgs_LibDependencies_ADD.append(stacktraceLib)
            if self.STATIC_LINK_GCCRUNTIME == 1:
                # tried $IF_STATIC_LINK_GCCRUNTIME_USE_PRINTPATH_METHOD=0 in Ubuntu 1804, and g++-7, and failed (still left .so file in ldd)
                lib2FindStatic = S(self.STDCXXLIB) + ".a"
                lib = Trim(self.Backtick(S(self.COMPILER_DRIVER_CPlusPlus) + " -print-file-name=" + lib2FindStatic + " 2>/dev/null"))
                if lib != lib2FindStatic:
                    self.LinkerArgs_LibDependencies_ADD.append(lib)
                else:
                    # consider using apt-get install glibc-static libstdc++-static
                    dashLName = Trim(self.Backtick("echo " + S(self.STDCXXLIB) + " | sed s/lib//"))
                    self.LinkerArgs_LibDependencies_ADD.append("-l" + dashLName)

            if self.IsGCCOrGPlusPlus_(self.COMPILER_DRIVER_CPlusPlus):
                if not self.STATIC_LINK_GCCRUNTIME:
                    self.LinkerArgs_LibDependencies_ADD.append("-lstdc++")
                if self.STATIC_LINK_GCCRUNTIME == 1:
                    # https://github.com/SophistSolutions/Stroika/issues/811 (-static causes some apps crash; and there is no option to JUST staticly link libc - eg no -static-libc)
                    self.LinkerArgs_ExtraPrefix += " -static-libstdc++"
                    self.LinkerArgs_ExtraPrefix += " -static-libgcc"
                    # self.LinkerArgs_ExtraPrefix += " -static-libc"  # Wish this existed as option!
            elif self.IsClangOrClangPlusPlus_(self.COMPILER_DRIVER_CPlusPlus):
                if self.STDCXXLIB == "libc++":
                    self.LinkerArgs_LibDependencies_ADD.append("-lc++")

        self.FillDefaultIncludesPathIfNeeded_()
        self.FillDefaultLibsPathIfNeeded_()
        self.FillDefaultLibDependencies_()
        self.FillInToolsPathAdditionsIfNeeded_()

        if isVisualStudio:
            self.LinkerArgs_ExtraPrefix += " -nologo"
            WIN_LIBCOMPATIBLE_ARCH = "x64" if self.ARCH == "x86_64" else S(self.ARCH)
            self.LinkerArgs_ExtraPrefix += " -MACHINE:" + WIN_LIBCOMPATIBLE_ARCH
            if self.VSVARS_MSVC_RUNTIME_LIBRARY is None:
                self.VSVARS_MSVC_RUNTIME_LIBRARY = "MultiThreadedDebug" if self.gAssertionsEnabled else "MultiThreaded"

        if self.CPPFLAGS_Overridden == false:
            self.GetDefaultCZZFLAGS_flags_flags = list(self.Platform_CPPFLAGS_B4Includes)
            self.GetDefaultCZZFLAGS_flags_flagValues2Remove = list(self.CPPFLAGS2Remove)
            self.Platform_CPPFLAGS_B4Includes = self.GetDefaultCZZFLAGS_flags_(0, true, false)
        # Stroika's own defines (its components, assertions, tracing) come from their own options, so --replace-all-CPPFLAGS
        # and --remove-CPPFLAGS leave them be
        self.GetDefaultCZZFLAGS_flags_flags = []
        self.GetDefaultCZZFLAGS_flags_flagValues2Remove = []
        self.StroikaFoundation_CPPFLAGS_B4Includes = self.GetDefaultCZZFLAGS_flags_(0, false, true)
        if self.CFLAGS_Overridden == false:
            self.GetDefaultCZZFLAGS_flags_flags = list(self.CFLAGS)
            self.GetDefaultCZZFLAGS_flags_flagValues2Remove = list(self.CFLAGS2Remove)
            self.CFLAGS = self.GetDefaultCZZFLAGS_flags_(1, true, true)
        if self.CXXFLAGS_Overridden == false:
            self.GetDefaultCZZFLAGS_flags_flags = list(self.CXXFLAGS)
            self.GetDefaultCZZFLAGS_flags_flagValues2Remove = list(self.CXXFLAGS2Remove)
            self.CXXFLAGS = self.GetDefaultCZZFLAGS_flags_(2, true, true)

        # Append these last so they can be used to override earlier options
        for r in self.CXXFLAGS2Append:
            self.CXXFLAGS.append(r)

        if self.BuildPlatform == "Unix" and self.CPPSTD_VERSION_FLAG != "":
            self.LinkerArgs_ExtraPrefix += " " + self.CPPSTD_VERSION_FLAG

        if self.INCLUDE_SYMBOLS_EXE:
            if isVisualStudio:
                # PREPEND this option, because it effects the default for other options like -OPT and resets them
                self.LinkerArgs_ExtraPrefix = "-DEBUG:FULL " + self.LinkerArgs_ExtraPrefix
            elif self.BuildPlatform == "Unix":
                self.LinkerArgs_ExtraPrefix += " -g"

        if PERL_OS == "darwin" and self.IsClangPlusPlus_(self.COMPILER_DRIVER_CPlusPlus) and S(self.ARCH) != "":
            self.CFLAGS.append(" -arch " + self.ARCH)
            self.CXXFLAGS.append(" -arch " + self.ARCH)
            self.LinkerArgs_ExtraPrefix += " -arch " + self.ARCH
            # Since XCode 15, we've been getting these warnings ('ld: warning: ignoring duplicate libraries'), and no simple way to avoid them.
            #   https://stackoverflow.com/questions/77164140/ld-warning-ignoring-duplicate-libraries-lgcc-after-the-recent-update-of-xc
            # Tried combining the pkg-config lines into one call (would have been easy to fix configure to do this) - but that didnt help.
            # Tried awk script:
            #   lewis@lewis-mac2 StroikaDev % (PKG_CONFIG_PATH=/Users/lewis/Sandbox/StroikaDev/Builds/Debug/ThirdPartyComponents/lib/pkgconfig pkg-config --static --libs zlib libcurl openssl ) | awk '{for (i=1;i<=NF;i++) if ($i =="-framework"||!a[$i]++) printf("%s%s",$i,FS)}{printf("\n")}'
            # comes close, but no cigar ) the -framework stuff pITA. Looked at docs, and no alternative syntax for -framework ARG.
            # COULD combine them all, and hardwire running the awk script to remove dups a -lz and each of these
            # libraries: '-lbrotlidec', '-lcrypto', '-lidn2', '-lssl', '-lz'
            # Seems least bad of a bad bunch of options:
            self.LinkerArgs_ExtraSuffix += " -Wl,-no_warn_duplicate_libraries"

        # Under LTO, gcc generates the code - and so emits every middle/back-end diagnostic - at LINK time, and
        # LTRANS honours only the link command's -W flags: compile-time warning options are not carried in the
        # LTO objects (checked 2026-09-23 with a two-file repro), and '#pragma GCC diagnostic' does not survive
        # into LTRANS either. So the compile warning policy must be repeated on the link line, or whatever it
        # suppresses comes back at link - e.g. hundreds of armhf "parameter passing for argument of type 'struct
        # wformat_args' changed in GCC 9.1" notes despite -Wno-psabi. Done HERE, after the last change to
        # CXXWARNING_FLAGS above (-Wno-maybe-uninitialized is exactly the kind of late warning that fires at an
        # LTO link) and after ApplyCompilerBugWorkarounds_ () has settled ENABLE_LTO. Prepended, so the link-only
        # suppressions already in LinkerArgs_ExtraPrefix (-Wno-free-nonheap-object etc) still come after it and win.
        if self.IsGCCOrGPlusPlus_(self.COMPILER_DRIVER) and self.ENABLE_LTO == true:
            self.LinkerArgs_ExtraPrefix = S(self.CXXWARNING_FLAGS) + " " + self.LinkerArgs_ExtraPrefix

    def ValidateConfigurationAndEmitNeededWarnings_(self):
        if self.IsClangPlusPlus_(self.COMPILER_DRIVER_CPlusPlus) and self.GetClangVersion_(self.COMPILER_DRIVER_CPlusPlus) < 15.0:
            self.Print("CONFIGURATION-WARNING: Stroika v3 requires clang 15 or later (compiler-driver: " + S(self.COMPILER_DRIVER_CPlusPlus) + ").\n")
        if self.IsGCCOrGPlusPlus_(self.COMPILER_DRIVER_CPlusPlus) and self.GetGCCVersion_(self.COMPILER_DRIVER) < 11:
            self.Print("CONFIGURATION-WARNING: Stroika 3 requires gcc 11 or later (compiler-driver: " + S(self.COMPILER_DRIVER_CPlusPlus) + ").\n")

    def GetMSVCVarName_(self, envVarName):
        """
        The Visual Studio environment (vcvarsall.bat's) for this ARCH and BuildToolsRoot - computed once, since ARCH and
        BuildToolsRoot shouldn't change once we start calling this
        """
        if S(self.ARCH) == "":
            Die("reorg code so this set first")
        if not self.GetMSVCVarName_filled_:
            # Visual Studio targets only x86 and x86_64. Any other ARCH (e.g. UNKNOWN, for a compiler that is not installed) gets
            # no Visual Studio environment, so configure gets far enough for --only-if-has-compiler to skip the configuration.
            if self.ARCH in ("x86", "x86_64"):
                if self.BuildToolsRoot is None:
                    self.BuildToolsRoot = self.GetDefaultToolsBuildDir(self.BuildPlatform)
                self.GetMSVCVarName_e_ = self.GetAugmentedEnvironmentVariablesForConfiguration(self.ARCH, self.BuildToolsRoot)
            self.GetMSVCVarName_filled_ = true
        return S(self.GetMSVCVarName_e_.get(envVarName))

    # ---------------------------------------------------------------- Visual Studio support

    def toCygPath_(self, arg):
        if arg is None:
            arg = ""
        if arg.endswith("\\"):
            arg = arg[:-1]
        if arg == "":
            return ""
        return self.Cygpath(["--unix"], [arg])[0]

    def fromCygPath_(self, arg):
        if S(arg) == "":
            return ""
        return self.Cygpath(["--mixed"], [arg])[0]

    toExternallyUsedPath_ = fromCygPath_

    def GetDefaultToolsBuildDir(self, PLATFORM):
        """
        The default (guessed) Visual Studio installation directory, e.g. C:/Program Files/Microsoft Visual Studio/18/Community

        Example calls
            GetDefaultToolsBuildDir ("VisualStudio.Net-2022")
            GetDefaultToolsBuildDir ("VisualStudio.Net")
        """
        PROGRAMFILESDIR = S(Env("PROGRAMFILES"))
        PROGRAMFILESDIR86 = S(Env("ProgramFiles(x86)"))
        names = ["18"]  # default to vs2k2026
        if PLATFORM == "VisualStudio.Net-2022":
            names = ["2022"]
        elif PLATFORM == "VisualStudio.Net-2026":
            names = ["18"]
        elif PLATFORM == "VisualStudio.Net":
            pass  # keep default
        else:
            Die("PLATFORM unreconfigued in configure")
        VSDIR = None
        for n in names:
            VSDIR = PROGRAMFILESDIR86 + "\\Microsoft Visual Studio\\" + n
            if not PerlExists(self.toCygPath_(VSDIR)):
                VSDIR = PROGRAMFILESDIR + "\\Microsoft Visual Studio\\" + n
            if not PerlExists(self.toCygPath_(VSDIR)):
                break
        # @todo consider somehow redoing this logic with use of vswhere, but not 100% sure how to fetch efficiently to use
        VSDIRs = PerlGlob(self.toCygPath_(VSDIR + "\\*"))
        if len(VSDIRs) == 0:
            Die("No 'VSDIR' found automatically")
        VSDIR = self.fromCygPath_(VSDIRs[0])
        if len(VSDIRs) > 1:
            self.Print("Configure Warning: Multiple VSDirs found: using " + VSDIR + "\n")
        if not PerlExists(self.toCygPath_(VSDIR)):
            Die("directory '" + VSDIR + "' doesn't exist")
        return VSDIR

    def GetString2InsertIntoBatchFileToInitCompiles_(self, ARCH, VSDIR):
        # SEE https://docs.microsoft.com/en-us/cpp/build/building-on-the-command-line?view=vs-2019 for docs on calling vcvarsall.bat
        if ARCH == "x86":
            arg = "x64_x86"
        elif ARCH == "x86_64":
            arg = "x64"
        else:
            Die("hardwired/to fix logic about mapping config names to 32/64")
        VSDIR_VC = S(VSDIR) + "\\VC"
        if not PerlExists(self.toCygPath_(VSDIR_VC)):
            Die("Couldn't find " + VSDIR_VC + ": did you install visual studio desktop C++ support?")
        # pushd/popd: vcvarsall.bat cd's to %VSCMD_START_DIR% if that is set, and older Visual Studios to %USERPROFILE%\Source
        result = "pushd %TEMP%\r\n"
        result += 'call "' + VSDIR_VC + "\\Auxiliary\\Build\\vcvarsall.bat" + '" ' + arg + " > nul;\r\n"
        result += "popd\r\n"
        return result

    def RunBackTickWithVCVarsSetInEnvironment_(self, ARCH, VSDIR, cmd2Run):
        fd, tmpPath = tempfile.mkstemp(prefix="runCmdInVCVarsContext_", suffix=".bat", dir=".")
        try:
            with os.fdopen(fd, "wb") as f:
                f.write(("@echo off\r\n" + self.GetString2InsertIntoBatchFileToInitCompiles_(ARCH, VSDIR) + cmd2Run + "\r\n").encode(ENC))
            # https://github.com/SophistSolutions/Stroika/issues/1073 /E:ON needed for this ticket
            # cmd finds the .bat by its bare name, in the current directory - which NoDefaultCurrentDirectoryInExePath turns off
            p = subprocess.run(["cmd", "/E:ON/C", os.path.basename(tmpPath)], stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                               env=ChildEnv(drop=["NoDefaultCurrentDirectoryInExePath"]))
            self.PrintErr(p.stderr.decode(ENC))
            return p.stdout.decode(ENC)
        finally:
            os.unlink(tmpPath)

    def GetEnvironmentVariablesForConfiguration_(self, ARCH, VSDIR):
        resultStr = self.RunBackTickWithVCVarsSetInEnvironment_(ARCH, VSDIR, "set")
        result = {}
        for line in re.split(r"[\r\n]", resultStr):
            envVar, _, envVarValue = line.partition("=")  # a value may hold '=' itself
            result[envVar] = envVarValue
        return result

    def GetAugmentedEnvironmentVariablesForConfiguration(self, ARCH, VSDIR):
        """A dictionary with all the configuration for the given argument ARCH string"""
        resEnv = self.GetEnvironmentVariablesForConfiguration_(ARCH, VSDIR)
        cwVSDIR = self.toCygPath_(VSDIR)
        HOSTSTR = "HostX64"  # I doubt anyone develops on 32bit anymore, but if they do we can easily detect and fix this
        if ARCH not in ("x86", "x86_64"):
            Die("unrecongized ARCH")
        target, asName = ("x86", "ml") if ARCH == "x86" else ("x64", "ml64")
        exeDirs = PerlGlob(cwVSDIR + "/VC/Tools/MSVC/*/bin/" + HOSTSTR + "/" + target)
        exeDir = self.fromCygPath_(exeDirs[-1] if exeDirs else None)
        if len(exeDirs) > 1:
            self.Print(self.PrintLevelLeader(N(self.MAKE_INDENT_LEVEL) + 2) + "Configure Warning: Multiple Compiler directories found: using " + exeDir + "\n")
        sdkPath = self.toCygPath_(resEnv.get("WindowsSdkVerBinPath"))
        exeDir2 = sdkPath + "/x64/"
        names = ["AS", "CC", "LD", "AR", "ASAN_DLL_DIR", "MIDL", "RC", "WindowsSdkVerBinPath"]  # 'AR' is what unix uses to create libraries
        values = self.Cygpath(["--mixed"], [exeDir + "\\" + asName, exeDir + "\\cl", exeDir + "\\link", exeDir + "\\lib", exeDir,
                                            exeDir2 + "midl", exeDir2 + "rc", sdkPath], emptyGivesEmpty=True)
        for n, v in zip(names, values):
            resEnv[n] = v

        myOrigFullPath = S(Env("PATH"))
        if sys.platform == "win32":  # what an MSYS2/Cygwin Perl's $ENV{PATH} says
            myOrigFullPath = self.Backtick('cygpath --unix --path "' + myOrigFullPath + '"')
            if myOrigFullPath.endswith("\n"):
                myOrigFullPath = myOrigFullPath[:-1]
        newFullPath = Trim(self.Backtick('cygpath --unix --path "' + S(resEnv.get("PATH")) + '"'))
        myOrigFullPathHash = set(PerlSplit(":", myOrigFullPath))
        newFullPathHash = set(PerlSplit(":", newFullPath)) - myOrigFullPathHash
        # Sorting is not desirable, but has doesn't preserve order anyhow, so best the output is regular (the same across runs)
        # todo must do similar but be careful about how to treat colon in paths.
        resEnv["TOOLS_PATH_ADDITIONS"] = ":".join(Trim(ip) for ip in sorted(newFullPathHash))

        for n in ("VCToolsInstallDir", "VSINSTALLDIR", "WindowsSdkDir"):
            resEnv[n] = self.toExternallyUsedPath_(self.toCygPath_(resEnv.get(n)))
        return resEnv

    # ---------------------------------------------------------------- writing the configuration file

    def ConfigFileText_(self):
        """
        The configuration file's text: each value escaped, so the file is well-formed XML whatever the values hold.

        Eventually - make this more central - put all configs here, and then build C++/dirs etc from this!
        """

        def Element(name, value):
            return "    <" + name + ">" + XMLText(value) + "</" + name + ">\n"

        isVS = re.match(r"VisualStudio.Net", self.BuildPlatform) is not None
        # probably belongs elsewhere
        if isVS:
            self.VC_PLATFORM_INCLUDES_PATH = self.Cygpath(["--mixed"], self.VC_PLATFORM_INCLUDES_PATH)
            self.PLATFORM_INCLUDES_PATH = self.Cygpath(["--mixed"], self.PLATFORM_INCLUDES_PATH)
            self.FOUNDATION_INCLUDES_PATH = self.Cygpath(["--mixed"], self.FOUNDATION_INCLUDES_PATH)
            self.LinkerArgs_LibPath = self.Cygpath(["--mixed"], self.LinkerArgs_LibPath)
        # FIXUP LinkerArgs_LibPath
        LinkerArgs_LibPathString = ""
        for l in self.LinkerArgs_LibPath:
            l = S(l)
            if isVS:
                if len(l) > 0 and l.endswith("\\"):
                    l += '"'
                LinkerArgs_LibPathString += '-LIBPATH:"' + l + '" '
            else:
                LinkerArgs_LibPathString += "-L" + l + " "

        appArgs = self.GetAppArgs_()
        o = []
        w = o.append
        w("<!--This file autogenerated by the configure command: see ConfigureCommandLine, modify it, and re-run-->\n\n")
        w("<Configuration>\n")

        w("    <!--Overall-->\n")
        w("    <ConfigureCommandLine>")
        w("configure ")
        w(XMLText(shlex.join(appArgs)))  # quoted as a shell reads it: make reconfigure evals it
        w("</ConfigureCommandLine>\n")
        w(Element("BuildPlatform", self.BuildPlatform))
        if self.BuildToolsRoot is not None:
            w(Element("BuildToolsRoot", self.BuildToolsRoot))
        w(Element("TargetPlatforms", self.TargetPlatforms))
        w(Element("ARCH", self.ARCH))
        w(Element("ConfigTags", self.Config_Tag))
        w(Element("BuildByDefault", self.BuildByDefault))

        w("\n    <!--Tools-->\n")
        if self.AR is not None:
            w(Element("AR", self.AR))
        w(Element("AS", self.AS))
        w(Element("CC", self.COMPILER_DRIVER_C))
        w(Element("CXX", self.COMPILER_DRIVER_CPlusPlus))
        w(Element("CMAKE", self.CMAKE if self.CMAKE is not None else "cmake"))
        if self.LIBTOOL is not None:
            w(Element("LIBTOOL", self.LIBTOOL))
        w(Element("LINKER", self.LINKER))
        for name in ("MIDL", "RANLIB", "RC", "STRIP"):
            if getattr(self, name) is not None:
                w(Element(name, getattr(self, name)))

        w("\n    <!--Features Enabled-->\n")
        if self.FEATUREFLAG_ATLMFC is not None:
            w(Element("qFeatureFlag_ATLMFC", self.FEATUREFLAG_ATLMFC))
        w(Element("qFeatureFlag_boost", self.FEATUREFLAG_boost))
        w(Element("qFeatureFlag_LibCurl", self.FEATUREFLAG_LIBCURL))
        w(Element("qFeatureFlag_fmtlib", self.FEATUREFLAG_fmtlib))
        w(Element("qFeatureFlag_GoogleTest", self.FEATUREFLAG_GoogleTest))
        w(Element("qFeatureFlag_LZMA", self.FEATUREFLAG_LZMA))
        w(Element("qFeatureFlag_mongocxxdriver", self.FEATUREFLAG_mongocxxdriver))
        w(Element("qFeatureFlag_OpenSSL", self.FEATUREFLAG_OpenSSL))
        if S(self.FEATUREFLAG_OpenSSLExtraArgs) != "":
            if self.FEATUREFLAG_OpenSSL == LIBFEATUREFLAG_UseStaticTPP:
                w(Element("qFeatureFlag_OpenSSL_ExtraArgs", self.FEATUREFLAG_OpenSSLExtraArgs))
            else:
                Die("Cannot specify OpenSSL-ExtraArgs unless --OpenSSL use")
        w(Element("qFeatureFlag_sqlite", self.FEATUREFLAG_sqlite))
        w(Element("qFeatureFlag_StrawberryPerl", self.FEATUREFLAG_StrawberryPerl))
        w(Element("qFeatureFlag_WinHTTP", self.FEATUREFLAG_WinHTTP))
        w(Element("qFeatureFlag_WIX", self.FEATUREFLAG_WIX))
        w(Element("qFeatureFlag_Xerces", self.FEATUREFLAG_Xerces))
        w(Element("qFeatureFlag_libxml2", self.FEATUREFLAG_libxml2))
        w(Element("qFeatureFlag_ZLib", self.FEATUREFLAG_ZLib))
        w(Element("qFeatureFlag_zstd", self.FEATUREFLAG_zstd))
        if self.gAssertionsEnabled != DEFAULT_BOOL_OPTIONS:
            w(Element("AssertionsEnabled", self.gAssertionsEnabled))
        w(Element("SanitizerFlags", "".join(S(v) + " " for v in self.sanitizerFlags)))

        w("\n    <!--MISC-->\n")
        w(Element("CrossCompiling", self.CrossCompiling))
        w("    <ExtraMakeDefines>\n")
        for var in self.useExtraMakeDefines:
            w("       <MakeDefine>" + XMLText(var) + "</MakeDefine>\n")
        w("    </ExtraMakeDefines>\n")
        w(Element("Foundation_PkgConfigNames", " ".join(self.foundationPackageCfgNames)))

        w("\n    <!--Platform Settings-->\n")
        for name in ("VSVARS_WindowsSdkDir", "VSVARS_WindowsSDKVersion", "VSVARS_VSINSTALLDIR", "VSVARS_VCToolsInstallDir",
                     "VSVARS_MSVC_RUNTIME_LIBRARY"):
            if getattr(self, name) is not None:
                w(Element(name, getattr(self, name)))
        if S(self.MACOSX_DEPLOYMENT_TARGET) != "":
            w(Element("MACOSX_DEPLOYMENT_TARGET", self.MACOSX_DEPLOYMENT_TARGET))
        if self.TOOLS_PATH_ADDITIONS is not None:
            w(Element("TOOLS_PATH_ADDITIONS", self.TOOLS_PATH_ADDITIONS))
        if len(self.VC_PLATFORM_INCLUDES_PATH) != 0:
            w(Element("VSVARS_PLATFORM_INCLUDES_PATH", self.PATH_SEPERATOR.join(S(p) for p in self.VC_PLATFORM_INCLUDES_PATH)))

        w("\n    <!--Compiling-->\n")
        w(Element("PLATFORM_CPPFLAGS_NOTINCLUDES", " ".join(S(v) for v in self.Platform_CPPFLAGS_B4Includes)))
        w(Element("PLATFORM_INCLUDES_PATH", self.PATH_SEPERATOR.join(S(p) for p in self.PLATFORM_INCLUDES_PATH)))
        w(Element("PLATFORM_CFLAGS", " ".join(S(v) for v in self.CFLAGS)))
        w(Element("PLATFORM_CXXFLAGS", " ".join(S(v) for v in self.CXXFLAGS)))
        w(Element("FOUNDATION_CPPFLAGS_NOTINCLUDES", " ".join(S(v) for v in self.StroikaFoundation_CPPFLAGS_B4Includes)))
        w(Element("FOUNDATION_INCLUDES_PATH", self.PATH_SEPERATOR.join(S(p) for p in self.FOUNDATION_INCLUDES_PATH)))

        w("\n    <!--Linking-->\n")
        w(Element("IncludeDebugSymbolsInLibraries", self.INCLUDE_SYMBOLS_LIB))
        w(Element("IncludeDebugSymbolsInExecutables", self.INCLUDE_SYMBOLS_EXE))
        w(Element("Platform_LinkerArgs_LibPath", LinkerArgs_LibPathString))
        w(Element("Platform_LinkerArgs_LibDependencies", self.LinkerArgs_LibDependencies))
        w(Element("Platform_LinkerArgs_ExtraPrefix", self.LinkerArgs_ExtraPrefix))
        w(Element("Platform_LinkerArgs_ExtraSuffix", self.LinkerArgs_ExtraSuffix))

        # todo fix/wrong - only works for case of zero or one file
        # ';' separated list of files to be copied into same directory as we link to, as part of linking operations.
        # ORIGINAL inspiration was ASAN on Windows - but this basic mechanism could also be used on unix for example, for dlls with linker flags to use bin relative DLLS/so file etc
        w(Element("LinkTime_CopyFilesToEXEDir", " ".join('"' + S(v) + '"' for v in self.LinkTime_CopyFilesToEXEDir)))

        w("\n    <!--Runtime/Testing-->\n")
        w(Element("RunPrefix", self.RunPrefix))

        w("\n    <!--Compiler/Tool Bug Workarounds/Defines-->\n")
        if self.qCompiler_HasNoMisleadingIndentation_Flag is not None:
            w(Element("qCompiler_HasNoMisleadingIndentation_Flag", self.qCompiler_HasNoMisleadingIndentation_Flag))

        w("\n    <!--VERSIONS-->\n")
        if self.IsGCCOrGPlusPlus_(self.COMPILER_DRIVER_CPlusPlus):
            w("        <!--" + XMLComment("g++ version: " + S(self.GetGCCVersion_(self.COMPILER_DRIVER_CPlusPlus, true))) + "-->\n")
        if self.IsClangOrClangPlusPlus_(self.COMPILER_DRIVER_CPlusPlus):
            w("        <!--" + XMLComment("clang++ version: " + S(self.GetClangVersion_(self.COMPILER_DRIVER_CPlusPlus, true))) + "-->\n")
        if self.IsMSVCCompiler_(self.COMPILER_DRIVER_CPlusPlus):
            w("        <!--" + XMLComment("MSVC++ version: " + S(self.Get_MSVC_CL_Version_(self.COMPILER_DRIVER_CPlusPlus))) + "-->\n")
        ubuntuVersion = self.getUbuntuVersion()
        if ubuntuVersion != 0:
            w("        <!--" + XMLComment("Ubuntu: " + S(ubuntuVersion)) + "-->\n")
        if PERL_OS == "darwin":
            w("        <!--" + XMLComment("MacOS: " + self.getMacOSVersion_()) + "-->\n")
            w("        <!--" + XMLComment("XCode: " + S(self.getXCodeVersion_()) + " ; selected: " + self.getXCodeSelect_()) + "-->\n")

        w("</Configuration>\n")
        return "".join(o)

    # ---------------------------------------------------------------- the top level

    def Run(self):
        """Everything but write the file: the file's name and text, or (None, None) if skipped"""
        # Workaround MSYS compatibility issues with Microsoft Visual C++ tools - as make exports it (SharedMakeVariables-Default.mk),
        # so configure run by hand finds what it finds under make. A MINGW64/UCRT64 shell is MSYS2 too (as Build/Scripts/DetectedHostOS).
        #   Note: MSYS2_ENV_CONV_EXCL doesn't appear necessary (as of 2022-01-25)
        if IS_WINDOWS_HOST and re.match(r"MSYS|MINGW", self.Backtick("uname -s")):
            os.environ["MSYS2_ARG_CONV_EXCL"] = "*"
        self.ParseCommandLine_()
        self.PostProcessOptions_()

        try:
            os.mkdir(self.configurationFiles)
        except OSError:
            pass

        generate = true
        generateBecause = ""
        CXX = self.COMPILER_DRIVER_CPlusPlus
        if self.onlyGenerateIfCompilerExists:
            if not self.HasCompiler_(CXX):
                generate = false
                generateBecause = "compiler " + S(CXX) + " not present"

            # Really should do similar for anything we say == system and $onlyGenerateIfCompilerExists
            if generate and self.FEATUREFLAG_ZLib == LIBFEATUREFLAG_UseSystem:
                if self.System("pkg-config --libs zlib 2>/dev/null >/dev/null") != 0:
                    generate = false
                    generateBecause = "zlib is not installed"
            # --valgrind enable compiles in memcheck's client requests, so every compile needs <valgrind/memcheck.h>: ask the
            # compiler rather than look for the file, so the answer is the include path the build will really search.
            if generate and self.TargettingValgrind:
                if self.System('printf "#include <valgrind/memcheck.h>\n" | ' + S(CXX) + " -fsyntax-only -x c++ - 2>/dev/null > /dev/null") != 0:
                    generate = false
                    generateBecause = "valgrind is not installed (no <valgrind/memcheck.h>)"

            if generate and self.IsGCCOrGPlusPlus_(CXX):
                itsVersion = self.GetGCCVersion_(CXX)
                if itsVersion < 11.0:
                    generate = false
                    generateBecause = "GCC (" + S(CXX) + ") v=" + S(itsVersion) + " is older than Stroika's minimum, gcc 11"
            if self.FEATUREFLAG_fmtlib is not None and self.FEATUREFLAG_fmtlib == LIBFEATUREFLAG_No and self.NeedsFmtLib_():
                generate = false
                generateBecause = "This compiler requires fmtlib, and configure arguments disabled fmtlib use."
            ubuntuVersion = self.getUbuntuVersion()
            # if flag to use libc++ - check if right version is available (but not on XCode)
            if generate and self.IsClangOrClangPlusPlus_(CXX):
                itsVersion = self.GetClangVersion_(CXX)
                if itsVersion < 15.0:
                    generate = false
                    generateBecause = S(CXX) + " v=" + S(itsVersion) + " is older than Stroika's minimum, clang 15"
                if generate and ubuntuVersion == 24.04 and itsVersion < 16.0 and self.STDCXXLIB == "libstdc++":
                    # clang++-15-release-libstdc++ fails building google test
                    generate = false
                    generateBecause = S(CXX) + " with libstdc++ doesn't work with this version of libstdc++"
                if (generate and 16.0 <= itsVersion < 18.0 and self.STDCXXLIB == "libstdc++"
                        and self.CPPSTD_VERSION_FLAG in ("--std=c++2b", "--std=c++23")):
                    # PERHAPS should fine tune this check to make sure we are looking at g++ lib 13
                    generate = false
                    generateBecause = "clang++-16/17 with libstdc++ doesn't support c++23 mode"
                if generate and self.STDCXXLIB == "libc++" and not self.StdLibSupportsCompiler_(CXX, "libc++"):
                    # only reached when libc++ was asked for explicitly - the default would already have fallen back
                    generate = false
                    generateBecause = "the installed libc++ says it does not support " + S(CXX)
                if generate and not self.HasStdLib_(CXX, self.STDCXXLIB):
                    generate = false
                    generateBecause = S(self.STDCXXLIB) + " not available for " + S(CXX)
            if generate and ubuntuVersion != 0:
                # needed for example of HOST OS is Ubuntu 24.04 (not necessarily OS in container)
                if self.IsTargettingSanitizer_("thread"):
                    randBits = self.Backtick("sudo -S cat /proc/sys/vm/mmap_rnd_bits < /dev/null 2>/dev/null")
                    if randBits == "":
                        generate = false
                        generateBecause = "Cannot read mmap_rnd_bits and https://stackoverflow.com/questions/77850769/fatal-threadsanitizer-unexpected-memory-mapping-when-running-on-linux-kernels"
                    elif N(randBits) > 28:
                        generate = false
                        generateBecause = "sudo sysctl vm.mmap_rnd_bits=28 to allow tsan: https://stackoverflow.com/questions/77850769/fatal-threadsanitizer-unexpected-memory-mapping-when-running-on-linux-kernels"
            if generate and ubuntuVersion == 24.04 and self.gUbuntu2404OptimizedNoLTOHazard:
                # gcc 13/14 as packaged on Ubuntu 24.04 give WRONG ANSWERS in Containers::Sequence/Traversal/
                # DataExchange when optimizing without LTO - see ApplyCompilerBugWorkarounds_ for the
                # measurements. That sub already forces LTO back on so the bad flags are never emitted; for an
                # OPTIONAL configuration, do not generate it at all rather than quietly building something the
                # caller did not ask for.
                generate = false
                generateBecause = "gcc 13/14 on Ubuntu 24.04 miscompile Stroika containers when optimizing without LTO (see ApplyCompilerBugWorkarounds_ in configure)"
            if generate and ubuntuVersion == 22.04:
                # needed for [34] Foundation::DataExchange::XML - raspberrypi-g++-12-release-sanitize_address/Tests/Test34
                if self.IsGCCOrGPlusPlus_(CXX):
                    if self.GetGCCVersion_(CXX) < 13.0 and self.ARCH == "armhf":
                        # maybe only needed for release builds - but fine tune tests later in the cycle, and also not checking if arm only issue
                        if self.IsTargettingSanitizer_("address"):
                            generate = false
                            generateBecause = "bogus failure on raspberrypi-g++-12-release-sanitize_address/Tests/Test34 - so skipping asan by default - for this target"
            if generate and self.qCompiler_SanitizerDoubleLockWithConditionVariables_Buggy:
                if "thread" in self.sanitizerFlags:
                    generate = false
                    generateBecause = "qCompiler_SanitizerDoubleLockWithConditionVariables_Buggy - see https://github.com/SophistSolutions/Stroika/issues/851 AND https://gcc.gnu.org/bugzilla//show_bug.cgi?id=101978 "

        if generate:
            self.ValidateConfigurationAndEmitNeededWarnings_()
            masterXMLConfigFile = self.configurationFiles + self.configurationName + ".xml"
            self.Print(self.PrintLevelLeader(self.MAKE_INDENT_LEVEL) + 'Writing "' + masterXMLConfigFile + '" ... ')
            text = self.ConfigFileText_()
            self.Print("done\n")
            return masterXMLConfigFile, text
        self.Print(self.PrintLevelLeader(self.MAKE_INDENT_LEVEL) + "Skipping configuration " + self.configurationName + " because "
                   + generateBecause + " and configuration invoked with --only-if-has-compiler\n")
        return None, None


HELP_TEXT_ = (
    'Usage:\n'
    '  configure CONFIGURATION-NAME [OPTIONS]* where options can be:\n'
    '\t    --arch {ARCH}                                    /* for high level architecture - first section of gcc -machine - e.g. x86, x86_64, arm - usually auto-detected */\n'
    '\t    [--config-tag {TAG-NAME}]*                       /* Add TAG-NAME to the list of tags associated with this configuration (for now limit one). Maybe repeated */\n'
    '\t    --build-by-default never|always|{uname}          /* Mark configuration to be built by default always (DEFAULT), never, or only if host uname/uname -o equals ARGUMENT */\n'
    '\t    --build-platform {PLATFORM}                      /* Specifies the BuildPlatform (currently supported: Unix (even on macos), VisualStudio.Net-2022, VisualStudio.Net-2026) - usually auto-detected (was ProjectPlatformSubDir in Stroika v2.1) */\n'
    '\t    --target-platforms {TargetPlatforms}             /* Specifies the TargetPlatforms- system compiling Stroika for - (set of ENUM where ENUM=(Windows, POSIX, Linux, MacOS)) - usually auto-detected */\n'
    '\t    --build-tools-root {BuildToolsRoot}              /* Specifies the BuildToolsRoot (makefile variable) - initially just for visual studio - usually auto-detected */\n'
    '\t    --assertions { enable|disable|default }          /* Enables/disable assertion feature (setting qStroika_Foundation_Debug_AssertionsChecked) */\n'
    '\t    --block-allocation { enable|disable|default }    /* Enables/disable block-allocation (a feature that improves performance, but messes up valgrind) */\n'
    '\t    --valgrind { enable|disable|default }            /* Enables/disable valgrind-specific runtime code */\n'
    '\t    --GLIBCXX_DEBUG { enable|disable|default }       /* Enables/Disables GLIBCXX_DEBUG (G++-specific) */\n'
    '\t    --MACOSX_DEPLOYMENT_TARGET { #|default|none }    /* set MACOSX_DEPLOYMENT_TARGET (mac os min version) (macosx target specific) */\n'
    '\t    --cppstd-version {FLAG}                          /* Sets can be c++20, c++2a, c++2b, c++23 */\n'
    '\t    --stdlib {LIB}                                   /* libc++ (clang lib), libstdc++ (gcc and often clang) */\n'
    '\t    --ATLMFC {use-system|no}                         /* Enables/disables use of ATLMFC for this configuration [default use-system on windows, and no otherwise] */\n'
    '\t    --boost {build-only|use|use-system|no}           /* Enables/disables use of boost for this configuration [default use] */\n'
    '\t    --LibCurl {build-only|use|use-system|no}         /* Enables/disables use of LibCurl for this configuration [default TBD]*/\n'
    '\t    --OpenSSL {build-only|use|use-system|no}         /* Enables/disables use of OpenSSL for this configuration [default use] */\n'
    '\t    --OpenSSL-ExtraArgs { purify? }                  /* Optionally configure extra OpenSSL features (see Stroika/OpenSSL makefile) */\n'
    '\t    --lzma {build-only|use|use-system|no}            /* Enables/disables use of LZMA SDK for this configuration [default use] */\n'
    '\t    --mongo-cxx-driver {build-only|use|use-system|no}/* Enables/disables use of MongoCXX for this configuration [default use] */\n'
    '\t    --googletest {build-only|use|use-system|no}      /* Enables/disables use of google test framework for this configuration [default use] */\n'
    '\t    --sqlite {build-only|use|use-system|no}          /* Enables/disables use of sqlite for this configuration [default use] */\n'
    '\t    --StrawberryPerl {use|no}                        /* Enables/disables use of StrawberryPerl (Windows Only) - JUST USED TO BUILD OPENSSL for Windows*/\n'
    '\t    --WIX {use|use-system|no}                        /* Enables/disables use of WIX (Windows Only) - to build windows installers*/\n'
    '\t    --WinHTTP {use-system|no}                        /* Enables/disables use of WinHTTP for this configuration [default use-system on windows, and no otherwise] */\n'
    '\t    --Xerces {build-only|use|use-system|no}          /* Enables/disables use of Xerces for this configuration [default use] */\n'
    '\t    --libxml2 {build-only|use|use-system|no}         /* Enables/disables use of libxml2 for this configuration [default use] */\n'
    '\t    --ZLib {build-only|use|use-system|no}            /* Enables/disables use of ZLib for this configuration [default use] */\n'
    '\t    --zstd {build-only|use|use-system|no}            /* Enables/disables use of zstd for this configuration [default use] */\n'
    '\t    --all-available-third-party-components           /* equivilent to --Xerces (etc) use - for all that are available on this platform (except polyfill components like fmtlib) */\n'
    '\t    --default-third-party-components                 /* reset third party settings to their default value (maybe less than all-available-third-party-components) */\n'
    '\t    --no-third-party-components           \t\t\t /* equivilent to --StrawberryPerl no --LibCurl no ...  */\n'
    '\t    --trace2file { enable|disable|default }          /* Enables/disable trace2file feature */\n'
    '\t    --static-link-gccruntime { enable|disable }      /* Enables/disable gcc runtime static link (only applies if gcc family compiler) */\n'
    '\t    --make-define {ARG}                              /* Define makefile define for the given configuration: text of arg appears as line in Configuration.mk */\n'
    '\t    --compiler-driver {ARG}                          /* default is gcc */\n'
    '\t    --ar {ARG}                                       /* default is undefined, but if compiler-driver is gcc or g++, this is gcc-ar */\n'
    "\t    --as {ARG}                                       /* default is 'as' on unix, and retrieved from visual studio on visual studio */\n"
    '\t    --ranlib {ARG}                                   /* default is undefined, but if compiler-driver is gcc or g++, this is gcc-ranlib */\n'
    '\t    --strip {ARG}                                    /* sets program to do stripping; default is undefined, but for POSIX, defaults to strip */\n'
    '\t    --append-CFLAGS {ARG}                            /* Appends ARG to CFLAGS */\n'
    '\t    --remove-CFLAGS {ARG}                            /* Remove ARG from CFLAGS (including default added args; processed after all adds applied) */\n'
    '\t    --replace-all-CFLAGS {ARG}                       /* OVERRIDES DEFAULTS- and sets CFLAGS to just these values */\n'
    '\t    --append-CPPFLAGS {ARG}                          /* Appends ARG to CPPFLAGS; effectively defines for CFLAGS and CXXFLAGS, elg --append-CPPFLAGS -DA=B */\n'
    '\t    --remove-CPPFLAGS {ARG}                          /* Remove ARG from CPPFLAGS (including default added args; processed after all adds applied) */\n'
    '\t    --replace-all-CPPFLAGS {ARG}                     /* OVERRIDES DEFAULTS- and sets CPPFLAGS to just these values (the qStroika_ defines are kept) */\n'
    '\t    --append-CXXFLAGS {ARG}                          /* Appends ARG to CXXFLAGS */\n'
    '\t    --remove-CXXFLAGS {ARG}                          /* Remove ARG from CXXFLAGS (including default added args; processed after all adds applied) */\n'
    '\t    --replace-all-CXXFLAGS {ARG}                     /* OVERRIDES DEFAULTS- and sets CXXFLAGS to just these values */\n'
    '\t    --shared-symbol-visibility {ARG}                 /* alias for append-CFLAGS AND append-CXXFLAGS with -fvisibility=XXX (defaults to hidden on gcc/clang/unix compilers) */\n'
    "\t    --append-extra-prefix-linker-args {ARG}          /* Appends ARG to 'extra prefix linker args */\n"
    "\t    --append-extra-suffix-linker-args {ARG}          /* Appends ARG to 'extra suffix linker args */\n"
    "\t    --append-extra-compiler-and-linker-args {ARG}    /* Appends ARG to 'extra compiler' and 'extra linker' args */\n"
    '\t    --includes-path {ARG}                            /* Sets INCLUDES_PATH variable (: separated, since unix standard and allows spaces, ; separated on windows hosts) */\n'
    "\t    --append-includes-path {ARG}                     /* Appends ARG to 'INCLUDES_PATH */\n"
    "\t    --libs-path {ARG}                                /* Sets LinkerArgs_LibPath variable (':' separated, since unix standard and allows spaces; separated on windows hosts) */\n"
    "\t    --append-libs-path {ARG}                         /* Appends ARG to 'LinkerArgs_LibPath */\n"
    '\t    --lib-dependencies {ARG}                         /* Sets LinkerArgs_LibDependencies variable (space separated) */\n'
    "\t    --append-lib-dependencies {ARG}                  /* Appends ARG to 'LinkerArgs_LibDependencies */\n"
    "\t    --linktime-copy-files-2-EXEDir {ARG}             /* Sets LinkTime_CopyFilesToEXEDir variable (' ' separated) */\n"
    "\t    --append-linktime-copy-files-2-EXEDir {ARG}      /* Appends ARG to 'LinkTime_CopyFilesToEXEDir */\n"
    '\t    --run-prefix {ARG}                               /* Sets variable RunPrefix with stuff injected before run for built executables,\n'
    '\t                                                        such as LD_PRELOAD=/usr/lib/arm-linux-gnueabihf/libasan.so.3 */\n'
    '\t    --append-run-prefix {ARG}                        /* Appends ARG RunPrefix: with stuff injected before run for built executables */\n'
    '\t    --include-default-TSAN_OPTIONS {true/false}      /* if true, and tsan enabled, add TSAN_OPTIONS= guess to RunPrefix */\n'
    '\t    --pg {ARG}                                       /* Turn on -pg option (profile for UNIX/gcc platform) on linker/compiler */\n'
    '\t    --lto { enable|disable }                         /* Turn on link time code gen on linker/compiler (for now only gcc/unix stack) */\n'
    '\t    --cross-compiling {true|false}                   /* Defaults generally to false, but set explicitly to control if certain tests will be run */\n'
    '\t    --apply-default-debug-flags                      /*  */\n'
    '\t    --apply-default-release-flags                    /*  */\n'
    '\t    --only-if-has-compiler                           /* Only generate this configuration if the compiler appears to exist (test run)*/\n'
    '\t    --debug-symbols {true|false}                     /* --debug-symbols-lib AND --debug-symbols-exe at the same time */\n'
    '\t    --debug-symbols-lib {true|false}                 /* defaults to true, but can be disabled if makes compile/link/etc too big/slow */\n'
    '\t    --debug-symbols-exe {true|false}                 /* defaults to true, but can be disabled if makes compile/link/etc too big/slow */\n'
    '\t    --malloc-guard {true|false}                      /* defaults to false (for now experimental and only works with GCC) */\n'
    '\t    --runtime-stack-check {true|false}               /* gcc -fstack-protector-all */\n'
    '\t    --msvc-runtime-library {MultiThreaded|...} \t\t /* MSVC_RUNTIME_LIBRARY windows value - defaults to no-DLL and debug based on assertion flag - https://cmake.org/cmake/help/latest/prop_tgt/MSVC_RUNTIME_LIBRARY.html */\n'
    '\t    --sanitize {none|thread|address|undefined|leak}  /* if arg none, reset to none, else adds arg to sanitized feature (gcc/clang only) -\n'
    '\t                                                        any arg you can pass to -fsanitize=XXXX */\n'
    '\t                                                     /* see https://gcc.gnu.org/onlinedocs/gcc-6.1.0/gcc.pdf (search -fsanitize=; eg. --sanitize address,undefined */\n'
    '\t    --no-sanitize {thread|vptr|etc...}               /* any from --sanitize or all; option maybe used to remove a sub-category of tests (like vptr) from larger category like address */\n'
    '\n'
    "Configure's behavior is also influenced by the following environment variables:\n"
    '\t    CC, CXX, BuildPlatform, TargetPlatforms, ARCH, AS, AR, RANLIB, STRIP; these just simpulate adding the obvoius associated argument to configure\n'
    '\t    EXTRA_CONFIGURE_ARGS= a space separated list of arguments added to the beginning of the configure command\n'
)


def Main(argv):
    c = Configure(argv)
    try:
        fileName, text = c.Run()
    except PerlExit as e:
        return e.status
    except PerlDie as e:
        c.PrintErr(str(e) + ("" if str(e).endswith("\n") else "\n"))
        return 255
    if fileName is not None:
        with open(fileName, "wb") as f:
            f.write(text.encode(ENC))
        try:
            os.remove("IntermediateFiles/APPLIED_CONFIGURATIONS")
        except OSError:
            pass
    return 0


if __name__ == "__main__":
    sys.exit(Main(sys.argv[1:]))
