    '\t    --ZLib {build-only|use|use-system|no}            /* Enables/disables use of ZLib for this configuration [default use] */\n'
    '\t    --zstd {build-only|use|use-system|no}            /* Enables/disables use of zstd for this configuration [default use] */\n'
    '\t    --all-available-third-party-components           /* equivilent to --Xerces (etc) use - for all that are available on this platform (except polyfill components like fmtlib) */\n'
    '\t    --default-third-party-components                 /* reset third party settings to their default value (maybe less than all-available-third-party-components) */\n'
    '\t    --no-third-party-components           \t\t\t /* equivilent to --StrawberryPerl no --LibCurl no ...  */\n'
    '\t    --trace2file { enable|disable|default }          /* Enables/disable trace2file feature */\n'
    '\t    --static-link-gccruntime { enable|disable }      /* Enables/disable gcc runtime static link (only applies if gcc family compiler) */\n'
    '\t    --make-define {ARG}                              /* Define makefile define for the given configuration: text of arg appears as line in Configuration.mk */\n'
    '\t    --compiler-driver {ARG}                          /* default is gcc */\n'
    '\t    --ar {ARG}                                       /* default is undefined, but if compiler-driver is gcc or g++, this is gcc-ar */\n'
    "\t    --as {ARG}                                       /* default is 'as' on unix, and retrieved from visual studio on visual studio */\n"
    '\t    --ranlib {ARG}                                   /* default is undefined, but if compiler-driver is gcc or g++, this is gcc-ranlib */\n'
