#!/bin/sh
# (sh, then Python: python3 runs this file by a path it can open. A native Windows python3.exe cannot open a /c/... path -
# under MSYS2's make, which exports MSYS2_ARG_CONV_EXCL=*, it arrives unconverted - so it gets the C:/... form. Cygwin's and
# MSYS2's own python3 are POSIX programs, and take the path as it is: that is /usr/bin/python3, however PATH spells it
# (-ef: /cygdrive/c/cygwin/bin/python3 is the same file, and a POSIX python takes a C:/... path as relative). With no fork
# but the exec: this runs often. The bash-only expansions are in eval, so the sh of Linux (dash) never parses them)
''':'
case "$0:$OSTYPE" in /*:msys* | /*:cygwin*)
	hash python3 2> /dev/null; eval 'p=${BASH_CMDS[python3]}'
	if [ -n "$p" ] && ! [ "$p" -ef /usr/bin/python3 ]; then
		case "$0" in /[A-Za-z]/*) eval 'd=${0:1:1}; exec python3 "${d^^}:${0:2}" "$@"' ;; esac
		exec python3 "$(cygpath -m "$0")" "$@"
	fi ;;
esac
exec python3 "$0" "$@"
'''
#
#   configure CONFIGURATION-NAME [OPTIONS]*         (configure --help lists the options)
#
#   Writes ConfigurationFiles/CONFIGURATION-NAME.xml: the named configuration - compilers, flags, third-party components
#   - with the command line that made it, so 'make reconfigure' can re-run it. Run from the top of the Stroika tree.
#
#   A port of the Perl configure (configure.pl, through Stroika v3.0d25).
#
#   @todo   Consider adding output variables CFLAGS_ADDITIONS, CXXFLAGS_ADDITIONS, CFLAGS_REMOVEALS, CXXFLAGS_REMOVEALS
#   @todo   Consider adding support for ASFLAGS (like CFLAGS)
#
import glob
import os
import re
import shlex
import subprocess
import sys
import tempfile

ENC = "latin-1"  # bytes in, the same bytes out - as the Perl reads and writes them

# Perl's true and false, as they print - 1 and 0
true = 1
false = 0
DEFAULT_BOOL_OPTIONS = -1

#
# BUILD iff LIBFEATUREFLAG_BuildOnly OR LIBFEATUREFLAG_UseStaticTPP
# HAS_FEATURE iff LIBFEATUREFLAG_UseStaticTPP OR LIBFEATUREFLAG_UseSystem
#
LIBFEATUREFLAG_BuildOnly = "build-only"
LIBFEATUREFLAG_UseStaticTPP = "use"
LIBFEATUREFLAG_UseSystem = "use-system"
LIBFEATUREFLAG_No = "no"


class PerlDie(Exception):
    """Perl's die: the message goes to stderr, and the exit status is 255"""


class PerlExit(Exception):
    def __init__(self, status):
        Exception.__init__(self, status)
        self.status = status


def Die(msg):
    raise PerlDie(msg)


def S(v):
    """A value in a Perl string context: undef is ""; a number prints as Perl prints it"""
    if v is None:
        return ""
    if isinstance(v, bool):
        return "1" if v else ""
    if isinstance(v, float):
        return str(int(v)) if v.is_integer() and abs(v) < 1e15 else "%.15g" % v
    return str(v)


def XMLText(v):
    """v (as S () gives it), escaped as an XML element's text"""
    return S(v).replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")


def XMLComment(v):
    """v (as S () gives it), as the text of an XML comment - which cannot hold '--', nor end with '-'"""
    s = S(v).replace("--", "- -")
    return s + " " if s.endswith("-") else s


_NUM_RE = re.compile(r"[ \t\n\r\f\v]*([+-]?(?:\d+(?:\.\d*)?|\.\d+)(?:[eE][+-]?\d+)?)")


def N(v):
    """A value in a Perl numeric context: a string's leading number, else 0"""
    if v is None:
        return 0
    if isinstance(v, (bool, int, float)):
        return v
    m = _NUM_RE.match(v)
    if not m:
        return 0
    t = m.group(1)
    return float(t) if any(c in t for c in ".eE") else int(t)


def Trim(s):
    if s is None:
        return None
    return s.strip(" \t\n\r\f\v")  # Perl's \s - not str.strip ()'s wider whitespace


def PerlSplit(sep, s):
    """Perl's split /SEP/ on a one-character literal separator: empty input gives nothing; trailing empty fields go"""
    if s is None or s == "":
        return []
    parts = s.split(sep)
    while parts and parts[-1] == "":
        parts.pop()
    return parts


def PerlOS():
    """What Perl's $^O says on this host: on Windows "cygwin" - MSYS2's perl says so too, not "msys" """
    if sys.platform in ("win32", "msys") or sys.platform.startswith("cygwin"):
        return "cygwin"
    return sys.platform  # 'linux', 'darwin', ...


PERL_OS = PerlOS()
IS_WINDOWS_HOST = PERL_OS in ("cygwin", "msys")


def Env(name):
    """$ENV{name}: case-sensitive, as Perl's is - a native Windows Python's os.environ upper-cases every name"""
    if sys.platform == "win32":
        import nt
        return nt.environ.get(name)
    return os.environ.get(name)


def ChildEnv(drop=()):
    """The environment, with its names' case kept (see Env), less the names in drop, for a child process"""
    if sys.platform == "win32":
        import nt
        env = dict(nt.environ)
        for k, v in os.environ.items():  # what this process has set since it started
            if not any(k == e.upper() for e in env):
                env[k] = v
    else:
        env = dict(os.environ)
    for d in drop:
        env.pop(d, None)
    return env


def ToPosixPathForTest(p):
    """A POSIX path (/c/..., /usr/...), as a native Windows Python must spell it to look at the file"""
    if sys.platform == "win32" and p.startswith("/"):
        r = subprocess.run(["cygpath", "--mixed", p], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        return Trim(r.stdout.decode(ENC))
    return p


def PerlExists(p):
    """Perl's -e"""
    return p is not None and p != "" and os.path.exists(ToPosixPathForTest(p))


def PerlGlob(pattern):
    """
    Perl's glob/bsd_glob of a POSIX path pattern: the matches, in GLOB_ALPHASORT order (case folded first), each spelled
    as the pattern spells its directories. A native Windows Python globs the C:/ form of the pattern, and gives back that.
    """
    native = pattern
    if sys.platform == "win32":
        # only the part before the first wildcard goes through cygpath, which would make a * a private-use character
        parts = pattern.split("/")
        k = next((i for i, p in enumerate(parts) if any(ch in p for ch in "*?[")), len(parts))
        rest = "/".join(parts[k:])
        native = ToPosixPathForTest("/".join(parts[:k]) or "/").rstrip("/") + ("/" + rest if rest else "")
    results = glob.glob(native)
    if sys.platform == "win32":
        results = [r.replace("\\", "/") for r in results]
    return sorted(results, key=lambda r: (r.lower(), r))


