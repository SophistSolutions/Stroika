#!/usr/bin/python3
#
#   configure CONFIGURATION-NAME [OPTIONS]*         (configure --help lists the options)
#
#   Writes ConfigurationFiles/CONFIGURATION-NAME.xml: the named configuration - compilers, flags, third-party components
#   - with the command line that made it, so 'make reconfigure' can re-run it. Run from the top of the Stroika tree.
#
#   A port of the Perl configure (configure.pl, through Stroika v3.0d25).
#
#   @todo   Consider adding output variables CFLAGS_ADDITIONS, CXXFLAGS_ADDITIONS, CFLAGS_REMOVEALS, CXXFLAGS_REMOVEALS
#   @todo   Consider adding support for ASFLAGS (like CFLAGS)
#
import glob
import os
import re
import shlex
import subprocess
import sys
import tempfile

# Text in and out is UTF-8, and a byte that is not stays as it is: what was given (on the command line, or by a tool run here)
# reaches the configuration file unchanged
ENCODING_ = "utf-8"
ENCODING_ERRORS_ = "surrogateescape"

#
# BUILD iff LIBFEATUREFLAG_BuildOnly_ OR LIBFEATUREFLAG_UseStaticTPP_
# HAS_FEATURE iff LIBFEATUREFLAG_UseStaticTPP_ OR LIBFEATUREFLAG_UseSystem_
#
LIBFEATUREFLAG_BuildOnly_ = "build-only"
LIBFEATUREFLAG_UseStaticTPP_ = "use"
LIBFEATUREFLAG_UseSystem_ = "use-system"
LIBFEATUREFLAG_No_ = "no"

if sys.platform == "win32":  # (run as python3 configure, say - the #! line names a POSIX one)
    sys.exit("configure needs a POSIX python3 - on Windows, MSYS2's (pacman -S python) or Cygwin's - not a native Windows one")
IS_WINDOWS_HOST_ = sys.platform == "msys" or sys.platform.startswith("cygwin")  # MSYS2's or Cygwin's python
IS_LINUX_HOST_ = sys.platform.startswith("linux")
IS_MACOS_HOST_ = sys.platform == "darwin"


class ConfigureError_(Exception):
    """configure fails: the message goes to stderr, and the exit status is 1"""


class Exit_(Exception):
    """configure stops, with this exit status - after --help, say"""

    def __init__(self, status):
        Exception.__init__(self, status)
        self.status = status


def Die_(msg):
    raise ConfigureError_(msg)


def Decode_(b):
    return b.decode(ENCODING_, ENCODING_ERRORS_)


def XMLText_(v):
    """v as the configuration file writes it - None as nothing, a bool as 1 or 0 - escaped as an XML element's text"""
    s = "" if v is None else ("1" if v else "0") if isinstance(v, bool) else str(v)
    return s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")


def XMLComment_(s):
    """s as the text of an XML comment - which cannot hold '--', nor end with '-'"""
    s = s.replace("--", "- -")
    return s + " " if s.endswith("-") else s


def Bit_(b):
    """b - True, False or None (unset, so off) - as a define's 1 or 0"""
    return "1" if b else "0"


def SplitList_(s, sep):
    """s, a sep-separated list, as a list - its empty items dropped"""
    return [i for i in s.split(sep) if i != ""]


def PathExists_(p):
    return p is not None and p != "" and os.path.exists(p)


def Glob_(pattern):
    """The matches of the path pattern, sorted case-insensitively"""
    return sorted(glob.glob(pattern), key=lambda r: (r.lower(), r))


