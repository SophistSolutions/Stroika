    '\t    --apply-default-debug-flags                      /*  */\n'
    '\t    --apply-default-release-flags                    /*  */\n'
    '\t    --only-if-has-compiler                           /* Only generate this configuration if the compiler appears to exist (test run)*/\n'
    '\t    --debug-symbols {true|false}                     /* --debug-symbols-lib AND --debug-symbols-exe at the same time */\n'
    '\t    --debug-symbols-lib {true|false}                 /* defaults to true, but can be disabled if makes compile/link/etc too big/slow */\n'
    '\t    --debug-symbols-exe {true|false}                 /* defaults to true, but can be disabled if makes compile/link/etc too big/slow */\n'
    '\t    --malloc-guard {true|false}                      /* defaults to false (for now experimental and only works with GCC) */\n'
    '\t    --runtime-stack-check {true|false}               /* gcc -fstack-protector-all */\n'
    '\t    --msvc-runtime-library {MultiThreaded|...} \t\t /* MSVC_RUNTIME_LIBRARY windows value - defaults to no-DLL and debug based on assertion flag - https://cmake.org/cmake/help/latest/prop_tgt/MSVC_RUNTIME_LIBRARY.html */\n'
    '\t    --sanitize {none|thread|address|undefined|leak}  /* if arg none, reset to none, else adds arg to sanitized feature (gcc/clang only) -\n'
    '\t                                                        any arg you can pass to -fsanitize=XXXX */\n'
    '\t                                                     /* see https://gcc.gnu.org/onlinedocs/gcc-6.1.0/gcc.pdf (search -fsanitize=; eg. --sanitize address,undefined */\n'
    '\t    --no-sanitize {thread|vptr|etc...}               /* any from --sanitize or all; option maybe used to remove a sub-category of tests (like vptr) from larger category like address */\n'
    '\n'
    "Configure's behavior is also influenced by the following environment variables:\n"
    '\t    CC, CXX, BuildPlatform, TargetPlatforms, ARCH, AS, AR, RANLIB, STRIP; these just simpulate adding the obvoius associated argument to configure\n'
    '\t    EXTRA_CONFIGURE_ARGS= a space separated list of arguments added to the beginning of the configure command\n'
)


def RunPython(argv):
    """
    The Python's result: (exitStatus, stdout, stderr, fileName, fileBytes, log) - fileName None if it writes no file, and
    log what it printed, in order, as [(1 or 2, bytes)]
    """
    c = Configure(argv)
    fileName = text = None
    try:
        fileName, text = c.Run()
        status = 0
    except PerlExit as e:
        status = e.status
    except PartialWrite as e:
        c.PrintErr(str(e) + "\n")
        fileName, text = e.fileName, e.text
        status = 255
    except PerlDie as e:
        c.PrintErr(str(e) + ("" if str(e).endswith("\n") else "\n"))
        status = 255
    log = [(fd, s.encode(ENC)) for fd, s in c.log]
    return (status, b"".join(s for fd, s in log if fd == 1), b"".join(s for fd, s in log if fd == 2), fileName,
            None if text is None else text.encode(ENC), log)


_PERL_AT_LINE = rb" at .+?\.pl line \d+(?:, <[^>]*> (?:line|chunk) \d+)?\.\n"
_PERL_WARNING = re.compile(rb"^(?:Use of uninitialized value|Argument \".*\" isn't numeric|substr outside of string|"
                           rb"splice\(\) offset past end of array|Can't exec \").*" + _PERL_AT_LINE, re.M)


def NormalizePerlStderr(b):
    """
    The Perl's stderr, as the Python writes it: without the Perl's own warnings (use warnings' 'Use of uninitialized
    value' and the like, which the Python has no reason to say), and without the ' at FILE line N.' Perl's die adds to a
    message with no newline
    """
    return re.sub(_PERL_AT_LINE, b"\n", _PERL_WARNING.sub(b"", b))


def Main(argv):
    perlCheckWanted = PerlCheck.PerlCheckWanted()
    try:
        py = RunPython(argv)
        pyFailure = None
    except CannotMatchPerl as e:
        py, pyFailure = None, str(e)
    except Exception as e:  # a bug in the port must not stop the build while the Perl is there to fall back on
        if not perlCheckWanted:
            raise
        py, pyFailure = None, "%s: %s" % (type(e).__name__, e)

    perl = None
    if py is None or perlCheckWanted:
        fd, perlOut = tempfile.mkstemp(prefix="stroika-perl-check-", suffix=".xml")
        os.close(fd)
        os.unlink(perlOut)
        try:
            env = ChildEnv()
            env[PERL_CHECK_OUTPUT_ENV] = perlOut
            perlScript = PerlCheck.PerlPath(os.path.join(THIS_DIR, "configure.pl"))
            p = subprocess.run(["perl", perlScript] + list(argv), stdout=subprocess.PIPE,
                               stderr=subprocess.PIPE, env=env)
            fileBytes = None
            if os.path.exists(perlOut):
                with open(perlOut, "rb") as f:
                    fileBytes = f.read()
            # with the file the Perl would have written: ConfigurationFiles/NAME.xml
            perl = (p.returncode, p.stdout, p.stderr, "ConfigurationFiles/" + argv[0] + ".xml" if argv else None, fileBytes,
                    [(1, p.stdout), (2, p.stderr)])
        finally:
            if os.path.exists(perlOut):
                os.unlink(perlOut)
        if py is None:
            PerlCheck.Decline("configure", argv[0] if argv else "", pyFailure)

    result = py if py is not None else perl
    if perl is not None and py is not None:
        label = argv[0] if argv else "-"
        # Perl's die exits with errno when that is not 0 (25, say, left by opening a file), else 255: the same failure
        perlStatus = py[0] if (py[0] == 255 and perl[0] != 0 and NormalizePerlStderr(perl[2]) == py[2]) else perl[0]
        perlComparable = (perlStatus, perl[1], NormalizePerlStderr(perl[2]), perl[4])
        pyComparable = (py[0], py[1], py[2], py[4])
        if perlComparable != pyComparable:
            parts = (("exit status", str(py[0]).encode(), str(perlStatus).encode()), ("stdout", py[1], perl[1]),
                     ("stderr", py[2], perlComparable[2]), (S(py[3]) or "file", py[4] or b"", perl[4] or b""))
            for what, a, b in parts:
                if a != b:
                    PerlCheck.Choose("configure", what, label, a, b)
            result = perl

    status, out, err, fileName, fileBytes, log = result
    if fileName is not None and fileBytes is not None:
        with open(fileName, "wb") as f:
            f.write(fileBytes)
        if status == 0:
            try:
                os.remove("IntermediateFiles/APPLIED_CONFIGURATIONS")
            except OSError:
                pass
    for fd, s in log:  # in the order printed, so a terminal shows it as it would the Perl's
        stream = sys.stdout if fd == 1 else sys.stderr
        stream.buffer.write(s)
        stream.flush()
    return status


if __name__ == "__main__":
    sys.exit(Main(sys.argv[1:]))
