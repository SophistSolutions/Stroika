#!/bin/bash
#
# Create the (many) configurations used for regression testing - a much wider matrix of compilers,
# standard library versions, sanitizers etc than 'MakeDefaultConfigurations' produces.
#
# Invoked by 'make regression-test-configurations'. Kept as a script rather than inline makefile
# recipes because the configure lines are long and heavily conditional, and were nearly unreadable
# as one backslash-continued shell blob inside a makefile.
#
# WARNING: this DELETES all existing configurations (ConfigurationFiles/*) first - by design, so the
#          regression test matrix is exactly what is defined here and nothing left over.
#
# Environment:
#	EXTRA_CONFIGURE_ARGS		extra args for every configure line here (read by configure itself,
#					out of the environment). This script prepends
#					--all-available-third-party-components to it, so whatever the caller
#					passes still wins - configure parses left to right, last one wins
#	MAKE_INDENT_LEVEL		indentation level for progress output (default 0)
#	DETECTED_HOST_OS		override host-OS detection (Cygwin|MSYS|Darwin|Linux|...)
#
# One configuration failing does not abandon the rest of the matrix.
#

MY_DIR_="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
StroikaRoot_="$(cd -P "${MY_DIR_}/../.." && pwd)"

DETECTED_HOST_OS="${DETECTED_HOST_OS:-$("${MY_DIR_}/DetectedHostOS")}"
MAKE_INDENT_LEVEL="${MAKE_INDENT_LEVEL:-0}"

#
# Regression testing wants the widest third-party coverage, so make that the baseline for every
# configuration below, with anything the caller passed in kept after it (so the caller wins).
#
#	configure splices EXTRA_CONFIGURE_ARGS in just after the configuration name - i.e. BEFORE the flags
#	on the line - and parses left to right, last one wins. So this is a default each configuration can
#	override, which is what we want: the no-third-party-components and
#	only-zlib-system-third-party-component configurations below say --no-third-party-components
#	explicitly, and that correctly beats this.
#
export EXTRA_CONFIGURE_ARGS="--all-available-third-party-components ${EXTRA_CONFIGURE_ARGS:-}"

cd "$StroikaRoot_"


basicUnixTestConfigurations_ ()
{
	export MAKE_INDENT_LEVEL=$((MAKE_INDENT_LEVEL + 1))

	# Note as of 2023-12-02, it appears memory sanitizer only works with clang++ (not gcc), and even that major
	# PITA to use - see https://github.com/google/sanitizers/wiki/MemorySanitizerLibcxxHowTo - must rebuild own libc++ specailly.
	# Note they do provide a dockerfile with all this setup, but still ... Not worth the trouble... --LGP 2023-12-02

	case "$(lsb_release -rs 2>/dev/null)" in
	22.04)
		./configure DEFAULT_CONFIG --config-tag Unix --only-if-has-compiler
		./configure no-third-party-components --config-tag Unix --only-if-has-compiler --no-third-party-components
		./configure only-zlib-system-third-party-component --config-tag Unix --only-if-has-compiler --no-third-party-components --zlib use-system
		# g++-11
		./configure g++-11-debug --config-tag Unix --compiler-driver g++-11 --apply-default-debug-flags --only-if-has-compiler --trace2file enable --cppstd-version c++20
		./configure g++-11-release++2b --config-tag Unix --compiler-driver g++-11 --apply-default-release-flags --only-if-has-compiler --trace2file enable --cppstd-version c++2b
		# g++-12
		./configure g++-12-debug --config-tag Unix --compiler-driver g++-12 --apply-default-debug-flags --only-if-has-compiler --trace2file enable --cppstd-version c++20
		./configure g++-12-release++2b --config-tag Unix --compiler-driver g++-12 --apply-default-release-flags --only-if-has-compiler --trace2file enable --cppstd-version c++2b
		# g++-13
		./configure g++-13-debug --config-tag Unix --compiler-driver g++-13 --apply-default-debug-flags --only-if-has-compiler --trace2file enable --cppstd-version c++20
		./configure g++-13-release++2b --config-tag Unix --compiler-driver g++-13 --apply-default-release-flags --only-if-has-compiler --trace2file enable --cppstd-version c++2b
		# clang-15
		./configure clang++-15-debug-libc++ --config-tag Unix --compiler-driver clang++-15 --apply-default-debug-flags --stdlib libc++ --only-if-has-compiler
		./configure clang++-15-release-libstdc++ --config-tag Unix --compiler-driver clang++-15 --apply-default-release-flags --stdlib libstdc++ --only-if-has-compiler --trace2file enable
		# - ASAN appears to work very sporadically (crashing about 1/2 the time)
		# 		Builds/g++-debug-sanitize_undefined_leak/Tests/Test44 --gtest_brief -- Segmentation fault (core dumped)
		# - LEAK sanitizer fails to build libcurl under Ubuntu 22.04, so disable that;
		# NO TSAN on Ubuntu 22.04 due to qCompiler_SanitizerDoubleLockWithConditionVariables_Buggy
		./configure g++-debug-sanitize_undefined   --config-tag Unix --only-if-has-compiler --apply-default-debug-flags --sanitize none,undefined --trace2file enable
		./configure g++-release-sanitize_undefined --config-tag Unix --only-if-has-compiler --apply-default-release-flags --sanitize none,undefined --trace2file enable
		# VALGRIND - some tests fail inside valgrind code - looks like bug there - don't bother for now...LGP 2024-08-24
		#			verified 2024-09-17 - at least two core dumps not apparently related to my code - two modules when we run tests
		#       ./configure valgrind-release-SSLPurify-NoBlockAlloc --only-if-has-compiler --config-tag Unix --config-tag valgrind --valgrind enable --openssl use --openssl-extraargs purify --apply-default-release-flags --trace2file disable --block-allocation disable
		;;

	24.04)
		./configure DEFAULT_CONFIG --config-tag Unix --only-if-has-compiler
		./configure no-third-party-components --config-tag Unix --only-if-has-compiler --no-third-party-components
		./configure only-zlib-system-third-party-component --config-tag Unix --only-if-has-compiler --no-third-party-components --zlib use-system
		# g++-12
		./configure g++-12-debug --config-tag Unix --compiler-driver g++-12 --apply-default-debug-flags --only-if-has-compiler --trace2file enable --cppstd-version c++20
		./configure g++-12-release++2b --config-tag Unix --compiler-driver g++-12 --apply-default-release-flags --only-if-has-compiler --trace2file enable --cppstd-version c++2b
		# g++-13
		./configure g++-13-debug --config-tag Unix --compiler-driver g++-13 --apply-default-debug-flags --only-if-has-compiler --trace2file enable --cppstd-version c++20
		./configure g++-13-release++2b --config-tag Unix --compiler-driver g++-13 --apply-default-release-flags --only-if-has-compiler --trace2file enable --cppstd-version c++2b
		# g++-14
		./configure g++-14-debug --config-tag Unix --compiler-driver g++-14 --apply-default-debug-flags --only-if-has-compiler --trace2file enable --cppstd-version c++20
		./configure g++-14-release++23 --config-tag Unix --compiler-driver g++-14 --apply-default-release-flags --only-if-has-compiler --trace2file enable --cppstd-version c++23
		# clang-16
		./configure clang++-16-debug-libc++ --config-tag Unix --compiler-driver clang++-16 --apply-default-debug-flags --stdlib libc++ --only-if-has-compiler
		./configure clang++-16-release-libstdc++ --config-tag Unix --compiler-driver clang++-16 --apply-default-release-flags --stdlib libstdc++ --only-if-has-compiler --trace2file enable
		./configure clang++-16-debug-libstdc++-c++23 --config-tag Unix --compiler-driver clang++-16 --apply-default-debug-flags --stdlib libstdc++ --only-if-has-compiler --cppstd-version c++2b
		./configure clang++-16-release-libc++23 --config-tag Unix --compiler-driver clang++-16 --apply-default-release-flags --stdlib libc++ --only-if-has-compiler --trace2file enable --cppstd-version c++2b
		# clang-17
		./configure clang++-17-debug-libc++ --config-tag Unix --compiler-driver clang++-17 --apply-default-debug-flags --stdlib libc++ --only-if-has-compiler
		./configure clang++-17-release-libstdc++ --config-tag Unix --compiler-driver clang++-17 --apply-default-release-flags --stdlib libstdc++ --only-if-has-compiler --trace2file enable
		./configure clang++-17-debug-libstdc++-c++23 --config-tag Unix --compiler-driver clang++-17 --apply-default-debug-flags --stdlib libstdc++ --only-if-has-compiler --cppstd-version c++23
		./configure clang++-17-release-libc++23 --config-tag Unix --compiler-driver clang++-17 --apply-default-release-flags --stdlib libc++ --only-if-has-compiler --trace2file enable --cppstd-version c++23
		# clang-18
		./configure clang++-18-debug-libc++ --config-tag Unix --compiler-driver clang++-18 --apply-default-debug-flags --stdlib libc++ --only-if-has-compiler
		./configure clang++-18-release-libstdc++ --config-tag Unix --compiler-driver clang++-18 --apply-default-release-flags --stdlib libstdc++ --only-if-has-compiler --trace2file enable
		./configure clang++-18-debug-libstdc++-c++23 --config-tag Unix --compiler-driver clang++-18 --apply-default-debug-flags --stdlib libstdc++ --only-if-has-compiler --cppstd-version c++23
		./configure clang++-18-release-libc++23 --config-tag Unix --compiler-driver clang++-18 --apply-default-release-flags --stdlib libc++ --only-if-has-compiler --trace2file enable --cppstd-version c++23
		# Sanitizers
		# 	nb: TSAN and ASAN don't mix well
		./configure g++-debug-sanitize_address_undefined_leak   --config-tag Unix --only-if-has-compiler --apply-default-debug-flags --sanitize none,address,undefined,leak --trace2file enable
		./configure g++-debug-sanitize_thread                   --config-tag Unix --only-if-has-compiler --apply-default-debug-flags --trace2file enable --cppstd-version c++20 --sanitize none,thread
		./configure g++-release-sanitize_address_undefined_leak --config-tag Unix --only-if-has-compiler --apply-default-release-flags --sanitize none,address,undefined,leak --trace2file enable
		./configure g++-release-sanitize_thread                 --config-tag Unix --only-if-has-compiler --apply-default-release-flags --trace2file enable --cppstd-version c++20 --sanitize none,thread
		# VALGRIND
		./configure valgrind-release-SSLPurify-NoBlockAlloc --only-if-has-compiler --config-tag Unix --config-tag valgrind --valgrind enable --openssl use --openssl-extraargs purify --apply-default-release-flags --trace2file disable --block-allocation disable
		;;

	26.04)
		./configure DEFAULT_CONFIG --config-tag Unix --only-if-has-compiler
		./configure no-third-party-components --config-tag Unix --only-if-has-compiler --no-third-party-components
		./configure only-zlib-system-third-party-component --config-tag Unix --only-if-has-compiler --no-third-party-components --zlib use-system
		# clang
		./configure clang++-debug --config-tag Unix --compiler-driver clang++ --apply-default-debug-flags --only-if-has-compiler
		./configure clang++-release --config-tag Unix --compiler-driver clang++ --apply-default-release-flags --only-if-has-compiler
		# clang-18
		./configure clang++-18-debug-libc++ --config-tag Unix --compiler-driver clang++-18 --apply-default-debug-flags --stdlib libc++ --only-if-has-compiler
		./configure clang++-18-release-libstdc++ --config-tag Unix --compiler-driver clang++-18 --apply-default-release-flags --stdlib libstdc++ --only-if-has-compiler --trace2file enable
		./configure clang++-18-debug-libstdc++-c++23 --config-tag Unix --compiler-driver clang++-18 --apply-default-debug-flags --stdlib libstdc++ --only-if-has-compiler --cppstd-version c++23
		./configure clang++-18-release-libc++23 --config-tag Unix --compiler-driver clang++-18 --apply-default-release-flags --stdlib libc++ --only-if-has-compiler --trace2file enable --cppstd-version c++23
		# g++-12
		./configure g++-12-debug --config-tag Unix --compiler-driver g++-12 --apply-default-debug-flags --only-if-has-compiler
		./configure g++-12-release --config-tag Unix --compiler-driver g++-12 --apply-default-release-flags --only-if-has-compiler
		# g++-13
		./configure g++-13-debug --config-tag Unix --compiler-driver g++-13 --apply-default-debug-flags --only-if-has-compiler
		./configure g++-13-release --config-tag Unix --compiler-driver g++-13 --apply-default-release-flags --only-if-has-compiler
		# g++-14
		./configure g++-14-debug --config-tag Unix --compiler-driver g++-14 --apply-default-debug-flags --only-if-has-compiler
		./configure g++-14-release --config-tag Unix --compiler-driver g++-14 --apply-default-release-flags --only-if-has-compiler
		# g++-15
		./configure g++-15-debug --config-tag Unix --compiler-driver g++-15 --apply-default-debug-flags --only-if-has-compiler
		./configure g++-15-release --config-tag Unix --compiler-driver g++-15 --apply-default-release-flags --only-if-has-compiler
		# g++-16
		./configure g++-16-debug --config-tag Unix --compiler-driver g++-16 --apply-default-debug-flags --only-if-has-compiler
		./configure g++-16-release --config-tag Unix --compiler-driver g++-16 --apply-default-release-flags --only-if-has-compiler
		;;

	*)
		"${MY_DIR_}/MakeDefaultConfigurations"
		./configure DEFAULT_CONFIG --config-tag Unix --only-if-has-compiler
		./configure no-third-party-components --config-tag Unix --only-if-has-compiler --no-third-party-components
		./configure only-zlib-system-third-party-component --config-tag Unix --only-if-has-compiler --no-third-party-components --zlib use-system
		./configure g++-release++2b --config-tag Unix --compiler-driver g++ --apply-default-release-flags --only-if-has-compiler --trace2file enable --cppstd-version c++2b
		./configure clang++-debug --config-tag Unix --compiler-driver clang++ --apply-default-debug-flags --only-if-has-compiler
		./configure clang++-release --config-tag Unix --compiler-driver clang++ --apply-default-release-flags --only-if-has-compiler
		./configure g++-15-debug --config-tag Unix --compiler-driver g++-15 --apply-default-debug-flags --only-if-has-compiler
		./configure g++-15-release --config-tag Unix --compiler-driver g++-15 --apply-default-release-flags --only-if-has-compiler
		./configure g++-16-debug --config-tag Unix --compiler-driver g++-16 --apply-default-debug-flags --only-if-has-compiler
		./configure g++-16-release --config-tag Unix --compiler-driver g++-16 --apply-default-release-flags --only-if-has-compiler
		;;
	esac
}


raspberryPiCrossCompileTestConfigurations_ ()
{

	"${MY_DIR_}/PrintProgressLine" "${MAKE_INDENT_LEVEL}" "Making raspberrypi-cross-compile-test-configurations:"
	export MAKE_INDENT_LEVEL=$((MAKE_INDENT_LEVEL + 1))

	# gcc-11 ARM raspberrypi compiler
	./configure raspberrypi-g++-11-release --config-tag Unix --config-tag raspberrypi --apply-default-release-flags --only-if-has-compiler  --compiler-driver 'arm-linux-gnueabihf-g++-11' --cross-compiling true
	# DUE TO qCompilerAndStdLib_arm_asan_FaultStackUseAfterScope_Buggy, omit raspberrypi-g++-11-release-sanitize_address since
	# various attempts at supressions failed, and the suppressions DO work for g++-12 (and other cases work) - and appears to just be old compiler bug with asan stuff --LGP 2023-12-16
	#### ./configure raspberrypi-g++-11-release-sanitize_address --config-tag Unix --config-tag raspberrypi --apply-default-release-flags --only-if-has-compiler --trace2file enable --compiler-driver 'arm-linux-gnueabihf-g++-11' --sanitize none,address --cross-compiling true
	#### NOTE --append-CXXFLAGS -fno-sanitize=alignment for https://stroika.atlassian.net/browse/STK-1023 (no-sanitize=alignment no longer sufficient in g++-11 raspberry pi - not sure why
	# ./configure raspberrypi-g++-11-debug-sanitize_undefined --config-tag Unix --config-tag raspberrypi --apply-default-debug-flags --only-if-has-compiler --trace2file enable --sanitize none,undefined --append-CXXFLAGS -fno-sanitize=alignment --compiler-driver 'arm-linux-gnueabihf-g++-11' --cross-compiling true
	#
	# gcc-12 ARM raspberrypi compiler
	#### NOTE --append-CXXFLAGS -fno-sanitize=alignment for https://stroika.atlassian.net/browse/STK-1023
	./configure raspberrypi-g++-12-release --config-tag Unix --config-tag raspberrypi --apply-default-release-flags --only-if-has-compiler  --compiler-driver 'arm-linux-gnueabihf-g++-12' --cross-compiling true
	./configure raspberrypi-g++-12-release-sanitize_address --config-tag Unix --config-tag raspberrypi --apply-default-release-flags --only-if-has-compiler --trace2file enable --compiler-driver 'arm-linux-gnueabihf-g++-12' --sanitize none,address --cross-compiling true
	#### NOTE --append-CXXFLAGS -fno-sanitize=alignment for https://stroika.atlassian.net/browse/STK-1023 (no-sanitize=alignment no longer sufficient in g++-12 raspberry pi - not sure why
	# ./configure raspberrypi-g++-12-debug-sanitize_undefined --config-tag Unix --config-tag raspberrypi --apply-default-debug-flags --only-if-has-compiler --trace2file enable --sanitize none,undefined --append-CXXFLAGS -fno-sanitize=alignment --compiler-driver 'arm-linux-gnueabihf-g++-12' --cross-compiling true
	#
	# gcc-13 ARM raspberrypi compiler
	#### NOTE --append-CXXFLAGS -fno-sanitize=alignment for https://stroika.atlassian.net/browse/STK-1023
	#### NOTE to get this working on current raspbi/debian - see https://stroika.atlassian.net/browse/STK-1022
	./configure raspberrypi-g++-13-release --config-tag Unix --config-tag raspberrypi --apply-default-release-flags --only-if-has-compiler  --compiler-driver 'arm-linux-gnueabihf-g++-13' --cross-compiling true
	./configure raspberrypi-g++-13-release-sanitize_address --config-tag Unix --config-tag raspberrypi --apply-default-release-flags --only-if-has-compiler --trace2file enable --compiler-driver 'arm-linux-gnueabihf-g++-13' --sanitize none,address --cross-compiling true
	./configure raspberrypi-g++-13-debug-sanitize_undefined --config-tag Unix --config-tag raspberrypi --apply-default-debug-flags --only-if-has-compiler --trace2file enable --sanitize none,undefined --append-CXXFLAGS -fno-sanitize=alignment --compiler-driver 'arm-linux-gnueabihf-g++-13' --cross-compiling true
}


#
# Which subset to make. The default (no argument) is the whole matrix for this host, and is the only
# mode that first deletes the existing configurations. The two --*-only modes exist because
# Build/Scripts/RegressionTests can be pointed at an individual set via
# BUILD_CONFIGURATIONS_MAKEFILE_TARGET (see Documentation/Regression-Tests.md).
#
case "${1:-}" in
	'')
		"${MY_DIR_}/PrintProgressLine" "${MAKE_INDENT_LEVEL}" "Making regression-test-configurations:"
		rm -f ConfigurationFiles/*
		# the configure lines below report at one level deeper than our own heading
		export MAKE_INDENT_LEVEL=$((MAKE_INDENT_LEVEL + 1))
		case "$DETECTED_HOST_OS" in
			MSYS | Cygwin)
				"${MY_DIR_}/MakeDefaultConfigurations"
				;;
			*)
				# each in a subshell, so the MAKE_INDENT_LEVEL each bumps for its own
				# configure lines does not leak into the next
				(basicUnixTestConfigurations_)
				(raspberryPiCrossCompileTestConfigurations_)
				;;
		esac
		;;
	--basic-unix-only)
		basicUnixTestConfigurations_
		;;
	--raspberrypi-only)
		raspberryPiCrossCompileTestConfigurations_
		;;
	*)
		echo "usage: MakeRegressionTestConfigurations [--basic-unix-only | --raspberrypi-only]" >&2
		exit 1
		;;
esac

# Currently not used, but maybe test occasionally - the 'private compiler versions' set, e.g.
# ./configure my-g++-8.3-debug-c++2a --config-tag Unix --compiler-driver /private-compiler-builds/gcc-8.3.0/bin/x86_64-pc-linux-gnu-gcc --apply-default-debug-flags --no-sanitize address --append-run-prefix 'LD_LIBRARY_PATH=$LD_LIBRARY_PATH:/private-compiler-builds/gcc-8.3.0/lib64' --only-if-has-compiler --cppstd-version c++2a
