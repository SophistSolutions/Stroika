#!/usr/bin/python3
#
#   MakeBuildRoot [--intermediate-files-root DIR] [--builds-root DIR] [--top-root DIR]
#
#   Makes a build root - as cmake -B makes a build directory: the directory that says where everything else is. It is
#   StroikaIntermediateFilesRoot, which holds the objects and other intermediate files, and the configurations
#   (ConfigurationFiles/). MakeBuildRoot writes there
#       DirectoryLayout.mk  the directories, each absolute: StroikaBuildsRoot, where the products go, ... - which make,
#                           Python and sh read
#       Makefile            so make run there builds the project (TOP_ROOT) into it
#   and copies in any configurations from a ConfigurationFiles/ beside it (where they were before Stroika v3.0d26).
#
#   --intermediate-files-root   the build root: by default StroikaIntermediateFilesRoot from the environment, else
#                               TOP_ROOT's IntermediateFiles/
#   --builds-root               StroikaBuildsRoot: by default Builds/ beside the build root
#   --top-root                  the project the build root builds (TOP_ROOT): by default TOP_ROOT from the environment,
#                               else this Stroika tree; an application made by Skel gives its own top directory
#   Each may be relative (to the current directory); DirectoryLayout.mk records them absolute. A build root made already
#   is left as it is - though a --builds-root or --top-root given must match it.
#
#   Nothing else makes one: make (but make help) and configure stop without one, printing the command line that makes the
#   build root they look for. So, first, in a new Stroika tree:
#       Build/Scripts/MakeBuildRoot                         # IntermediateFiles/ here, and Builds/ beside it
#   in an application made by Skel, in its top directory:
#       ThirdPartyComponents/Stroika/StroikaRoot/Build/Scripts/MakeBuildRoot --top-root .
#   or to build out of the source tree:
#       Build/Scripts/MakeBuildRoot --intermediate-files-root /fastdisk/stroika-out/IntermediateFiles/
#       cd /fastdisk/stroika-out/IntermediateFiles && make default-configurations && make CONFIGURATION=Debug all -j8
#
#   Build/Lib/Python/DirectoryLayout.py does the work; the top of Build/Lib/Make/SharedMakeVariables-Default.mk documents
#   the directories.
#
import argparse
import os
import sys

THIS_DIR_ = os.path.dirname(os.path.abspath(__file__))
sys.dont_write_bytecode = True  # no __pycache__ in the source tree, from the imports below
sys.path.insert(0, os.path.join(THIS_DIR_, "..", "Lib", "Python"))
import DirectoryLayout  # noqa: E402

parser = argparse.ArgumentParser(description="Make a Stroika build root (StroikaIntermediateFilesRoot): the directory that says "
                                 "where the build goes. Each directory may be relative (to the current directory).")
parser.add_argument("--intermediate-files-root", dest="intermediateFilesRoot",
                    help="the build root (StroikaIntermediateFilesRoot): by default the environment's, else TOP_ROOT's IntermediateFiles/")
parser.add_argument("--builds-root", dest="buildsRoot", help="StroikaBuildsRoot, where the products go: by default Builds/ beside the build root")
parser.add_argument("--top-root", dest="topRoot", default=os.environ.get("TOP_ROOT"),
                    help="the project it builds (TOP_ROOT): by default the environment's, else this Stroika tree - in an application made "
                    "by Skel, its top directory")
parser.add_argument("oldRoot", nargs="?", help=argparse.SUPPRESS)
args = parser.parse_args()
if args.oldRoot is not None:
    sys.exit("MakeBuildRoot ROOT-DIRECTORY (making links to it) is gone since Stroika v3.0d26: MakeBuildRoot "
             "--intermediate-files-root DIR makes a build root, with no links (@see the Stroika v3.0d26 upgrade notes, Release-Notes.md)")
intermediateFilesRoot = args.intermediateFilesRoot or os.environ.get("StroikaIntermediateFilesRoot") or \
    DirectoryLayout.AbsoluteDir(args.topRoot or DirectoryLayout.STROIKA_SOURCE_ROOT) + "IntermediateFiles/"
DirectoryLayout.MakeBuildRoot(intermediateFilesRoot, args.buildsRoot, args.topRoot)
