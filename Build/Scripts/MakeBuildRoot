#!/usr/bin/python3
#
#   MakeBuildRoot - run it once, with no arguments, in the top directory of what you build, before any make:
#       Build/Scripts/MakeBuildRoot                                             in Stroika's own tree
#       ThirdPartyComponents/Stroika/StroikaRoot/Build/Scripts/MakeBuildRoot    in an application's (as Skel makes one)
#   It makes the build root there, IntermediateFiles/, and the products go in Builds/, also there. make and configure stop
#   without a build root, printing the line that makes it.
#
#   To build somewhere else - on a faster disk, say - name all three directories:
#       MakeBuildRoot --top-root T --intermediate-files-root I --builds-root B
#   T, the top root, is the project to build: the directory you would otherwise run it in. I is the build root, and B
#   where the products go. (--top-root T alone is the same as running it with no arguments in T.) Nothing else is
#   accepted, and MakeBuildRoot reads no environment variables. Each directory may be relative (to the current
#   directory). For example:
#       Build/Scripts/MakeBuildRoot --top-root . --intermediate-files-root /fastdisk/stroika-out/IntermediateFiles/ \
#           --builds-root /fastdisk/stroika-out/Builds/
#       cd /fastdisk/stroika-out/IntermediateFiles && make default-configurations && make CONFIGURATION=Debug all -j8
#
#   The build root - as cmake -B makes a build directory: the directory that says where the build goes - holds the objects
#   and the other intermediate files, the configurations (ConfigurationFiles/), and
#       DirectoryLayout.mk  the directories, each absolute: StroikaBuildsRoot, where the products go, ... - which make,
#                           Python and sh read
#       Makefile            so make run there builds the project (T) into it
#   MakeBuildRoot also copies in any configurations from a ConfigurationFiles/ beside the build root (where they were
#   before Stroika v3.0d26). Run again, it leaves a build root as it is, if it records the same directories.
#
#   Build/Lib/Python/DirectoryLayout.py does the work; the top of Build/Lib/Make/SharedMakeVariables-Default.mk documents
#   the directories.
#
import argparse
import os
import sys

THIS_DIR_ = os.path.dirname(os.path.abspath(__file__))
sys.dont_write_bytecode = True  # no __pycache__ in the source tree, from the imports below
sys.path.insert(0, os.path.join(THIS_DIR_, "..", "Lib", "Python"))
import DirectoryLayout  # noqa: E402

parser = argparse.ArgumentParser(description="Make a Stroika build root. Usually: run it once, with no arguments, in the top "
                                 "directory of what you build (Stroika's tree, or an application's) - it makes IntermediateFiles/ "
                                 "and Builds/ there. To build somewhere else, name all three directories. Each may be relative "
                                 "(to the current directory).")
parser.add_argument("--top-root", dest="topRoot", metavar="T",
                    help="the project to build: by default the current directory")
parser.add_argument("--intermediate-files-root", dest="intermediateFilesRoot", metavar="I",
                    help="the build root, elsewhere - only with --top-root and --builds-root")
parser.add_argument("--builds-root", dest="buildsRoot", metavar="B",
                    help="where the products go, elsewhere - only with --top-root and --intermediate-files-root")
parser.add_argument("oldRoot", nargs="?", help=argparse.SUPPRESS)
args = parser.parse_args()
if args.oldRoot is not None:
    sys.exit("MakeBuildRoot ROOT-DIRECTORY (making links to it) is gone since Stroika v3.0d26: MakeBuildRoot --top-root T "
             "--intermediate-files-root I --builds-root B builds elsewhere, with no links (@see MakeBuildRoot --help)")
if args.intermediateFilesRoot is None and args.buildsRoot is None:
    topRoot = args.topRoot or "."
    DirectoryLayout.MakeBuildRoot(topRoot, os.path.join(topRoot, "IntermediateFiles"), os.path.join(topRoot, "Builds"))
elif None not in (args.topRoot, args.intermediateFilesRoot, args.buildsRoot):
    DirectoryLayout.MakeBuildRoot(args.topRoot, args.intermediateFilesRoot, args.buildsRoot)
else:
    parser.error("give --top-root, --intermediate-files-root and --builds-root all three - or at most --top-root, for its "
                 "IntermediateFiles/ and Builds/")
