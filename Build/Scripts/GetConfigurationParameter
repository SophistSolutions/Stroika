#!/usr/bin/python3
#
#   GetConfigurationParameter CONFIGURATION PARAMETER
#
#   Prints PARAMETER's value in ConfigurationFiles/CONFIGURATION.xml (no newline added); ExtraMakeDefines prints its
#   values run together. See Build/Lib/Python/ConfigurationReader.py.
#
import os
import sys

sys.dont_write_bytecode = True  # no __pycache__ in the source tree, from the import below
sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "Lib", "Python"))
import ConfigurationReader  # noqa: E402


def Die(msg):
    sys.stderr.write(msg + "\n")
    sys.exit(255)  # as Perl's die did


if len(sys.argv) < 3:
    Die("Missing configuration name argument")
if sys.argv[2] == "":
    Die("Missing configuration parameter name argument")

value = ConfigurationReader.GetConfigurationParameter(sys.argv[1], sys.argv[2])
out = "".join(value) if isinstance(value, list) else value
sys.stdout.buffer.write(out.encode(ConfigurationReader.ENCODING))
