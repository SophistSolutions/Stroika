#!/bin/sh
# (sh, then Python: python3 runs this file by a path it can open. A native Windows python3.exe cannot open a /c/... path -
# under MSYS2's make, which exports MSYS2_ARG_CONV_EXCL=*, it arrives unconverted - so it gets the C:/... form. Cygwin's and
# MSYS2's own python3 are POSIX programs, and take the path as it is: that is /usr/bin/python3, however PATH spells it
# (-ef: /cygdrive/c/cygwin/bin/python3 is the same file, and a POSIX python takes a C:/... path as relative). With no fork
# but the exec: this runs often. The bash-only expansions are in eval, so the sh of Linux (dash) never parses them)
''':'
case "$0:$OSTYPE" in /*:msys* | /*:cygwin*)
	hash python3 2> /dev/null; eval 'p=${BASH_CMDS[python3]}'
	if [ -n "$p" ] && ! [ "$p" -ef /usr/bin/python3 ]; then
		case "$0" in /[A-Za-z]/*) eval 'd=${0:1:1}; exec python3 "${d^^}:${0:2}" "$@"' ;; esac
		exec python3 "$(cygpath -m "$0")" "$@"
	fi ;;
esac
exec python3 "$0" "$@"
'''
#
# e.g.
#		RunArgumentsWithCommonBuildVars Debug-U-32 make -k foo
#
#	First arg is configuration. The remaining args all passed along to the next command
#
#	On windows (Visual Studio), this creates a .bat file, runs vcvarsall.bat (right arch), and then puts the arguments
#	to this script into that .bat file, and runs the full .bat file
#
import os
import subprocess
import sys
import tempfile

sys.dont_write_bytecode = True  # no __pycache__ in the source tree, from the import below
sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "Lib", "Python"))
import ConfigurationReader  # noqa: E402


def Die(msg):
    sys.stderr.write(msg + "\n")
    sys.exit(255)  # as Perl's die did


activeConfig = sys.argv[1] if len(sys.argv) > 1 else ""
cmd = " ".join(sys.argv[2:])


### SEE https://docs.microsoft.com/en-us/cpp/build/building-on-the-command-line?view=vs-2019 for docs on calling vcvarsall.bat
def GetString2InsertIntoBatchFileToInitCompiles_():
    arch = ConfigurationReader.GetConfigurationParameter(activeConfig, "ARCH")
    vsDir = ConfigurationReader.GetConfigurationParameter(activeConfig, "BuildToolsRoot")
    if arch == "x86":
        arg = "x64_x86"
    elif arch == "x86_64":
        arg = "x64"
    else:
        Die("hardwired/to fix logic about mapping config names to 32/64")
    ## pushd/popd: vcvarsall.bat cd's to %VSCMD_START_DIR% if that is set, and older Visual Studios to %USERPROFILE%\Source
    result = "pushd %TEMP%\r\n"
    result += 'call "' + vsDir + "\\VC\\Auxiliary\\Build\\vcvarsall.bat" + '" ' + arg + " > nul;\r\n"
    result += "popd\r\n"
    return result


def RunSystemWithVCVarsSetInEnvironment_(cmd2Run):
    # in the current directory, as the .bat is run by its bare name (below)
    fd, tmpPath = tempfile.mkstemp(prefix="runCmdInVCVarsContext_", suffix=".bat", dir=".")
    try:
        with os.fdopen(fd, "wb") as f:
            f.write(("@echo off\r\n" + GetString2InsertIntoBatchFileToInitCompiles_() + cmd2Run + "\r\n").encode(ConfigurationReader.ENCODING))
        # https://github.com/SophistSolutions/Stroika/issues/1073 /E:ON needed for this ticket
        # cmd finds the .bat by its bare name, in the current directory - which NoDefaultCurrentDirectoryInExePath turns off
        env = dict(os.environ)
        env.pop("NoDefaultCurrentDirectoryInExePath", None)
        try:
            return subprocess.call(["cmd", "/E:ON/C", os.path.basename(tmpPath)], env=env)
        except OSError:
            return -1  # could not run the command at all
    finally:
        os.unlink(tmpPath)


result = RunSystemWithVCVarsSetInEnvironment_(cmd)
# a failure's exit status: its low byte - or 1 if that is 0 (a signal, or the command could not run at all), never success
sys.exit(0 if result == 0 else ((result & 0xFF) or 1))
