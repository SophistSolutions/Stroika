#!/bin/bash
#
#   **DEPRECATED** - use MakeFileLink or MakeDirectoryLink.
#
#   The name promised something it could not keep: on Windows this produced symbolic links that
#   native tools frequently cannot follow (Redirection Guard / STATUS_UNTRUSTED_MOUNT_POINT), and it
#   did so silently. It also had to guess from the target whether you meant a file or a directory -
#   which is unanswerable when the target does not exist yet, and Windows stamps that choice into the
#   link permanently. Only the caller knows. So there are now two scripts, and which one you call IS
#   that answer.
#
#   This shim forwards, so applications built on Stroika keep working untouched. Migrate when
#   convenient: replace MakeSymbolicLink with MakeFileLink (or MakeDirectoryLink) - the arguments are
#   unchanged.
#

MY_DIR_="$( cd -P "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"

echo "MakeSymbolicLink is **DEPRECATED** - use MakeFileLink (or MakeDirectoryLink); forwarding" 1>&2

if [ -d "$1" ] ; then
    exec "${MY_DIR_}/MakeDirectoryLink" "$@"
else
    exec "${MY_DIR_}/MakeFileLink" "$@"
fi
