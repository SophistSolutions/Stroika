#!/bin/bash

# EXAMPLE RUN:
#       ./Build/Scripts/RunLocalWindowsDockerRegressionTests
#       CONTAINER_IMAGE=sophistsolutionsinc/stroika-buildvm-windows-cygwin-vs2k22 USE_TEST_BASENAME=Windows_Cygwin-VS2k22-In-Docker ./Build/Scripts/RunLocalWindowsDockerRegressionTests
#       CONTAINER_IMAGE=sophistsolutionsinc/stroika-buildvm-windows-msys-vs2k22 USE_TEST_BASENAME=Windows_MSYS-VS2k22-In-Docker ./Build/Scripts/RunLocalWindowsDockerRegressionTests
#
#       for var in "Cygwin-VS2k22" "MSYS-VS2k22" ; do LCV=`echo "${var}" | tr '[:upper:]' '[:lower:]'` CONTAINER_IMAGE=sophistsolutionsinc/stroika-buildvm-windows-${LCV} USE_TEST_BASENAME=Windows_${var}-In-Docker ./Build/Scripts/RunLocalWindowsDockerRegressionTests ; done
#
# MONGO_CONNECTION_STRING, if set, goes into the container: the mongo server Tests/36 tests against (else it skips them).
#
# Conan's cache is kept between runs, in a docker volume per image (<image>-conan-cache; CONAN_CACHE_VOLUME names another,
# empty none): copied onto the container's own disk before the build, and back after it, less what the run did not use.
# Not Conan's home on the volume itself: a Hyper-V container reaches a volume as a mapped folder, which builds far more
# slowly. One run at a time per volume; `docker volume rm <name>` starts one afresh.
#
CONTAINER_IMAGE="${CONTAINER_IMAGE:-sophistsolutionsinc/stroika-buildvm-windows-msys-vs2k22}"
CONTAINER_NAME="${CONTAINER_NAME:-DockerWindowsStroikaRegressionTester1}"
USE_TEST_BASENAME="${USE_TEST_BASENAME:-Windows_MSYS-VS2k22-In-Docker}"
BRANCH="${BRANCH:-v3-Dev}"
VERSION=`./Build/Scripts/ExtractVersionInformation STROIKA_VERSION FullVersionString`
DOCKER="${DOCKER:-docker.exe}"
IMAGE_NAME_="${CONTAINER_IMAGE##*/}"
CONAN_CACHE_VOLUME="${CONAN_CACHE_VOLUME-${IMAGE_NAME_%%:*}-conan-cache}"

# Due to https://github.com/SophistSolutions/Stroika/issues/876 - Invoke-WebRequest : The remote name could not be resolved: 
#  Add 
#  "dns": [
#     "8.8.8.8"
#   ],
#   to Docker Desktop App / Settings / Docker Engine / JSON Configuration File
#   - and list the LAN's own DNS server too, or the container cannot resolve LAN names (the mongo server in MONGO_CONNECTION_STRING)

CPUS_=6
MEMORY_=16G
DISK_=175G

DOCKER_RUN_ARGS_=
DOCKER_RUN_ARGS_+=" --detach"
DOCKER_RUN_ARGS_+=" --interactive"
DOCKER_RUN_ARGS_+=" --memory ${MEMORY_}"
DOCKER_RUN_ARGS_+=" --cpus ${CPUS_}"
DOCKER_RUN_ARGS_+=" --name $CONTAINER_NAME"
DOCKER_RUN_ARGS_+=" --storage-opt size=${DISK_}"
if [[ -n "${CONAN_CACHE_VOLUME}" ]] ; then
    DOCKER_RUN_ARGS_+=" --volume ${CONAN_CACHE_VOLUME}:c:/conan-cache"
    DOCKER_RUN_ARGS_+=" --env CONAN_HOME=c:/conan"
fi
# robocopy's options for copying Conan's cache: directories' times too - conan remove --lru takes a package's last use
# from its folder's - and no retries
CONAN_CACHE_COPY_="/MT:16 /DCOPY:DAT /R:0 /W:0 /NFL /NDL /NJH /NP"

[[ "$($DOCKER ps -a | grep $CONTAINER_NAME)" ]] && $DOCKER rm -f $CONTAINER_NAME

# FYI possible error: https://stackoverflow.com/questions/67162945/docker-for-windows-the-requested-resource-is-in-use-error-when-mem-limit-is-set

echo "Running docker build (${CONTAINER_IMAGE} for ${USE_TEST_BASENAME})(usually takes about 6 hrs)"
$DOCKER run \
    ${DOCKER_RUN_ARGS_} \
    -v `cygpath --windows --absolute --mixed .`:c:/LAUNCHEDFROM \
    $CONTAINER_IMAGE

$DOCKER exec \
    $CONTAINER_NAME \
    bash -c "git clone https://github.com/SophistSolutions/Stroika.git --branch $BRANCH"

# (powershell, so no POSIX shell converts robocopy's /options to paths; "complete": the last copy out finished)
if [[ -n "${CONAN_CACHE_VOLUME}" ]] ; then
    echo "Copying in Conan's cache, from volume ${CONAN_CACHE_VOLUME}"
    $DOCKER exec $CONTAINER_NAME powershell -Command "if (Test-Path C:\conan-cache\complete) { robocopy C:\conan-cache C:\conan /E /XF complete ${CONAN_CACHE_COPY_}; exit [int](\$LASTEXITCODE -ge 8) } else { 'none' }"
fi
RUN_START_=$(date +%s)

# NB: https://github.com/SophistSolutions/Stroika/issues/895 -  -l needed for building openssl on MSYS
$DOCKER exec \
    --env USE_TEST_BASENAME=$USE_TEST_BASENAME \
    --env "MONGO_CONNECTION_STRING=$MONGO_CONNECTION_STRING" \
    $CONTAINER_NAME \
    bash -l -c "export PARALELLMAKEFLAG=-j${CPUS_}; cd c:/Stroika; ./Build/Scripts/RegressionTests; cp Tests/HistoricalRegressionTestResults/REGRESSION-TESTS-*-OUT.txt c:/launchedfrom/Tests/HistoricalRegressionTestResults/; cp Tests/HistoricalPerformanceRegressionTestResults/PerformanceDump-* c:/launchedfrom/Tests/HistoricalPerformanceRegressionTestResults/"

echo "Done with build, and copied out results to (Tests/HistoricalRegressionTestResults/REGRESSION-TESTS-$USE_TEST_BASENAME-$VERSION-OUT.txt Tests/HistoricalPerformanceRegressionTestResults/PerformanceDump-$USE_TEST_BASENAME-x86-$VERSION.txt Tests/HistoricalPerformanceRegressionTestResults/PerformanceDump-$USE_TEST_BASENAME-x86_64-$VERSION.txt)"
# Try copy with (above) -v bind-mount, because stopping and copying now (used to work) - causes docker destkop installation to fail/become corrupt
# $DOCKER exec \
#     --env USE_TEST_BASENAME=$USE_TEST_BASENAME \
#     $CONTAINER_NAME \
#     bash -l -c "cd c:/Stroika; cp Tests/HistoricalRegressionTestResults/REGRESSION-TESTS-$USE_TEST_BASENAME-$VERSION-OUT.txt c:/launchedfrom/Tests/HistoricalRegressionTestResults/"
# $DOCKER exec \
#     --env USE_TEST_BASENAME=$USE_TEST_BASENAME \
#     $CONTAINER_NAME \
#     bash -l -c "cd c:/Stroika; cp Tests/HistoricalRegressionTestResults/PerformanceDump-$USE_TEST_BASENAME-* c:/launchedfrom/Tests/HistoricalPerformanceRegressionTestResults/"

# Only when the run used Conan's cache: one that failed before building used none, and removing all it did not use would
# empty the cache. A run touches the folder of each recipe it uses (which is how conan remove --lru knows).
if [[ -n "${CONAN_CACHE_VOLUME}" ]] ; then
    if $DOCKER exec $CONTAINER_NAME powershell -Command "exit [int](-not (Get-ChildItem C:\conan\p -Directory -ErrorAction Ignore | Where-Object LastWriteTimeUtc -ge ([DateTimeOffset]::FromUnixTimeSeconds(${RUN_START_}).UtcDateTime)))" ; then
        UNUSED_FOR_=$(( ($(date +%s) - RUN_START_) / 3600 + 1 ))h
        echo "Copying out Conan's cache, to volume ${CONAN_CACHE_VOLUME}, less what this run did not use (unused for ${UNUSED_FOR_})"
        $DOCKER exec $CONTAINER_NAME bash -l -c "conan remove '*#*:*' --lru=${UNUSED_FOR_} --confirm; conan remove '*#*' --lru=${UNUSED_FOR_} --confirm"
        # robocopy lists each file /MIR purges, /NFL /NDL notwithstanding (Server Core ltsc2025's) - thousands, for a package
        # dropped - so its output goes to a log in the container, and only its summary and any errors are shown
        $DOCKER exec $CONTAINER_NAME powershell -Command "Remove-Item -ErrorAction Ignore C:\conan-cache\complete; robocopy C:\conan C:\conan-cache /MIR ${CONAN_CACHE_COPY_} /LOG:C:\conan-copy-out.log; \$rc = \$LASTEXITCODE; Select-String -Path C:\conan-copy-out.log -Pattern 'Total\s+Copied','^\s*(Dirs|Files|Bytes) :',' ERROR ' | ForEach-Object Line; if (\$rc -ge 8) { exit 1 }; New-Item C:\conan-cache\complete > \$null"
    else
        echo "Conan's cache unused (the run failed before building): volume ${CONAN_CACHE_VOLUME} left as it was"
    fi
fi

$DOCKER stop $CONTAINER_NAME
# echo "Done with build, so copying out results to (Tests/HistoricalRegressionTestResults/REGRESSION-TESTS-$USE_TEST_BASENAME-$VERSION-OUT.txt Tests/HistoricalPerformanceRegressionTestResults/PerformanceDump-$USE_TEST_BASENAME-x86-$VERSION.txt Tests/HistoricalPerformanceRegressionTestResults/PerformanceDump-$USE_TEST_BASENAME-x86_64-$VERSION.txt)"
# $DOCKER cp $CONTAINER_NAME:Stroika/Tests/HistoricalRegressionTestResults/REGRESSION-TESTS-$USE_TEST_BASENAME-$VERSION-OUT.txt Tests/HistoricalRegressionTestResults/
# $DOCKER cp $CONTAINER_NAME:Stroika/Tests/HistoricalPerformanceRegressionTestResults/PerformanceDump-$USE_TEST_BASENAME-x86-$VERSION.txt Tests/HistoricalPerformanceRegressionTestResults/
# $DOCKER cp $CONTAINER_NAME:Stroika/Tests/HistoricalPerformanceRegressionTestResults/PerformanceDump-$USE_TEST_BASENAME-x86_64-$VERSION.txt Tests/HistoricalPerformanceRegressionTestResults/
echo "Container $CONTAINER_NAME stopped but still around to examine/post-mortem"
