#!/bin/bash
TEXT="$1"

# EXAMPLES
# (export TOP_ROOT=/myStarterApp/ ; ./Build/Scripts/SubstituteBackVariables /myStarterApp/ThirdPartyComponents/Stroika/StroikaRoot/Builds/Debug/myStarterApp/myStarterApp)
# (export TOP_ROOT=/myStarterApp ; ./Build/Scripts/SubstituteBackVariables /myStarterApp/ThirdPartyComponents/Stroika/StroikaRoot/Builds/Debug/myStarterApp/myStarterApp)
# (export TOP_ROOT=/c/Sandbox/Stroika/DevRoot/; ./Build/Scripts/SubstituteBackVariables /c/Sandbox/Stroika/DevRoot/Builds)

if [ ! -z $StroikaSourceRoot ] ; then
	#TEXT=`echo $TEXT | sed s%$StroikaSourceRoot%\{StroikaSourceRoot\}%g`
	# StroikaSourceRoot=${StroikaSourceRoot%/}
	TEXT=`echo $TEXT | sed "s%^$StroikaSourceRoot%%g"`
fi
if [ ! -z $TOP_ROOT ] ; then
	#TEXT=`echo $TEXT | sed s%$TOP_ROOT%\{TOP_ROOT\}%g`
	# TOP_ROOT=${TOP_ROOT%/}
	TEXT=`echo $TEXT | sed "s%^$TOP_ROOT%%g"`
fi
# build output - outside both, or spelled C:/... as the build root's DirectoryLayout.mk writes it on Windows - shows as
# Builds/..., as it does in the source tree
if [ ! -z $StroikaBuildsRoot ] ; then
	TEXT=`echo $TEXT | sed "s%^$StroikaBuildsRoot%Builds/%g"`
fi
if [ ! -z $StroikaIntermediateFilesRoot ] ; then
	TEXT=`echo $TEXT | sed "s%^$StroikaIntermediateFilesRoot%IntermediateFiles/%g"`
fi
echo -n $TEXT