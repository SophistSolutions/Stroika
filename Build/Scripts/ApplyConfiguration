#!/bin/sh
# (sh, then Python: python3 runs this file by a path it can open. A native Windows python3.exe cannot open a /c/... path -
# under MSYS2's make, which exports MSYS2_ARG_CONV_EXCL=*, it arrives unconverted - so it gets the C:/... form. Cygwin's and
# MSYS2's own python3 are POSIX programs, and take the path as it is: that is /usr/bin/python3, however PATH spells it
# (-ef: /cygdrive/c/cygwin/bin/python3 is the same file, and a POSIX python takes a C:/... path as relative). With no fork
# but the exec: this runs often. The bash-only expansions are in eval, so the sh of Linux (dash) never parses them)
''':'
case "$0:$OSTYPE" in /*:msys* | /*:cygwin*)
	hash python3 2> /dev/null; eval 'p=${BASH_CMDS[python3]}'
	if [ -n "$p" ] && ! [ "$p" -ef /usr/bin/python3 ]; then
		case "$0" in /[A-Za-z]/*) eval 'd=${0:1:1}; exec python3 "${d^^}:${0:2}" "$@"' ;; esac
		exec python3 "$(cygpath -m "$0")" "$@"
	fi ;;
esac
exec python3 "$0" "$@"
'''
#
#   ApplyConfiguration [OPTIONS] CONFIGURATION
#
#   From ConfigurationFiles/CONFIGURATION.xml, writes IntermediateFiles/CONFIGURATION/Configuration.mk (and runs
#   CreatePackageConfigFiles), and updates that configuration's entries in Workspaces/VisualStudio.Net's IntelliSense .props
#   (Visual Studio configurations only) and .vscode/c_cpp_properties.json.
#
#   A port of ApplyConfiguration.pl (through Stroika v3.0d25).
#
#   @todo write to temporary file and only update if actually changed
#
import json
import os
import re
import subprocess
import sys
import tempfile

THIS_DIR_ = os.path.dirname(os.path.abspath(__file__))
sys.dont_write_bytecode = True  # no __pycache__ in the source tree, from the imports below
sys.path.insert(0, os.path.join(THIS_DIR_, "..", "Lib", "Python"))
import ConfigurationReader  # noqa: E402

ENC_ = ConfigurationReader.ENCODING
DEFAULT_BOOL_OPTIONS_ = -1
INTERMEDIATE_FILES_ = "IntermediateFiles/"
VS_INTELLISENSE_FILE_ = "Workspaces/VisualStudio.Net/Microsoft.Cpp.stroika.ConfigurationBased.props"
VSCODE_CPP_FILE_ = ".vscode/c_cpp_properties.json"


def Die_(msg, status=255):
    sys.stderr.write(msg)
    sys.exit(status)


def SplitList_(s, sep):
    """s, a sep-separated list, as a list - its empty items dropped"""
    return [i for i in s.split(sep) if i != ""]


def Backtick_(args, env=None):
    """The command's stdout (stderr discarded), and its exit status - 127 if it could not be run"""
    try:
        p = subprocess.run(args, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, env=env)
    except OSError:
        return "", 127
    return p.stdout.decode(ENC_), p.returncode


IS_WINDOWS_HOST_ = sys.platform in ("win32", "msys") or sys.platform.startswith("cygwin")  # under MSYS2 or Cygwin
IS_MACOS_HOST_ = sys.platform == "darwin"
PATH_SEPERATOR_ = ";" if IS_WINDOWS_HOST_ else ":"
# MSYS2 rather than Cygwin. A MINGW64/MINGW32/UCRT64 shell (which is what MSYSTEM=MINGW64 gives you, and what VSCode terminal
# profiles commonly set) says "MINGW64_NT-..." - still MSYS2. Build/Scripts/DetectedHostOS maps MINGW -> MSYS for exactly
# this reason; keep the two in agreement or they disagree about what host this is.
IS_MSYS_HOST_ = IS_WINDOWS_HOST_ and re.match(r"MSYS|MINGW", Backtick_(["uname", "-s"])[0].strip()) is not None


def PosixPathExists_(p):
    """Whether p exists: for a native Windows Python, a POSIX path (/usr/bin) is first mapped through cygpath"""
    if sys.platform == "win32" and p.startswith("/"):
        p = Backtick_(["cygpath", "--windows", p])[0].strip()
    return os.path.exists(p)


def ConfigParam2BoolInt_(v):
    return {"0": 0, "false": 0, "1": 1, "true": 1}.get(v, DEFAULT_BOOL_OPTIONS_)


def IsVisualStudio_(buildPlatform):
    return re.match(r"VisualStudio.Net", buildPlatform) is not None


class Config_:
    def __init__(self, name):
        self.name = name
        G = lambda p: ConfigurationReader.GetConfigurationParameter(name, p)  # noqa: E731
        self.G = G
        self.BuildPlatform = G("BuildPlatform")
        self.TargetPlatforms = G("TargetPlatforms")
        self.BuildToolsRoot = G("BuildToolsRoot")
        self.COMPILER_DRIVER_CPlusPlus = G("CompilerDriver-C++")
        self.PLATFORM_CPPFLAGS_NOTINCLUDES = G("PLATFORM_CPPFLAGS_NOTINCLUDES")
        self.CPPFLAGS_NOTINCLUDES = self.PLATFORM_CPPFLAGS_NOTINCLUDES + " " + G("FOUNDATION_CPPFLAGS_NOTINCLUDES")
        self.CFLAGS = G("PLATFORM_CFLAGS")
        self.CXXFLAGS = G("PLATFORM_CXXFLAGS")
        self.Platform_LinkerArgs_ExtraPrefix = G("Platform_LinkerArgs_ExtraPrefix")
        self.Platform_LinkerArgs_ExtraSuffix = G("Platform_LinkerArgs_ExtraSuffix")
        self.gAssertionsEnabled = ConfigParam2BoolInt_(G("AssertionsEnabled"))
        self.PLATFORM_INCLUDES_PATH = G("PLATFORM_INCLUDES_PATH")
        self.FOUNDATION_INCLUDES_PATH = G("FOUNDATION_INCLUDES_PATH")
        self.Platform_LinkerArgs_LibPath = G("Platform_LinkerArgs_LibPath")
        self.IncludeDebugSymbolsInExecutables = G("IncludeDebugSymbolsInExecutables")
        self.IncludeDebugSymbolsInLibraries = G("IncludeDebugSymbolsInLibraries")
        self.Foundation_PkgConfigNames = G("Foundation_PkgConfigNames")
        self.useExtraMakeDefines = G("ExtraMakeDefines")

        includes = []
        for p in SplitList_(self.PLATFORM_INCLUDES_PATH, PATH_SEPERATOR_):
            if IsVisualStudio_(self.BuildPlatform):
                # cl takes / or \ in a filename, and a name holding spaces only in double quotes - so C:/foo, in double quotes
                # (https://learn.microsoft.com/en-us/cpp/build/reference/cl-filename-syntax?view=msvc-170)
                includes.append('-I"' + Backtick_(["cygpath", "--mixed", p])[0].strip() + '"')
            else:
                includes.append("-I" + p)
        self.PLATFORM_CPPFLAGS_INCLUDES = " ".join(includes)


def ConfigurationMkText_(c):
    out = []
    w = out.append

    def CachedLineItem(vn, v=None):
        if v is None:
            v = c.G(vn)
        w("#CACHED VALUE OF: " + vn + '\t\t\t:=\t$(shell $(StroikaRoot)Build/Scripts/GetConfigurationParameter "$(CONFIGURATION)" ' + vn + ")\n")
        # a $ in the XML must reach make as itself - not as the start of a variable expansion
        w(vn + " := " + str(v).replace("$", "$$") + "\n")
        w("\n")

    w("#\n")
    w("#Copyright(c) Sophist Solutions, Inc. 1990-2026.  All rights reserved\n")
    w("#\n")
    w("\n")
    w("\n")
    w("#WARNING: THIS FILE WAS AUTOGENERATED WITH ApplyConfiguration\n" * 8)
    w("#\n")
    w("#This file mainly consists of CACHES of the values that could have been retrieved WITH\n")
    w('#      VAR :=\t$(shell $(StroikaRoot)Build/Scripts/GetConfigurationParameter "$(CONFIGURATION)" VAR)\n')
    w("\n")
    w("\n")
    w("ifndef StroikaRoot\n")
    w('$(error, "StroikaRoot must be defined and included before this file")\n')
    w("endif\n")
    w("\n")
    CachedLineItem("BuildPlatform", c.BuildPlatform)
    CachedLineItem("TargetPlatforms", c.TargetPlatforms)
    CachedLineItem("BuildToolsRoot", c.BuildToolsRoot)
    w("\n")
    w("#\n")
    w("# PKG-CONFIG support\n")
    w("export PKG_CONFIG_PATH :=\t$(shell realpath --canonicalize-missing ${StroikaRoot}Builds/$(CONFIGURATION)/lib/pkgconfig)\n")
    w("\n")
    w("\n")
    for vn in ("ARCH", "CMAKE", "TOOLS_PATH_ADDITIONS", "CC", "CXX", "AS", "RC", "MIDL"):
        CachedLineItem(vn)
    CachedLineItem("AssertionsEnabled", c.gAssertionsEnabled)
    for vn in ("Platform_LinkerArgs_LibPath", "LinkTime_CopyFilesToEXEDir", "PLATFORM_INCLUDES_PATH", "FOUNDATION_INCLUDES_PATH",
               "VSVARS_PLATFORM_INCLUDES_PATH", "VSVARS_MSVC_RUNTIME_LIBRARY", "PLATFORM_CPPFLAGS_NOTINCLUDES"):
        CachedLineItem(vn)
    w("\n#Compiler include format of varaible PLATFORM_INCLUDES_PATH\n")
    w("PLATFORM_CPPFLAGS_INCLUDES :=\t" + c.PLATFORM_CPPFLAGS_INCLUDES + "\n")
    w("\n# Utility combination (widely used in building third party components)\n")
    w("PLATFORM_CPPFLAGS :=\t${PLATFORM_CPPFLAGS_NOTINCLUDES} ${PLATFORM_CPPFLAGS_INCLUDES}\n")
    w("\n# SB same as cached config variable but not done yet\n")
    w("PLATFORM_CFLAGS :=\t" + c.CFLAGS + "\n")
    w("\n# SB same as cached config variable but not done yet\n")
    w("PLATFORM_CXXFLAGS :=\t" + c.CXXFLAGS + "\n")
    w("\n")
    for vn in ("STRIP", "AR", "LIBTOOL", "RANLIB"):
        CachedLineItem(vn)
    w("\n")
    CachedLineItem("RunPrefix")
    CachedLineItem("CrossCompiling")
    w("\n")
    w("CONFIGURATION := " + c.name + "\n")
    for vn in ("qCompiler_HasNoMisleadingIndentation_Flag", "qFeatureFlag_ATLMFC", "qFeatureFlag_boost", "qFeatureFlag_fmtlib",
               "qFeatureFlag_GoogleTest", "qFeatureFlag_LibCurl", "qFeatureFlag_LZMA", "qFeatureFlag_mongocxxdriver", "qFeatureFlag_OpenSSL",
               "qFeatureFlag_OpenSSL_ExtraArgs", "qFeatureFlag_sqlite", "qFeatureFlag_StrawberryPerl", "qFeatureFlag_WinHTTP", "qFeatureFlag_WIX",
               "qFeatureFlag_Xerces", "qFeatureFlag_libxml2", "qFeatureFlag_ZLib", "qFeatureFlag_zstd", "ConfigTags", "SanitizerFlags"):
        CachedLineItem(vn)
    w("\n\n")
    w("#Configured Command Line Arguments (-make-define)\n")
    for d in c.useExtraMakeDefines:
        w(d + "\n")
    w("\n\n")
    w("#Script to map filenames to native format (for windows)\n")
    w('##\tEG USE AS:   CPPFLAGS += -I"$(call FUNCTION_CONVERT_FILES_TO_COMPILER_NATIVE ,${StroikaRoot})/Builds..."\n')
    if IsVisualStudio_(c.BuildPlatform):
        w("FUNCTION_CONVERT_FILES_TO_COMPILER_NATIVE=$(shell cygpath --ignore --mixed $1)\n")
        w("FUNCTION_CONVERT_FILEPATH_TO_COMPILER_NATIVE=$(shell cygpath --ignore --mixed $1)\n")
    else:
        w("FUNCTION_CONVERT_FILES_TO_COMPILER_NATIVE=$1\n")
        w("FUNCTION_CONVERT_FILEPATH_TO_COMPILER_NATIVE=$1\n")
    w("\n\n")
    w("\n\n")
    w("#Linker flags\n")
    w("Platform_LinkerArgs_LibPath := " + c.Platform_LinkerArgs_LibPath + "\n")
    w("#\n")
    w("Platform_LinkerArgs_ExtraPrefix :=\t" + c.Platform_LinkerArgs_ExtraPrefix + "\n")
    w("Platform_LinkerArgs_ExtraSuffix :=\t" + c.Platform_LinkerArgs_ExtraSuffix + "\n")
    w("IncludeDebugSymbolsInExecutables :=\t" + c.IncludeDebugSymbolsInExecutables + "\n")
    w("IncludeDebugSymbolsInLibraries :=\t" + c.IncludeDebugSymbolsInLibraries + "\n")
    w("#Linker-Driver\n")
    CachedLineItem("LINKER")
    w("\n\n#File Suffixes\n")
    for vn in ("LIB_SUFFIX", "OBJ_SUFFIX", "EXE_SUFFIX"):
        CachedLineItem(vn)
    w("\n")
    w("\n")
    if IsVisualStudio_(c.BuildPlatform):
        w("\n")
        w("##\n")
        w("##\n")
        w("## Windows format path versions of some of these variables\n")
        w("##\n")
        w('##WIN_$var = cygpath --ignore --mixed "$var"                OR\n')
        w('##WIN_$var = cygpath --ignore --mixed --path "$var"         (as appropriate)\n')
        w("##\n")
        w("##\n")
        w("CMAKE=" + c.G("CMAKE") + "\n")
        arch = c.G("ARCH")
        w("WIN_LIBCOMPATIBLE_ARCH=" + ("x64" if arch == "x86_64" else arch) + "\n")  # lib.exe (and probably link) want x64
        # Not a great way to test, but adequate: it is not critical that it is always right. And we tend to use -Z7 - so
        # this really doesn't get used much - may not be needed anymore. Not sure why we would use this 'feature' of the
        # linker system on MSVC -- LGP 2025-06-11
        if "-Zi" in c.CXXFLAGS or "-Zl" in c.CXXFLAGS:
            w("WIN_USE_PROGRAM_DATABASE=1\n")
        w("\n")
        w("\n")
    w("OUT_ARG_PREFIX_NATIVE := -OUT:\n" if IsVisualStudio_(c.BuildPlatform) else "OUT_ARG_PREFIX_NATIVE := -o \n")
    w("\n")
    return "".join(out)


def PkgConfigWords_(c, which):
    """
    The words of pkg-config WHICH (--cflags-only-I / --cflags-only-other) for the configuration's Foundation packages - those
    the configuration built itself, in Builds/CONFIGURATION/lib/pkgconfig, or else the system's; nothing if any is missing.
    So nothing before the third-party components are built: make re-applies the .vscode entry as that directory changes.
    """
    if c.Foundation_PkgConfigNames.strip() == "":
        return []
    pcDir = os.path.normpath(os.path.join(THIS_DIR_, "..", "..", "Builds", c.name, "lib", "pkgconfig"))
    if sys.platform == "win32":  # pkg-config is MSYS2's or Cygwin's, which splits PKG_CONFIG_PATH on ':'
        pcDir = Backtick_(["cygpath", "--unix", pcDir])[0].strip()
    out, _ = Backtick_(["pkg-config", which] + c.Foundation_PkgConfigNames.split(), env=dict(os.environ, PKG_CONFIG_PATH=pcDir))
    return out.split()


def AppendPkgConfigIncludes_(c, paths):
    """paths, with each -I directory pkg-config gives for the configuration's packages that paths does not already name"""
    dirs = [e[2:] for e in PkgConfigWords_(c, "--cflags-only-I") if e.startswith("-I") and len(e) > 2]
    if IS_WINDOWS_HOST_ and dirs:
        dirs = Backtick_(["cygpath", "--mixed"] + dirs)[0].splitlines()  # (which also folds a .pc's ${pcfiledir}/../..)
    elif not IS_WINDOWS_HOST_:
        dirs = [os.path.normpath(d) for d in dirs]
    Key = lambda p: p.rstrip("/\\").lower() if IS_WINDOWS_HOST_ else p.rstrip("/")  # noqa: E731
    seen = {Key(p) for p in paths}
    for d in dirs:
        if d.strip() != "" and Key(d) not in seen:
            seen.add(Key(d))
            paths.append(d)
    return paths


def MapArraysOfFiles2Path_(conditionalPaths, backupPaths):
    """The Windows form of each of conditionalPaths that exists (or, if none does, of each of backupPaths), each once"""
    result = []
    for f in [f for f in conditionalPaths if PosixPathExists_(f)] or backupPaths:
        w = Backtick_(["cygpath", "--windows", f])[0].strip()
        if w.lower() not in (r.lower() for r in result):
            result.append(w)
    return ";".join(result)


def GetMSYSPathVar2Add_():
    # GUESS directory for MSYS - the running one's first
    backup = ["c:/tools/msys64/usr/bin", "c:/tools/msys32/usr/bin", "c:/tools/msys64/mingw64/bin", "c:/msys/usr/bin", "c:/msys64/usr/bin",
              "c:/msys64/mingw64/bin"]
    return MapArraysOfFiles2Path_((["/usr/bin"] if IS_MSYS_HOST_ else []) + backup, backup)


def GetCygwinPathVar2Add_():
    backup = ["c:/tools/cygwin/bin", "c:/cygwin/bin", "c:/cygwin64/bin", "c:/cygwin32/bin"]
    return MapArraysOfFiles2Path_((["/usr/bin"] if IS_WINDOWS_HOST_ and not IS_MSYS_HOST_ else []) + backup, backup)


PROPS_START_ = "<PropertyGroup Condition="
PROPS_KEY_PREFIX_ = "  <PropertyGroup Condition=\"'$(Configuration)|$(Platform)'=='"


def ReadPropsEntries_(text):
    """The .props file's per-configuration PropertyGroups: {configuration: its lines}, in file order"""
    entries = {}
    extracting = ""
    for line in re.split(r"(?<=\n)", text):
        if line == "":
            continue
        if PROPS_START_ not in line:
            if extracting != "":
                entries[extracting] += line
            if "</PropertyGroup>" in line:
                extracting = ""
        else:
            k = line[len(PROPS_KEY_PREFIX_):]
            k = k[:k.find("|")] if "|" in k else k[:-1]  # (with no |, all but its last character)
            extracting = k
            entries[k] = line
    return entries


def VSIntellisenseText_(c, existingText):
    entries = ReadPropsEntries_(existingText)
    out = []
    w = out.append
    w("<!--\n")
    w(" Copyright(c) Sophist Solutions, Inc. 1990-2026.  All rights reserved\n")
    w("-->\n")
    w("\n")
    w("\n")
    w("<!--WARNING: THIS FILE WAS AUTOGENERATED WITH ApplyConfiguration-->\n" * 6)
    w("\n")
    w("\n")
    w('<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003" TreatAsLocalProperty="Platform">\n')
    # the other configurations' entries, sorted - so the file is the same from run to run
    for k in sorted(entries):
        if k != c.name:
            w(entries[k])
    w("  <PropertyGroup Condition=\"'$(Configuration)|$(Platform)'=='" + c.name + "|Win32'\">\n")
    defs = [e[2:] for e in c.CPPFLAGS_NOTINCLUDES.split(" ") if e.startswith("-D")]
    defs += [e[2:].strip() for e in PkgConfigWords_(c, "--cflags-only-other") if e.startswith("-D")]
    w("    <NMakePreprocessorDefinitions>" + ";".join(defs) + "</NMakePreprocessorDefinitions>\n")
    paths = AppendPkgConfigIncludes_(
        c, SplitList_(c.FOUNDATION_INCLUDES_PATH + PATH_SEPERATOR_ + c.PLATFORM_INCLUDES_PATH, PATH_SEPERATOR_))
    w("    <NMakeIncludeSearchPath>" + ";".join(paths) + "</NMakeIncludeSearchPath>\n")
    w("  </PropertyGroup>\n")
    # configuration variables, so Visual Studio can run the MSYS or Cygwin make without the user adding it to a path - the
    # one this runs under first. StroikaBuildToolsExtraPath augments ExecutablePath in the .vcproj files, so the make uses
    # the right path
    hostStkBuildPath, otherStkBuildPath = GetMSYSPathVar2Add_(), GetCygwinPathVar2Add_()
    if not IS_MSYS_HOST_:
        hostStkBuildPath, otherStkBuildPath = otherStkBuildPath, hostStkBuildPath
    w("\n")
    w('  <PropertyGroup Label="UserMacros">\n')
    w("    <StroikaBuildToolsExtraPath>" + hostStkBuildPath + ";" + otherStkBuildPath + "</StroikaBuildToolsExtraPath>\n")
    w("    <JOBS_FLAG>-j 5</JOBS_FLAG>\n")
    w("  </PropertyGroup>\n")
    w("  <PropertyGroup Label=\"UserMacros\" Condition=\"'$(Configuration)|$(Platform)'=='" + c.name + "|Win32'\">\n")
    w("    <StroikaBuildToolsExtraPath>" + hostStkBuildPath + "</StroikaBuildToolsExtraPath>\n")
    w("  </PropertyGroup>\n")
    w("  <ItemGroup>\n")
    w('  <BuildMacro Include="StroikaBuildToolsExtraPath">\n')
    w("     <Value>$(StroikaBuildToolsExtraPath)</Value>\n")
    w("  </BuildMacro>\n")
    w('  <BuildMacro Include="JOBS_FLAG">\n')
    w("     <Value>$(JOBS_FLAG)</Value>\n")
    w("  </BuildMacro>\n")
    w("  </ItemGroup>\n")
    w("</Project>\n")
    w("\n")
    return "".join(out)


def ToFullPathEXE_(exe):
    out, rc = Backtick_(["which", exe])
    return exe if rc != 0 else out.strip()


def MSVCLatestCppStandard_(compiler):
    """
    The IntelliSense cppStandard for MSVC's -std:c++latest - a newer draft with each MSVC - asked of the compiler itself: the
    latest finished standard at or below the _MSVC_LANG it reports, never a draft. Without an answer (the compiler is not on
    this machine, say), c++23: what both supported MSVCs come to (19.44 and 19.51 report 202400L).
    """
    try:
        with tempfile.TemporaryDirectory() as d:
            with open(os.path.join(d, "probe.cpp"), "w") as f:
                f.write("_MSVC_LANG\n")
            p = subprocess.run([compiler, "/nologo", "/std:c++latest", "/EP", "probe.cpp"], cwd=d, stdout=subprocess.PIPE,
                               stderr=subprocess.DEVNULL, timeout=60)
        m = re.search(r"\b(\d{6})L\b", p.stdout.decode(ENC_, errors="replace"))
        if p.returncode == 0 and m:
            for value, name in ((202302, "c++23"), (202002, "c++20")):
                if int(m.group(1)) >= value:
                    return name
    except (OSError, subprocess.SubprocessError):
        pass
    return "c++23"


def IntelliSenseModeFor_(c, compilerDriver):
    """
    (compiler, ARCH, host) as the VS Code C/C++ extension's intelliSenseMode: <os>-<toolset>-<arch>, os windows|linux|macos,
    toolset msvc|gcc|clang, arch x86|x64|arm|arm64 (not Stroika's x86_64). Without a VALID one the extension configures no
    IntelliSense at all, silently - left to itself it wrote "None", which is not one (found 2026-09-22).
    """
    os_ = "macos" if IS_MACOS_HOST_ else ("windows" if IS_WINDOWS_HOST_ else "linux")
    lc = compilerDriver.lower()
    toolSet = "msvc" if "cl.exe" in lc else ("clang" if "clang" in lc else "gcc")
    arch = c.G("ARCH").strip()
    if arch == "" or arch == "x86_64":
        arch = "x64"
    elif arch == "aarch64":
        arch = "arm64"
    elif arch.startswith("arm") and arch != "arm64":
        arch = "arm"
    return os_ + "-" + toolSet + "-" + arch


jqNewline_ = None


def JQPretty_(doc):
    """What jq prints for doc - with the line ending of the jq on PATH: CRLF from a native Windows one (MINGW's jq.exe)"""
    global jqNewline_
    if jqNewline_ is None:
        jqNewline_ = "\r\n" if "\r\n" in Backtick_(["jq", "-n", "[1]"])[0] else "\n"
    return (json.dumps(doc, indent=2, ensure_ascii=False) + "\n").replace("\n", jqNewline_)


def VSCodeText_(c, existingText):
    """The new .vscode/c_cpp_properties.json, given the old (None if there is none)"""
    EMPTY = '{"configurations":[]}\n'
    text = EMPTY if existingText is None else existingText
    try:
        doc = json.loads(text)
        if not (isinstance(doc, (dict, list)) and len(doc) > 0):  # jq ".[]" printed nothing
            raise ValueError
    except ValueError:
        doc = json.loads(EMPTY)
    # myDefaultIncludePath, if missing (an .env that is not an object is left as it is). Empty: the
    # project's own include directories, for it to add. NOT ${workspaceFolder}: IntelliSense searches includePath for <...>
    # includes too, so it would take a Skel app's root VERSION file for <version> (case-insensitive on Windows)
    env = doc.get("env") if isinstance(doc, dict) else None
    if isinstance(doc, dict) and (env is None or (isinstance(env, dict) and env.get("myDefaultIncludePath") is None)):
        if env is None:
            doc["env"] = {}
        doc["env"]["myDefaultIncludePath"] = []
    configs = doc.get("configurations") if isinstance(doc, dict) else None
    configs = configs if isinstance(configs, list) else []
    index = len(configs)
    for i, e in enumerate(configs):
        if isinstance(e, dict) and e.get("name") == c.name:
            index = i

    # cppStandard: from the flags' --std= or -std: (the last word, if one holds more)
    std = "c++17"
    l = c.CXXFLAGS.find("--std=")
    if l != -1:
        std = c.CXXFLAGS[l + 6:]
    l = c.CXXFLAGS.find("-std:")
    if l != -1:
        std = c.CXXFLAGS[l + 5:]
    if " " in std:
        std = std[:std.find(" ")]
    if std == "c++2a":
        std = "c++20"
    elif std == "c++latest":
        std = MSVCLatestCppStandard_(c.COMPILER_DRIVER_CPlusPlus)

    includes = AppendPkgConfigIncludes_(
        c, ["${myDefaultIncludePath}"] + SplitList_(c.FOUNDATION_INCLUDES_PATH + PATH_SEPERATOR_ + c.PLATFORM_INCLUDES_PATH, PATH_SEPERATOR_))
    defines = [e[2:] for e in c.CPPFLAGS_NOTINCLUDES.split(" ") if e.startswith("-D")]
    defines += [e[2:].strip() for e in PkgConfigWords_(c, "--cflags-only-other") if e.startswith("-D")]
    newCfg = {
        "name": c.name,
        "cppStandard": std,
        "includePath": includes,
        "defines": defines,
        "compilerPath": ToFullPathEXE_(c.COMPILER_DRIVER_CPlusPlus),
        "intelliSenseMode": IntelliSenseModeFor_(c, c.COMPILER_DRIVER_CPlusPlus),
    }
    if index == len(configs):
        configs.append(newCfg)
    else:
        configs[index] = newCfg
    doc["configurations"] = configs
    # sorted by name, ignoring ASCII case (jq's sort_by (.name|ascii_downcase)); an entry with no name first
    def SortKey(e):
        name = e.get("name") if isinstance(e, dict) else None
        return name.translate(str.maketrans("ABCDEFGHIJKLMNOPQRSTUVWXYZ", "abcdefghijklmnopqrstuvwxyz")) if isinstance(name, str) else ""
    doc["configurations"] = sorted(configs, key=SortKey)
    return JQPretty_(doc)


def ReadText_(path, encoding):
    try:
        with open(path, "rb") as f:
            return f.read().decode(encoding)
    except OSError:
        return None


def WriteBytes_(path, data):
    os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
    with open(path, "wb") as f:
        f.write(data)


def Main_(argv):
    genVSCode = genConfigMake = genVSIntellisense = True
    activeConfiguration = None
    for var in argv:
        if var.lower() in ("-help", "--help", "-?"):
            print("Usage:")
            print("\tApplyConfiguration [OPTIONS] CONFIGURATION")
            print("\t  where options can be:")
            print("\t    --help              /* print this help */")
            print("\t    --only-vscode       /* only update .vscode/cpp stuff */")
            sys.exit(0)
        elif var.lower() == "--only-vscode":
            genConfigMake = genVSIntellisense = False
        else:
            activeConfiguration = var
    if activeConfiguration is None:
        Die_("Missing argument configuration\n")

    leader = "   " * (int(os.environ.get("MAKE_INDENT_LEVEL", "0") or "0") + 1)  # Build/Scripts/PrintLevelLeader's output
    configMk = INTERMEDIATE_FILES_ + activeConfiguration + "/Configuration.mk"
    c = Config_(activeConfiguration)
    genVSIntellisense = genVSIntellisense and IsVisualStudio_(c.BuildPlatform)
    jqInstalled = Backtick_(["which", "jq"])[0].strip() != ""  # (without jq, the .vscode file is left alone)

    if genConfigMake:
        if os.path.exists(configMk):
            os.remove(configMk)
        os.makedirs(INTERMEDIATE_FILES_ + activeConfiguration + "/Library", exist_ok=True)
        sys.stdout.write(leader + 'Writing "' + configMk + '" ... ')
        sys.stdout.flush()
        WriteBytes_(configMk, ConfigurationMkText_(c).encode(ENC_))
        sys.stdout.write("done\n")
        sys.stdout.write(leader)
        sys.stdout.flush()
        # THIS_DIR_ is in the path form sys.executable takes (a POSIX python3 takes a C:/... path as relative)
        rc = subprocess.call([sys.executable, os.path.join(THIS_DIR_, "CreatePackageConfigFiles"), "--configuration", activeConfiguration])
        if rc != 0:
            Die_("Error running CreatePackageConfigFiles --configuration " + activeConfiguration + " - exiting\n", rc & 0xFF or 255)
    if genVSIntellisense:
        sys.stdout.write(leader + 'Updating "' + VS_INTELLISENSE_FILE_ + '" ... ')
        WriteBytes_(VS_INTELLISENSE_FILE_, VSIntellisenseText_(c, ReadText_(VS_INTELLISENSE_FILE_, "utf-8") or "").encode("utf-8"))
        sys.stdout.write("done\n")
    if genVSCode:
        sys.stdout.write(leader + "Updating configuration " + activeConfiguration + ' in "' + VSCODE_CPP_FILE_ + '" ... ')
        if jqInstalled:
            WriteBytes_(VSCODE_CPP_FILE_, VSCodeText_(c, ReadText_(VSCODE_CPP_FILE_, "utf-8")).encode("utf-8"))
        else:
            sys.stdout.write("SKIPPED SINCE jq not installed ... ")
        sys.stdout.write("done\n")
    sys.stdout.flush()


Main_(sys.argv[1:])
