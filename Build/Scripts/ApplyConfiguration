#!/usr/bin/python3
#
#   ApplyConfiguration [OPTIONS] CONFIGURATION
#
#   From ConfigurationFiles/CONFIGURATION.xml, writes IntermediateFiles/CONFIGURATION/Configuration.mk and its CMake toolchain
#   file, Toolchain.cmake, with its Stroika settings, Stroika-Configuration.cmake - each wherever its variable puts it (the
#   build root's DirectoryLayout.mk) - and runs CreatePackageConfigFiles, and updates that configuration's
#   entries in CMakeUserPresets.json, Workspaces/VisualStudio.Net's IntelliSense .props (Visual Studio configurations only)
#   and .vscode/c_cpp_properties.json.
#
#   A port of ApplyConfiguration.pl (through Stroika v3.0d25).
#
#   @todo write to temporary file and only update if actually changed
#
import json
import os
import re
import shlex
import subprocess
import sys
import tempfile

THIS_DIR_ = os.path.dirname(os.path.abspath(__file__))
sys.dont_write_bytecode = True  # no __pycache__ in the source tree, from the imports below
sys.path.insert(0, os.path.join(THIS_DIR_, "..", "Lib", "Python"))
import ConfigurationReader  # noqa: E402
import DirectoryLayout  # noqa: E402
import HostOS  # noqa: E402

ENC_ = ConfigurationReader.ENCODING
DEFAULT_BOOL_OPTIONS_ = -1
VS_INTELLISENSE_FILE_ = "Workspaces/VisualStudio.Net/Microsoft.Cpp.stroika.ConfigurationBased.props"
VSCODE_CPP_FILE_ = ".vscode/c_cpp_properties.json"
CMAKE_PRESETS_FILE_ = DirectoryLayout.STROIKA_SOURCE_ROOT + "CMakeUserPresets.json"  # beside Stroika's top CMakeLists.txt


def Die_(msg, status=255):
    sys.stderr.write(msg)
    sys.exit(status)


def SplitList_(s, sep):
    """s, a sep-separated list, as a list - its empty items dropped"""
    return [i for i in s.split(sep) if i != ""]


def Backtick_(args, env=None):
    """The command's stdout (stderr discarded), and its exit status - 127 if it could not be run"""
    try:
        p = subprocess.run(args, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, env=env)
    except OSError:
        return "", 127
    return p.stdout.decode(ENC_), p.returncode


IS_WINDOWS_HOST_ = HostOS.Matches("Windows")
IS_MACOS_HOST_ = HostOS.Matches("Darwin")
PATH_SEPERATOR_ = ";" if IS_WINDOWS_HOST_ else ":"
IS_MSYS_HOST_ = HostOS.Matches("MSYS")  # MSYS2 rather than Cygwin - a MINGW64 or UCRT64 shell too


def ConfigParam2BoolInt_(v):
    return {"0": 0, "false": 0, "1": 1, "true": 1}.get(v, DEFAULT_BOOL_OPTIONS_)


def IsVisualStudio_(buildPlatform):
    return re.match(r"VisualStudio.Net", buildPlatform) is not None


class Config_:
    def __init__(self, name):
        self.name = name
        G = lambda p: ConfigurationReader.GetConfigurationParameter(name, p)  # noqa: E731
        self.G = G
        self.BuildPlatform = G("BuildPlatform")
        self.TargetPlatforms = G("TargetPlatforms")
        self.BuildToolsRoot = G("BuildToolsRoot")
        self.COMPILER_DRIVER_CPlusPlus = G("CompilerDriver-C++")
        self.PLATFORM_CPPFLAGS_NOTINCLUDES = G("PLATFORM_CPPFLAGS_NOTINCLUDES")
        self.CPPFLAGS_NOTINCLUDES = self.PLATFORM_CPPFLAGS_NOTINCLUDES + " " + G("FOUNDATION_CPPFLAGS_NOTINCLUDES")
        self.CFLAGS = G("PLATFORM_CFLAGS")
        self.CXXFLAGS = G("PLATFORM_CXXFLAGS")
        self.Platform_LinkerArgs_ExtraPrefix = G("Platform_LinkerArgs_ExtraPrefix")
        self.Platform_LinkerArgs_ExtraSuffix = G("Platform_LinkerArgs_ExtraSuffix")
        self.gAssertionsEnabled = ConfigParam2BoolInt_(G("AssertionsEnabled"))
        self.PLATFORM_INCLUDES_PATH = G("PLATFORM_INCLUDES_PATH")
        self.FOUNDATION_INCLUDES_PATH = G("FOUNDATION_INCLUDES_PATH")
        self.Platform_LinkerArgs_LibPath = G("Platform_LinkerArgs_LibPath")
        self.IncludeDebugSymbolsInExecutables = G("IncludeDebugSymbolsInExecutables")
        self.IncludeDebugSymbolsInLibraries = G("IncludeDebugSymbolsInLibraries")
        self.Foundation_PkgConfigNames = G("Foundation_PkgConfigNames")
        self.useExtraMakeDefines = G("ExtraMakeDefines")

        includes = []
        for p in SplitList_(self.PLATFORM_INCLUDES_PATH, PATH_SEPERATOR_):
            if IsVisualStudio_(self.BuildPlatform):
                # cl takes / or \ in a filename, and a name holding spaces only in double quotes - so C:/foo, in double quotes
                # (https://learn.microsoft.com/en-us/cpp/build/reference/cl-filename-syntax?view=msvc-170)
                includes.append('-I"' + Backtick_(["cygpath", "--mixed", p])[0].strip() + '"')
            else:
                includes.append("-I" + p)
        self.PLATFORM_CPPFLAGS_INCLUDES = " ".join(includes)


def ConfigurationMkText_(c):
    out = []
    w = out.append

    def CachedLineItem(vn, v=None):
        if v is None:
            v = c.G(vn)
        w("#CACHED VALUE OF: " + vn + '\t\t\t:=\t$(shell $(StroikaSourceRoot)Build/Scripts/GetConfigurationParameter "$(CONFIGURATION)" ' + vn + ")\n")
        # a $ in the XML must reach make as itself - not as the start of a variable expansion
        w(vn + " := " + str(v).replace("$", "$$") + "\n")
        w("\n")

    w("#\n")
    w("#Copyright(c) Sophist Solutions, Inc. 1990-2026.  All rights reserved\n")
    w("#\n")
    w("\n")
    w("\n")
    w("#WARNING: THIS FILE WAS AUTOGENERATED WITH ApplyConfiguration\n" * 8)
    w("#\n")
    w("#This file mainly consists of CACHES of the values that could have been retrieved WITH\n")
    w('#      VAR :=\t$(shell $(StroikaSourceRoot)Build/Scripts/GetConfigurationParameter "$(CONFIGURATION)" VAR)\n')
    w("\n")
    w("\n")
    CachedLineItem("BuildPlatform", c.BuildPlatform)
    CachedLineItem("TargetPlatforms", c.TargetPlatforms)
    CachedLineItem("BuildToolsRoot", c.BuildToolsRoot)
    w("\n")
    w("#\n")
    w("# PKG-CONFIG support\n")
    if IS_WINDOWS_HOST_:
        # PKG_CONFIG_PATH is a :-separated list, so it cannot hold the C:/... form the build root's DirectoryLayout.mk writes:
        # the shell's own form (/c/..., /cygdrive/c/...), as the make reading this spells it
        w("export PKG_CONFIG_PATH :=\t$(shell cygpath --unix ${StroikaBuildsRoot}$(CONFIGURATION)/lib/pkgconfig)\n")
    else:
        w("export PKG_CONFIG_PATH :=\t$(shell realpath --canonicalize-missing ${StroikaBuildsRoot}$(CONFIGURATION)/lib/pkgconfig)\n")
    w("\n")
    w("\n")
    for vn in ("ARCH", "CMAKE", "TOOLS_PATH_ADDITIONS", "CC", "CXX", "AS", "RC", "MIDL"):
        CachedLineItem(vn)
    CachedLineItem("AssertionsEnabled", c.gAssertionsEnabled)
    for vn in ("Platform_LinkerArgs_LibPath", "LinkTime_CopyFilesToEXEDir", "PLATFORM_INCLUDES_PATH", "FOUNDATION_INCLUDES_PATH",
               "VSVARS_PLATFORM_INCLUDES_PATH", "VSVARS_MSVC_RUNTIME_LIBRARY", "PLATFORM_CPPFLAGS_NOTINCLUDES"):
        CachedLineItem(vn)
    w("\n#Compiler include format of varaible PLATFORM_INCLUDES_PATH\n")
    w("PLATFORM_CPPFLAGS_INCLUDES :=\t" + c.PLATFORM_CPPFLAGS_INCLUDES + "\n")
    w("\n# Utility combination (widely used in building third party components)\n")
    w("PLATFORM_CPPFLAGS :=\t${PLATFORM_CPPFLAGS_NOTINCLUDES} ${PLATFORM_CPPFLAGS_INCLUDES}\n")
    w("\n# SB same as cached config variable but not done yet\n")
    w("PLATFORM_CFLAGS :=\t" + c.CFLAGS + "\n")
    w("\n# SB same as cached config variable but not done yet\n")
    w("PLATFORM_CXXFLAGS :=\t" + c.CXXFLAGS + "\n")
    w("\n")
    for vn in ("STRIP", "AR", "LIBTOOL", "RANLIB"):
        CachedLineItem(vn)
    w("\n")
    CachedLineItem("RunPrefix")
    CachedLineItem("CrossCompiling")
    w("\n")
    w("CONFIGURATION := " + c.name + "\n")
    for vn in ("qCompiler_HasNoMisleadingIndentation_Flag", "qFeatureFlag_ATLMFC", "qFeatureFlag_boost", "qFeatureFlag_fmtlib",
               "qFeatureFlag_GoogleTest", "qFeatureFlag_LibCurl", "qFeatureFlag_LZMA", "qFeatureFlag_mongocxxdriver", "qFeatureFlag_OpenSSL",
               "qFeatureFlag_OpenSSL_ExtraArgs", "qFeatureFlag_sqlite", "qFeatureFlag_StrawberryPerl", "qFeatureFlag_WinHTTP", "qFeatureFlag_WIX",
               "qFeatureFlag_Xerces", "qFeatureFlag_libxml2", "qFeatureFlag_ZLib", "qFeatureFlag_zstd", "ConfigTags", "SanitizerFlags"):
        CachedLineItem(vn)
    w("\n\n")
    w("#Configured Command Line Arguments (-make-define)\n")
    for d in c.useExtraMakeDefines:
        w(d + "\n")
    w("\n\n")
    w("#Script to map filenames to native format (for windows)\n")
    w('##\tEG USE AS:   CPPFLAGS += -I"$(call FUNCTION_CONVERT_FILES_TO_COMPILER_NATIVE ,${StroikaBuildsRoot})..."\n')
    if IsVisualStudio_(c.BuildPlatform):
        w("FUNCTION_CONVERT_FILES_TO_COMPILER_NATIVE=$(shell cygpath --ignore --mixed $1)\n")
        w("FUNCTION_CONVERT_FILEPATH_TO_COMPILER_NATIVE=$(shell cygpath --ignore --mixed $1)\n")
    else:
        w("FUNCTION_CONVERT_FILES_TO_COMPILER_NATIVE=$1\n")
        w("FUNCTION_CONVERT_FILEPATH_TO_COMPILER_NATIVE=$1\n")
    w("\n\n")
    w("\n\n")
    w("#Linker flags\n")
    w("Platform_LinkerArgs_LibPath := " + c.Platform_LinkerArgs_LibPath + "\n")
    w("#\n")
    w("Platform_LinkerArgs_ExtraPrefix :=\t" + c.Platform_LinkerArgs_ExtraPrefix + "\n")
    w("Platform_LinkerArgs_ExtraSuffix :=\t" + c.Platform_LinkerArgs_ExtraSuffix + "\n")
    w("IncludeDebugSymbolsInExecutables :=\t" + c.IncludeDebugSymbolsInExecutables + "\n")
    w("IncludeDebugSymbolsInLibraries :=\t" + c.IncludeDebugSymbolsInLibraries + "\n")
    w("#Linker-Driver\n")
    CachedLineItem("LINKER")
    w("\n\n#File Suffixes\n")
    for vn in ("LIB_SUFFIX", "OBJ_SUFFIX", "EXE_SUFFIX"):
        CachedLineItem(vn)
    w("\n")
    w("\n")
    if IsVisualStudio_(c.BuildPlatform):
        w("\n")
        w("##\n")
        w("##\n")
        w("## Windows format path versions of some of these variables\n")
        w("##\n")
        w('##WIN_$var = cygpath --ignore --mixed "$var"                OR\n')
        w('##WIN_$var = cygpath --ignore --mixed --path "$var"         (as appropriate)\n')
        w("##\n")
        w("##\n")
        w("CMAKE=" + c.G("CMAKE") + "\n")
        arch = c.G("ARCH")
        w("WIN_LIBCOMPATIBLE_ARCH=" + ("x64" if arch == "x86_64" else arch) + "\n")  # lib.exe (and probably link) want x64
        # Not a great way to test, but adequate: it is not critical that it is always right. And we tend to use -Z7 - so
        # this really doesn't get used much - may not be needed anymore. Not sure why we would use this 'feature' of the
        # linker system on MSVC -- LGP 2025-06-11
        if "-Zi" in c.CXXFLAGS or "-Zl" in c.CXXFLAGS:
            w("WIN_USE_PROGRAM_DATABASE=1\n")
        w("\n")
        w("\n")
    w("OUT_ARG_PREFIX_NATIVE := -OUT:\n" if IsVisualStudio_(c.BuildPlatform) else "OUT_ARG_PREFIX_NATIVE := -o \n")
    w("\n")
    return "".join(out)


def CMakeString_(s):
    """s as a CMake quoted argument"""
    return '"' + s.replace("\\", "\\\\").replace('"', '\\"').replace("$", "\\$") + '"'


def ToolchainText_(c):
    """
    The configuration's CMake toolchain file: the compilers and flags with which a CMake build builds as this configuration -
    Stroika's own (Library/CMakeLists.txt), and the third-party components Build/Lib/Make/Makefile-CMake-Common.mk builds
    (each with its own flags).
    """
    flags = lambda *parts: " ".join(p.strip() for p in parts if p.strip())  # noqa: E731
    out = []
    w = out.append
    w("# The CMake toolchain file for the Stroika configuration " + c.name + " - written by Build/Scripts/ApplyConfiguration from\n")
    w("# its ConfigurationFiles/" + c.name + ".xml: the compilers and flags with which a CMake build builds as that configuration.\n")
    w("#     cmake -DCMAKE_TOOLCHAIN_FILE=<this file> ...\n")
    w("# The flags are cache entries, as -D makes them, so a -D on the command line wins over them. Not here: the generator, and a\n")
    w("# Visual Studio generator's platform (-A); CMAKE_POLICY_DEFAULT_CMP0091 and CMP0141 (NEW, for the MSVC settings below),\n")
    w("# which cmake reads before this file; and the build type - a project can pick its own before cmake reads this file (fmtlib\n")
    w("# picks Release, at its project ()), so a single-configuration generator's goes on the command line (None, below); a\n")
    w("# Visual Studio generator needs none, and some projects react to one anyway (zstd 1.5.7 adds -DDEBUGLEVEL=1, given Debug).\n")
    w("\n")
    if IsVisualStudio_(c.BuildPlatform):
        debug = c.gAssertionsEnabled == 1
        buildType = "Debug" if debug else "Release"
        # a Visual Studio generator ignores these, using the compiler of the Visual Studio it builds with
        w("set(CMAKE_C_COMPILER " + CMakeString_(c.G("CC")) + ")\n")
        w("set(CMAKE_CXX_COMPILER " + CMakeString_(c.G("CXX")) + ")\n")
        w("\n")
        w("# the same C runtime as Stroika's own code - a mismatch is an LNK2038 when something links both (needs CMP0091 NEW)\n")
        w("set(CMAKE_MSVC_RUNTIME_LIBRARY " + CMakeString_(c.G("VSVARS_MSVC_RUNTIME_LIBRARY")) + ")\n")
        if debug:
            w("# -Z7, as Stroika's own code: debug information in each object, so none missing from an installed library (needs CMP0141 NEW)\n")
            w("set(CMAKE_MSVC_DEBUG_INFORMATION_FORMAT Embedded)\n")
        w("\n")
        w("# the configuration's flags for the build type it builds (--config " + buildType + "), replacing cmake's for it\n")
        w("set(CMAKE_C_FLAGS_" + buildType.upper() + " " + CMakeString_(flags(c.PLATFORM_CPPFLAGS_NOTINCLUDES, c.CFLAGS)) + ' CACHE STRING "")\n')
        w("set(CMAKE_CXX_FLAGS_" + buildType.upper() + " " + CMakeString_(flags(c.PLATFORM_CPPFLAGS_NOTINCLUDES, c.CXXFLAGS)) + ' CACHE STRING "")\n')
        w("# and for its links cmake's flags (/debug with Debug), but /INCREMENTAL:NO (Stroika's links take the configuration's own\n")
        w("# from Stroika-Configuration.cmake): ASan, -LTCG and -OPT:REF each rule out linking incrementally, which a Visual Studio\n")
        w("# generator asks for given -DEBUG - and each link would warn that it ignores /INCREMENTAL (LNK4300, LNK4075)\n")
        linkFlags = "/debug /INCREMENTAL:NO" if debug else "/INCREMENTAL:NO"
        for kind in ("EXE", "MODULE", "SHARED"):
            w("set(CMAKE_" + kind + "_LINKER_FLAGS_" + buildType.upper() + ' "' + linkFlags + '" CACHE STRING "")\n')
    else:
        which = lambda exe: Backtick_(["which", exe])[0].strip()  # noqa: E731 - as make's $(shell which ...): empty if not found
        w("set(CMAKE_C_COMPILER " + CMakeString_(which(c.G("CC"))) + ")\n")
        w("set(CMAKE_CXX_COMPILER " + CMakeString_(which(c.G("CXX"))) + ")\n")
        w("set(CMAKE_AR " + CMakeString_(which(c.G("AR"))) + ' CACHE FILEPATH "")\n')
        w("set(CMAKE_RANLIB " + CMakeString_(which(c.G("RANLIB"))) + ' CACHE FILEPATH "")\n')
        if c.G("STRIP").strip() != "":
            w("set(CMAKE_STRIP " + CMakeString_(which(c.G("STRIP"))) + ' CACHE FILEPATH "")\n')
        arch = c.G("ARCH").strip()
        if IS_MACOS_HOST_ and "clang++" in c.G("CXX") and arch != "":  # as configure, which then gives the flags -arch ARCH
            w("\n")
            w("# the configuration's architecture, as its flags' -arch: given none, cmake on an Apple Silicon Mac adds -arch for the\n")
            w("# host's own - so a configuration for another (Release-x86_64) would build both\n")
            w("set(CMAKE_OSX_ARCHITECTURES " + CMakeString_(arch) + ' CACHE STRING "")\n')
        w("\n")
        w("# the configuration's flags, all of them - with build type None (Debian's packaging convention), cmake adds none for\n")
        w("# a build type\n")
        w("set(CMAKE_C_FLAGS " + CMakeString_(flags(c.PLATFORM_CPPFLAGS_NOTINCLUDES, c.CFLAGS)) + ' CACHE STRING "")\n')
        w("set(CMAKE_CXX_FLAGS " + CMakeString_(flags(c.PLATFORM_CPPFLAGS_NOTINCLUDES, c.CXXFLAGS)) + ' CACHE STRING "")\n')
    return "".join(out)


def StroikaConfigurationText_(c):
    """
    The configuration's Stroika settings, for Stroika's own CMake build (Library/CMakeLists.txt, which reads them from beside
    the toolchain file it is given): its target platforms, each optional component's feature flag, where make installs the
    third-party components, and Foundation's preprocessor definitions and include directories - what make takes from
    Configuration.mk and stroika-foundation.pc.
    """
    vs = IsVisualStudio_(c.BuildPlatform)
    path = lambda p: Backtick_(["cygpath", "--mixed", p])[0].strip() if vs else p  # noqa: E731 - cmake on Windows takes C:/...
    items = lambda values: " ".join(CMakeString_(v) for v in values)  # noqa: E731
    foundationFlags = c.G("FOUNDATION_CPPFLAGS_NOTINCLUDES").split()
    out = []
    w = out.append
    w("# Stroika's own settings for the configuration " + c.name + " - written by Build/Scripts/ApplyConfiguration from its\n")
    w("# ConfigurationFiles/" + c.name + ".xml, for Stroika's CMake build, which reads this file from beside the configuration's\n")
    w("# Toolchain.cmake.\n")
    w("\n")
    w("set(STROIKA_CONFIGURATION " + CMakeString_(c.name) + ")\n")
    w("set(STROIKA_BUILD_PLATFORM " + CMakeString_(c.BuildPlatform) + ")\n")
    w("set(STROIKA_TARGET_PLATFORMS " + items(c.TargetPlatforms.split()) + ")\n")
    w("set(STROIKA_ARCH " + CMakeString_(c.G("ARCH").strip()) + ")\n")
    w("set(STROIKA_OPENSSL_EXTRA_ARGS " + CMakeString_(c.G("qFeatureFlag_OpenSSL_ExtraArgs").strip()) + ")\n")
    w("set(STROIKA_ASSERTIONS_ENABLED " + ("ON" if c.gAssertionsEnabled else "OFF") + ")\n")
    # the C++ standard the configuration's flags name (configure's --cppstd-version) - MSVC's c++latest is 23 to cmake
    standard = ""
    for f in c.CXXFLAGS.split():
        m = re.match(r"^[-/]+std[=:](?:c|gnu)\+\+(\w+)$", f)
        if m:
            standard = {"latest": "23", "2a": "20", "2b": "23", "2c": "26"}.get(m.group(1), m.group(1))
    w("set(STROIKA_CXX_STANDARD " + CMakeString_(standard) + ")\n")
    w("\n")
    w("# the configuration's compiler flags without its platform's preprocessor definitions (PLATFORM_CFLAGS, PLATFORM_CXXFLAGS) -\n")
    w("# what make gives a third-party component that takes its flags from the environment (OpenSSL)\n")
    w("set(STROIKA_PLATFORM_C_FLAGS " + CMakeString_(c.CFLAGS) + ")\n")
    w("set(STROIKA_PLATFORM_CXX_FLAGS " + CMakeString_(c.CXXFLAGS) + ")\n")
    if vs:
        w("# the Visual Studio it builds with - whose VC/Auxiliary/Build/vcvarsall.bat sets up a command's environment for it\n")
        w("set(STROIKA_BUILD_TOOLS_ROOT " + CMakeString_(path(c.BuildToolsRoot)) + ")\n")
    w("\n")
    w("# where the configuration's third-party components are installed - their headers, libraries and CMake packages\n")
    w("set(STROIKA_BUILDS_DIR " + CMakeString_(path(DirectoryLayout.BUILDS_ROOT + c.name) + "/") + ")\n")
    w("\n")
    w("# each optional component: use (Stroika builds it), use-system, or no - configure's --<component>\n")
    for feature in ("ATLMFC", "boost", "fmtlib", "GoogleTest", "LibCurl", "LZMA", "mongocxxdriver", "OpenSSL", "sqlite", "StrawberryPerl",
                    "WinHTTP", "WIX", "Xerces", "libxml2", "ZLib", "zstd"):
        w("set(STROIKA_FEATURE_" + feature + " " + CMakeString_(c.G("qFeatureFlag_" + feature)) + ")\n")
    w("\n")
    w("# Foundation's preprocessor definitions and include directories, and the platform's include directories\n")
    w("set(STROIKA_FOUNDATION_DEFINITIONS " + items(f[2:] for f in foundationFlags if f.startswith("-D")) + ")\n")
    w("set(STROIKA_FOUNDATION_COMPILE_OPTIONS " + items(f for f in foundationFlags if not f.startswith("-D")) + ")\n")
    w("set(STROIKA_FOUNDATION_INCLUDE_DIRECTORIES " + items(path(p) for p in SplitList_(c.FOUNDATION_INCLUDES_PATH, PATH_SEPERATOR_)) + ")\n")
    w("set(STROIKA_PLATFORM_INCLUDE_DIRECTORIES " + items(path(p) for p in SplitList_(c.PLATFORM_INCLUDES_PATH, PATH_SEPERATOR_)) + ")\n")
    w("\n")
    w("# what links Foundation links with: the configuration's link options and system libraries (stroika-platform.pc's Libs)\n")
    linkOptions = shlex.split(c.Platform_LinkerArgs_ExtraPrefix) + shlex.split(c.Platform_LinkerArgs_LibPath) + shlex.split(c.Platform_LinkerArgs_ExtraSuffix)
    w("set(STROIKA_LINK_OPTIONS " + items(linkOptions) + ")\n")
    w("set(STROIKA_LINK_LIBRARIES " + items(shlex.split(c.G("Platform_LinkerArgs_LibDependencies"))) + ")\n")
    w("# the files each executable needs beside it (with MSVC's AddressSanitizer, its runtime DLL): LinkTime_CopyFilesToEXEDir\n")
    w("set(STROIKA_COPY_FILES_TO_EXE_DIR " + items(path(f) for f in shlex.split(c.G("LinkTime_CopyFilesToEXEDir"))) + ")\n")
    w("# whether an installer keeps a program's debug symbols - else it strips them, with the toolchain file's CMAKE_STRIP\n")
    w("set(STROIKA_INCLUDE_DEBUG_SYMBOLS_IN_EXECUTABLES " + ("ON" if c.IncludeDebugSymbolsInExecutables == "1" else "OFF") + ")\n")
    w("\n")
    w("# how the regression tests run: the configuration's command prefix, and the bash that runs Tests/Scripts/RunTest (this\n")
    w("# host's - on Windows, MSYS2's or Cygwin's, not a bash.exe that is WSL's)\n")
    w("set(STROIKA_RUN_PREFIX " + CMakeString_(c.G("RunPrefix")) + ")\n")
    bash = path(Backtick_(["which", "bash"])[0].strip())
    w("set(STROIKA_BASH " + CMakeString_(bash + (".exe" if vs and not bash.endswith(".exe") else "")) + ")\n")
    return "".join(out)


def CMakePresetsText_(c, existingText):
    """
    The new CMakeUserPresets.json, given the old (None if there is none) - in the old one's line ending: the configuration's
    configure, build and test presets, each named for it, building it with Stroika's CMake build (CMakeLists.txt) - its
    generator, its toolchain file, and its build directory, CMake/ beside its Configuration.mk. Other presets are kept.
    """
    vs = IsVisualStudio_(c.BuildPlatform)
    configurationDir = DirectoryLayout.AbsoluteDir(DirectoryLayout.INTERMEDIATE_FILES_ROOT) + c.name + "/"
    configure = {"name": c.name}
    if vs:
        # the configuration's Visual Studio (its version: VisualStudio.Net-<year>), and the -A make's CMake builds give
        m = re.match(r"VisualStudio\.Net-(\d+)$", c.BuildPlatform)
        version = {"2022": "17", "2026": "18"}.get(m.group(1)) if m else None
        if version is not None:
            configure["generator"] = "Visual Studio " + version + " " + m.group(1)
        configure["architecture"] = "x64" if c.G("ARCH").strip() == "x86_64" else "Win32"
    else:
        configure["generator"] = "Unix Makefiles"  # so its steps' own builds share the build's job slots (CMakeLists.txt)
    configure["binaryDir"] = configurationDir + "CMake"
    configure["toolchainFile"] = configurationDir + "Toolchain.cmake"
    if vs:
        configure["cmakeExecutable"] = c.G("CMAKE")  # Visual Studio's, which knows its generator - for an IDE: cmake ignores it
    build = {"name": c.name, "configurePreset": c.name}
    test = {"name": c.name, "configurePreset": c.name, "output": {"outputOnFailure": True}}
    if vs:
        # the build type, as make's CMake builds give it (Makefile-CMake-Common.mk): Debug where assertions are on
        build["configuration"] = test["configuration"] = "Debug" if c.gAssertionsEnabled == 1 else "Release"

    try:
        doc = json.loads(existingText) if existingText is not None else {}
        if not isinstance(doc, dict):
            raise ValueError
    except ValueError:  # not JSON, or not an object: start afresh
        doc = {}
    version = doc.get("version")
    doc["version"] = version if isinstance(version, int) and version > 3 else 3  # 3: CMake 3.21, the first with toolchainFile
    for key, preset in (("configurePresets", configure), ("buildPresets", build), ("testPresets", test)):
        presets = doc.get(key) if isinstance(doc.get(key), list) else []
        presets = [p for p in presets if not (isinstance(p, dict) and p.get("name") == c.name)] + [preset]
        doc[key] = sorted(presets, key=NameSortKey_)
    newline = "\r\n" if existingText is not None and "\r\n" in existingText else "\n"
    return (json.dumps(doc, indent=2, ensure_ascii=False) + "\n").replace("\n", newline)


def PkgConfigWords_(c, which):
    """
    The words of pkg-config WHICH (--cflags-only-I / --cflags-only-other) for the configuration's Foundation packages - those
    the configuration built itself, in its Builds/CONFIGURATION/lib/pkgconfig, or else the system's; nothing if any is missing.
    So nothing before the third-party components are built: make re-applies the .vscode entry as that directory changes.
    """
    if c.Foundation_PkgConfigNames.strip() == "":
        return []
    pcDir = DirectoryLayout.ShellPath(DirectoryLayout.BUILDS_ROOT + c.name + "/lib/pkgconfig")  # PKG_CONFIG_PATH is a :-separated list
    out, _ = Backtick_(["pkg-config", which] + c.Foundation_PkgConfigNames.split(), env=dict(os.environ, PKG_CONFIG_PATH=pcDir))
    return out.split()


def AppendPkgConfigIncludes_(c, paths):
    """paths, with each -I directory pkg-config gives for the configuration's packages that paths does not already name"""
    dirs = [e[2:] for e in PkgConfigWords_(c, "--cflags-only-I") if e.startswith("-I") and len(e) > 2]
    if IS_WINDOWS_HOST_ and dirs:
        dirs = Backtick_(["cygpath", "--mixed"] + dirs)[0].splitlines()  # (which also folds a .pc's ${pcfiledir}/../..)
    elif not IS_WINDOWS_HOST_:
        dirs = [os.path.normpath(d) for d in dirs]
    Key = lambda p: p.rstrip("/\\").lower() if IS_WINDOWS_HOST_ else p.rstrip("/")  # noqa: E731
    seen = {Key(p) for p in paths}
    for d in dirs:
        if d.strip() != "" and Key(d) not in seen:
            seen.add(Key(d))
            paths.append(d)
    return paths


def MapArraysOfFiles2Path_(conditionalPaths, backupPaths):
    """The Windows form of each of conditionalPaths that exists (or, if none does, of each of backupPaths), each once"""
    result = []
    for f in [f for f in conditionalPaths if os.path.exists(f)] or backupPaths:
        w = Backtick_(["cygpath", "--windows", f])[0].strip()
        if w.lower() not in (r.lower() for r in result):
            result.append(w)
    return ";".join(result)


def GetMSYSPathVar2Add_():
    # GUESS directory for MSYS - the running one's first
    backup = ["c:/tools/msys64/usr/bin", "c:/tools/msys32/usr/bin", "c:/tools/msys64/mingw64/bin", "c:/msys/usr/bin", "c:/msys64/usr/bin",
              "c:/msys64/mingw64/bin"]
    return MapArraysOfFiles2Path_((["/usr/bin"] if IS_MSYS_HOST_ else []) + backup, backup)


def GetCygwinPathVar2Add_():
    backup = ["c:/tools/cygwin/bin", "c:/cygwin/bin", "c:/cygwin64/bin", "c:/cygwin32/bin"]
    return MapArraysOfFiles2Path_((["/usr/bin"] if IS_WINDOWS_HOST_ and not IS_MSYS_HOST_ else []) + backup, backup)


PROPS_START_ = "<PropertyGroup Condition="
PROPS_KEY_PREFIX_ = "  <PropertyGroup Condition=\"'$(Configuration)|$(Platform)'=='"


def ReadPropsEntries_(text):
    """The .props file's per-configuration PropertyGroups: {configuration: its lines}, in file order"""
    entries = {}
    extracting = ""
    for line in re.split(r"(?<=\n)", text):
        if line == "":
            continue
        if PROPS_START_ not in line:
            if extracting != "":
                entries[extracting] += line
            if "</PropertyGroup>" in line:
                extracting = ""
        else:
            k = line[len(PROPS_KEY_PREFIX_):]
            k = k[:k.find("|")] if "|" in k else k[:-1]  # (with no |, all but its last character)
            extracting = k
            entries[k] = line
    return entries


def VSIntellisenseText_(c, existingText):
    entries = ReadPropsEntries_(existingText)
    out = []
    w = out.append
    w("<!--\n")
    w(" Copyright(c) Sophist Solutions, Inc. 1990-2026.  All rights reserved\n")
    w("-->\n")
    w("\n")
    w("\n")
    w("<!--WARNING: THIS FILE WAS AUTOGENERATED WITH ApplyConfiguration-->\n" * 6)
    w("\n")
    w("\n")
    w('<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003" TreatAsLocalProperty="Platform">\n')
    # the other configurations' entries, sorted - so the file is the same from run to run
    for k in sorted(entries):
        if k != c.name:
            w(entries[k])
    w("  <PropertyGroup Condition=\"'$(Configuration)|$(Platform)'=='" + c.name + "|Win32'\">\n")
    defs = [e[2:] for e in c.CPPFLAGS_NOTINCLUDES.split(" ") if e.startswith("-D")]
    defs += [e[2:].strip() for e in PkgConfigWords_(c, "--cflags-only-other") if e.startswith("-D")]
    w("    <NMakePreprocessorDefinitions>" + ";".join(defs) + "</NMakePreprocessorDefinitions>\n")
    paths = AppendPkgConfigIncludes_(
        c, SplitList_(c.FOUNDATION_INCLUDES_PATH + PATH_SEPERATOR_ + c.PLATFORM_INCLUDES_PATH, PATH_SEPERATOR_))
    w("    <NMakeIncludeSearchPath>" + ";".join(paths) + "</NMakeIncludeSearchPath>\n")
    w("  </PropertyGroup>\n")
    # configuration variables, so Visual Studio can run the MSYS or Cygwin make without the user adding it to a path - the
    # one this runs under first. StroikaBuildToolsExtraPath augments ExecutablePath in the .vcproj files, so the make uses
    # the right path
    hostStkBuildPath, otherStkBuildPath = GetMSYSPathVar2Add_(), GetCygwinPathVar2Add_()
    if not IS_MSYS_HOST_:
        hostStkBuildPath, otherStkBuildPath = otherStkBuildPath, hostStkBuildPath
    w("\n")
    w('  <PropertyGroup Label="UserMacros">\n')
    w("    <StroikaBuildToolsExtraPath>" + hostStkBuildPath + ";" + otherStkBuildPath + "</StroikaBuildToolsExtraPath>\n")
    w("    <JOBS_FLAG>-j 5</JOBS_FLAG>\n")
    w("  </PropertyGroup>\n")
    w("  <PropertyGroup Label=\"UserMacros\" Condition=\"'$(Configuration)|$(Platform)'=='" + c.name + "|Win32'\">\n")
    w("    <StroikaBuildToolsExtraPath>" + hostStkBuildPath + "</StroikaBuildToolsExtraPath>\n")
    w("  </PropertyGroup>\n")
    w("  <ItemGroup>\n")
    w('  <BuildMacro Include="StroikaBuildToolsExtraPath">\n')
    w("     <Value>$(StroikaBuildToolsExtraPath)</Value>\n")
    w("  </BuildMacro>\n")
    w('  <BuildMacro Include="JOBS_FLAG">\n')
    w("     <Value>$(JOBS_FLAG)</Value>\n")
    w("  </BuildMacro>\n")
    w("  </ItemGroup>\n")
    w("</Project>\n")
    w("\n")
    return "".join(out)


def ToFullPathEXE_(exe):
    out, rc = Backtick_(["which", exe])
    return exe if rc != 0 else out.strip()


def MSVCLatestCppStandard_(compiler):
    """
    The IntelliSense cppStandard for MSVC's -std:c++latest - a newer draft with each MSVC - asked of the compiler itself: the
    latest finished standard at or below the _MSVC_LANG it reports, never a draft. Without an answer (the compiler is not on
    this machine, say), c++23: what both supported MSVCs come to (19.44 and 19.51 report 202400L).
    """
    try:
        with tempfile.TemporaryDirectory() as d:
            with open(os.path.join(d, "probe.cpp"), "w") as f:
                f.write("_MSVC_LANG\n")
            # MSYS2_ARG_CONV_EXCL, as make exports it: else MSYS2 makes /nologo a path, for a native program
            p = subprocess.run([compiler, "/nologo", "/std:c++latest", "/EP", "probe.cpp"], cwd=d, stdout=subprocess.PIPE,
                               stderr=subprocess.DEVNULL, timeout=60, env=dict(os.environ, MSYS2_ARG_CONV_EXCL="*"))
        m = re.search(r"\b(\d{6})L\b", p.stdout.decode(ENC_, errors="replace"))
        if p.returncode == 0 and m:
            for value, name in ((202302, "c++23"), (202002, "c++20")):
                if int(m.group(1)) >= value:
                    return name
    except (OSError, subprocess.SubprocessError):
        pass
    return "c++23"


def IntelliSenseModeFor_(c, compilerDriver):
    """
    (compiler, ARCH, host) as the VS Code C/C++ extension's intelliSenseMode: <os>-<toolset>-<arch>, os windows|linux|macos,
    toolset msvc|gcc|clang, arch x86|x64|arm|arm64 (not Stroika's x86_64). Without a VALID one the extension configures no
    IntelliSense at all, silently - left to itself it wrote "None", which is not one (found 2026-09-22).
    """
    os_ = "macos" if IS_MACOS_HOST_ else ("windows" if IS_WINDOWS_HOST_ else "linux")
    lc = compilerDriver.lower()
    toolSet = "msvc" if "cl.exe" in lc else ("clang" if "clang" in lc else "gcc")
    arch = c.G("ARCH").strip()
    if arch == "" or arch == "x86_64":
        arch = "x64"
    elif arch == "aarch64":
        arch = "arm64"
    elif arch.startswith("arm") and arch != "arm64":
        arch = "arm"
    return os_ + "-" + toolSet + "-" + arch


def VSCodeText_(c, existingText):
    """The new .vscode/c_cpp_properties.json, given the old (None if there is none) - in the old one's line ending"""
    EMPTY = '{"configurations":[]}\n'
    text = EMPTY if existingText is None else existingText
    try:
        doc = json.loads(text)
        if not (isinstance(doc, (dict, list)) and len(doc) > 0):  # empty, or not an object or array: start afresh
            raise ValueError
    except ValueError:
        doc = json.loads(EMPTY)
    # myDefaultIncludePath, if missing (an .env that is not an object is left as it is). Empty: the
    # project's own include directories, for it to add. NOT ${workspaceFolder}: IntelliSense searches includePath for <...>
    # includes too, so it would take a Skel app's root VERSION file for <version> (case-insensitive on Windows)
    env = doc.get("env") if isinstance(doc, dict) else None
    if isinstance(doc, dict) and (env is None or (isinstance(env, dict) and env.get("myDefaultIncludePath") is None)):
        if env is None:
            doc["env"] = {}
        doc["env"]["myDefaultIncludePath"] = []
    configs = doc.get("configurations") if isinstance(doc, dict) else None
    configs = configs if isinstance(configs, list) else []
    index = len(configs)
    for i, e in enumerate(configs):
        if isinstance(e, dict) and e.get("name") == c.name:
            index = i

    # cppStandard: from the flags' --std= or -std: (the last word, if one holds more)
    std = "c++17"
    l = c.CXXFLAGS.find("--std=")
    if l != -1:
        std = c.CXXFLAGS[l + 6:]
    l = c.CXXFLAGS.find("-std:")
    if l != -1:
        std = c.CXXFLAGS[l + 5:]
    if " " in std:
        std = std[:std.find(" ")]
    if std == "c++2a":
        std = "c++20"
    elif std == "c++latest":
        std = MSVCLatestCppStandard_(c.COMPILER_DRIVER_CPlusPlus)

    includes = AppendPkgConfigIncludes_(
        c, ["${myDefaultIncludePath}"] + SplitList_(c.FOUNDATION_INCLUDES_PATH + PATH_SEPERATOR_ + c.PLATFORM_INCLUDES_PATH, PATH_SEPERATOR_))
    defines = [e[2:] for e in c.CPPFLAGS_NOTINCLUDES.split(" ") if e.startswith("-D")]
    defines += [e[2:].strip() for e in PkgConfigWords_(c, "--cflags-only-other") if e.startswith("-D")]
    newCfg = {
        "name": c.name,
        "cppStandard": std,
        "includePath": includes,
        "defines": defines,
        "compilerPath": ToFullPathEXE_(c.COMPILER_DRIVER_CPlusPlus),
        "intelliSenseMode": IntelliSenseModeFor_(c, c.COMPILER_DRIVER_CPlusPlus),
    }
    if index == len(configs):
        configs.append(newCfg)
    else:
        configs[index] = newCfg
    doc["configurations"] = sorted(configs, key=NameSortKey_)
    newline = "\r\n" if existingText is not None and "\r\n" in existingText else "\n"
    return (json.dumps(doc, indent=2, ensure_ascii=False) + "\n").replace("\n", newline)


def NameSortKey_(e):
    """The sort key for a JSON array's entries: by name, ignoring ASCII case only; an entry with no name first"""
    name = e.get("name") if isinstance(e, dict) else None
    return name.translate(str.maketrans("ABCDEFGHIJKLMNOPQRSTUVWXYZ", "abcdefghijklmnopqrstuvwxyz")) if isinstance(name, str) else ""


def ReadText_(path, encoding):
    try:
        with open(path, "rb") as f:
            return f.read().decode(encoding)
    except OSError:
        return None


def WriteBytes_(path, data):
    os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
    with open(path, "wb") as f:
        f.write(data)


def Main_(argv):
    genVSCode = genConfigMake = genVSIntellisense = True
    activeConfiguration = None
    for var in argv:
        if var.lower() in ("-help", "--help", "-?"):
            print("Usage:")
            print("\tApplyConfiguration [OPTIONS] CONFIGURATION")
            print("\t  where options can be:")
            print("\t    --help              /* print this help */")
            print("\t    --only-vscode       /* only update .vscode/cpp stuff */")
            sys.exit(0)
        elif var.lower() == "--only-vscode":
            genConfigMake = genVSIntellisense = False
        else:
            activeConfiguration = var
    if activeConfiguration is None:
        Die_("Missing argument configuration\n")

    leader = "   " * (int(os.environ.get("MAKE_INDENT_LEVEL", "0") or "0") + 1)  # Build/Scripts/PrintLevelLeader's output
    configMk = DirectoryLayout.INTERMEDIATE_FILES_ROOT + activeConfiguration + "/Configuration.mk"
    c = Config_(activeConfiguration)
    genVSIntellisense = genVSIntellisense and IsVisualStudio_(c.BuildPlatform)

    if genConfigMake:
        if os.path.exists(configMk):
            os.remove(configMk)
        os.makedirs(DirectoryLayout.INTERMEDIATE_FILES_ROOT + activeConfiguration + "/Library", exist_ok=True)
        sys.stdout.write(leader + 'Writing "' + DirectoryLayout.ForDisplay(configMk) + '" ... ')
        sys.stdout.flush()
        WriteBytes_(configMk, ConfigurationMkText_(c).encode(ENC_))
        sys.stdout.write("done\n")
        toolchain = DirectoryLayout.INTERMEDIATE_FILES_ROOT + activeConfiguration + "/Toolchain.cmake"
        sys.stdout.write(leader + 'Writing "' + DirectoryLayout.ForDisplay(toolchain) + '" ... ')
        sys.stdout.flush()
        WriteBytes_(toolchain, ToolchainText_(c).encode(ENC_))
        sys.stdout.write("done\n")
        stroikaConfiguration = DirectoryLayout.INTERMEDIATE_FILES_ROOT + activeConfiguration + "/Stroika-Configuration.cmake"
        sys.stdout.write(leader + 'Writing "' + DirectoryLayout.ForDisplay(stroikaConfiguration) + '" ... ')
        sys.stdout.flush()
        WriteBytes_(stroikaConfiguration, StroikaConfigurationText_(c).encode(ENC_))
        sys.stdout.write("done\n")
        sys.stdout.write(leader + "Updating configuration " + activeConfiguration + ' in "' + DirectoryLayout.ForDisplay(CMAKE_PRESETS_FILE_) + '" ... ')
        sys.stdout.flush()
        WriteBytes_(CMAKE_PRESETS_FILE_, CMakePresetsText_(c, ReadText_(CMAKE_PRESETS_FILE_, "utf-8")).encode("utf-8"))
        sys.stdout.write("done\n")
        sys.stdout.write(leader)
        sys.stdout.flush()
        # THIS_DIR_ is in the path form sys.executable takes (a POSIX python3 takes a C:/... path as relative)
        rc = subprocess.call([sys.executable, os.path.join(THIS_DIR_, "CreatePackageConfigFiles"), "--configuration", activeConfiguration])
        if rc != 0:
            Die_("Error running CreatePackageConfigFiles --configuration " + activeConfiguration + " - exiting\n", rc & 0xFF or 255)
    if genVSIntellisense:
        sys.stdout.write(leader + 'Updating "' + VS_INTELLISENSE_FILE_ + '" ... ')
        WriteBytes_(VS_INTELLISENSE_FILE_, VSIntellisenseText_(c, ReadText_(VS_INTELLISENSE_FILE_, "utf-8") or "").encode("utf-8"))
        sys.stdout.write("done\n")
    if genVSCode:
        sys.stdout.write(leader + "Updating configuration " + activeConfiguration + ' in "' + VSCODE_CPP_FILE_ + '" ... ')
        WriteBytes_(VSCODE_CPP_FILE_, VSCodeText_(c, ReadText_(VSCODE_CPP_FILE_, "utf-8")).encode("utf-8"))
        sys.stdout.write("done\n")
    sys.stdout.flush()


Main_(sys.argv[1:])
