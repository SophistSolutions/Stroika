#!/bin/bash

export USE_TEST_BASENAME="${USE_TEST_BASENAME:-WSL_Ubuntu_Simple}"
if [ "$BRANCH" == "" ] ; then
    BRANCH=$(git symbolic-ref --short HEAD)
fi
VERSION=`./Build/Scripts/ExtractVersionInformation STROIKA_VERSION FullVersionString`

# Default: where RunRemoteRegressionTests builds on its target. It belongs on the distro's own disk, NOT under /mnt/c
# (the Windows drive, far slower) - so where ~/Sandbox is a symbolic link to /mnt/c/Sandbox, as on some WSL dev boxes,
# the invoker sets this (Documentation/Regression-Tests.md uses /var/tmp). And not /tmp: on Ubuntu 25.10+ that is a
# RAM-backed tmpfs (half the WSL VM's memory), and a 26.04 run filled it 6 minutes in ("No space left on device").
STROIKA_WSL_REGTEST_DIR="${STROIKA_WSL_REGTEST_DIR:-$HOME/Sandbox/Stroika-Build-Dir-$USE_TEST_BASENAME}"
if [[ "$(realpath -m "$STROIKA_WSL_REGTEST_DIR")" == /mnt/* ]] ; then
    echo "WARNING: $STROIKA_WSL_REGTEST_DIR is on the Windows drive ($(realpath -m "$STROIKA_WSL_REGTEST_DIR")) - the build will be far slower; set STROIKA_WSL_REGTEST_DIR (e.g. /var/tmp/Stroika-Build-Dir-$USE_TEST_BASENAME)"
fi

# Clone THIS tree, not GitHub, so the run tests the commits here (pushed or not) and they match the $VERSION its
# results are filed under - same reasoning as RegressionTests' skel test. Uncommitted changes are not cloned.
# STROIKA_GIT_REMOTE=git@github.com:SophistSolutions/Stroika.git for the old behavior.
STROIKA_GIT_REMOTE="${STROIKA_GIT_REMOTE:-$(pwd)}"

echo "Clearing and checking out $BRANCH from $STROIKA_GIT_REMOTE (into $STROIKA_WSL_REGTEST_DIR)"
rm -rf "$STROIKA_WSL_REGTEST_DIR"
git clone "$STROIKA_GIT_REMOTE" "$STROIKA_WSL_REGTEST_DIR" --branch $BRANCH

echo "Running WSL build (usually takes about 4-5 hrs)"
(cd "$STROIKA_WSL_REGTEST_DIR" && ./Build/Scripts/RegressionTests)

echo "Done with build, so copying out results"
cp "$STROIKA_WSL_REGTEST_DIR"/Tests/HistoricalRegressionTestResults/REGRESSION-TESTS-$USE_TEST_BASENAME-$VERSION-OUT.txt Tests/HistoricalRegressionTestResults/
cp "$STROIKA_WSL_REGTEST_DIR"/Tests/HistoricalPerformanceRegressionTestResults/PerformanceDump-$USE_TEST_BASENAME-$VERSION.txt Tests/HistoricalPerformanceRegressionTestResults/
echo "$STROIKA_WSL_REGTEST_DIR still around to examine/post-mortem"