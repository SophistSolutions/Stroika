               "body" : {
                  "content" : [
                     {
                        "content" : [
                           {
                              "text" : "Gist of plan ;",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "o follow C++ std convention, and const operations intrinsically threadsafe",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "o hidden objects (reps) must be threadsafe if caller cannot tell shared acorss threads (like current container code) ",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "o use Synchonized<> where needed - and fix this to use shared_lock (requires new VS2k15) - and cleanups - class not well done - confusing about locks etc...",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     }
                  ],
