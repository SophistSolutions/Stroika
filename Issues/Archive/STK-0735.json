      "description" : {
         "content" : [
            {
               "content" : [
                  {
                     "text" : "see ",
                     "type" : "text"
                  },
                  {
                     "marks" : [
                        {
                           "attrs" : {
                              "href" : "https://wiki.openssl.org/index.php/OpenSSL_3.0"
                           },
                           "type" : "link"
                        }
                     ],
                     "text" : "https://wiki.openssl.org/index.php/OpenSSL_3.0",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "OSSL_PROVIDER *legacy;",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "OSSL_PROVIDER *deflt;",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "/* Load Multiple providers into the default (NULL) library context */",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "legacy = OSSL_PROVIDER_load(NULL, \"legacy\");",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "if (legacy == NULL) {",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "printf(\"Failed to load Legacy provider\\n\");",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "exit(EXIT_FAILURE);",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "}",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "deflt = OSSL_PROVIDER_load(NULL, \"default\");",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "if (deflt == NULL) {",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "printf(\"Failed to load Default provider\\n\");",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "OSSL_PROVIDER_unload(legacy);",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "exit(EXIT_FAILURE);",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "}",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "/* Rest of application */",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "OSSL_PROVIDER_unload(legacy);",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "OSSL_PROVIDER_unload(deflt);",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "exit(EXIT_SUCCESS);",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            }
         ],
         "type" : "doc",
         "version" : 1
      },
