               "body" : {
                  "content" : [
                     {
                        "content" : [
                           {
                              "text" : "workaround steps:",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "content" : [
                                 {
                                    "text" : "run MSYS shell as administrator",
                                    "type" : "text"
                                 }
                              ],
                              "type" : "paragraph"
                           },
                           {
                              "content" : [
                                 {
                                    "text" : "cd /c/ProgramData/Docker/tmp",
                                    "type" : "text"
                                 }
                              ],
                              "type" : "paragraph"
                           },
                           {
                              "content" : [
                                 {
                                    "text" : "wait for hang (after you see:",
                                    "type" : "text"
                                 }
                              ],
                              "type" : "paragraph"
                           },
                           {
                              "content" : [
                                 {
                                    "text" : "~~~",
                                    "type" : "text"
                                 }
                              ],
                              "type" : "paragraph"
                           },
                           {
                              "content" : [
                                 {
                                    "text" : "atabase directory: /var/lib/pacman/",
                                    "type" : "text"
                                 },
                                 {
                                    "type" : "hardBreak"
                                 },
                                 {
                                    "text" : ":: Do you want to remove unused repositories? [Y/n]",
                                    "type" : "text"
                                 },
                                 {
                                    "type" : "hardBreak"
                                 },
                                 {
                                    "text" : "removing unused sync repositories...",
                                    "type" : "text"
                                 }
                              ],
                              "type" : "paragraph"
                           },
                           {
                              "content" : [
                                 {
                                    "text" : "~~~",
                                    "type" : "text"
                                 }
                              ],
                              "type" : "paragraph"
                           }
                        ],
                        "type" : "blockquote"
                     },
                     {
                        "content" : [
                           {
                              "text" : "look for directory like ",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "text" : "   hcs338366986 (sole directory - if multiple still not hung)",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "text" : "rm -rf  hcs338366986/Files/'$Recycle.Bin",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     }
