               "body" : {
                  "content" : [
                     {
                        "content" : [
                           {
                              "text" : "Major change to handling comparers. MOSTLY - switch to using stdc++ approach, but added 'traits' mechanism to idientify classes of compares for automatic conversion. Redidi ALL containers (we support) to take argument altnaratente comperes, and lost TRAITS from about all of them.",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "text" : "How just traits on CTORs, where we tkae by value arg of comparer (optionally).",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     }
                  ],
                  "type" : "doc",
                  "version" : 1
               },
