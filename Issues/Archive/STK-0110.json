      "description" : {
         "content" : [
            {
               "content" : [
                  {
                     "text" : "Consider adding a class ",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "struct Path {",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "using PathElement = String;",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "Path (...PathElement... list);",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "// then use some subset of xpath syntax to allow stuff like)",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "};",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "VariantValue v = ...;// some value",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "Sequence<VariantValue> matching = v.Match (VariantValue:",
                     "type" : "text"
                  },
                  {
                     "attrs" : {
                        "id" : "1f61b",
                        "shortName" : ":stuck_out_tongue:",
                        "text" : "😛"
                     },
                     "type" : "emoji"
                  },
                  {
                     "text" : "ath (L\"/\", L\"jim\", L\"*\"));",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "returns sequence of all items with object jim underneath and then that top level element underneath. Must work out details, but this could be very helpful in using this class. Also helpful to start with subset of xpath - like maybe the subset used in xsd?",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            }
