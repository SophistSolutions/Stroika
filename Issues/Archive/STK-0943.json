                  "displayName" : "Lewis Pringle",
                  "self" : "https://stroika.atlassian.net/rest/api/3/user?accountId=557058%3A4fe560ca-b4e1-41d1-9bdf-97b1684eda32",
                  "timeZone" : "America/New_York"
               },
               "body" : {
                  "content" : [
                     {
                        "content" : [
                           {
                              "text" : "workaround is to have make project-files (in stroika-based apps - not stroika itself) reconsruct the symbolic links (windows only).",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "text" : "project-files:\n    @$(MAKE) --directory $(StroikaRoot) --silent CONFIGURATION_TAGS=\"$(CONFIGURATION_TAGS)\" $@\n    @#Workaround https://stroika.atlassian.net/browse/STK-943\n    @cd Workspaces/VisualStudio.Net; rm -f Microsoft.Cpp.stroika.ConfigurationBased.props; $(StroikaRoot)/ScriptsLib/MakeSymbolicLink ../../ThirdPartyComponents/Stroika/StroikaRoot/Workspaces/VisualStudio.Net/Microsoft.Cpp.stroika.ConfigurationBased.props\n    @cd Workspaces/VisualStudio.Net; rm -f Microsoft.Cpp.stroika.user.props; $(StroikaRoot)/ScriptsLib/MakeSymbolicLink ../../ThirdPartyComponents/Stroika/StroikaRoot/Workspaces/VisualStudio.Net/Microsoft.Cpp.stroika.user.props\n",
                              "type" : "text"
                           }
                        ],
                        "type" : "codeBlock"
                     },
                     {
                        "content" : [
                           {
                              "text" : "the rest - I THINK - is a microsoft problem. MAYBE someday report to them, but not worth the trouble since highly likely to be ignored, and so much effort to explain.",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     }
                  ],
                  "type" : "doc",
                  "version" : 1
               },
