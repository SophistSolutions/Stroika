                              "text" : "diff --git a/.vscode/launch.json b/.vscode/launch.json\nindex 99a6bc0cab..43ab915ede 100755\n--- a/.vscode/launch.json\n+++ b/.vscode/launch.json\n@@ -15,7 +15,7 @@\n       \"name\": \"(gdb-UNIX) Launch EXE\",\n       \"type\": \"cppdbg\",\n       \"request\": \"launch\",\n-      \"program\": \"${workspaceFolder}/Builds/${command:cpptools.activeConfigName}/Tests/Test37\",\n+      \"program\": \"${workspaceFolder}/Builds/${command:cpptools.activeConfigName}/Tests/Test16\",\n       //\"program\": \"${workspaceFolder}/Builds/${command:cpptools.activeConfigName}/Samples-SystemPerformanceClient/SystemPerformanceClient\",\n       \"args\": [\"-m\"],\n       \"stopAtEntry\": true,\ndiff --git a/Library/Sources/Stroika/Foundation/Containers/Mapping.inl b/Library/Sources/Stroika/Foundation/Containers/Mapping.inl\nindex 97f32b5c39..adde8a0054 100644\n--- a/Library/Sources/Stroika/Foundation/Containers/Mapping.inl\n+++ b/Library/Sources/Stroika/Foundation/Containers/Mapping.inl\n@@ -7,8 +7,14 @@\n  ***************************** Implementation Details ***************************\n  ********************************************************************************\n  */\n-#include \"Stroika/Foundation/Containers/Factory/Mapping_Factory.h\"\n+\n+ #include <iostream>\n+\n+\n+ #include \"Stroika/Foundation/Characters/ToString.h\"\n+ #include \"Stroika/Foundation/Containers/Factory/Mapping_Factory.h\"\n #include \"Stroika/Foundation/Debug/Assertions.h\"\n+#include \"Stroika/Foundation/Debug/Trace.h\"\n #include \"Stroika/Foundation/Debug/Cast.h\"\n #include \"Stroika/Foundation/Traversal/Generator.h\"\n \n@@ -330,6 +336,12 @@ namespace Stroika::Foundation::Containers {\n          */\n         size_t thisSize = this->size ();\n \n+        if constexpr (same_as<string,KEY_TYPE>) {\n+            cerr << \"DEBUG CALL TO RETAINALL\" << endl;\n+            cerr << \"\\titems=\" << Characters::ToString(items) << endl;\n+            cerr << \"\\t*this=\" << Characters::ToString(*this) << endl;\n+        }\n+\n         // Small case - just remove a few items\n         bool fewerLookupsThanAdds = items.size () <= thisSize;\n \n@@ -346,12 +358,27 @@ namespace Stroika::Foundation::Containers {\n #if qStroika_Foundation_Debug_AssertionsChecked\n                     [[maybe_unused]] size_t sz = this->size ();\n #endif\n-                    i = this->erase (i);\n+\n+if constexpr (same_as<string,KEY_TYPE>) {\n+    cerr << \"\\tERASING - I BEFORE=\" << i->fKey << endl;;\n+}\n+i = this->erase (i);\n+if constexpr (same_as<string,KEY_TYPE>) {\n+    if (i.Done()) {\n+        cerr << \"\\tERASING - I DONE\" << endl;;\n+    }\n+    else {\n+        cerr << \"\\tERASING - I AFTER=\" << i->fKey << endl;;\n+    }\n+}\n #if qStroika_Foundation_Debug_AssertionsChecked\n                     Assert (this->size () == sz - 1u);\n #endif\n                 }\n                 else {\n+                    if constexpr (same_as<string,KEY_TYPE>) {\n+                        cerr << \"\\tSKIPPING - CUZ OK - I =\" << i->fKey << endl;;\n+                    }\n                     ++i;\n                 }\n             }\ndiff --git a/Tests/16/Test.cpp b/Tests/16/Test.cpp\nindex b37ab7c501..bb04c2ab40 100644\n--- a/Tests/16/Test.cpp\n+++ b/Tests/16/Test.cpp\n@@ -315,8 +315,8 @@ namespace {\n     {\n         // See https://stroika.atlassian.net/browse/STK-1026 - and undo hack in RetainAll for smallCase\n         // This test IS failing on MACOS XCODE 15.3 (and others)\n-        Mapping<string, int> mOrig{{\"id\", 1}, {\"y\", 7}, {\"x\", 7}};\n-        Mapping<string, int> m = mOrig;\n+        Mapping_stdhashmap<string, int> mOrig{{\"id\", 1}, {\"y\", 7}, {\"x\", 7}};\n+        Mapping_stdhashmap<string, int> m = mOrig;\n         m.RetainAll (initializer_list<string>{\"id\"});\n         EXPECT_TRUE (m.Keys ().SetEquals (initializer_list<string>{\"id\"}));\n     }\n\nDEBUG CALL TO RETAINALL\n        items=[ id ]\n        *this=[ {x: 7}, {y: 7}, {id: 1} ]\n        ERASING - I BEFORE=x\n        ERASING - I AFTER=y\n        ERASING - I BEFORE=y\n        ERASING - I AFTER=x\n        ERASING - I BEFORE=x\n        ERASING - I DONE\n        \n        \nSo - it appears the mapping_stdhasmap code (directing calling/re=isoig the mappingerase api)\nseems to screw up somehow. See if its just this version of clang++, and maybe ignore/workaround that way.\n",
