      "description" : {
         "content" : [
            {
               "content" : [
                  {
                     "text" : "As of Stroika v3.0d1, we updated the min/max date requireemnts to go to  apx 4000bc to 9000AD (full julian date range).",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "But its NOT very accurate before gregorian. Needs work.",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "Found a bunch of websites with hints, but didnt work through or math didnt work.",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "NOT IMPRORTANT, but collected notes…",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : " ",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "        // NOTE LOGIC HERE NOT RIGHT ABOUT ROUNDING",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : " ",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "#if 0",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "        /*",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "content" : [
                        {
                           "content" : [
                              {
                                 "text" : "From ",
                                 "type" : "text"
                              },
                              {
                                 "marks" : [
                                    {
                                       "attrs" : {
                                          "href" : "https://en.wikipedia.org/wiki/Julian_day:"
                                       },
                                       "type" : "link"
                                    }
                                 ],
                                 "text" : "https://en.wikipedia.org/wiki/Julian_day:",
                                 "type" : "text"
                              }
                           ],
                           "type" : "paragraph"
                        }
                     ],
                     "type" : "listItem"
                  }
               ],
               "type" : "bulletList"
            },
            {
               "content" : [
                  {
                     "content" : [
                        {
                           "content" : [
                              {
                                 "text" : "The algorithm is valid for all (possibly proleptic) Gregorian calendar dates",
                                 "type" : "text"
                              }
                           ],
                           "type" : "paragraph"
                        }
                     ],
                     "type" : "listItem"
                  }
               ],
               "type" : "bulletList"
            },
            {
               "content" : [
                  {
                     "content" : [
                        {
                           "content" : [
                              {
                                 "text" : "after November 23, −4713. Divisions are integer divisions towards zero; fractional parts are ignored.[66]",
                                 "type" : "text"
                              }
                           ],
                           "type" : "paragraph"
                        }
                     ],
                     "type" : "listItem"
                  }
               ],
               "type" : "bulletList"
            },
            {
               "content" : [
                  {
                     "text" : "         *",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "content" : [
                        {
                           "content" : [
                              {
                                 "text" : "JDN = (1461 × (Y + 4800 + (M − 14)/12))/4 +(367 × (M − 2 − 12 × ((M − 14)/12)))/12 − (3 × ((Y + 4900 + (M - 14)/12)/100))/4 + D − 32075",
                                 "type" : "text"
                              }
                           ],
                           "type" : "paragraph"
                        }
                     ],
                     "type" : "listItem"
                  }
               ],
               "type" : "bulletList"
            },
            {
               "content" : [
                  {
                     "text" : "         */",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "        auto newAlgo =",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "            (1461 * (yy + 4800 + (mm - 14) / 12)) / 4",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "            + (367 * (mm - 2 - 12 * ((mm - 14) / 12))) / 12",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "content" : [
                        {
                           "content" : [
                              {
                                 "text" : "(3 * ((yy + 4900 + (mm - 14) / 12) / 100)) / 4",
                                 "type" : "text"
                              }
                           ],
                           "type" : "paragraph"
                        }
                     ],
                     "type" : "listItem"
                  }
               ],
               "type" : "bulletList"
            },
            {
               "content" : [
                  {
                     "text" : "            + dd - 32075",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "            ;",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : " ",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : " ",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "       ",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "        const year_month_day kStartOfJulianCalendar_ = -4712y / January / 1;    // maybe off by one year due to zero issue",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : " ",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : " ",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "        {",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "            const year_month_day testdate = 2023y / February / 18; // maybe off by one year due to zero issue",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "       ",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "            auto diff = std::chrono::sys_days (testdate) - std::chrono::sys_days (kStartOfJulianCalendar_);",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "            //auto diff = testdate - kStartOfJulianCalendar_;",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "            int a = 3;",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "        }",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "        {",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "            // FROM ",
                     "type" : "text"
                  },
                  {
                     "attrs" : {
                        "url" : "https://en.wikipedia.org/wiki/Julian_day#cite_note-72"
                     },
                     "type" : "inlineCard"
                  },
                  {
                     "text" : " ",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "            int y = 4716;",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "            int v = 3;",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "            int j = 1401;",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "            int u = 5;",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "            int m = 2;",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "            int s = 153;",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "            int n = 12;",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "            int w = 2;",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "            int r = 4;",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "            int B = 274277;",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "            int p = 1461;",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "            int C = -38;",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "        }",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "        {",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : " ",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "        }",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "        {",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "            using namespace chrono;",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "            ///",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "            year_month_day ymd (1990y / 01 / 01); // Create a date object. '_y' is a literal like 'f' for float which comes with `date::literals` or `chorno::literals`.",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "            sys_days total_days = (sys_days)ymd; // Convert it to a time_point.",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "            total_days += days (44334);          // Add the days.",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "            year_month_day later = total_days;   // Convert it back to an object.",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "        }",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
