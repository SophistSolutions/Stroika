                  {
                     "text" : "SortedSet<ResultsIDType>    resultIds   =   fScanDB_.GetResultsByResultID (greaterThanResultsID);",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "constexpr   unsigned int    kDefaultMaxResultIds_   { 900 };",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "unsigned int maxPts2Return = maxResults.Value (kDefaultMaxResultIds_);",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "if (resultIds.size () > maxPts2Return) {",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "DbgTrace (L\"SKIPPING : set size was %d with maxPts2Return=%d\", int (resultIds.size ()), int (maxPts2Return));",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "resultIds = SortedSet<ResultsIDType> { resultIds.Skip (resultIds.size () - maxPts2Return) };",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "DbgTrace (L\"SKIPPING : set size NOW is %d\", int (resultIds.size ()));",
                     "type" : "text"
                  },
