      "description" : {
         "content" : [
            {
               "content" : [
                  {
                     "text" : "ADD DOCS FOR",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "template    <typename   T>",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "T   PinToSpecialPoint (T p, T special, T epsilon = (10000 * numeric_limits<T>::epsilon ()));",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "/**",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "*/",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "template    <typename   T>",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "T   PinInRange (T initialValue, T lowerBound, T upperBound);",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "/**",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "content" : [
                        {
                           "content" : [
                              {
                                 "text" : "This returns the given value, as the new type NEW_T, but if the value wont fit in NEW_T, it returns",
                                 "type" : "text"
                              }
                           ],
                           "type" : "paragraph"
                        }
                     ],
                     "type" : "listItem"
                  },
                  {
                     "content" : [
                        {
                           "content" : [
                              {
                                 "text" : "the largest value that would.",
                                 "type" : "text"
                              },
                              {
                                 "type" : "hardBreak"
                              },
                              {
                                 "text" : "*",
                                 "type" : "text"
                              }
                           ],
                           "type" : "paragraph"
                        }
                     ],
                     "type" : "listItem"
                  },
                  {
                     "content" : [
                        {
                           "content" : [
                              {
                                 "text" : "This is handy for stuff like ::write() system calls, where you might be given a ptrdiff_t, and have to",
                                 "type" : "text"
                              }
                           ],
                           "type" : "paragraph"
                        }
                     ],
                     "type" : "listItem"
                  },
                  {
                     "content" : [
                        {
                           "content" : [
                              {
                                 "text" : "call something taking int, and given how these types might be differnt sizes, it simplifies picking",
                                 "type" : "text"
                              }
                           ],
                           "type" : "paragraph"
                        }
                     ],
                     "type" : "listItem"
                  },
                  {
                     "content" : [
                        {
                           "content" : [
                              {
                                 "text" : "the right size to call write with.",
                                 "type" : "text"
                              },
                              {
                                 "type" : "hardBreak"
                              },
                              {
                                 "text" : "*/",
                                 "type" : "text"
                              },
                              {
                                 "type" : "hardBreak"
                              },
                              {
                                 "text" : "template    <typename NEW_T, typename   T>",
                                 "type" : "text"
                              },
                              {
                                 "type" : "hardBreak"
                              },
                              {
                                 "text" : "NEW_T   PinToMaxForType (T initialValue);",
                                 "type" : "text"
                              }
                           ],
                           "type" : "paragraph"
                        }
                     ],
                     "type" : "listItem"
                  }
               ],
               "type" : "bulletList"
            },
            {
               "content" : [
                  {
                     "text" : "and maybe default-arg for upper-bound on PinInRange – so upperBound is max.",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "So effectively ‘pinatleast’",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            }
