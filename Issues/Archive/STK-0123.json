                  },
                  "displayName" : "Lewis Pringle",
                  "self" : "https://stroika.atlassian.net/rest/api/3/user?accountId=557058%3A4fe560ca-b4e1-41d1-9bdf-97b1684eda32",
                  "timeZone" : "America/New_York"
               },
               "body" : {
                  "content" : [
                     {
                        "type" : "rule"
                     },
                     {
                        "content" : [
                           {
                              "text" : "See if this is a better openssl style",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "marks" : [
                                 {
                                    "attrs" : {
                                       "href" : "https://wiki.openssl.org/index.php/EVP_Symmetric_Encryption_and_Decryption"
                                    },
                                    "type" : "link"
                                 }
                              ],
                              "text" : "https://wiki.openssl.org/index.php/EVP_Symmetric_Encryption_and_Decryption",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "\\\\\\----",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "cipher = EVP_get_cipherbyname(\"aes-256-cbc\");",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "if(!cipher) { fprintf(stderr, \"no such cipher\\n\"); return 1; }",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "text" : "dgst=EVP_get_digestbyname(\"md5\");",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "type" : "rule"
                     },
                     {
                        "content" : [
                           {
                              "text" : "Read and make sure no good ideas here like new, or getbyname",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "marks" : [
                                 {
                                    "attrs" : {
                                       "href" : "http://stackoverflow.com/questions/9488919/openssl-password-to-key"
                                    },
                                    "type" : "link"
                                 }
                              ],
                              "text" : "http://stackoverflow.com/questions/9488919/openssl-password-to-key",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "text" : "—",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "const   DWORD   KEYLENGTH_3             =   0x00800000;",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "const   ALG_ID  ENCRYPT_ALGORITHM_3     =   CALG_RC4;",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "text" : "// force to match 128bits we have in KEYLENGTH_3 (hus, if a 128-bit RC4 session key is to be generated, the value 0x00800000 is combined with any other dwFlags predefined value with a bitwise-OR operation.)",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "text" : "#if 0",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "const   DWORD   KEYLENGTH_3             =   0x00800000;",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "const   ALG_ID  ENCRYPT_ALGORITHM_3     =   CALG_RC4;",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "text" : "// force to match 128bits we have in KEYLENGTH_3 (hus, if a 128-bit RC4 session key is to be generated, the value 0x00800000 is combined with any other dwFlags predefined value with a bitwise-OR operation.)",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "HCRYPTHASH hHash    =   NULL;",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "Verify (::CryptCreateHash (hCryptProv, CALG_MD5, 0, 0, &hHash));",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "Verify (::CryptHashData (hHash, (BYTE*)key.c_str (), key.length () * sizeof (wchar_t), 0));",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "Verify (::CryptDeriveKey (hCryptProv, ENCRYPT_ALGORITHM_3, hHash, KEYLENGTH_3, &hKey));",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "Verify (::CryptDestroyHash (hHash));",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "#endif",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     }
