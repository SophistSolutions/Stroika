                     "text" : "lewispringle@gmail.com",
                     "type" : "text"
                  },
                  {
                     "marks" : [
                        {
                           "type" : "strong"
                        }
                     ],
                     "text" : "/8E1204E6: ",
                     "type" : "text"
                  },
                  {
                     "text" : "And for variant of Compress/Decompress that takes a stream, rename those to MakeCompressor()",
                     "type" : "text"
                  },
