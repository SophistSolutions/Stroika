               "body" : {
                  "content" : [
                     {
                        "content" : [
                           {
                              "text" : "I think a better solution to the performance problems will turn out to be something like this:",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "marks" : [
                                 {
                                    "attrs" : {
                                       "href" : "https://en.wikipedia.org/wiki/Non-blocking_linked_list"
                                    },
                                    "type" : "link"
                                 }
                              ],
                              "text" : "https://en.wikipedia.org/wiki/Non-blocking_linked_list",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "or better – Herb Sutter provides a C++ implementation:",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "marks" : [
                                 {
                                    "attrs" : {
