               "body" : {
                  "content" : [
                     {
                        "content" : [
                           {
                              "text" : "#sudo apt-get install libc+",
                              "type" : "text"
                           },
                           {
                              "marks" : [
                                 {
                                    "type" : "underline"
                                 }
                              ],
                              "text" : "abi1 for clang libc",
                              "type" : "text"
                           },
                           {
                              "text" : "+ based apps to run\\\r",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "./configure my-clang-3.9.0-libc+",
                              "type" : "text"
                           },
                           {
                              "marks" : [
                                 {
                                    "type" : "underline"
                                 }
                              ],
                              "text" : "-debug --compiler-driver ~/clang-3.9.0/bin/clang",
                              "type" : "text"
                           },
                           {
                              "text" : "+ --apply-default-debug-flags --only-if-has-compiler --static-link-gccruntime disable --lto disable --cppstd-version-flag --std=c+",
                              "type" : "text"
                           },
                           {
                              "marks" : [
                                 {
                                    "type" : "underline"
                                 }
                              ],
                              "text" : "1y --append-extra-compiler-and-linker-args -stdlib=libc",
                              "type" : "text"
                           },
                           {
                              "text" : "+;\\",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     }
