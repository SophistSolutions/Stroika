      "description" : {
         "content" : [
            {
               "content" : [
                  {
                     "text" : "o\tAdd ",
                     "type" : "text"
                  },
                  {
                     "marks" : [
                        {
                           "attrs" : {
                              "href" : "http://api.jquery.com/jquery.grep/"
                           },
                           "type" : "link"
                        }
                     ],
                     "text" : "http://api.jquery.com/jquery.grep/",
                     "type" : "text"
                  },
                  {
                     "text" : " to stroika",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "\tContainers",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "\tI THINK cannot go in iterable becase return type SB right for each container. Maybe do in iterable, but ‘hide’ in each subclass (like Set<>). That’s probably best.",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "\tMaybe with new c++ rules for inheritance return type subtyping this make work with a single virtual function!",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "\tBut either way – have it return a subset of the ‘this’ argument container that passes the argument lambda function.",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "\tUnclear if it should be called ‘grap’ or ‘filter’ or ‘subset’. Anyhow – in doccoment include all these names.",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            }
         ],
         "type" : "doc",
         "version" : 1
      },
