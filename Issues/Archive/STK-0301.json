      "customfield_10001" : "1_*:*_2_*:*_3705680746_*|*_3_*:*_1_*:*_19447761441_*|*_5_*:*_1_*:*_0",
      "customfield_10012" : "0|i001un:",
      "customfield_10300" : "{}",
      "description" : {
         "content" : [
            {
               "content" : [
                  {
                     "text" : ">>> test with linux and libc++ (not just libstdc++). Autodetect which and do right #includes for each. Seems cstdint missing on macos – probably because of this.",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "FROM ",
                     "type" : "text"
                  },
                  {
                     "marks" : [
                        {
                           "attrs" : {
                              "href" : "http://libcxx.llvm.org/"
                           },
                           "type" : "link"
                        }
                     ],
                     "text" : "http://libcxx.llvm.org/",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "Maybe something like:",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "•\tclang++ -stdlib=libc++ helloworld.cpp -nodefaultlibs -lc++ -lcxxrt -lm -lc -lgcc_s -lgcc",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "Alternately, you could just add libcxxrt to your libraries list, which in most situations will give the same result:",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "•\tclang++ -stdlib=libc++ helloworld.cpp -lcxxrt",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "Wrote script to biuld clang from scatch(not working yet). That maybe better, and jjsuit build with clang libs",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            }
         ],
         "type" : "doc",
         "version" : 1
      },
