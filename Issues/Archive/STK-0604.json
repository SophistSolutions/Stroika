      "description" : {
         "content" : [
            {
               "content" : [
                  {
                     "text" : "Consider some more generic mechanism to handle this common case:",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "#if qPlatform_Windows",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "try {",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "ThrowErrNoIfNegative<Socket:",
                     "type" : "text"
                  },
                  {
                     "attrs" : {
                        "id" : "1f61b",
                        "shortName" : ":stuck_out_tongue:",
                        "text" : "😛"
                     },
                     "type" : "emoji"
                  },
                  {
                     "text" : "latformNativeHandle> (::bind (sfd, (sockaddr*)&useSockAddr, sizeof (useSockAddr)));",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "}",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "catch (const Execution:",
                     "type" : "text"
                  },
                  {
                     "attrs" : {
                        "id" : "1f61b",
                        "shortName" : ":stuck_out_tongue:",
                        "text" : "😛"
                     },
                     "type" : "emoji"
                  },
                  {
                     "text" : "latform::Windows::Exception& e) {",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "if (e == WSAEACCES) {",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "Throw (StringException (L\"Cannot Bind to port: WSAEACCES (probably already bound with SO_EXCLUSIVEADDRUSE)\"));",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "}",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "}",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "#else",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "// EACCESS reproted as FileAccessException - which is crazy confusing.",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "// @todo - find a better way, but for now remap this...",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "try {",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "ThrowErrNoIfNegative (Handle_ErrNoResultInterruption ([&sfd, &useSockAddr]() -> int { return ::bind (sfd, (sockaddr*)&useSockAddr, sizeof (useSockAddr)); }));",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "}",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "catch (const IO::FileAccessException&) {",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "Throw (StringException (L\"Cannot Bind to port: EACCESS (probably already bound with SO_EXCLUSIVEADDRUSE)\"));",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "}",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "#endif",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "catch (...) {",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "Throw (StringException (L\"Cannot Bind to port: \" + Characters::ToString (current_exception ())));",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "}",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "—",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "This could then replace the mechaniusm we use to add filenames to file access excetpions.",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "Someething MAYBE like:",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            }
         ],
