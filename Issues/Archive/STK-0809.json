      "description" : {
         "content" : [
            {
               "content" : [
                  {
                     "text" : "create windows only VSWhere (like) script",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "Get",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "  Vswhere.exe stuff working – where we pass in INSTALLDIR as param, and have generic scripts for building from that. And VSWhereDir",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : " ",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "              Then fix configure to use vswhere and the rest from that path.",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : " ",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "make --silent --directory BootstrapToolsSrc/vswhere whereLatest",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : " ",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "              ***USE IN GetDefaultToolsBuildDir()",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "ThirdPartyComponents",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : " (or build scr tools)",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "attrs" : {
                        "url" : "https://github.com/Microsoft/vswhere/releases"
                     },
                     "type" : "inlineCard"
                  },
                  {
                     "text" : " ",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "grab vswhere from that",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : " ",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "Use ",
                     "type" : "text"
                  },
                  {
                     "attrs" : {
                        "url" : "https://github.com/microsoft/vswhere/releases"
                     },
                     "type" : "inlineCard"
                  },
                  {
                     "text" : " ",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "              c:\\users\\lewis\\Downloads\\vswhere.exe -all",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : " ",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "              to identify available (and default?) vs instances so we know where to grab code",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "              All PLATFORM stuff to specify this additionally as a parameter",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : " ",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "              \"\\users\\lewis\\Downloads\\vswhere.exe\" -format json",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "              \"\\users\\lewis\\Downloads\\vswhere.exe\" -format json |grep installationPath",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : " ",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "takes param optionally saying Visualstudio 2022 or 2019 etc. And then does above or similar logic to what i do now in configure script ",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : " ($PROJECTPLATFORMSUBDIR eq \"\") {\n            my @files = glob(\"'$PROGRAMFILESDIR/Microsoft Visual Studio/2022/*/VC'\");\n            if (scalar(@files) != 0) {\n                $PROJECTPLATFORMSUBDIR = 'VisualStudio.Net-2022';",
                     "type" : "text"
                  }
               ],
               "type" : "codeBlock"
            },
            {
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "but then replace all that with a call to this new VSWhere script.",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            }
         ],
