      "description" : {
         "content" : [
            {
               "content" : [
                  {
                     "text" : "issue probably with ProcessRunner code for windows…",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "But BWA elsewhere.",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "// on medusa, this fails with no error message and just errr#1 - withoput the given BWA",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "ProcessRunner pr{CommandLine{CommandLine::WrapInShell::eBash, \"echo hi mom\"}};",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : " // bash should work fine on windows, as long as in path (msys or cygwin) - see earlier checks (SETUP)",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "String        out = get<0> (pr.Run (\"\"));",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "EXPECT_EQ (out.Trim (), \"hi mom\");",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  }
               ],
               "type" : "paragraph"
            }
         ],
