      "description" : {
         "content" : [
            {
               "content" : [
                  {
                     "text" : "BlockAllocation_Private_AdjustSizeForPool_",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "see alignas alignof(T). Maybe must round up to the nearest alignof(T)?",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "Not cuz we need that mcuh space, but to assure the blocks alligned.",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "Be sure to add ASSERTION S(ensure) that ptr returned is properly aligned.",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "HINT - we got erorrs (on soemthign else) from undefined behavior sanitizer on ARM, so it maybe picky...",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            }
         ],
