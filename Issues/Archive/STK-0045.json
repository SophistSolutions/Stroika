      "description" : {
         "content" : [
            {
               "content" : [
                  {
                     "text" : "Consider IDM (identity management) Framework",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "\tIdentity Objects",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "o\tGUIDS(opaue)",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "\tPermission Objects",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "o\tOpaue",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "\tIntegrate with third party systems to find identities (LDAP, RADIUS, OpenID, SSL-ClientClient)",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "\tIntegrate with third party systems to store permissions",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "\tSee general enough to replace HFWS impl",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "\tConsider needs of Block – and see if what I can come up with is sufficient for them (and maybe suggest they use this)",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "\tProvide private impl of ID->Permissions mapping (simple table) and lookup to gen permissions tokens (objects0",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "\tFramework for validation of permissions (given identities)",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "\tIntegrate with web-framework",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            }
         ],
         "type" : "doc",
         "version" : 1
      },
