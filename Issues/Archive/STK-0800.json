      "description" : {
         "content" : [
            {
               "content" : [
                  {
                     "text" : "#if qHas_Syslog",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "    Logger::Get ().SetAppender (make_shared<Logger::SysLogAppender> (L\"WhyTheFuckIsMyNetworkSoSlow\"));",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "#elif qPlatform_Windows",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "    Logger::Get ().SetAppender (make_shared<Logger::WindowsEventLogAppender> (L\"WhyTheFuckIsMyNetworkSoSlow\"));",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "#endif",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "    Logger::Get ().SetBufferingEnabled (true);",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "    Logger::Get ().SetSuppressDuplicates (1min);",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "              >> fix above so can be done in one SetOptions() line to avoid the thread interrupt on startup",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            }
         ],
         "type" : "doc",
         "version" : 1
      },
