               "body" : {
                  "content" : [
                     {
                        "content" : [
                           {
                              "text" : "see also if I can use that to factor",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "text" : "if (true) {",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "// looks better as an object, than as an array",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "struct laglon_ {",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "float lat;",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "float lon;",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "};",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "mapper.AddClass<laglon_> (initializer_list",
                              "type" : "text"
                           },
                           {
                              "marks" : [
                                 {
                                    "attrs" : {
                                       "href" : "ObjectVariantMapper::StructFieldInfo"
                                    },
                                    "type" : "link"
                                 }
                              ],
                              "text" : "ObjectVariantMapper::StructFieldInfo",
                              "type" : "text"
                           },
                           {
                              "text" : "{",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "{L\"latitude\"sv, StructFieldMetaInfo{&laglon_::lat}},",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "{L\"longitude\"sv, StructFieldMetaInfo{&laglon_::lon}},",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "});",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "mapper.Add<tuple<float, float>> (",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "[] (const ObjectVariantMapper& mapper, const tuple<float, float>* obj) -> VariantValue { return mapper.FromObject (laglon_{get<0> (*obj), get<1> (",
                              "type" : "text"
                           },
                           {
                              "marks" : [
                                 {
                                    "type" : "em"
                                 }
                              ],
                              "text" : "obj)}); },",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "marks" : [
                                 {
                                    "type" : "em"
                                 }
                              ],
                              "text" : "[] (const ObjectVariantMapper& mapper, const VariantValue& d, tuple<float, float>",
                              "type" : "text"
                           },
                           {
                              "text" : " intoObj) -> void { auto tmp{ mapper.ToObject<laglon_> (d) }; *intoObj = make_tuple (tmp.lat, tmp.lon); });",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
