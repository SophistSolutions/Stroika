      "customfield_10001" : "1_*:*_1_*:*_115132458141_*|*_4_*:*_1_*:*_10111_*|*_5_*:*_1_*:*_9694_*|*_6_*:*_1_*:*_0",
      "customfield_10012" : "0|i000dr:",
