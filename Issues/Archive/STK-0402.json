      "description" : {
         "content" : [
            {
               "content" : [
                  {
                     "text" : "This is like list reader but you start a level down.",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "List reader works OK when you ahve top level with repeating elt underneath and nothing else.",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "But if you have a struct with one or two feilds and then a repeating eltl like below, this is needed:",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "class   propsetReader_ : public ObjectReaderRegistry::IElementConsumer {",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "public:",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "propsetReader_ (KeyValuePair<String, ValType>* vp)",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : ": fValuePtr_ (vp)",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
