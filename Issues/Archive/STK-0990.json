      "description" : {
         "content" : [
            {
               "content" : [
                  {
                     "text" : "thoroughly support spans in InputStream/OutputStream and",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "SOMEHAT RELATED",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "CLEANUP",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "OutputStream<Characters::Character>::Ptr::Write (const Characters::String& s) const",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "{",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "    // @todo performance tweek so uses Peek",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "    Memory::StackBuffer<wchar_t> ignored;",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "    span<const wchar_t> sp = s.GetData<wchar_t> (&ignored);",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "    Write (sp.data (), sp.data () + sp.size ());",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "}",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : " ",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "OUTPUT STREAM TO SUPPORT SPANS.",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            }
