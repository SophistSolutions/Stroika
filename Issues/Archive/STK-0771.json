      "description" : {
         "content" : [
            {
               "content" : [
                  {
                     "marks" : [
                        {
                           "type" : "underline"
                        }
                     ],
                     "text" : "USE THIS FOR WINDOWS TOO TO CREATE INSTALLER WITH x86 and x86_64 binaries in same installer",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "Ø ",
                     "type" : "text"
                  },
                  {
                     "marks" : [
                        {
                           "type" : "underline"
                        }
                     ],
                     "text" : "New configuration option PACKAGE_ONLY, which skips library, TPP, etc, and only builds samples/tests/runtests",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "Ø ",
                     "type" : "text"
                  },
                  {
                     "marks" : [
                        {
                           "type" : "underline"
                        }
                     ],
                     "text" : "New build rule like linker to FatPackage – with new configuration whihci is list of base configurations (from each can figure architecture)- PACKAGE_BASED_ON=",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "Ø ",
                     "type" : "text"
                  },
                  {
                     "marks" : [
                        {
                           "type" : "underline"
                        }
                     ],
                     "text" : "Then generic rule to do the package (using lipo link above)",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "Ø ",
                     "type" : "text"
                  },
                  {
                     "marks" : [
                        {
                           "type" : "underline"
                        }
                     ],
                     "text" : "Probably set stuff like COMPILER flags etc all to EMPTY or MISSING from config in PACKAGEONLY configuration",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "Applies for windows installers (x86 and 64) and for macos. Not sure if unix installers (rpm/deb) support this idea?",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "marks" : [
                        {
                           "type" : "underline"
                        }
                     ],
                     "text" : "      ",
                     "type" : "text"
                  },
                  {
                     "attrs" : {
                        "url" : "https://developer.apple.com/documentation/apple-silicon/building-a-universal-macos-binary"
                     },
                     "type" : "inlineCard"
                  },
                  {
                     "text" : " ",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            }
