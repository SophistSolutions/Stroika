               "body" : {
                  "content" : [
                     {
                        "content" : [
                           {
                              "text" : "mostly understood. Understood 95% of comments/cases still left in the code.",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "text" : "Isuse is - CTOR deducted type is often R-Value-Reference (eg. if given equal_to<T>{} CTOR arg). And the type used in ffactory must be equal_to<T> not equal_to<T>&&. So decay_t a good solution.",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     }
                  ],
