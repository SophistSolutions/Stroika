               "body" : {
                  "content" : [
                     {
                        "content" : [
                           {
                              "text" : "NOTE - NOT a compiler bug since happens with gcc 11 and msvc.",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "text" : "            // @todo see <https://stroika.atlassian.net/browse/STK-933> for why this decay_t in various CTOR calls to Factory\n            // I THINK <https://en.cppreference.com/w/cpp/language/reference#Forwarding_references> should have allowed this to work\n            // without that decay_t;",
                              "type" : "text"
                           }
                        ],
                        "type" : "codeBlock"
                     },
                     {
                        "content" : [
                           {
                              "text" : "SIMPLE workaround is using decay_t in call to factory, so done in many places with link back to this bug report",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "text" : "to understand and see if better way;",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "text" : "BUt marked as low priority since my misudnrsanding, noit a bug and probably as is fairly invisible / modest workaround.",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     }
