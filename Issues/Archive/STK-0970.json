      "description" : {
         "content" : [
            {
               "content" : [
                  {
                     "text" : "As of Stroika 2.1 testing - final - there using make_shared - on all platforms - shared_ptr was faster. ",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "It makes the Iterable code slightly more complex and that complexity leaks out.",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "So GET RID OF it - and assume shared_ptr for Iterable<>.",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            }
         ],
         "type" : "doc",
         "version" : 1
