      "description" : {
         "content" : [
            {
               "content" : [
                  {
                     "text" : "From ",
                     "type" : "text"
                  },
                  {
                     "marks" : [
                        {
                           "attrs" : {
                              "href" : "http://open-std.org/jtc1/sc22/wg21/docs/papers/2013/n3797.pdf"
                           },
                           "type" : "link"
                        }
                     ],
                     "text" : "http://open-std.org/jtc1/sc22/wg21/docs/papers/2013/n3797.pdf",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "If the value returned by the operator-> function has class type, this may result in selecting and calling another operator->",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "function. The process repeats until an operator-> function returns a value of non-class type.",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            }
         ],
