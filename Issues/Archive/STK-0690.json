      "customfield_10001" : "1_*:*_1_*:*_86306647753_*|*_3_*:*_1_*:*_6312631_*|*_5_*:*_1_*:*_0",
      "customfield_10012" : "0|i00493:",
      "customfield_10300" : "{}",
      "description" : {
         "content" : [
            {
               "content" : [
                  {
                     "text" : "Since Stroika v2.1d6, iterators use unique_ptr instead of SharedByValue.",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "This is mostly a win, except for a few places where we copy iteerators.",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "MANY of these are by design. Many are just in debugging code (like most DelegatedIterator use).",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "And many more can be fixed by more careful use of move.",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "Like Set::AddAdd (), etc.",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "Set breakpoint in Iterator::Clone () - and see where it gets called (like in the seuqnce and set regtests).",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "And maybe more.",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            }
         ],
         "type" : "doc",
         "version" : 1
      },
