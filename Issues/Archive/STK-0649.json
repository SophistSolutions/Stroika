      "description" : {
         "content" : [
            {
               "content" : [
                  {
                     "text" : "void Analyze::Manager:",
                     "type" : "text"
                  },
                  {
                     "attrs" : {
                        "id" : "1f603",
                        "shortName" : ":smiley:",
                        "text" : "😃"
                     },
                     "type" : "emoji"
                  },
                  {
                     "text" : "eleteSubstance (const String& libraryName, SubstanceID substanceId)",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "{",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "Debug::TraceContextBumper ctx{Stroika_Foundation_Debug_OptionalizeTraceArgs (L\"Analyze::Manager:",
                     "type" : "text"
                  },
                  {
                     "attrs" : {
                        "id" : "1f603",
                        "shortName" : ":smiley:",
                        "text" : "😃"
                     },
                     "type" : "emoji"
                  },
                  {
                     "text" : "eleteSubstance\", L\"libraryName=%s, substanceId=%d\", libraryName.c_str (), (int)substanceId)};",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "using namespace Frameworks::WebServer;",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "if (libraryName != L\"Default\") {",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "Execution::Throw (ClientErrorException (L\"Only library 'Default' currently supported\"));",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "}",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "auto rwLock = sLibCache_.rwget ();",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "if (Iterator<SubstanceMetaInformation> i = GetAllLibraryDefinition ().fSubstances.FindFirstThat ([=](SubstanceMetaInformation smi) { return smi.fID == substanceId; })) {",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "Assert (i.Current ().fFromFile.IsPresent ()); // because we currently read all these from individual files and always record the filename",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "String substanceFileName = *i.Current ().fFromFile;",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "rwLock.store (nullopt);",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "IO::FileSystem:",
                     "type" : "text"
                  },
                  {
                     "attrs" : {
                        "id" : "1f603",
                        "shortName" : ":smiley:",
                        "text" : "😃"
                     },
                     "type" : "emoji"
                  },
                  {
                     "text" : "efault ().RemoveFileIf (L\"/var/opt/HSI-ChemVu/AnalysisLibraries/Default/Active-Substances/\" + substanceFileName);",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "IO::FileSystem:",
                     "type" : "text"
                  },
                  {
                     "attrs" : {
                        "id" : "1f603",
                        "shortName" : ":smiley:",
                        "text" : "😃"
                     },
                     "type" : "emoji"
                  },
                  {
                     "text" : "efault ().RemoveFileIf (L\"/var/opt/HSI-ChemVu/AnalysisLibraries/Default/All-Substances/\" + substanceFileName);",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "// There is a wait coming somewhere, this is a good spot to force it...",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "// Someday, make the recompile stuff faster, or separate the recompile for meta info from the recompile for peaks...",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "rwLock.store (FillLibInfo_ ());",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "}",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "else {",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "Execution::Throw (ClientErrorException (L\"Not a valid substance ID\"));",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "}",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "}",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
