      "description" : {
         "content" : [
            {
               "content" : [
                  {
                     "text" : "\tDo 2 new demo apps",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "o\tMinimal WebServer",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "o\tSimpleWebServerService",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "\tUse objectmapper for config data ",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "\tGet port# to listen on from config file",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "\tGet directory for where to serve files from",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "\tMaybe also separate file/config for mapping file suffix to mime-content types",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "[ we HAVE one webserver sample. But embelish this to be more like a real web server - reading from files]",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "[ and buoild new webservice example - providing webservice callbacks (soap and /or JSON).",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            }
         ],
