      "description" : {
         "content" : [
            {
               "content" : [
                  {
                     "text" : ">>>> FINISH CLEANUP OF XML OBJECT READER DEMO",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "\tA lot of similarity in BuiltinReader",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "OLD COMMENT:",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "Do generic templates for built-in reader.  Accum in stringbuilsder.  Then specialize just method to msp final string to type in endtag handke",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "o\tIn new BuiltinReader – accumulate STRING (with StringsBuilder) and then specailze just the final conversiotn stage on the end-tag.",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "\tAdd abiltity to skip all the way down to <return> element and when you push reader N on stack",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "o\tAdd reader that takes another reader as arg and skips either N LEVELS or down to first tag matching X and then invokes aggregated arg.",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "\tAdd ability when reading <value type=A. or <value type=B> to switch reader type.",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "\tGenerally cleanup code",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            }
         ],
         "type" : "doc",
         "version" : 1
      },
