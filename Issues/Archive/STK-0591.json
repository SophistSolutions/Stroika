      "description" : {
         "content" : [
            {
               "content" : [
                  {
                     "text" : "InputSubStream (inputstream, start, end)",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "This takes an offset to start, and max offset end in CTOR (and a wrapped stream). ",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "Then - it queries the offset of the original stream, and uses this to pull just the right subset",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "out of the underlying Stream (NOT THOUGHT THROUGH - MAYBE USING SEEK?). Then calls to",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "read on THIS substream make it look like it goes from 0..max-offset MINUS original-offset.",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "THIS can be used for taking a BLOB of data - say from a webservice call - and then",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "the argument to a PROXY/STUB de-serializer would be a regular stream and c++ structures",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "would come back.",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            }
         ],
