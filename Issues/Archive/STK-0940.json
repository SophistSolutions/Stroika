      "description" : {
         "content" : [
            {
               "content" : [
                  {
                     "text" : "Issue is that the the skel script creates a symbolic link to ",
                     "type" : "text"
                  },
                  {
                     "marks" : [
                        {
                           "type" : "code"
                        }
                     ],
                     "text" : "../../ThirdPartyComponents/Stroika/StroikaRoot/Workspaces/VisualStudio.Net/Microsoft.Cpp.stroika.user.props",
                     "type" : "text"
                  },
                  {
                     "text" : " and that file may or may not exist",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "Its imported with a line like ",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "    <Import Project=\"$(ProjectDir)\\..\\..\\..\\Workspaces\\VisualStudio.net\\Microsoft.Cpp.stroika.user.props\" Condition=\"exists('$(ProjectDir)\\..\\..\\..\\Workspaces\\VisualStudio.net\\Microsoft.Cpp.stroika.user.props')\" Label=\"User-Editable-Properties\" />\n",
                     "type" : "text"
                  }
               ],
               "type" : "codeBlock"
            },
            {
               "type" : "paragraph"
            },
            {
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "whcih if the symbolic link exists, but the thing pointed to doesnt exist, erorrs out (due to IMHO a BAD design choice for interpretation of exist () function in project files when file referenced is symbolic link).",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "BUt I cannot change that choice. Sigh.",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            }
         ],
         "type" : "doc",
         "version" : 1
      },
