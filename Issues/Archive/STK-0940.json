                  "content" : [
                     {
                        "content" : [
                           {
                              "text" : "Fix is a couple things:",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "text" : "In skel output, the makefile has builtin ‘project-files’ target (whcih fixes things).",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "text" : "And has ",
                              "type" : "text"
                           },
                           {
                              "marks" : [
                                 {
                                    "type" : "code"
                                 }
                              ],
                              "text" : "Builds/__AUTOMATIC_MAKE_PROEJCT_FILES__",
                              "type" : "text"
                           },
                           {
                              "text" : " target so when you build it automatically fixes project files. Still need to update docs.",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     }
