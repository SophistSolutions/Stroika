      "customfield_10012" : "0|i0052f:",
      "customfield_10300" : "{}",
      "description" : {
         "content" : [
            {
               "content" : [
                  {
                     "text" : "Ø  XML",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "o    DataExchange::XML:: SerializationConfiguration",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "o    DataExchange:: Variant::XML::Reader/Writer",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "Ø  Try doing a draft of these",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "o    First – ignore the issue of attributes and namespacs and arrays",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "o    THEn – add filter function (or virtual method) – to handle to/from on arrays and namespaces and attributes",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "o    I THINK this is fairly easy for attributes and namespaces.",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "o    I think its doable – for arrays",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "o    It MAY require having an XPath (or VariantValuePath) type class to denote position in the tree",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "§  If so – consider implementing",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "§  If not, better",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "o    Try doing a simple regression test sample",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            }
         ],
         "type" : "doc",
         "version" : 1
      },
