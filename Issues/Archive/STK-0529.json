      "description" : {
         "content" : [
            {
               "content" : [
                  {
                     "text" : "o\tUse pointer-to-member (data member) instead of offsetof() in ObjectVariantMapper and other mapper",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "o\tLeverage fixed size buffer (maybe sizeof(size_t)??) – and memcpy ptr to member in/out.",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "o\tSo we generically safe the ptrtomember.",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "o\tOr use anyvariantvalue?",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "o\tBut either way – store efficiently and use casts to produce right ptrtomember for actual IO code.",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            }
         ],
         "type" : "doc",
         "version" : 1
      },
