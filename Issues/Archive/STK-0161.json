      "description" : {
         "content" : [
            {
               "content" : [
                  {
                     "text" : "Add “Upgrade” module in DataExcahgne,. For now – just add simple utilities like:",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "(((NTOE – API optimized for case where no upgrade needed ",
                     "type" : "text"
                  },
                  {
                     "marks" : [
                        {
                           "type" : "strike"
                        }
                     ],
                     "text" : "}}} but could do better at that ;",
                     "type" : "text"
                  },
                  {
                     "text" : ") Not error if stuff we’re looking for not found…",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "type" : "rule"
            },
            {
               "content" : [
                  {
                     "text" : "namespace {",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "bool    UpgradeObjectElement_ (VariantValue* variantObject, const String& eltName, const function<bool(VariantValue*)>& eltUpgrader)",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "{",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "if (variantObject->GetType () == VariantValue::Type::eMap) {",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "Mapping<String,VariantValue> vm = variantObject->As<Mapping<String,VariantValue>> ();",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "auto o = vm.Lookup (eltName);",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "if (o.IsPresent ()) {",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "VariantValue    v   =   *o;",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "if (eltUpgrader (&v)) {",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "vm.Add (eltName, v);",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "*variantObject = vm;",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "return true;",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "}",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "}",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "}",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "return false;",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "}",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "}",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "(and see how used in BLKQCL-Controller, and maybe do upgrader for mapping enums etc).",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "function<bool(VariantValue*)>    MakeStringMapUpgrader_ (const Mapping<String,String>& m) {",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "return [m] (VariantValue* variantValueToUpgrade) -> bool {",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "RequireNotNull (variantValueToUpgrade);",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "if (variantValueToUpgrade->GetType () == VariantValue::Type::eString) {",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "auto    o = m.Lookup (variantValueToUpgrade->As<String> ());",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "if (o.IsPresent ()) {",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "*variantValueToUpgrade = *o;",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "return true;",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "}",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "}",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "return false;",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "};",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "}",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            }
         ],
