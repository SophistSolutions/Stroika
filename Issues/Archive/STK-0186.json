               },
               "body" : {
                  "content" : [
                     {
                        "content" : [
                           {
                              "text" : "Changed in v2.1 branch September 2018, and for Windows, SharedPtr still slgihtly faster, and otherwise use shared_ptr.",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "text" : "Test std::shared_ptr versus Memory::SharedPtr (shared_ptr vs SharedPtr)",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "PERFORMANCE_SCORE\t0.86",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "DETAILS:         \t[baseline test 10.7365 secs, and comparison 9.21932 sec, and warnIfPerfScore > 1.05, and perfScore=0.858692]",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "SharedPtr is FASTER",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "text" : "Switched from #define to constexpr:",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "text" : "#if defined(_MSC_VER)",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "constexpr bool kSharedPtr_IsFasterThan_shared_ptr = true;",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "#else",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "constexpr bool kSharedPtr_IsFasterThan_shared_ptr = false;",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "#endif",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "text" : "Lower priority of this issue.",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     }
