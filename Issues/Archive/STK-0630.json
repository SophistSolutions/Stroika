                     "48x48" : "https://secure.gravatar.com/avatar/9415554eef74e2169ce3e459c177ff75?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FLP-4.png"
                  },
                  "displayName" : "Lewis Pringle",
                  "self" : "https://stroika.atlassian.net/rest/api/3/user?accountId=557058%3A4fe560ca-b4e1-41d1-9bdf-97b1684eda32",
                  "timeZone" : "America/New_York"
               },
               "body" : {
                  "content" : [
                     {
                        "content" : [
                           {
                              "text" : "READ these two articles CAREFULLY about upgradelocks.",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "text" : "The first contains a good implemeantion I COULD USE DIRECTLY. The second contains example code that may help for use cases (like what I called non-atomic upgradelock).",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "text" : "       Add regtest – and do something good with",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "text" : "              RWSycnrhonzied<> x;",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "text" : "              Auto cl = x.cget ();",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "text" : "              Auto rwl = x.rwget ();      //",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "text" : "                      // See ",
                              "type" : "text"
                           },
                           {
                              "attrs" : {
                                 "url" : "https://stackoverflow.com/questions/24334735/can-a-shared-lock-on-a-stdshared-timed-mutex-be-upgraded-to-an-exclusive-lock"
                              },
                              "type" : "inlineCard"
                           },
                           {
                              "text" : " ",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "text" : "                      // ",
                              "type" : "text"
                           },
                           {
                              "attrs" : {
                                 "url" : "http://www.open-std.org/jtc1/sc22/wg21/docs/papers/2012/n3427.html"
                              },
                              "type" : "inlineCard"
                           },
                           {
                              "text" : " ",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "text" : " ",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "text" : "                      DECIDE what I want to do (probably to make it easy/automatic) – and implement that. AND DOCUMENT. Now not documented, but on gcc – just hangs.",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "text" : " ",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "text" : " ",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "text" : "       MAYBE overload of rwget() taking previous read lock to upgrade? That CTOR of WriteableLock taking ref to prev readable, which it unlocks, and then relocks in DTOR. That seems safe and portable. And document (assert) no OTHER shared_locks from THIS THREAD possible. So you CAN upgrade lock – just have to be explicit about it.",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "text" : " ",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "text" : "OR – maybe use:",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "text" : "       ",
                              "type" : "text"
                           },
                           {
                              "attrs" : {
                                 "url" : "https://github.com/HowardHinnant/upgrade_mutex"
                              },
                              "type" : "inlineCard"
                           },
                           {
                              "text" : " ",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "text" : " ",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "attrs" : {
                                 "url" : "https://oroboro.com/upgradable-read-write-locks/"
                              },
                              "type" : "inlineCard"
                           },
                           {
                              "text" : " ",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
