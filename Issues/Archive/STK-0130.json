      "description" : {
         "content" : [
            {
               "content" : [
                  {
                     "text" : ">>> fix/debug",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "ScriptsLib/BuildClang.sh",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : ":   ScriptsLib/BuildGCC.sh",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "(and make sure they respect passed in args… env vars – and document how",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "VERS=a ScriptsLib/BuildClang.sh",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : ",,,,",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "This is important because the ones that come with ubuntu have a queer dependency on whatever recent version of gcc you have installed, and so when I install new GCC, clang goes crazy.",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            }
         ],
