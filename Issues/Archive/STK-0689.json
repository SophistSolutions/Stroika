      "description" : {
         "content" : [
            {
               "content" : [
                  {
                     "text" : "This depends on the smaller simpler issue of just supporting the etag field in a response.",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "But this issue refers to building on that logic to (maybe not thought through) automatically generate etags base don some sort of policy? and/or last modified fields.",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "And then little point in this without adding conditional get support.",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            }
         ],
