      "description" : {
         "content" : [
            {
               "content" : [
                  {
                     "text" : "ProcessMapType  ExtractFromProcFS_ ()",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "{",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "/// Most status - like time - come from ",
                     "type" : "text"
                  },
                  {
                     "marks" : [
                        {
                           "attrs" : {
                              "href" : "http://linux.die.net/man/5/proc"
                           },
                           "type" : "link"
                        }
                     ],
                     "text" : "http://linux.die.net/man/5/proc",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "///proc/[pid]/stat",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "//  Status information about the process. This is used by ps(1). It is defined in /usr/src/linux/fs/proc/array.c.",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "//",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "ProcessMapType  results;",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "attrs" : {
                  "level" : 1
               },
               "content" : [
                  {
                     "text" : "if     qUseProcFS_",
                     "type" : "text"
                  }
               ],
               "type" : "heading"
            },
            {
               "content" : [
                  {
                     "text" : "for (String dir : IO::FileSystem:",
                     "type" : "text"
                  },
                  {
                     "attrs" : {
                        "id" : "1f603",
                        "shortName" : ":smiley:",
                        "text" : "😃"
                     },
                     "type" : "emoji"
                  },
                  {
                     "text" : "irectoryIterable (String_Constant (L\"/proc\"))) {",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "bool isAllNumeric = not dir.FindFirstThat ([] (Character c) -> bool { return not c.IsDigit (); });",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "attrs" : {
                  "level" : 1
               },
               "content" : [
                  {
                     "text" : "if     USE_NOISY_TRACE_IN_THIS_MODULE_",
                     "type" : "text"
                  }
               ],
               "type" : "heading"
            },
            {
               "content" : [
                  {
                     "text" : "Debug::TraceContextBumper ctx (SDKSTR (\"Stroika::Frameworks::SystemPerformance::Instruments:",
                     "type" : "text"
                  },
                  {
                     "attrs" : {
                        "id" : "1f61b",
                        "shortName" : ":stuck_out_tongue:",
                        "text" : "😛"
                     },
                     "type" : "emoji"
                  },
                  {
                     "text" : "rocessDetails::{}::ExtractFromProcFS_::reading proc files\"));",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "DbgTrace (L\"isAllNumeric=%d, dir= %s\", isAllNumeric, dir.c_str ());",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "attrs" : {
                  "level" : 1
               },
               "content" : [
                  {
                     "text" : "endif",
                     "type" : "text"
                  }
               ],
               "type" : "heading"
            },
            {
               "content" : [
                  {
                     "text" : "if (isAllNumeric) {",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "pid_t pid = String2Int<pid_t> (dir);",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "attrs" : {
                  "level" : 1
               },
               "content" : [
                  {
                     "text" : "if     USE_NOISY_TRACE_IN_THIS_MODULE_",
                     "type" : "text"
                  }
               ],
               "type" : "heading"
            },
            {
               "content" : [
                  {
                     "text" : "DbgTrace (\"reading for pid = %d\", pid);",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "attrs" : {
                  "level" : 1
               },
               "content" : [
                  {
                     "text" : "endif",
                     "type" : "text"
                  }
               ],
               "type" : "heading"
            },
            {
               "content" : [
                  {
                     "text" : "String  processDirPath = String_Constant (L\"/proc/\") + dir + String_Constant (L\"/\");",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "ProcessType processDetails;",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "IgnoreExceptionsExceptThreadAbortForCall (processDetails.fCommandLine = ReadFileString_ (processDirPath + String_Constant (L\"cmdline\")));",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "IgnoreExceptionsExceptThreadAbortForCall (processDetails.fCurrentWorkingDirectory = IO::FileSystem::FileSystem:",
                     "type" : "text"
                  },
                  {
                     "attrs" : {
                        "id" : "1f603",
                        "shortName" : ":smiley:",
                        "text" : "😃"
                     },
                     "type" : "emoji"
                  },
                  {
                     "text" : "efault ().ResolveShortcut (processDirPath + String_Constant (L\"cwd\")));",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "IgnoreExceptionsExceptThreadAbortForCall (processDetails.fEnvironmentVariables = ReadFileStringsMap_ (processDirPath + String_Constant (L\"environ\")));",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "IgnoreExceptionsExceptThreadAbortForCall (processDetails.fEXEPath = IO::FileSystem::FileSystem:",
                     "type" : "text"
                  },
                  {
                     "attrs" : {
                        "id" : "1f603",
                        "shortName" : ":smiley:",
                        "text" : "😃"
                     },
                     "type" : "emoji"
                  },
                  {
                     "text" : "efault ().ResolveShortcut (processDirPath + String_Constant (L\"exe\")));",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "IgnoreExceptionsExceptThreadAbortForCall (processDetails.fRoot = IO::FileSystem::FileSystem:",
                     "type" : "text"
                  },
                  {
                     "attrs" : {
                        "id" : "1f603",
                        "shortName" : ":smiley:",
                        "text" : "😃"
                     },
                     "type" : "emoji"
                  },
                  {
                     "text" : "efault ().ResolveShortcut (processDirPath + String_Constant (L\"root\")));",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "try {",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "static  const   double  kClockTick_ = sysconf(_SC_CLK_TCK);",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "StatFileInfo_   stats    =  ReadStatFile_ (processDirPath + String_Constant (L\"stat\"));",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "processDetails.fProcessStartedAt = DateTime (static_cast<time_t> (stats.start_time));",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "processDetails.fTotalTimeUsed = double (stats.utime) + double (stats.stime ) / kClockTick_;",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "}",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "catch (...) {",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "}",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "results.Add (pid, processDetails);",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "}",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "}",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            }
         ],
         "type" : "doc",
         "version" : 1
      },
