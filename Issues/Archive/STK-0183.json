      "description" : {
         "content" : [
            {
               "content" : [
                  {
                     "text" : ">>>> consider adding Optional::ClaearIf(bool) – and clears if arg so stuff like this can be written in one line.",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "// If zero, dont write these, mark them as 'empty' to save space in spillfile",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "if (*dui.fIOReadRate == 0) {",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "dui.fIOReadRate->clear ();",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "}",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "if (*dui.fIOWriteRate == 0) {",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "dui.fIOWriteRate->clear ();",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "}",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "if (*dui.fInUsePct == 0) {",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "dui.fInUsePct->clear ();",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "}",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "UNSURE - too many variations - and no logic to scheme - consider carefully.",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            }
