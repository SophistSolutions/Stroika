                  },
                  "displayName" : "Lewis Pringle",
                  "self" : "https://stroika.atlassian.net/rest/api/3/user?accountId=557058%3A4fe560ca-b4e1-41d1-9bdf-97b1684eda32",
                  "timeZone" : "America/New_York"
               },
               "body" : {
                  "content" : [
                     {
                        "content" : [
                           {
                              "text" : "Small progress in 2.0a126 (added CC=/AR=), but still quite incomplete.",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "text" : "Issue is that the config and Configure scripts just dont really seem to support an ARM target.",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "text" : "See ",
                              "type" : "text"
                           },
                           {
                              "marks" : [
                                 {
                                    "attrs" : {
                                       "href" : "http://stackoverflow.com/questions/11841919/cross-compile-openssh-for-arm"
                                    },
                                    "type" : "link"
                                 }
                              ],
                              "text" : "http://stackoverflow.com/questions/11841919/cross-compile-openssh-for-arm",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "text" : "MAYBE use someting like:",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "./Configure linux-armv4 shared zlib-dynamic --prefix=/usr",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "make CC=$HOST-gcc AR=\"$HOST-ar r\" RANLIB=$HOST-ranlib",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "make CC=$HOST-gcc AR=\"$HOST-ar r\" RANLIB=$HOST-ranlib INSTALL_PREFIX=$ROOTFS install",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "text" : "or - I think they are working on makefiles for next release. May make sense to postpone this til then unless/until there is a real need to have openssl on that platofmr (and can use use-system).",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     }
                  ],
                  "type" : "doc",
                  "version" : 1
               },
