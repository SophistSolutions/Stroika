                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "constexpr bool operator> (const Version& lhs, const Version& rhs);",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "#endif",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "Once I have this code right, and testable on a C++20 compiler, then replicate this logic as appropriate for all the other three-way-comparer code in Stroika (even if just conditioanl compile).",
