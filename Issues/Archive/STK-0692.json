                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "#if __cpp_lib_three_way_comparison >= 201711",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "public:",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "constexpr std::strong_ordering operator<=> (const Version& rhs)",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "#endif",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
