      "description" : {
         "content" : [
            {
               "content" : [
                  {
                     "text" : "Use this to fix AddAll() and esp CTORS for containers that take iterators and similarly use to fix contienr of contrainers (stl iterables)",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "template <class _InputIterator>",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "vector(_InputIterator __first,",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "typename enable_if<__is_input_iterator<_InputIterator>::value &&",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "!__is_forward_iterator<_InputIterator>::value &&",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "... more conditions ...",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "_InputIterator>::type __last);",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            }
         ],
