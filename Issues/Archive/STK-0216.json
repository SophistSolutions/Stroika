      "description" : {
         "content" : [
            {
               "content" : [
                  {
                     "text" : "FileStream Properties",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : ".NET Framework 4.5 Other Versions ",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "The FileStream type exposes the following members.",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "Properties",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "Show:  Inherited  Protected",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "Name\tDescription",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "Public property  Supported by the XNA Framework\tCanRead\tGets a value indicating whether the current stream supports reading. (Overrides Stream.CanRead.)",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "Public property  Supported by the XNA Framework\tCanSeek\tGets a value indicating whether the current stream supports seeking. (Overrides Stream.CanSeek.)",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "Public property  Supported by the XNA Framework\tCanTimeout\tGets a value that determines whether the current stream can time out. (Inherited from Stream.)",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "Public property  Supported by the XNA Framework\tCanWrite\tGets a value indicating whether the current stream supports writing. (Overrides Stream.CanWrite.)",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "Public property\tHandle\tObsolete. Gets the operating system file handle for the file that the current FileStream object encapsulates.",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "Public property  Supported by the XNA Framework\tIsAsync\tGets a value indicating whether the FileStream was opened asynchronously or synchronously.",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "Public property  Supported by the XNA Framework\tLength\tGets the length in bytes of the stream. (Overrides Stream.Length.)",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "Public property  Supported by the XNA Framework\tName\tGets the name of the FileStream that was passed to the constructor.",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "Public property  Supported by the XNA Framework\tPosition\tGets or sets the current position of this stream. (Overrides Stream.Position.)",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "Public property  Supported by the XNA Framework\tReadTimeout\tGets or sets a value, in miliseconds, that determines how long the stream will attempt to read before timing out. (Inherited from Stream.)",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "Public property\tSafeFileHandle\tGets a SafeFileHandle object that represents the operating system file handle for the file that the current FileStream object encapsulates.",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "Public property  Supported by the XNA Framework\tWriteTimeout\tGets or sets a value, in miliseconds, that determines how long the stream will attempt to write before timing out. (Inherited from Stream.)",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            }
         ],
