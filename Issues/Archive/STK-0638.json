               "body" : {
                  "content" : [
                     {
                        "content" : [
                           {
                              "text" : "Changed priority to HIGH - because this causes real practical problems with keepalives - lots of connections kept open by browser.",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     }
                  ],
