      "description" : {
         "content" : [
            {
               "content" : [
                  {
                     "text" : "We currently have ",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "OptionsFileHelper::OpenWithCreateAlongPath",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "and ",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "OptionsFileHelper_... in IntermetnetdaTypeRegistry.cpp",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "Both are not very good 'clones' of the HelathFrame similarly named code.",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "Do (non-portable) but more respectable Windows specific ipl in DataExchange, and re-vector that othe rcode to the new place.",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "Though the Led verison looks more complete, probably start with the InternetMEdiateFiles version since that was done more recently.",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            }
         ],
