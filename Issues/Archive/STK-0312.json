      "description" : {
         "content" : [
            {
               "content" : [
                  {
                     "text" : ">> for InternetMediaTypes – add ability to add externally specified mappings (like ccr is ‘textformat’) etc.",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "MAYBE have list of ‘text-like’ types, and list of image-like ones etc. Or have set of ‘bits’ – isabits – associated (oiptinally) with things added in registration.",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "NOTE – what RAILS DOES:",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "MIMETYPES.RB…",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "content" : [
                        {
                           "content" : [
                              {
                                 "text" : "Add new mime types for use in respond_to blocks:",
                                 "type" : "text"
                              }
                           ],
                           "type" : "paragraph"
                        }
                     ],
                     "type" : "listItem"
                  },
                  {
                     "content" : [
                        {
                           "content" : [
                              {
                                 "text" : "Mime::Type.register \"text/richtext\", :rtf",
                                 "type" : "text"
                              }
                           ],
                           "type" : "paragraph"
                        }
                     ],
                     "type" : "listItem"
                  },
                  {
                     "content" : [
                        {
                           "content" : [
                              {
                                 "text" : "Mime::Type.register_alias \"text/html\", :iphone",
                                 "type" : "text"
                              }
                           ],
                           "type" : "paragraph"
                        }
                     ],
                     "type" : "listItem"
                  }
               ],
               "type" : "orderedList"
            }
