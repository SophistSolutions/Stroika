      "customfield_10012" : "0|i00253:",
      "customfield_10300" : "{}",
      "description" : {
         "content" : [
            {
               "content" : [
                  {
                     "text" : "// useful generic casting tool for containers (like Sequence<int> to Sequence_Array<int> - - but returns null if not right type so you can use as:",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "If (Sequence_Array<int>* s = myS.Dyamic_Cast<Sequence_Array<int>>) {",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "s->SetSlotsAlloced (40);",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "}",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "BUT  trick is finding right target type. Maybe have generic private name in “ContainerOf” – and have all the ContainerOf’s have a generic ‘extended friend’ for Iterable<>:",
                     "type" : "text"
                  },
                  {
                     "attrs" : {
                        "id" : "1f603",
                        "shortName" : ":smiley:",
                        "text" : "😃"
                     },
                     "type" : "emoji"
                  },
                  {
                     "text" : "ynamic_cast<>??",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "Template <typename ContainerOfT>",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "ContaienrOfT* Iterable<T>:",
                     "type" : "text"
                  },
                  {
                     "attrs" : {
                        "id" : "1f603",
                        "shortName" : ":smiley:",
                        "text" : "😃"
                     },
                     "type" : "emoji"
                  },
                  {
                     "text" : "ynamic_Cast () {",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "If (dynamic_cast<T::Rep*> (GetRep()) {",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "Return reinterpret_cast<ContainerOfT*> (this);",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "}",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "Return nullptr;",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "}",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            }
         ],
         "type" : "doc",
         "version" : 1
      },
