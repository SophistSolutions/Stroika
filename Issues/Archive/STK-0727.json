               "body" : {
                  "content" : [
                     {
                        "content" : [
                           {
                              "text" : "NOTE: This works FINE for any header (except the three prohibited by the stnadard). Just SKIP writing in the initial flush any header value in ‘Trailers’. And then FORCE EXTRA writing any header in trailers at teh end, and updat ethe assert logic to ALLOW changes to headers (just these fields if possible to restrict) - from the Trailers set.",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     }
