                     ],
                     "text" : "https://tools.ietf.org/html/rfc2616#section-3.6.1",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "marks" : [
                        {
                           "attrs" : {
                              "href" : "https://tools.ietf.org/html/rfc2616#section-14.40"
                           },
                           "type" : "link"
                        }
                     ],
                     "text" : "https://tools.ietf.org/html/rfc2616#section-14.40",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "etc..",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "Fairly easy.",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "content" : [
                        {
                           "content" : [
                              {
                                 "text" : "must add property to Response called 'trailers' which is a set of headers not to be sent initially.",
                                 "type" : "text"
                              }
                           ],
                           "type" : "paragraph"
                        }
                     ],
                     "type" : "listItem"
                  },
                  {
                     "content" : [
                        {
                           "content" : [
                              {
                                 "text" : "then ALLOW updates to all the headers in the trailers section (currently have asserts no) (cannot disable asserts perfectly but good enuf)",
                                 "type" : "text"
                              }
                           ],
                           "type" : "paragraph"
                        }
                     ],
                     "type" : "listItem"
                  },
                  {
                     "content" : [
                        {
                           "content" : [
                              {
                                 "text" : "then if set, send trailers andHEAD and actual trailuers (trailers would be a properity of http::Headers).",
                                 "type" : "text"
                              }
                           ],
                           "type" : "paragraph"
                        }
                     ],
                     "type" : "listItem"
                  }
               ],
               "type" : "bulletList"
            },
            {
               "content" : [
                  {
                     "text" : "There are lots of details abotu making this work correctly (including accept-trailers or some such).",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "Seems a real corner case and probably not worth doing anytime soon (especailly as http 2.0 has a differnet mechanism.",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            }
         ],
