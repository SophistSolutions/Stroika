               "body" : {
                  "content" : [
                     {
                        "content" : [
                           {
                              "text" : "Consider tool like DbgTraceDumper module",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "+// Debugging utilities",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "+namespace {",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "+    void    Dump_ (const Set<pid_t>& ps, const String& prefix = String ())",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "+    {",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "+        Debug::TraceContextBumper ctx (\"{}:",
                              "type" : "text"
                           },
                           {
                              "attrs" : {
                                 "id" : "1f603",
                                 "shortName" : ":smiley:",
                                 "text" : "😃"
                              },
                              "type" : "emoji"
                           },
                           {
                              "text" : "ump_(Set<pid_t>)\");",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "+        StringBuilder sb;",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "+        sb += L\"{ \";",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "+        for (auto p : ps) {",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "+            sb += Characters::Format (L\"%d, \", p);",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "+        }",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "+        sb += L\" }\";",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "+        DbgTrace (L\"%s%s\", prefix.c_str (), sb.c_str ());",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "+    }",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "+}",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "+namespace {",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "+    void    Dump_ (const PerProcessStaticStats_& p, const String& prefix = String ())",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "+    {",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "+        DbgTrace (L\"%sPerProcessStaticStats_ { fProcessName: %s; fProcessStartedAt: %s; fCmdLine: %s;  fParentProcessID: %d;  fExecutablePath: %s; } \", prefix.c_str (), p.fProcessName.c_str (), p.fProcessStartedAt.Format ().c_str (), p.fCmdLine.Value ().c_str (), p.fParentProcessID.Value (-1), p.fExecutablePath.c_str ());",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "+    }",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "+    void    Dump_ (const Mapping<pid_t, PerProcessStaticStats_>& ps, const String& prefix = String ())",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "+    {",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "+        Debug::TraceContextBumper ctx (\"{}:",
                              "type" : "text"
                           },
                           {
                              "attrs" : {
                                 "id" : "1f603",
                                 "shortName" : ":smiley:",
                                 "text" : "😃"
                              },
                              "type" : "emoji"
                           },
                           {
                              "text" : "ump_(Mapping<pid_t,PerProcessStaticStats_>)\");",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "+        if (not prefix.empty ()) {",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "+            DbgTrace (L\"%s\", prefix.c_str ());",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "+        }",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "+        for (auto p : ps) {",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "+            Dump_ (p.fValue, Characters::Format (L\"%d: \", p.fKey));",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "+        }",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "+    }",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "+}",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "+namespace { ",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "Use probably templates or iterable. Handy. Maybe “ToString” – as helper – just for debugging?",
