                  },
                  "displayName" : "Lewis Pringle",
                  "self" : "https://stroika.atlassian.net/rest/api/3/user?accountId=557058%3A4fe560ca-b4e1-41d1-9bdf-97b1684eda32",
                  "timeZone" : "America/New_York"
               },
               "body" : {
                  "content" : [
                     {
                        "content" : [
                           {
                              "text" : "OLD NOTES ON THIS:",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "On Linux libc++ can typically be used with only ‘-stdlib=libc+",
                              "type" : "text"
                           },
                           {
                              "marks" : [
                                 {
                                    "type" : "underline"
                                 }
                              ],
                              "text" : "’. However some libc",
                              "type" : "text"
                           },
                           {
                              "text" : "+ installations require the user manually link libc+",
                              "type" : "text"
                           },
                           {
                              "marks" : [
                                 {
                                    "type" : "underline"
                                 }
                              ],
                              "text" : "abi themselves. If you are running into linker errors when using libc",
                              "type" : "text"
                           },
                           {
                              "text" : "+ try adding ‘-lc++abi’ to the link line. For example:",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "$ clang++ -stdlib=libc++ test.cpp -lc++ -lc++abi -lm -lc -lgcc_s -lgcc",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "Alternately, you could just add libc++abi to your libraries list, which in most situations will give the same result:",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "$ clang++ -stdlib=libc++ test.cpp -lc++abi",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     }
                  ],
                  "type" : "doc",
                  "version" : 1
               },
