      "description" : {
         "content" : [
            {
               "content" : [
                  {
                     "text" : "// @todo note - this used to check fStatus flag and I just changed to checking *fTLSInterruptFlag_ – LGP 2015-02-26",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "if (fStatus_ == Status::eAborting) {",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "Assert (*fTLSAbortFlag_);",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "Assert (*fTLSInterruptFlag_);       // except maybe possible slight race til I use atomic exchange!!! – LGP 2015-02-26",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "// saw triggered on UNIX, gcc48, 2015-04-03 running regtests",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "// saw triggered on Windows, using MSVC2k15. But very rare",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "}",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            }
         ],
