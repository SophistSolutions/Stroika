               "body" : {
                  "content" : [
                     {
                        "content" : [
                           {
                              "text" : "     *        noexcept - unclear why I cannot declare copy constructor and copy assignment operators as noexect\n     *        on GCC. THIS compiles fine, but then later bits of code that use it fail to compile (g++ 9 at least).",
                              "type" : "text"
                           }
                        ],
                        "type" : "codeBlock"
                     },
                     {
                        "content" : [
                           {
                              "text" : "    Host (const Host&)     = default;\n    Host (Host&&) noexcept = default;\n\n\npublic:\n    nonvirtual Host& operator= (const Host&) = default;\n    nonvirtual Host& operator= (Host&&) noexcept = default;",
                              "type" : "text"
                           }
                        ],
                        "type" : "codeBlock"
                     }
                  ],
                  "type" : "doc",
                  "version" : 1
               },
