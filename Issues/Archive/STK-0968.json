      "customfield_10300" : "{build={count=1, dataType=build, failedBuildCount=0, successfulBuildCount=1, unknownBuildCount=0}, repository={count=1, dataType=repository}, json={\"cachedValue\":{\"errors\":[],\"summary\":{\"repository\":{\"overall\":{\"count\":1,\"lastUpdated\":\"2024-12-16T13:19:08.000-0500\",\"dataType\":\"repository\"},\"byInstanceType\":{\"oAuth-com.github.integration.production\":{\"count\":1,\"name\":\"GitHub\"},\"GitHub\":{\"count\":1,\"name\":\"GitHub\"}}},\"build\":{\"overall\":{\"count\":1,\"lastUpdated\":null,\"failedBuildCount\":0,\"successfulBuildCount\":1,\"unknownBuildCount\":0,\"dataType\":\"build\"},\"byInstanceType\":{\"cloud-providers\":{\"count\":1,\"name\":\"Other providers\"}}}}},\"isStale\":true}}",
      "description" : {
         "content" : [
            {
               "content" : [
                  {
                     "text" : "The fact that InsertAt is a const method and Append() is non-const is clearly deeply confusing.",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "Best to relplace ",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "Current Mutating methods (as of v3.0d1x)",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "     *          o   SetCharAt",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "     *          o   c_str()",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "     *          o   operator=",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "     *          o   clear()",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "     *          o   Append",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "     *          o   operator+=",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "     *          o   c_str ()  -- non-const",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "     *          o   erase()",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "mark as deprecated, and some gone.",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "Then can say clearly - all string apis non-const.",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "Biggest/only challenge, is non-const c_str() which is very handy for printing stuff (debug messages) - but maybe avoided/fixed by new String format stuff, so maybe wait on that to decide (or maybe do all but c_str() til we decide about that).",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            }
         ],
         "type" : "doc",
         "version" : 1
      },
