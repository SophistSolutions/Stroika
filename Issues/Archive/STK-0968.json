               "body" : {
                  "content" : [
                     {
                        "content" : [
                           {
                              "text" : "CONSIDER making String fully immutable",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "text" : "o   BUT – key question – is c_str()",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "text" : "§  Cound convert all to As<wstring>.c_str () but PITA",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "text" : "o   Look at std::format first!!! PRIORITY",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "text" : "o   Since this will decide if there is a good alternative for the .c_str() stuff",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     }
                  ],
                  "type" : "doc",
                  "version" : 1
               },
