               "body" : {
                  "content" : [
                     {
                        "content" : [
                           {
                              "text" : "NOTE - I have this problem on my DEVVM - but not my laptop - and BOTH are running the same version of windows 10.",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "text" : "I've tried to check for config differneces but havent found any.",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "text" : "NOTE - I looked at ",
                              "type" : "text"
                           },
                           {
                              "marks" : [
                                 {
                                    "attrs" : {
                                       "href" : "https://social.msdn.microsoft.com/Forums/en-US/fc85630e-5684-4df6-ad2f-5a128de3deef/260-character-explorer-path-length-limit?forum=windowsgeneraldevelopmentissues"
                                    },
                                    "type" : "link"
                                 }
                              ],
                              "text" : "https://social.msdn.microsoft.com/Forums/en-US/fc85630e-5684-4df6-ad2f-5a128de3deef/260-character-explorer-path-length-limit?forum=windowsgeneraldevelopmentissues",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "text" : "I looked at ",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "HKEY_LOCAL_MACHINE\\SYSTEM\\CurrentControlSet\\Control\\FileSystem",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "text" : "and BOTH sytsems - the oen that works and the one that doesnt -(with long paths has LongPathsEnabled set to 0.",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "text" : "I never tried LongPathsEnabled = 1;",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     }
