      "customfield_10001" : "1_*:*_1_*:*_14270163517_*|*_5_*:*_1_*:*_0",
      "customfield_10012" : "0|i004cf:",
      "customfield_10300" : "{}",
      "description" : {
         "content" : [
            {
               "content" : [
                  {
                     "text" : "At least PART of this probelm apepars to be ",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "content" : [
                        {
                           "content" : [
                              {
                                 "text" : "-mmacosx-version-min=10.15 needed for ",
                                 "type" : "text"
                              },
                              {
                                 "marks" : [
                                    {
                                       "attrs" : {
                                          "href" : "https://stackoverflow.com/questions/56924853/why-xcode-11-beta-cant-use-c17s-filesystem-header"
                                       },
                                       "type" : "link"
                                    }
                                 ],
                                 "text" : "https://stackoverflow.com/questions/56924853/why-xcode-11-beta-cant-use-c17s-filesystem-header",
                                 "type" : "text"
                              }
                           ],
                           "type" : "paragraph"
                        },
                        {
                           "content" : [
                              {
                                 "content" : [
                                    {
                                       "content" : [
                                          {
                                             "text" : "./configure Release --apply-default-release-flags --append-extra-compiler-and-linker-args -mmacosx-version-min=10.15",
                                             "type" : "text"
                                          }
                                       ],
                                       "type" : "paragraph"
                                    }
                                 ],
                                 "type" : "listItem"
                              }
                           ],
                           "type" : "bulletList"
                        }
                     ],
                     "type" : "listItem"
                  }
               ],
               "type" : "orderedList"
            },
            {
               "content" : [
                  {
                     "text" : "I think I worked around about as well as I can (easily). Its OK and off on xcode 11.2, and Macos 10.15",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "But on travis ci - they only support 10.14 for now.",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "So I left in ",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "--append-extra-compiler-and-linker-args -mmacosx-version-min=10.15",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "and will retry mid december ",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "(",
                     "type" : "text"
                  },
                  {
                     "marks" : [
                        {
                           "attrs" : {
                              "href" : "https://travis-ci.community/t/macos-catalina-build-environment/5608)"
                           },
                           "type" : "link"
                        }
                     ],
                     "text" : "https://travis-ci.community/t/macos-catalina-build-environment/5608)",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "says will have new macos in mid december - try again then (probably need to change name of os config - well see).",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            }
         ],
         "type" : "doc",
         "version" : 1
