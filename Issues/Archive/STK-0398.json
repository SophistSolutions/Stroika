               "body" : {
                  "content" : [
                     {
                        "content" : [
                           {
                              "text" : "Got working for case with --openssl use-system and -libcurl use",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "text" : "But --openssl use doesnt work (yet) with --libcurl use because of dependency on something called pkgconfig, so work on getting that setup properly with openessl build./mkaefile.",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     }
                  ],
