      "description" : {
         "content" : [
            {
               "content" : [
                  {
                     "text" : "template    <typename KEY_TYPE, typename VALUE_TYPE, typename TRAITS>",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "typename Mapping_LinkedList<KEY_TYPE, VALUE_TYPE, TRAITS>::Rep_::",
                     "type" : "text"
                  },
                  {
                     "marks" : [
                        {
                           "type" : "em"
                        }
                     ],
                     "text" : "SharedPtrIRep  Mapping_LinkedList<KEY_TYPE, VALUE_TYPE, TRAITS>::Rep",
                     "type" : "text"
                  },
                  {
                     "text" : "::CloneEmpty (IteratorOwnerID forIterableEnvelope) const",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "{",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "if (fData_.HasActiveIterators ()) {",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "CONTAINER_LOCK_HELPER_START (fData_.fLockSupport) {",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "// const cast because though cloning LOGICALLY makes no changes in reality we have to patch iterator lists",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "auto r = Iterable<KeyValuePair<KEY_TYPE, VALUE_TYPE>>::template MakeSharedPtr<Rep_> (const_cast<Rep_*> (this), forIterableEnvelope);",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "r->fData_.RemoveAll ();",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "return r;",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "}",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "CONTAINER_LOCK_HELPER_END ();",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "}",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "else {",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "return Iterable<KeyValuePair<KEY_TYPE, VALUE_TYPE>>::template MakeSharedPtr<Rep_> ();",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "}",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "I THINK these reps have race and we must check hasiterable inside lock (since someone could own rep in one thread and this code run in another and that other thread could then add iterator while we're running.",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            }
         ],
