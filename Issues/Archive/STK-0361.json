                     "48x48" : "https://secure.gravatar.com/avatar/9415554eef74e2169ce3e459c177ff75?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FLP-4.png"
                  },
                  "displayName" : "Lewis Pringle",
                  "self" : "https://stroika.atlassian.net/rest/api/3/user?accountId=557058%3A4fe560ca-b4e1-41d1-9bdf-97b1684eda32",
                  "timeZone" : "America/New_York"
               },
               "body" : {
                  "content" : [
                     {
                        "content" : [
                           {
                              "text" : "This was a major change - mostly backward compatible (with deprecation of most of the older classes).",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "text" : "Replace use of Execution::StringException with Execution::Exception.",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "Now use new feature Activity/DeclareActivity",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "text" : "Use SystemErrorException in place of errnoException or Platform::Windows::Exception (or any other the other similar - HRESULTException etc).",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "text" : "Created erorr 'categoryies' as appropriate  (e.g. Platform::Windows:;HRESULT_error_category)",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "text" : "Deprecated all the exceptions at the top level of IO (e.g. IO::FileBusyException). Use IO::SystemErrorException or new IO::FileSystem::Exception (same as SystemErrorException but adding pathname attributes).",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     }
                  ],
                  "type" : "doc",
                  "version" : 1
               },
