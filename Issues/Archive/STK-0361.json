                  "displayName" : "Lewis Pringle",
                  "self" : "https://stroika.atlassian.net/rest/api/3/user?accountId=557058%3A4fe560ca-b4e1-41d1-9bdf-97b1684eda32",
                  "timeZone" : "America/New_York"
               },
               "body" : {
                  "content" : [
                     {
                        "content" : [
                           {
                              "text" : "MAYBE:",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "text" : "o Add GetErrorCode field to StringException",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "text" : "o MAYBE rename StringException → Excetion (Execution::Exception)",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "text" : "o lose Win32Error object and errno_exception - they just generate the right StringException with the right error_code.",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "text" : "o Improve StringException::kDefaultErrorCode_ at least a separate category that says something generic. And if possible, a special category that has the actual message (probably not possible buecause we only have an int, and thats not guaranteed enuf to store the message without expensive indirection).",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     }
                  ],
                  "type" : "doc",
                  "version" : 1
               },
