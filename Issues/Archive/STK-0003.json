               "body" : {
                  "content" : [
                     {
                        "content" : [
                           {
                              "text" : "Pretty sure we had that in original stroika. I used to use it (maybe ForceInRange?) way back in C code for BBN days.",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "text" : "On Jun 10, 2013, at 5:17 PM, \"Lewis G. Pringle, Jr.\" <notifications@github.com> wrote:",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "text" : "> So I can replace logic like: ",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "> min (max (yearDiff, 0.0f), 100.0f);",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "> ",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "> with a more intuitively named function",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "> double year = PinInRange (yearDiff, 0.0f, 100.0f);",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "> ",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "> (does same thing - just clearer).",
                              "type" : "text"
