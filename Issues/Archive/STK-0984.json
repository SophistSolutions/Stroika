               "body" : {
                  "content" : [
                     {
                        "content" : [
                           {
                              "text" : "                # avoid buggy 17.7 ASAN issue - https://developercommunity.visualstudio.com/t/ASAN-177-clang_rtasan_dynamic-x86_64d/10436682?\n                #echo \"WORKAROUND https://devblogs.microsoft.com/cppblog/msvc-address-sanitizer-one-dll-for-all-runtime-configurations/\"\n                # \"WORKAROUND https://developercommunity.visualstudio.com/t/ASAN-177-clang_rtasan_dynamic-x86_64d/10436682?viewtype=all\"\n                #\n                # Since 17.7.x, we need /c/Program Files/Microsoft Visual Studio/2022/Community/VC/Tools/MSVC/14.37.32822/bin/Hostx64/x64/ - full toolspath is overkill\n                # but simple enuf and only when building for asan\n",
                              "type" : "text"
                           }
                        ],
                        "type" : "codeBlock"
                     }
