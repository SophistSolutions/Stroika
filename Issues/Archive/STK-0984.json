                        "content" : [
                           {
                              "text" : "Did hack to configure to avoid this issue.",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "text" : " ",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "text" : "NEW VS DOCKER BROKE",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "text" : "   PATH=$PATH:/c/Program\\ Files/Microsoft\\ Visual\\ Studio/2022/Community/VC/Tools/MSVC/14.37.32822/bin//Hostx64/x64/",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "text" : " OR",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "text" : "export PATH=$PATH:/C:Program\\ Files/Microsoft\\ Visual\\ Studio/2022/BuildTools/VC/Tools/MSVC/14.37.32822/bin//Hostx64/x64/\"",
