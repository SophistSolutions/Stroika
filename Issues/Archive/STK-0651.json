               "body" : {
                  "content" : [
                     {
                        "content" : [
                           {
                              "text" : "I think this can be done with the combo of:",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "text" : "template <typename ITERABLE>",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "using GetTypeOfIterableValue = decltype (declval<ITERABLE>()).begin ());",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "text" : "Then add the check on CONTAINER_T",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "&& IsAddable<GetTypeOfIterableValue <CONTAINER_T>>;",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     }
                  ],
                  "type" : "doc",
                  "version" : 1
