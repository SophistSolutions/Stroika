      "description" : {
         "content" : [
            {
               "content" : [
                  {
                     "text" : "\tMaybe rename class ‘FileSystem’ to ‘FS’ or AbstractFileSystem or FileSystemPtr???? – yes- FileSystemPtr maybe the best fit given new nomenclature, but not quite accurate in terms of impl.",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "Name Ptr shorter, and less likely confused with enclosing namespace.",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "SIMILAR (but distinct) from what we did with Streams etc.",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "Marked High priority not so much cuz its importnat but we want to DECIDE any big name changes as early as possible so Stroika can be more widely released.",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            }
         ],
         "type" : "doc",
         "version" : 1
