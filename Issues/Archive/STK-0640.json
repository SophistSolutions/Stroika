      "description" : {
         "content" : [
            {
               "content" : [
                  {
                     "text" : "Stroika_Foundation_Debug_ATTRIBUTE_NO_SANITIZE (\"stack-use-after-scope\")",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "TRIED THIS:",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "#if qCompiler_Sanitizer_stack_use_after_scope_on_arm_Buggy",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "// Crazy warning - cuz its NOT ignored - it works around probable bug with stack-use-after-scope",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "DISABLE_COMPILER_GCC_WARNING_START (\"GCC diagnostic ignored \\\"-Wattributes\\\"\");",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "#endif",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "template <typename T, size_t BUF_SIZE>",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "#if qCompiler_Sanitizer_stack_use_after_scope_on_arm_Buggy",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "Stroika_Foundation_Debug_ATTRIBUTE_NO_SANITIZE (\"stack-use-after-scope\")",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "#endif",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "inline SmallStackBuffer<T, BUF_SIZE>::SmallStackBuffer ()",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : ": fSize_ (0)",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : ", fPointer_ (fBuffer_)",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "{",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "#if qDebug",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "::memcpy (fGuard1_, kGuard1_, sizeof (kGuard1_));",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "::memcpy (fGuard2_, kGuard2_, sizeof (kGuard2_));",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "#endif",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "Invariant ();",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "}",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "#if qCompiler_Sanitizer_stack_use_after_scope_on_arm_Buggy",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "DISABLE_COMPILER_GCC_WARNING_END (\"GCC diagnostic ignored \\\"-Wattributes\\\"\");",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "#endif",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "But according to ",
                     "type" : "text"
                  },
                  {
                     "marks" : [
                        {
                           "attrs" : {
                              "href" : "https://github.com/google/sanitizers/wiki/AddressSanitizerClangVsGCC-(5.0-vs-7.1)"
                           },
                           "type" : "link"
                        }
                     ],
                     "text" : "https://github.com/google/sanitizers/wiki/AddressSanitizerClangVsGCC-(5.0-vs-7.1)",
                     "type" : "text"
                  },
                  {
                     "text" : " - no_sanitize() attribute doesnt work til gcc 8, and by then they may have fixed the underlying bug.",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            }
         ],
         "type" : "doc",
         "version" : 1
