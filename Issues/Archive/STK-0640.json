                        ],
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "text" : "worked a little better for gcc7.2 on arm, but not fully (not on ",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "==13528==ERROR: AddressSanitizer: stack-use-after-scope on address 0x7ec81a60 at pc 0x55bdcaa3 bp 0x7ec8197c sp 0x7ec81974",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "WRITE of size 60 at 0x7ec81a60 thread T0",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "#0 0x55bdcaa1 in operator() /home/lewis/Sandbox/Stroika-Regression-Tests/Library/Sources/Stroika/Foundation/DataExchange/OptionsFile.cpp:108",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "#1 0x55be111f in _M_invoke /usr/arm-linux-gnueabihf/include/c++/7/bits/std_function.h:302",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "#2 0x55be5b91 in std::function<Stroika::Foundation::Characters::String (Stroika::Foundation::Characters::String const&, Stroika::Foundation::Characters::String const&)>::operator()(Stroika::Foundation::Characters::String const&, Stroika::Foundation::Characters::String const&) const /usr/arm-linux-gnueabihf/include/c++/7/bits/std_function.h:706",
