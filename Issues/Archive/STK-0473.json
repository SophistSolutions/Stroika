      "description" : {
         "content" : [
            {
               "content" : [
                  {
                     "text" : "inline  bool    SpinLock::try_lock ()",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "{",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "return not fLock_.test_and_set (std::memory_order_acquire);",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "}",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "if this fails to get the lock, it still sets the value! Very dangerous! appears thats a race. That otehr will unset, but maybe overlapping.",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "Not sure of the rest of this impl. ALL VERY VERY BAD and MSUT FIX ASAP",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            }
