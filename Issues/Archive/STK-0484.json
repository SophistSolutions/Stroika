      "description" : {
         "content" : [
            {
               "content" : [
                  {
                     "text" : "Review thread safety of WaitableEvent",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "I added a helgrind suppression to avoid a warning.",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "I think my code is sensible, but am quite unsure.",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "Look closely at  ",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "marks" : [
                        {
                           "attrs" : {
                              "href" : "http://cbloomrants.blogspot.com/2011/07/07-26-11-implementing-event-wfmo.html"
                           },
                           "type" : "link"
                        }
                     ],
                     "text" : "http://cbloomrants.blogspot.com/2011/07/07-26-11-implementing-event-wfmo.html",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "inline  WaitableEvent::WE_::WE_ (ResetType resetType)",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : ": fResetType (resetType)",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "{",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "Stroika_Foundation_Debug_ValgrindDisableHelgrind (fTriggered);  // @see ",
                     "type" : "text"
                  },
                  {
                     "marks" : [
                        {
                           "attrs" : {
                              "href" : "https://stroika.atlassian.net/browse/STK-484"
                           },
                           "type" : "link"
                        }
                     ],
                     "text" : "https://stroika.atlassian.net/browse/STK-484",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "}",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "AND     Stroika_Foundation_Debug_ValgrindDisableHelgrind (fWE_.fConditionVariable);\t// avoid sporadic (about 1/3 time) probably spurrious helgrind failure - for test Foundation::Execution::Threads – LGP 2016-06-02",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            }
         ],
