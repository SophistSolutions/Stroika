                  "content" : [
                     {
                        "content" : [
                           {
                              "text" : "when done - we can lose ",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "text" : "            # WORKAROUND til we have https://stroika.atlassian.net/browse/STK-1005 addressed\n            # # Though included in packageconfig support(Builds\\Debug\\ThirdPartyComponents\\lib\\pkgconfig\\libxml-2.0.pc), in a queer place,\n            # # and if we count on it, intellisense/vscode wont know right directories\n            push @INCLUDES_PATH, trim (`realpath --canonicalize-missing Builds/$configurationName/ThirdPartyComponents/include/libxml2`) . \"/\";\n            push @CPPFLAGS, '-DLIBXML_STATIC';  # cannot use pkg-config for this because then wouldn't be seen in .vscode etc\n",
                              "type" : "text"
                           }
                        ],
                        "type" : "codeBlock"
                     },
                     {
                        "content" : [
                           {
                              "text" : "issue there is that the pkgconfig file for libxml2 has this #define entry and weird -I location for includes. Must duplicate that  in ApplyConfigurations) for now…",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     }
