            {
               "content" : [
                  {
                     "text" : "SPEND A LITTLE TIME THINKING ABOUT EXCEPTION STUFF",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : ">> \tfirst read BS (stroustprup) book",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "\t And probably next make StringException subclass from std::exception",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "\tAnd make sure all my excpetions (or most) subclass of StringException",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "o\t(maybe rename StringExcpetion to just Exception)",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "\t",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "\tExceptionPropagateHelper\t must be redone using new C++11 features",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            }
