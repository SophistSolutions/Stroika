               "body" : {
                  "content" : [
                     {
                        "content" : [
                           {
                              "text" : "the gcc --stack-protector stuff doesnt work on aix, but ",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "text" : "echo $AIXTHREAD_DISCLAIM_GUARDPAGES",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "text" : "from ",
                              "type" : "text"
                           },
                           {
                              "marks" : [
                                 {
                                    "attrs" : {
                                       "href" : "https://www.ibm.com/support/knowledgecenter/ssw_aix_61/com.ibm.aix.performance/thread_supp_tun_params.htm"
                                    },
                                    "type" : "link"
                                 }
                              ],
                              "text" : "https://www.ibm.com/support/knowledgecenter/ssw_aix_61/com.ibm.aix.performance/thread_supp_tun_params.htm",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "text" : "may - search that file for more hints",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     }
