                  },
                  "displayName" : "Lewis Pringle",
                  "self" : "https://stroika.atlassian.net/rest/api/3/user?accountId=557058%3A4fe560ca-b4e1-41d1-9bdf-97b1684eda32",
                  "timeZone" : "America/New_York"
               },
               "body" : {
                  "content" : [
                     {
                        "content" : [
                           {
                              "text" : "another HINT on windows side - to detect stack size and usage:",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "text" : "public static class StackManagement",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "{",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "[StructLayout(LayoutKind.Sequential)]",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "struct MEMORY_BASIC_INFORMATION",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "{",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "public UIntPtr BaseAddress;",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "public UIntPtr AllocationBase;",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "public uint AllocationProtect;",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "public UIntPtr RegionSize;",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "public uint State;",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "public uint Protect;",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "public uint Type;",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "};",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "text" : "private const long STACK_RESERVED_SPACE = 4096 * 16;",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "text" : "public unsafe static bool CheckForSufficientStack(UInt64 bytes)",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "{",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "MEMORY_BASIC_INFORMATION stackInfo = new MEMORY_BASIC_INFORMATION();",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "UIntPtr currentAddr = new UIntPtr(&stackInfo);",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "VirtualQuery(currentAddr, ref stackInfo, sizeof(MEMORY_BASIC_INFORMATION));",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "text" : "UInt64 stackBytesLeft = currentAddr.ToUInt64() - stackInfo.AllocationBase.ToUInt64();",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "text" : "return stackBytesLeft > (bytes + STACK_RESERVED_SPACE);",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "}",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "text" : "[DllImport(\"kernel32.dll\")]",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "private static extern int VirtualQuery(UIntPtr lpAddress, ref MEMORY_BASIC_INFORMATION lpBuffer, int dwLength);",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "}",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     }
