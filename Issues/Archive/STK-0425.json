      "description" : {
         "content" : [
            {
               "content" : [
                  {
                     "text" : "Run regression tests on a virgin raspberrypi system. Many fail with errors about",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "missing locale",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "SHoudl fix so more flexible. But current workaorund is to just install the locale.",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "marks" : [
                        {
                           "attrs" : {
                              "href" : "http://www.jaredwolff.com/blog/raspberry-pi-setting-your-locale/"
                           },
                           "type" : "link"
                        }
                     ],
                     "text" : "http://www.jaredwolff.com/blog/raspberry-pi-setting-your-locale/",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "Edit /etc/locale.gen and uncomment the line with en_US.UTF-8",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "Run locale-gen en_US.UTF-8",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "Run update-locale en_US.UTF-8",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            }
