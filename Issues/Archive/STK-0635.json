                  },
                  "displayName" : "Lewis Pringle",
                  "self" : "https://stroika.atlassian.net/rest/api/3/user?accountId=557058%3A4fe560ca-b4e1-41d1-9bdf-97b1684eda32",
                  "timeZone" : "America/New_York"
               },
               "body" : {
                  "content" : [
                     {
                        "content" : [
                           {
                              "marks" : [
                                 {
                                    "attrs" : {
                                       "href" : "http://open-std.org/jtc1/sc22/wg21/docs/papers/2013/n3797.pdf"
                                    },
                                    "type" : "link"
                                 }
                              ],
                              "text" : "http://open-std.org/jtc1/sc22/wg21/docs/papers/2013/n3797.pdf",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "A static data member of literal type can be declared in the",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "class definition with the constexpr specifier; if so, its declaration shall specify a brace-or-equal-initializer",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "in which every initializer-clause that is an assignment-expression is a constant expression. [ Note: In both",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "these cases, the member may appear in constant expressions. — end note ] The member shall still be defined",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "in a namespace scope if it is odr-used (3.2) in the program and the namespace scope definition shall not",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "contain an initializer.",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     }
                  ],
                  "type" : "doc",
                  "version" : 1
               },
