                  "timeZone" : "America/New_York"
               },
               "body" : {
                  "content" : [
                     {
                        "content" : [
                           {
                              "text" : "This is now fixed.",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "text" : "The trick is:",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "text" : "struct X { ",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "static const X kValue;",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "};",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "inline constexpr X::kValue{initializer};",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "marks" : [
                                 {
                                    "attrs" : {
                                       "href" : "https://stackoverflow.com/questions/11928089/static-constexpr-member-of-same-type-as-class-being-defined"
                                    },
                                    "type" : "link"
                                 }
                              ],
                              "text" : "https://stackoverflow.com/questions/11928089/static-constexpr-member-of-same-type-as-class-being-defined",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     }
