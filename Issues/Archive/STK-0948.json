      "description" : {
         "content" : [
            {
               "content" : [
                  {
                     "text" : "# Crasher bug with Link-Time Code Generation on Visual Studio 2k19, and 2k21 (NOT 2k17)",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "# So far, only happens on OpenSSL 3.0.7",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "#       Finished generating code",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "#       C:\\Stroika\\IntermediateFiles\\Release-x86\\ThirdPartyComponents\\openssl\\crypto\\evp\\evp_lib.c(539) : fatal error C1001: Internal compiler error.",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "#       (compiler file 'D:\\a\\_work\\1\\s\\src\\vctools\\Compiler\\Utc\\src\\p2\\main.c', line 224)",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "#       To work around this problem, try simplifying or changing the program near the locations listed above.",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "#       If possible please provide a repro here: ",
                     "type" : "text"
                  },
                  {
                     "marks" : [
                        {
                           "attrs" : {
                              "href" : "https://developercommunity.visualstudio.com"
                           },
                           "type" : "link"
                        }
                     ],
                     "text" : "https://developercommunity.visualstudio.com",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "#       Please choose the Technical Support command on the Visual C++",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "#       Help menu, or open the Technical Support help file for more information",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "#           -- LGP 2022-11-02",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "ifeq (",
                     "type" : "text"
                  },
                  {
                     "marks" : [
                        {
                           "attrs" : {
                              "href" : "http://VisualStudio.Net"
                           },
                           "type" : "link"
                        }
                     ],
                     "text" : "VisualStudio.Net",
                     "type" : "text"
                  },
                  {
                     "text" : ",$(findstring ",
                     "type" : "text"
                  },
                  {
                     "marks" : [
                        {
                           "attrs" : {
                              "href" : "http://VisualStudio.Net"
                           },
                           "type" : "link"
                        }
                     ],
                     "text" : "VisualStudio.Net",
                     "type" : "text"
                  },
                  {
                     "text" : ",$(ProjectPlatformSubdir)))",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "ifeq ($(ARCH),x86)",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "ifeq ($(VERSION),3.0.7)",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "ifneq ($(findstring -GL,$(CXXFLAGS)),)",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "CFLAGS+= -GL-",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "CXXFLAGS+= -GL-",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "endif",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "endif",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "endif",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "endif",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            }
