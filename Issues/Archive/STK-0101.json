      "description" : {
         "content" : [
            {
               "content" : [
                  {
                     "text" : "\tString EVEN WITH all my fixes to String thread safety, what if you have",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "o\tGlobal",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "\tString x;",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "o\tThread 1",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "\tUse (x.c_str ())",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "o\tThread 2:",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "\tX = L”x”;",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "Use of c_str() or As<Character*> () or As<wchar_t>() instrunisically unsafe IF you use a String object from multiple threads – and overwrite it WHILE calling x.c_str()",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "COULD have changed String::x_str() to return proxy object to bump refcount, BUT that woudlnt work with uses through (…) – like Format() – which is probably 99% of uses, so not a good idea.",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            },
            {
               "content" : [
                  {
                     "text" : "(OR - COULD return proxy object but hiding simpler)",
                     "type" : "text"
                  }
               ],
               "type" : "paragraph"
            }
         ],
         "type" : "doc",
         "version" : 1
      },
