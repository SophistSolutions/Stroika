      "description" : {
         "content" : [
            {
               "content" : [
                  {
                     "text" : "{    // TODO DEBUGGING",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "            // To capture issues Sterling showed me 2022-11-04",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "            try {",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "                DateTime dt = DateTime::Parse (L\"1906-05-12 12:00:00+00\", DateTime::kISO8601Format);",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "                VerifyTestResult (false);",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "            }",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "            catch (const DateTime::FormatException&) {",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "                // good",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "            }",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "            catch (...) {",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "                VerifyTestResult (false);",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "            }",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "            try {",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "                DateTime dt = DateTime::Parse (L\"1906-05-12T12:00:00+00\", DateTime::kISO8601Format);",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "                VerifyTestResult ((dt.GetDate () == Date{Year(1906), MonthOfYear::eMay, DayOfMonth::e12}));",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "                VerifyTestResult ((dt.GetTimeOfDay () == TimeOfDay {0, 0, 0}));",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "                VerifyTestResult (dt.GetTimezone ()->GetBiasFromUTC (dt.GetDate (), *dt.GetTimeOfDay ()) == 0);",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "            }",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "            catch (...) {",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "                VerifyTestResult (false);",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "            }",
                     "type" : "text"
                  },
                  {
                     "type" : "hardBreak"
                  },
                  {
                     "text" : "         }",
                     "type" : "text"
