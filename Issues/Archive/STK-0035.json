               "body" : {
                  "content" : [
                     {
                        "content" : [
                           {
                              "text" : "ALSO - this is probably the same bug:",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "text" : "\tVALGRIND ISSUES",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "o\tTEST Foundation::Execution::Threads on UNIX shows two leak issues – some sort of bug? Probably",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "TRY THIS:",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "valgrind --track-origins=yes --tool=memcheck --leak-check=yes --suppressions=DefaultValgrindSuppressions.supp  ../Builds/DefaultConfiguration/Test34",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "(I DID SEE SOMETHING UNDER VALGRIND THAT COULD BE AN ISSUE)",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "MAYBE ISSUE IS:",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "void    Thread::WaitForDoneUntil (Time:",
                              "type" : "text"
                           },
                           {
                              "attrs" : {
                                 "id" : "1f603",
                                 "shortName" : ":smiley:",
                                 "text" : "😃"
                              },
                              "type" : "emoji"
                           },
                           {
                              "text" : "urationSecondsType timeoutAt) const",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "{",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "Debug::TraceContextBumper ctx (SDKSTR (\"Thread::WaitForDoneUntil\"));",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "//DbgTrace (\"(timeout = %.2f)\", timeout);",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "if (fRep_.get () == nullptr) {",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "…",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "Maybe if we don’t join we get leak?",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "// If not joinable, presume that means cuz its done",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "if (fRep_->fThread_.joinable  ()) {",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "// this will block indefinitely - but if a timeout was specified",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "fRep_->fThread_.join ();",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "}",
                              "type" : "text"
                           },
                           {
                              "type" : "hardBreak"
                           },
                           {
                              "text" : "}",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     }
