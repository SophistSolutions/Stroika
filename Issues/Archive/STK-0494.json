                     "48x48" : "https://secure.gravatar.com/avatar/9415554eef74e2169ce3e459c177ff75?d=https%3A%2F%2Favatar-management--avatars.us-west-2.prod.public.atl-paas.net%2Finitials%2FLP-4.png"
                  },
                  "displayName" : "Lewis Pringle",
                  "self" : "https://stroika.atlassian.net/rest/api/3/user?accountId=557058%3A4fe560ca-b4e1-41d1-9bdf-97b1684eda32",
                  "timeZone" : "America/New_York"
               },
               "body" : {
                  "content" : [
                     {
                        "content" : [
                           {
                              "text" : "I HAD a note",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "text" : "*",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "content" : [
                                 {
                                    "content" : [
                                       {
                                          "text" : " According to ",
                                          "type" : "text"
                                       },
                                       {
                                          "marks" : [
                                             {
                                                "attrs" : {
                                                   "href" : "http://www.boost.org/doc/libs/1_54_0/doc/html/atomic/usage_examples.html#boost_atomic.usage_examples.example_spinlock"
                                                },
                                                "type" : "link"
                                             }
                                          ],
                                          "text" : "http://www.boost.org/doc/libs/1_54_0/doc/html/atomic/usage_examples.html#boost_atomic.usage_examples.example_spinlock",
                                          "type" : "text"
                                       }
                                    ],
                                    "type" : "paragraph"
                                 }
                              ],
                              "type" : "listItem"
                           },
                           {
                              "content" : [
                                 {
                                    "content" : [
                                       {
                                          "text" : " it makes sense to use memory_order_acquire, but that doesn't seem right, as the",
                                          "type" : "text"
                                       }
                                    ],
                                    "type" : "paragraph"
                                 }
                              ],
                              "type" : "listItem"
                           },
                           {
                              "content" : [
                                 {
                                    "content" : [
                                       {
                                          "text" : " lock could protect reading or writing another memory area.",
                                          "type" : "text"
                                       }
                                    ],
                                    "type" : "paragraph"
                                 }
                              ],
                              "type" : "listItem"
                           }
                        ],
                        "type" : "bulletList"
                     },
                     {
                        "content" : [
                           {
                              "text" : "But thats wrong.",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "text" : "You use a mutex to protect some datastrucutre. When a thread acquires the lock, it wants to make sure its copy is up to date (this acqure). ANd when its done - releases the lock - it wants to assure its changes are published (the release).",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "text" : "This has PROBABLY been fine since 2.0a156 - but is now 99% sure fine as of Stroika v2.0a228 (and closing issue)",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     }
                  ],
                  "type" : "doc",
                  "version" : 1
               },
