                  "content" : [
                     {
                        "content" : [
                           {
                              "text" : "       CONSIDER LOSING kInfinity – or making it an ENUM.",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "text" : "       OR FIND DOCS saying what we do with arithmetic is safe – that infinity () + 3 == infiniiy()",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "text" : " ",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "text" : " ",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "text" : "            constexpr DurationSecondsType kInfinite = std::numeric_limits<DurationSecondsType>::max ();",
                              "type" : "text"
                           }
                        ],
                        "type" : "paragraph"
                     },
                     {
                        "content" : [
                           {
                              "text" : " ",
