# Name: stroika-platform
# Description: Stroika-specific pkg-config file to facilitate factoring builds using pkgconfig; settings for std c++ library, sdk (e.g. windows), etc. This is used in building third-party-components to assure they reference a consistent version of std c++ etc libs
# URL: https://www.sophists.com
# Libs: -L${libdir}
# Cflags: -I${includedir} -D_UNICODE -DUNICODE -D_WINDOWS -D_DEBUG -D_DISABLE_VECTOR_ANNOTATION -D_DISABLE_STRING_ANNOTATION
def generate_stroika_platform_pc_file_(config: Configuration, prefix_directory: str):
    name = 'stroika-platform'
    # todo alot left todo here
    libs = ["-L${libdir}"] + config.LinkerArgs_LibDependencies
    # todo map foo.lib to -lfoo (for windows only but harmless otherwise)
    libs = [lib if lib.startswith('-') else f'-l{lib.removesuffix(".lib")}' for lib in libs]
    cflags = config.full_CFLAG_Platform
    requires = None
    description = "Stroika-specific pkg-config file to facilitate factoring builds using pkgconfig; settings for std c++ library, sdk (e.g. windows), etc. This is used in building third-party-components to assure they reference a consistent version of std c++ etc libs";
    generate_pc_file_common_(prefix_directory, name, libs, cflags, requires, description)

def generate_stroika_foundation_pc_file_(config: Configuration, prefix_directory: str):
    name = 'stroika-foundation'
    # todo alot left todo here
    libs = ["-L${libdir}", "-lstroika-foundation"]
    cflags = config.full_CFLAG_Foundation
    requires = ["stroika-platform"] + config.PkgConfigNames.split()
    description = "Stroika-specific pkg-config file the Stroika Foundation library"
    generate_pc_file_common_(prefix_directory, name, libs, cflags, requires, description)

def generate_stroika_frameworks_pc_file_(config: Configuration, prefix_directory: str):
    name = 'stroika-frameworks'
    # todo alot left todo here
    libs = ["-L${libdir}", "-lstroika-frameworks"]
    cflags = None
    requires = ["stroika-foundation"]
    description = "Stroika-specific pkg-config file the Stroika Frameworks (UPNP, Test, WebServices, etc) library"
    generate_pc_file_common_(prefix_directory, name, libs, cflags,  requires, description)


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="Create pkgconfig files for Stroika libraries from ConfigurationFiles configuration")
    parser.add_argument( "--configuration",action="store",required=True, help="one of output of ./ScriptsLib/GetConfigurations --all")
    args = parser.parse_args()

    CONFIG = args.configuration
    xml_file = f"ConfigurationFiles/{CONFIG}.xml"
    cfgFile = Configuration(configFileName=xml_file)
    output_directory = f"Builds/{CONFIG}/"
    print (f"Writing stroika-platform.pc, stroika-foundation.pc, stroika-frameworks.pc to: {output_directory}lib/pkgconfig")
    generate_stroika_platform_pc_file_(cfgFile, output_directory)
    generate_stroika_foundation_pc_file_(cfgFile, output_directory)
    generate_stroika_frameworks_pc_file_(cfgFile, output_directory)
