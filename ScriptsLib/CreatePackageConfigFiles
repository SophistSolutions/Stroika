class Configuration:
    def __init__(self, elementTree:ET = None, configFileName: str = None):
        if configFileName and not elementTree:
            elementTree = ET.parse(configFileName)
        self.ConfigurationName = os.path.basename(configFileName) if configFileName else None
        if elementTree:
            root : ET.Element = elementTree.getroot()
            if root is not None:
                self.ConfigurationCommandLine = getText_(root.find('ConfigureCommandLine'))
                self.BuildPlatform = getText_(root.find('BuildPlatform'))
                self.BuildToolsRoot = getText_(root.find('BuildToolsRoot'))
                self.TargetPlatforms = getText_(root.find('TargetPlatforms'))
                self.ARCH = getText_(root.find('ARCH'))
                self.ConfigTags = getText_(root.find('ConfigTags'))
                self.BuildByDefault = getText_(root.find('BuildByDefault'))
                self.CPPFLAGS_NOTINCLUDES = getText_(root.find('CPPFLAGS_NOTINCLUDES'))
                self.CFLAGS = getText_(root.find('CFLAGS'))
                self.CXXFLAGS = getText_(root.find('CXXFLAGS'))

    def xxx(cls):
        print("This is a  method")


def generate_pc_file_common_(prefix_directory: str, name: str, libs: str, cflags: str, cxxflags: str, requires: str, description: str):
    outFilePath = os.path.join(prefix_directory, 'lib', 'pkgconfig', f'{name}.pc')
    os.makedirs(os.path.dirname(outFilePath), exist_ok=True)
    outFile = open(outFilePath, "w")
    outFile.write("# Automatically generated by DRAFT_PC_SUPPORT/CreatePackageConfig.py\n")
    outFile.write("# DRAFT VERSION - NOT READY TO USE\n")
    outFile.write("\n")
    outFile.write("libdir=${pcfiledir}/..\n")
    outFile.write("includedir=${pcfiledir}/../../include\n")    
    outFile.write("\n")
    outFile.write(f'Name: {name}\n')
    if description:
        outFile.write(f"Description: {description}\n")
    outFile.write("URL: https://www.sophists.com\n")    
    outFile.write("\n")
    if requires:
        outFile.write(f"Requires: {requires}\n")
    if libs:
        outFile.write(f"Libs: ${libs}\n")
    if cflags:
        outFile.write(f"Cflags: ${cflags}\n")
    if cxxflags:
        outFile.write(f"cxxflags: ${cxxflags}\n")
    outFile.close ()


