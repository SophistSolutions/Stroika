class Configuration:
    def __init__(self, elementTree:ET = None, configFileName: str = None):
        if configFileName and not elementTree:
            elementTree = ET.parse(configFileName)
        self.ConfigurationName = os.path.basename(configFileName) if configFileName else None
        if elementTree:
            root : ET.Element = elementTree.getroot()
            if root is not None:
                self.ConfigurationCommandLine = getText_(root.find('ConfigureCommandLine'))
                self.BuildPlatform = getText_(root.find('BuildPlatform'))
                self.BuildToolsRoot = getText_(root.find('BuildToolsRoot'))
                self.TargetPlatforms = getText_(root.find('TargetPlatforms'))
                self.ARCH = getText_(root.find('ARCH'))
                self.ConfigTags = getText_(root.find('ConfigTags'))
                self.BuildByDefault = getText_(root.find('BuildByDefault'))
                self.PLATFORM_CPPFLAGS_NOTINCLUDES = getText_(root.find('PLATFORM_CPPFLAGS_NOTINCLUDES'))
                self.FOUNDATION_CPPFLAGS_NOTINCLUDES = getText_(root.find('FOUNDATION_CPPFLAGS_NOTINCLUDES'))
                self.CFLAGS = getText_(root.find('CFLAGS'))
                self.CXXFLAGS = getText_(root.find('CXXFLAGS'))
                self.PLATFORM_INCLUDES_PATH = getText_(root.find('PLATFORM_INCLUDES_PATH'))
                self.FOUNDATION_INCLUDES_PATH = getText_(root.find('FOUNDATION_INCLUDES_PATH'))
                self.PkgConfigNames = getText_(root.find('PkgConfigNames'))
                self.LinkerArgs_LibDependencies = getText_(root.find('LinkerArgs_LibDependencies')).split() if root.find('LinkerArgs_LibDependencies') is not None else []

    # We return CXXFLAGS here since that is what pkg-config uses for CFLAGS
    @property
    def full_CFLAG_Platform(self):
        opts = self.CXXFLAGS.split() + self.PLATFORM_CPPFLAGS_NOTINCLUDES.split()
        # now add appropriate -I lines
        if self.PLATFORM_INCLUDES_PATH:
            opts = opts + [f'-I\"{incPath}\"' for incPath in self.PLATFORM_INCLUDES_PATH.split(pathSep)]
        return " ".join(opts)

    @property
    def full_CFLAG_Foundation(self):
        opts = self.FOUNDATION_CPPFLAGS_NOTINCLUDES.split()
        if self.FOUNDATION_INCLUDES_PATH:
            opts = opts + [f'-I"{incPath}"' for incPath in self.FOUNDATION_INCLUDES_PATH.split(pathSep)]
        return " ".join(opts)

def generate_pc_file_common_(prefix_directory: str, name: str, libs: list, cflags: str, requires: list, description: str):
    outFilePath = os.path.join(prefix_directory, 'lib', 'pkgconfig', f'{name}.pc')
    os.makedirs(os.path.dirname(outFilePath), exist_ok=True)
    outFile = open(outFilePath, "w")
    outFile.write("# Automatically generated by ${StroikaRoot}ScriptsLib/CreatePackageConfigFiles\n")
    outFile.write("\n")
    outFile.write("libdir=${pcfiledir}/..\n")
    outFile.write("includedir=${pcfiledir}/../../include\n")    
    outFile.write("\n")
    outFile.write(f'Name: {name}\n')
    outFile.write(f"Version: {getVersion_()}\n")
    if description:
        outFile.write(f"Description: {description}\n")
    outFile.write("URL: https://www.sophists.com\n")    
    outFile.write("\n")
    if requires:
        tmp = ", ".join(requires)
        outFile.write(f"Requires: {tmp}\n")
    if libs:
        tmp = ", ".join(libs)
        outFile.write(f"Libs: {" ".join(tmp)}\n")
    if cflags:
        outFile.write(f"Cflags: {cflags}\n")
    outFile.close ()


