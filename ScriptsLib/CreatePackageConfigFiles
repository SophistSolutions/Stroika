import xml.etree.ElementTree as ET
import os


pathSep =  ';' if os.name == 'nt' else  ':'


def getText_(element: ET.Element) -> str:
    if element is not None :
        return element.text
    return ""

def getVersion_() -> str:
    with open('STROIKA_VERSION', 'r') as f:
        return f.read().strip()
    
