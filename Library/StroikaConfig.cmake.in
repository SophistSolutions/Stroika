#
# Stroika's CMake package, for the configuration @STROIKA_CONFIGURATION@ - written by its build (Library/CMakeLists.txt). For
# a program built on Stroika, with this configuration's toolchain file (its compilers and flags, which must be Stroika's)
# and its Builds directory in CMAKE_PREFIX_PATH:
#     find_package (Stroika REQUIRED)
#     target_link_libraries (MyApp PRIVATE Stroika::Stroika)
# Stroika::Stroika is all of Stroika: Stroika::Frameworks, which brings Stroika::Foundation with it (either alone is there
# too); Stroika::HTMLViewCompiler compiles a .swsp file to C++; and Stroika's CMake functions (Build/Lib/CMake) are defined -
# StroikaMakeVersionFile, StroikaCopyFilesToExeDir, StroikaInstallers and StroikaEmbedFiles. The libraries are where
# Stroika's build made them, the headers in its source tree.
#

# the configuration's settings (STROIKA_*), which Stroika's functions and the finding of its third-party libraries use
include ("@configurationDir_@/Stroika-Configuration.cmake")
list (APPEND CMAKE_MODULE_PATH "@sourceRoot_@Build/Lib/CMake")
# and its build type, C++ standard and third-party components, as Stroika's own build takes them
include (StroikaBuildSettings)

if (TARGET Stroika::Foundation) # found already, here
    return ()
endif ()
include (StroikaDependencies)
include ("${CMAKE_CURRENT_LIST_DIR}/StroikaTargets.cmake")
include (StroikaCopyFilesToExeDir)
include (StroikaEmbedFiles)
include (StroikaInstallers)
include (StroikaMakeVersionFile)
